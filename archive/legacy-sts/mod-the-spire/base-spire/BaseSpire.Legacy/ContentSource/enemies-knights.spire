package base-spire {
  power Dampen {
    isDebuff = true
    removeWhenApplierDies = true
    events = [event(type=power_removed, owner=target, power=Dampen,
      effect=restoreTemporarilyDowngradedCards(Dampen, target=self))]
  }

  enemy MysteriousKnight {
    hp = variants(default=range(101, 101), tough=range(108, 108))
    startingPowers = [power(Strength, 6), power(PlatingPower, 6)]
    moves = actions(
      mysteriousKnightWarChant = applyPower(Strength, 3, target=self),
      mysteriousKnightFlail = repeat(2, attack(variants(default=9, deadly=10), target=player)),
      mysteriousKnightRam = attack(variants(default=15, deadly=17), target=player)
    )
    behavior = startWith(mysteriousKnightRam, then=chooseWithLimits(
      candidate(mysteriousKnightWarChant, weight=1, maxConsecutive=1),
      candidate(mysteriousKnightFlail, weight=2),
      candidate(mysteriousKnightRam, weight=2)
    ))
  }

  enemy MagiKnight {
    hp = variants(default=range(82, 82), tough=range(89, 89))
    moves = actions(
      magiKnightPowerShield = sequence(
        attack(variants(default=6, deadly=7), target=player),
        gainBlock(variants(default=5, tough=9), target=self)
      ),
      magiKnightDampen = if(hasPower(Dampen, target=player),
        registerPowerApplier(Dampen, target=player), else=sequence(
          applyPower(Dampen, 1, target=player),
          if(hasPower(Dampen, target=player),
            temporarilyDowngradeCards(Dampen, target=player), else=sequence())
        )
      ),
      magiKnightSpear = attack(variants(default=10, deadly=11), target=player),
      magiKnightPrep = gainBlock(variants(default=5, tough=9), target=self),
      magiKnightBomb = attack(variants(default=35, deadly=40), target=player)
    )
    behavior = graph(start=magiKnightPowerShield, edges=[
      edge(magiKnightPowerShield, magiKnightDampen),
      edge(magiKnightDampen, magiKnightSpear),
      edge(magiKnightSpear, magiKnightPrep),
      edge(magiKnightPrep, magiKnightBomb),
      edge(magiKnightBomb, magiKnightSpear)
    ])
  }
}
