package base-spire {
  potion FirePotion {
    rarity = common
    usage = combatOnly
    target = enemy
    use = attack(20, target=target, properties=[unpowered])
  }

  potion BlockPotion {
    rarity = common
    usage = combatOnly
    target = self
    use = gainBlock(12)
  }

  potion StrengthPotion {
    rarity = common
    usage = combatOnly
    target = self
    use = applyPower(Strength, 2, target=self)
  }

  potion BlessingOfTheForge {
    rarity = uncommon
    usage = combatOnly
    target = self
    use = upgradeCards(pile=hand)
  }

  potion BeetleJuice {
    rarity = rare
    usage = combatOnly
    target = enemy
    use = applyPower(Shrink, 4, target=target)
  }

  potion FlexPotion {
    rarity = common
    usage = combatOnly
    target = self
    use = applyPower(FlexPotionPower, 5, target=self)
  }
}
