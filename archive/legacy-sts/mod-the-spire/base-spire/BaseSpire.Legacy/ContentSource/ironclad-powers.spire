package base-spire {
  power BarricadePower {
    preventsBlockClear = true
  }

  power TankPower {
    incomingDamageModifiers = [modifier(multiplier=2, require=[move], exclude=[unpowered])]
  }

  power OneTwoPunchPower {
    cardRule = cardRule(type=attack, extraPlays=1, consumeOnPlayCount=true)
    removeAfterOwnerTurnEnd = true
  }

  power CorruptionPower {
    cardRule = cardRule(type=skill, cost=0, resultPile=exhaust)
  }

  power FreeAttackPower {
    cardRule = cardRule(type=attack, cost=0, consumeOnPlay=true)
  }

  power NoEnergyGainPower {
    preventEnergyGain = true
    removeAfterOwnerTurnEnd = true
  }

  power FeelNoPain {
    trigger = afterCardExhausted
    effect = gainBlock(1, perPowerStack=FeelNoPain)
  }

  power RagePower {
    trigger = afterCardPlayed
    whenCardType = attack
    effect = gainBlock(1, perPowerStack=RagePower)
    removeAfterPlayerTurnEnd = true
  }

  power JugglingPower {
    trigger = afterCardPlayed
    whenCardType = attack
    effect = if(cardPlaysThisTurn(3, type=attack, phase=started),
      cloneCard(count=scaled(0, 1, count=targetPowerAmount(JugglingPower, target=self))))
  }

  power FlameBarrierPower {
    removeAfterOpponentTurnEnd = true
    events = [event(type=damage, owner=target, require=[move], exclude=[unpowered],
      positiveAmount=false, effect=scaledAttack(0, 1,
        count=targetPowerAmount(FlameBarrierPower, target=self), target=target,
        properties=[unpowered]))]
  }

  power JuggernautPower {
    events = [event(type=block, owner=source,
      effect=randomAttack(scaled(0, 1, count=targetPowerAmount(JuggernautPower, target=self)),
        properties=[unpowered]))]
  }

  power RupturePower {
    trigger = afterCardPlayed
    effect = applyScaledPower(Strength, 0, 1,
      count=takePowerEventAmount(RupturePower), target=self)
    events = [
      event(type=damage, owner=target, ownerTurnOnly=true, deferToCardPlayed=true,
        effect=applyScaledPower(Strength, 0, 1,
          count=targetPowerAmount(RupturePower, target=self), target=self)),
      event(type=hp_loss, owner=target, ownerTurnOnly=true, deferToCardPlayed=true,
        effect=applyScaledPower(Strength, 0, 1,
          count=targetPowerAmount(RupturePower, target=self), target=self))
    ]
  }

  power DarkEmbracePower {
    trigger = afterPlayerTurnEnd
    effect = draw(scaled(0, 1, count=product(
      takePowerTurnEventAmount(DarkEmbracePower),
      targetPowerAmount(DarkEmbracePower, target=self))))
    events = [
      event(type=card_exhausted, owner=source, ownerTurnOnly=false, causedByEthereal=false,
        effect=draw(scaled(0, 1, count=targetPowerAmount(DarkEmbracePower, target=self)))),
      event(type=card_exhausted, owner=source, ownerTurnOnly=false, causedByEthereal=true,
        deferToOwnerTurnEnd=true, accumulate=eventCount, effect=sequence())
    ]
  }

  power ViciousPower {
    events = [event(type=power, owner=source, power=Vulnerable,
      ownerTurnOnly=false,
      effect=draw(scaled(0, 1, count=targetPowerAmount(ViciousPower, target=self))))]
  }

  power PlatingPower {
    on = [
      trigger(event=afterOwnerTurnStart, effect=decrementPower(PlatingPower)),
      trigger(event=afterOwnerTurnEnd, effect=gainBlock(1, perPowerStack=PlatingPower))
    ]
  }

  power ColossusPower {
    trigger = afterEnemyTurnEnd
    decrementOnTrigger = true
    incomingDamageModifiers = [modifier(multiplier=0.5, require=[move], exclude=[unpowered],
      sourcePower=Vulnerable)]
  }

  power AggressionPower {
    on = [trigger(event=afterOwnerTurnStart,
      effect=randomMoveCards(from=discard, to=hand,
        count=scaled(0, 1, count=targetPowerAmount(AggressionPower, target=self)),
        filter=attack, after=upgradeSelectedCard()))]
  }

  power PyrePower {
    maxEnergyPerStack = 1
  }

  power CrueltyPower {
    vulnerableMultiplierPercentPerStack = 1
  }

  power SetupStrikePower {
    isTemporary = true
    onStackChange = grantPower(Strength, stackDelta)
    onExpire = grantPower(Strength, negativeSourceStacks)
    removeAfterOwnerTurnEnd = true
  }

  power ManglePower {
    isDebuff = true
    isTemporary = true
    onStackChange = grantPower(Strength, negativeStackDelta)
    onExpire = grantPower(Strength, sourceStacks)
    removeAfterOwnerTurnEnd = true
  }

  power CrimsonMantlePower {
    variables = [variable(SelfDamage, 0)]
    on = [trigger(event=afterOwnerTurnStart, effect=sequence(
      scaledAttack(0, 1, count=powerVariable(CrimsonMantlePower, SelfDamage),
        target=self, properties=[unblockable, unpowered]),
      gainBlock(1, perPowerStack=CrimsonMantlePower)
    ))]
  }

  power InfernoPower {
    variables = [variable(SelfDamage, 0)]
    on = [trigger(event=afterOwnerTurnStart,
      effect=scaledAttack(0, 1, count=powerVariable(InfernoPower, SelfDamage),
        target=self, properties=[unblockable, unpowered]))]
    events = [event(type=damage, owner=target, ownerTurnOnly=true,
      effect=scaledAttack(0, 1, count=targetPowerAmount(InfernoPower, target=self),
        target=allEnemies, properties=[unpowered]))]
  }

  power StampedePower {
    on = [trigger(event=afterAutoPostPlayPhaseEntered,
      effect=autoPlayRandomCards(from=hand,
        count=scaled(0, 1, count=targetPowerAmount(StampedePower, target=self)), type=attack))]
  }

  power HellraiserPower {
    events = [event(type=draw, owner=source, phase=early, cardTag=Strike,
      effect=autoPlaySelectedCard(from=hand))]
  }

  power WellLaidPlansPower {
    on = [trigger(event=beforeFlushLate,
      effect=chooseCards(from=hand, prompt="Choose cards to retain", minChoices=0,
        maxChoices=scaled(0, 1, count=targetPowerAmount(WellLaidPlansPower, target=self)),
        filter=notRetained, onSelected=retainSelectedCard()))]
  }

  power UnmovablePower {
    blockGainModifiers = [modifier(multiplier=2, require=[move], priorEntriesPerStack=1,
      playerOnly=true)]
  }
}
