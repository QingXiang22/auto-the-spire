using namespace base-spire;
dsl_version = "core/0.3"

# Monster-room gold reward. EncounterModel.MinGoldReward / MaxGoldReward are 10..20 for RoomType.Monster at
# Ascension 0, and the source rolls inside that inclusive range. sampleInt is half-open, so the upper bound is
# 21. The roll shares the original player's Rewards stream with potion and card rewards.
# Elite and boss ranges and gold proportion for escapes are not migrated.
# Source GoldReward.Populate stores the amount; OnSelect grants gold only when the player claims it.
procedure OfferCombatGold {
  parameters = { owner = Ref(Player) }
  locals = { amount = Int }
  body = {
    if = {
      condition = equal(field(owner, Player.Room), "rewards")
      then = { fail = { message = "Close the previous development rewards first" } }
    }
    sampleInt = { stream = "base-spire:player:rewards" min = 10 max = 21 into = amount }
    set = { target = owner field = Player.GoldRewardAmount value = amount }
    set = { target = owner field = Player.GoldRewardPending value = true }
    set = { target = owner field = Player.Room value = "rewards" }
    set = { target = owner field = Player.RoomUsed value = false }
    set = { target = owner field = Player.PendingForge value = false }
  }
}
procedure WhenCombatEnded {
  parameters = { owner = Ref(Player) victory = Bool }
  body = {
    if = { condition = not(isNone(field(owner, Player.CurrentRun))) then = { return = {} } }
    if = { condition = field(owner, Player.CombatTimedOut) then = {
      set = { target = owner field = Player.Room value = "none" }
      return = {}
    } }
    if = {
      condition = and(victory, greater(field(owner, Player.Hp), 0))
      then = {
        if = { condition = equal(field(owner, Player.CharacterId), "base-spire:ironclad") then = {
          call = { procedure = OfferNormalCombatRewards args = { owner = owner visitId = add(field(owner, Player.DevelopmentRewardVisit), 1) source = "monster" actIndex = 0 ascension = 0 } }
          set = { target = owner field = Player.DevelopmentRewardVisit value = add(field(owner, Player.DevelopmentRewardVisit), 1) }
        } else = { call = { procedure = OfferCombatGold args = { owner = owner } } } }
      }
    }
  }
}
subscription OnCombatEnded { event = CombatEnded reaction = WhenCombatEnded }

procedure ClaimDevelopmentGoldReward {
  parameters = { owner = Ref(Player) }
  body = {
    if = {
      condition = not(and(equal(field(owner, Player.Room), "rewards"), field(owner, Player.GoldRewardPending)))
      then = { fail = { message = "No development gold reward is pending" } }
    }
    call = { procedure = GainGoldWithSource args = { owner = owner amount = field(owner, Player.GoldRewardAmount) source = "base-spire:combat-gold-reward" } }
    set = { target = owner field = Player.GoldRewardPending value = false }
    set = { target = owner field = Player.GoldRewardAmount value = 0 }
  }
}
procedure CloseDevelopmentRewards {
  parameters = { owner = Ref(Player) }
  locals = { rewards = Binding }
  body = {
    if = {
      condition = not(equal(field(owner, Player.Room), "rewards"))
      then = { fail = { message = "No development rewards are open" } }
    }
    let = { into = rewards value = field(owner, Player.CurrentRewardSet) }
    call = { procedure = ClearCombatCardReward args = { owner = owner } }
    call = { procedure = ClearCombatPotionReward args = { owner = owner } }
    if = { condition = not(isNone(field(owner, Player.CurrentRewardSet))) then = {
      set = { target = field(owner, Player.CurrentRewardSet) field = CombatRewardSet.Closed value = true }
      set = { target = owner field = Player.CurrentRewardSet value = none }
    } }
    set = { target = owner field = Player.GoldRewardPending value = false }
    set = { target = owner field = Player.GoldRewardAmount value = 0 }
    set = { target = owner field = Player.Room value = "none" }
    set = { target = owner field = Player.RoomUsed value = false }
    set = { target = owner field = Player.PendingForge value = false }
    if = { condition = not(isNone(field(owner, Player.CurrentRun))) then = { call = { procedure = CloseNormalVisit args = { owner = owner rewards = rewards } } } }
  }
}
action ClaimDevelopmentGoldReward {
  role = player
  requires = and(equal(field(first(type(Player)), Player.Room), "rewards"), field(first(type(Player)), Player.GoldRewardPending))
  body = { call = { procedure = ClaimDevelopmentGoldReward args = { owner = first(type(Player)) } } }
}
action CloseDevelopmentRewards {
  role = player
  requires = equal(field(first(type(Player)), Player.Room), "rewards")
  body = { call = { procedure = CloseDevelopmentRewards args = { owner = first(type(Player)) } } }
}
