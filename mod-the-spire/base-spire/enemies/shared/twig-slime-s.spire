using namespace base-spire;
dsl_version = "core/0.3"
template TwigSlimeSContent { body = {
  use Graph { template = EnemyMoveGraphDefinition args = { definition = "base-spire:twig-slime-s" initial = "TACKLE_MOVE" } }
  use Tackle { template = EnemyMoveNodeDefinition args = { definition = "base-spire:twig-slime-s" id = "TACKLE_MOVE" next = "TACKLE_MOVE" intent = "attack" index = 0 } }
  procedure Execute {
    parameters = { owner = Ref(Player) target = Ref(Enemy) node = Ref(EnemyMoveNode) }
    body = { call = { procedure = DamagePlayerPowered args = { attacker = target owner = owner amount = 4 } } }
  }
  dispatchCase Execute { dispatch = ExecuteEnemyMove key = "base-spire:twig-slime-s" procedure = Execute }
  action Spawn { role = player body = { call = { procedure = SpawnDevelopmentEnemy args = { definition = "base-spire:twig-slime-s" hp = 7 } } } }
} }
use TwigSlimeS { template = TwigSlimeSContent }
