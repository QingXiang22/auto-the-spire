using namespace base-spire;
dsl_version = "core/0.3"

template AxeRubyRaiderContent { body = {
  use Graph { template = EnemyMoveGraphDefinition args = { definition = "base-spire:axe-ruby-raider" initial = "SWING_1" } }
  use First { template = EnemyMoveNodeDefinition args = { definition = "base-spire:axe-ruby-raider" id = "SWING_1" next = "SWING_2" intent = "attack,defend" index = 0 } }
  use Second { template = EnemyMoveNodeDefinition args = { definition = "base-spire:axe-ruby-raider" id = "SWING_2" next = "BIG_SWING" intent = "attack,defend" index = 1 } }
  use Big { template = EnemyMoveNodeDefinition args = { definition = "base-spire:axe-ruby-raider" id = "BIG_SWING" next = "SWING_1" intent = "attack" index = 2 } }
  procedure Execute { parameters = { owner = Ref(Player) target = Ref(Enemy) node = Ref(EnemyMoveNode) } body = {
    if = { condition = equal(field(node, EnemyMoveNode.Id), "BIG_SWING") then = {
      call = { procedure = EnemyAttack args = { attacker = target defender = owner amount = 12 hits = 1 } }
    } else = {
      call = { procedure = EnemyAttack args = { attacker = target defender = owner amount = 5 hits = 1 } }
      call = { procedure = GainEnemyBlock args = { target = target amount = 5 } }
    } }
  } }
  dispatchCase Execute { dispatch = ExecuteEnemyMove key = "base-spire:axe-ruby-raider" procedure = Execute }
  action Spawn { role = player requires = pureCall(CanUseDevelopmentActions, first(type(Player))) body = {
    call = { procedure = SpawnDevelopmentEnemy args = { definition = "base-spire:axe-ruby-raider" hp = 20 } }
  } }
} }
use AxeRubyRaider { template = AxeRubyRaiderContent }
