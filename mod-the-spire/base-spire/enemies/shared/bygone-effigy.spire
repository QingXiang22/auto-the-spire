using namespace base-spire;
dsl_version = "core/0.3"
# Locked sts2-sim 611cea2, BygoneEffigy.cs, single-player A0.
template BygoneEffigyContent { body = {
  use Graph { template = EnemyMoveGraphDefinition args = { definition = "base-spire:bygone-effigy" initial = "SLEEP_MOVE" } }
  use Move0 { template = EnemyMoveNodeDefinition args = { definition = "base-spire:bygone-effigy" id = "SLEEP_MOVE" next = "WAKE_MOVE" intent = "sleep" index = 0 } }
  use Move1 { template = EnemyMoveNodeDefinition args = { definition = "base-spire:bygone-effigy" id = "WAKE_MOVE" next = "SLASHES_MOVE" intent = "buff" index = 1 } }
  use Move2 { template = EnemyMoveNodeDefinition args = { definition = "base-spire:bygone-effigy" id = "SLASHES_MOVE" next = "SLASHES_MOVE" intent = "attack" index = 2 } }
  procedure Execute { parameters = { owner = Ref(Player) target = Ref(Enemy) node = Ref(EnemyMoveNode) } locals = { card = Binding } body = {
    if = { condition = equal(field(node, EnemyMoveNode.Id), "SLEEP_MOVE") then = {  } }
    if = { condition = equal(field(node, EnemyMoveNode.Id), "WAKE_MOVE") then = { call = { procedure = ApplyEnemyPower args = { target = target definition = "base-spire:strength-power" stacks = 10 } } } }
    if = { condition = equal(field(node, EnemyMoveNode.Id), "SLASHES_MOVE") then = { call = { procedure = EnemyAttack args = { attacker = target defender = owner amount = 13 hits = 1 } } } }
  } }
  dispatchCase Execute { dispatch = ExecuteEnemyMove key = "base-spire:bygone-effigy" procedure = Execute }
  procedure Enter { parameters = { owner = Ref(Player) target = Ref(Enemy) } body = {
    if = { condition = equal(field(target, Enemy.DefinitionId), "base-spire:bygone-effigy") then = { call = { procedure = ApplyEnemyPower args = { target = target definition = "base-spire:slow-power" stacks = 1 } } } }
  } }
  subscription Enter { event = EnemyAddedToCombat reaction = Enter }
  action Spawn { role = player requires = pureCall(CanSpawnDevelopmentEnemies, first(type(Player))) locals = { target = Binding } body = {
    call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:bygone-effigy" min = 127 max = 127 } into = target }
  } }
} }
use BygoneEffigy { template = BygoneEffigyContent }
