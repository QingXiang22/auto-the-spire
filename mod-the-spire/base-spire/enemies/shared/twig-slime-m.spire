using namespace base-spire;
dsl_version = "core/0.3"

# Source TwigSlimeM.cs, A0: HP 26..28 (development minimum 26), damage 11, one Slimed.
# AddBranch(attack, 2) is maxRepeats=2, weight=1, cooldown=0; status CannotRepeat is maxRepeats=1.
template TwigSlimeMContent { body = {
  use Graph { template = EnemyMoveGraphDefinition args = { definition = "base-spire:twig-slime-m" initial = "STICKY_SHOT_MOVE" } }
  use Attack { template = EnemyMoveNodeDefinition args = { definition = "base-spire:twig-slime-m" id = "POKEY_POUNCE_MOVE" next = "RAND" intent = "attack" index = 0 } }
  use Sticky { template = EnemyMoveNodeDefinition args = { definition = "base-spire:twig-slime-m" id = "STICKY_SHOT_MOVE" next = "RAND" intent = "status" index = 1 } }
  use Random { template = EnemyMoveNodeDefinition args = { definition = "base-spire:twig-slime-m" id = "RAND" kind = "random" } }
  use AttackBranch { template = EnemyMoveBranchDefinition args = { definition = "base-spire:twig-slime-m" node = "RAND" target = "POKEY_POUNCE_MOVE" maxRepeats = 2 } }
  use StickyBranch { template = EnemyMoveBranchDefinition args = { definition = "base-spire:twig-slime-m" node = "RAND" target = "STICKY_SHOT_MOVE" maxRepeats = 1 } }
  procedure Execute {
    parameters = { owner = Ref(Player) target = Ref(Enemy) node = Ref(EnemyMoveNode) }
    locals = { card = Binding }
    body = {
      if = { condition = equal(field(node, EnemyMoveNode.Id), "STICKY_SHOT_MOVE") then = {
        call = { procedure = CreateCardInstance args = { owner = owner definition = "base-spire:slimed" } into = card }
        call = { procedure = GenerateCardIntoCombat args = { owner = owner card = card creator = none to = "discard" clone = false } }
      } else = { call = { procedure = DamagePlayerPowered args = { attacker = target owner = owner amount = 11 } } } }
    }
  }
  dispatchCase Execute { dispatch = ExecuteEnemyMove key = "base-spire:twig-slime-m" procedure = Execute }
  action Spawn { role = player requires = pureCall(CanSpawnDevelopmentEnemies, first(type(Player))) body = { call = { procedure = SpawnDevelopmentEnemy args = { definition = "base-spire:twig-slime-m" hp = 26 } } } }
} }
use TwigSlimeM { template = TwigSlimeMContent }
