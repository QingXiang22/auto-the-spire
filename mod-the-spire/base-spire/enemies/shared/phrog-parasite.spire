using namespace base-spire;
dsl_version = "core/0.3"
# Locked sts2-sim 611cea2, PhrogParasite.cs, single-player A0.
template PhrogParasiteContent { body = {
  use Graph { template = EnemyMoveGraphDefinition args = { definition = "base-spire:phrog-parasite" initial = "INFECT_MOVE" } }
  use Move0 { template = EnemyMoveNodeDefinition args = { definition = "base-spire:phrog-parasite" id = "INFECT_MOVE" next = "LASH_MOVE" intent = "status" index = 0 } }
  use Move1 { template = EnemyMoveNodeDefinition args = { definition = "base-spire:phrog-parasite" id = "LASH_MOVE" next = "INFECT_MOVE" intent = "attack" index = 1 } }
  procedure Execute { parameters = { owner = Ref(Player) target = Ref(Enemy) node = Ref(EnemyMoveNode) } locals = { card = Binding } body = {
    if = { condition = equal(field(node, EnemyMoveNode.Id), "INFECT_MOVE") then = { repeat = { count = 3 body = { call = { procedure = CreateCardInstance args = { owner = owner definition = "base-spire:infection" } into = card } call = { procedure = GenerateCardIntoCombat args = { owner = owner card = card creator = none to = "discard" clone = false } } } } } }
    if = { condition = equal(field(node, EnemyMoveNode.Id), "LASH_MOVE") then = { call = { procedure = EnemyAttack args = { attacker = target defender = owner amount = 4 hits = 4 } } } }
  } }
  dispatchCase Execute { dispatch = ExecuteEnemyMove key = "base-spire:phrog-parasite" procedure = Execute }
  procedure Enter { parameters = { owner = Ref(Player) target = Ref(Enemy) } body = {
    if = { condition = equal(field(target, Enemy.DefinitionId), "base-spire:phrog-parasite") then = { call = { procedure = ApplyEnemyPower args = { target = target definition = "base-spire:infested-power" stacks = 4 } } } }
  } }
  subscription Enter { event = EnemyAddedToCombat reaction = Enter }
  action Spawn { role = player requires = pureCall(CanSpawnDevelopmentEnemies, first(type(Player))) locals = { target = Binding } body = {
    call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:phrog-parasite" min = 61 max = 64 } into = target }
  } }
} }
use PhrogParasite { template = PhrogParasiteContent }
