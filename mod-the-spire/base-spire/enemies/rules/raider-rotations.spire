using namespace base-spire;
dsl_version = "core/0.3"

# Scripted Raider rotations from sts2/src/Core/Models/Monsters. Each template owns one enemy's move list and
# advances Enemy.MoveIndex exactly like the source state machine's FollowUpState chain. Initial HP uses the
# source minimum because the roll inside the source range is part of the (unmigrated) run RNG.

# AxeRubyRaider.cs (Ascension 0): MinInitialHp 20; SWING_1 and SWING_2 both deal 5 damage and gain 5 block,
# BIG_SWING deals 12, and the chain is SWING_1 -> SWING_2 -> BIG_SWING -> SWING_1.
template AttackDefendRotationEnemy {
  parameters = {
    definition = { type = String(length = 64) }
    hp = { type = Int(min = 1, max = 9999) }
    damage = { type = Int(min = 0, max = 999) }
    block = { type = Int(min = 0, max = 999) }
    bigDamage = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenEnemyTurn {
      parameters = { owner = Ref(Player) target = Ref(Enemy) }
      body = {
        if = {
          condition = equal(field(target, Enemy.DefinitionId), arg(definition))
          then = {
            if = {
              condition = equal(field(target, Enemy.MoveIndex), 2)
              then = {
                call = { procedure = DamagePlayerPowered args = { attacker = target owner = owner amount = arg(bigDamage) } }
                set = { target = target field = Enemy.MoveIndex value = 0 }
                set = { target = target field = Enemy.Intent value = "attack" }
              }
              else = {
                call = { procedure = DamagePlayerPowered args = { attacker = target owner = owner amount = arg(damage) } }
                call = { procedure = GainEnemyBlock args = { target = target amount = arg(block) } }
                set = { target = target field = Enemy.MoveIndex value = add(field(target, Enemy.MoveIndex), 1) }
                set = { target = target field = Enemy.Intent value = "attack" }
              }
            }
          }
        }
      }
    }
    subscription OnEnemyTurn { event = EnemyTurnStarted reaction = WhenEnemyTurn }
    action Spawn {
      role = player
      requires = pureCall(CanUseDevelopmentActions, first(type(Player)))
      locals = { target = Binding }
      body = {
        create = {
          type = Enemy scope = frameScope() into = target
          fields = { DefinitionId = arg(definition) SpawnOrder = count(type(Enemy)) Hp = arg(hp) MaxHp = arg(hp) MoveIndex = 0 Intent = "attack" }
        }
      }
    }
  }
}

# CrossbowRubyRaider.cs (Ascension 0): MinInitialHp 18; RELOAD gains 3 block, FIRE deals 14 damage, and the
# chain starts on RELOAD and alternates.
template BlockThenAttackEnemy {
  parameters = {
    definition = { type = String(length = 64) }
    hp = { type = Int(min = 1, max = 9999) }
    block = { type = Int(min = 0, max = 999) }
    damage = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenEnemyTurn {
      parameters = { owner = Ref(Player) target = Ref(Enemy) }
      body = {
        if = {
          condition = equal(field(target, Enemy.DefinitionId), arg(definition))
          then = {
            if = {
              condition = equal(field(target, Enemy.MoveIndex), 0)
              then = {
                call = { procedure = GainEnemyBlock args = { target = target amount = arg(block) } }
                set = { target = target field = Enemy.MoveIndex value = 1 }
                set = { target = target field = Enemy.Intent value = "attack" }
              }
              else = {
                call = { procedure = DamagePlayerPowered args = { attacker = target owner = owner amount = arg(damage) } }
                set = { target = target field = Enemy.MoveIndex value = 0 }
                set = { target = target field = Enemy.Intent value = "defend" }
              }
            }
          }
        }
      }
    }
    subscription OnEnemyTurn { event = EnemyTurnStarted reaction = WhenEnemyTurn }
    action Spawn {
      role = player
      requires = pureCall(CanUseDevelopmentActions, first(type(Player)))
      locals = { target = Binding }
      body = {
        create = {
          type = Enemy scope = frameScope() into = target
          fields = { DefinitionId = arg(definition) SpawnOrder = count(type(Enemy)) Hp = arg(hp) MaxHp = arg(hp) MoveIndex = 0 Intent = "defend" }
        }
      }
    }
  }
}

# TrackerRubyRaider.cs (Ascension 0): MinInitialHp 21; TRACK applies FrailPower 2 to the target, then
# HOUNDS_MOVE hits for 1 damage eight times and repeats forever.
template DebuffThenMultiAttackEnemy {
  parameters = {
    definition = { type = String(length = 64) }
    hp = { type = Int(min = 1, max = 9999) }
    frail = { type = Int(min = 1, max = 999) }
    damage = { type = Int(min = 0, max = 999) }
    hits = { type = Int(min = 1, max = 9) }
  }
  body = {
    procedure WhenEnemyTurn {
      parameters = { owner = Ref(Player) target = Ref(Enemy) }
      body = {
        if = {
          condition = equal(field(target, Enemy.DefinitionId), arg(definition))
          then = {
            if = {
              condition = equal(field(target, Enemy.MoveIndex), 0)
              then = {
                call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:frail-power" stacks = arg(frail) } }
                set = { target = target field = Enemy.MoveIndex value = 1 }
                set = { target = target field = Enemy.Intent value = "attack" }
              }
              else = {
                repeat = {
                  count = arg(hits)
                  body = { call = { procedure = DamagePlayerPowered args = { attacker = target owner = owner amount = arg(damage) } } }
                }
              }
            }
          }
        }
      }
    }
    subscription OnEnemyTurn { event = EnemyTurnStarted reaction = WhenEnemyTurn }
    action Spawn {
      role = player
      requires = pureCall(CanUseDevelopmentActions, first(type(Player)))
      locals = { target = Binding }
      body = {
        create = {
          type = Enemy scope = frameScope() into = target
          fields = { DefinitionId = arg(definition) SpawnOrder = count(type(Enemy)) Hp = arg(hp) MaxHp = arg(hp) MoveIndex = 0 Intent = "debuff" }
        }
      }
    }
  }
}
