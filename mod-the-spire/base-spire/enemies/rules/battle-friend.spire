using namespace base-spire;
dsl_version = "core/0.3"

template BattleFriendEnemy {
  parameters = { definition = { type = String(length = 64) } hp = { type = Int(min = 1, max = 9999) } }
  body = {
    use Graph { template = EnemyMoveGraphDefinition args = { definition = arg(definition) initial = "IDLE" } }
    use Idle { template = EnemyMoveNodeDefinition args = { definition = arg(definition) id = "IDLE" next = "IDLE" intent = "stun" index = 0 } }
    procedure Execute { parameters = { owner = Ref(Player) target = Ref(Enemy) node = Ref(EnemyMoveNode) } body = {} }
    dispatchCase Execute { dispatch = ExecuteEnemyMove key = arg(definition) procedure = Execute }
    procedure Added { parameters = { owner = Ref(Player) target = Ref(Enemy) } body = {
      if = { condition = equal(field(target, Enemy.DefinitionId), arg(definition)) then = {
        call = { procedure = ApplyEnemyPower args = { target = target definition = "base-spire:battleworn-dummy-time-limit-power" stacks = 3 } }
      } }
    } }
    subscription Added { event = EnemyAddedToCombat reaction = Added }
    procedure Escape { parameters = { owner = Ref(Player) listener = Ref(Enemy) } body = {
      if = { condition = pureCall(BattlewornDummyTimeLimitPower.Expired, listener) then = {
        call = { procedure = EscapeEnemy args = { owner = owner target = listener } }
      } }
    } }
    subscription Escape {
      event = AfterEnemySideTurnEnd reaction = Escape
      instances = where(type(Enemy), e, and(equal(field(e, Enemy.DefinitionId), arg(definition)), pureCall(EnemyIsActive, e)))
      instance_order = pureCall(EnemyHookOrder, listener, false) priority = 0
    }
    action Spawn { role = player requires = pureCall(CanUseDevelopmentActions, first(type(Player))) locals = { hp = Int } body = {
      call = { procedure = RollEncounterEnemyHp args = { min = arg(hp) max = arg(hp) } into = hp }
      call = { procedure = SpawnDevelopmentEnemy args = { definition = arg(definition) hp = hp } }
    } }
  }
}
