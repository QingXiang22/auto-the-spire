<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ENV-T09.2 商店模块的**历史独立验证工程**（只读留档）。

    2026-10-11 ENV-T09-shop-integration：商店已迁移进正式生产树
    （`BaseSpire/Slice/ShopRoomWiring.cs`、`BaseSpire/Slice/ShopCompute.cs`、
    `BaseSpire/Slice/ColorlessShopPool.cs`），正式入口检查在
    `BaseSpire.Slice.Tests/ShopFlowChecks.cs`。本工程保留旧交付可追溯，但**不再编译**：

      * 原来编译的 `..\ShopRoomWiring.cs` / `..\ShopCompute.cs` 已改名为
        `*.cs.frozen-20261011`（冻结副本，含旧的两瓶药水主机与整条 64 项无色抽样，
        后者已确认不符合源 `CardFactory.cs:69-79` 的"先按稀有度过滤再 NextItem"）；
      * 它引用的 `dsh-core-author-04` 冻结二进制是旧池，不能当作现行内容池验收。

    重新运行需要显式把下面两条 `Compile` 指回冻结副本，并且只用于对照旧交付行为，
    不作为当前门槛。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <AssemblyName>ShopFlowChecks</AssemblyName>
    <RootNamespace>BaseSpire.Slice.ShopFlowChecks</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <FrozenBinariesDir>$(MSBuildThisFileDirectory)..\..\..\..\..\.artifacts\parallel\dsh-core-author-04\bin\BaseSpire\debug</FrozenBinariesDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Core.TheSpire">
      <HintPath>$(FrozenBinariesDir)\Core.TheSpire.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BaseSpire">
      <HintPath>$(FrozenBinariesDir)\BaseSpire.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
