using namespace base-spire;
dsl_version = "core/0.3"
# Relic that applies a player power at combat start. BronzeScales.cs grants ThornsPower 3 from
# AfterRoomEntered(CombatRoom); the development combat start is the equivalent time point here.

template BeforeCombatStartPowerRelic {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    stacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenCombatStarts {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        call = {
          procedure = ApplyPlayerPower args = {
            owner = owner definition = arg(power) stacks = arg(stacks)
          }
        }
      }
    }
    subscription OnCombatStart {
      event = BeforeCombatStart reaction = WhenCombatStarts instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
