using namespace base-spire;
dsl_version = "core/0.3"
# Relic that debuffs every hittable enemy when a combat starts. BagOfMarbles.cs applies VulnerablePower 1 to
# the combat's hittable enemies from its room-entry hook; the development combat start is the equivalent point.

template BeforeCombatStartEnemyPowerRelic {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    stacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenCombatStarts {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        forEach = {
          query = where(type(Enemy), enemy, pureCall(EnemyIsActive, enemy)) item = enemy
          body = {
            call = {
              procedure = ApplyEnemyPower args = {
                target = enemy definition = arg(power) stacks = arg(stacks)
              }
            }
          }
        }
      }
    }
    subscription OnCombatStart {
      event = BeforeCombatStart reaction = WhenCombatStarts instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = collectionIndex(Relics, listener) priority = 100
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
