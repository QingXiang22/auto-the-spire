using namespace base-spire;
dsl_version = "core/0.3"
# Orichalcum captures zero block in Early, before Power listeners, and consumes that
# per-instance eligibility in the ordinary phase even if another listener granted block.
template TurnEndNoBlockRelic {
  parameters = { definition = { type = String(length = 64) } block = { type = Int(min = 0, max = 999) } }
  body = {
    entity State { fields = { Relic = { type = Ref(Relic) } Armed = { type = Bool default = false } } }
    procedure Acquired {
      parameters = { owner = Ref(Player) relic = Ref(Relic) } locals = { state = Binding }
      body = { if = { condition = equal(field(relic, Relic.DefinitionId), arg(definition)) then = {
        create = { type = State scope = entityScope(owner) into = state fields = { Relic = relic } }
      } } }
    }
    subscription Acquired { event = RelicObtained reaction = Acquired }
    procedure Removed {
      parameters = { owner = Ref(Player) relic = Ref(Relic) }
      body = { forEach = { query = where(type(State), s, equal(field(s, State.Relic), relic)) item = state body = { destroy = { target = state } } } }
    }
    subscription Removed { event = RelicRemoved reaction = Removed }
    procedure Reset {
      parameters = { owner = Ref(Player) listener = Ref(Relic) } locals = { state = Binding }
      body = {
        let = { into = state value = first(where(type(State), s, equal(field(s, State.Relic), listener))) }
        set = { target = state field = State.Armed value = false }
      }
    }
    procedure Capture {
      parameters = { owner = Ref(Player) listener = Ref(Relic) } locals = { state = Binding }
      body = {
        let = { into = state value = first(where(type(State), s, equal(field(s, State.Relic), listener))) }
        if = { condition = equal(field(owner, Player.Block), 0) then = { set = { target = state field = State.Armed value = true } } }
      }
    }
    procedure Grant {
      parameters = { owner = Ref(Player) listener = Ref(Relic) } locals = { state = Binding }
      body = {
        let = { into = state value = first(where(type(State), s, equal(field(s, State.Relic), listener))) }
        if = { condition = field(state, State.Armed) then = {
          set = { target = state field = State.Armed value = false }
          call = { procedure = GainUnpoweredBlock args = { owner = owner amount = arg(block) } }
        } }
      }
    }
    subscription Reset { event = BeforePlayerSideTurnStart reaction = Reset instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    subscription Capture { event = BeforePlayerSideTurnEndEarly reaction = Capture instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    subscription Grant { event = BeforePlayerSideTurnEnd reaction = Grant instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
# Pendulum.cs: every `turns` owner turn starts, draw `cards`. The instance counter is not reset by the
# development lifecycle, matching the saved TurnsSeen property in the source.

template EveryTurnsDrawRelic {
  parameters = {
    definition = { type = String(length = 64) }
    turns = { type = Int(min = 1, max = 999) }
    cards = { type = Int(min = 0, max = 9) }
  }
  body = {
    procedure WhenTurnStarted {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        set = { target = listener field = Relic.Counter value = modulo(add(field(listener, Relic.Counter), 1), arg(turns)) }
        if = {
          condition = equal(field(listener, Relic.Counter), 0)
          then = {
            call = {
              procedure = DrawCards args = {
                owner = owner count = arg(cards)
              }
            }
          }
        }
      }
    }
    subscription OnTurnStart {
      event = AfterPlayerSideTurnStart reaction = WhenTurnStarted instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
# Strawberry.cs: GainMaxHp adds the amount to max HP and then heals the same amount, so obtaining the relic
# raises both MaxHp and Hp by its value.

template ObtainMaxHpRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 1, max = 999) }
    fullHeal = { type = Bool default = false }
  }
  body = {
    procedure WhenObtained {
      parameters = { owner = Ref(Player) relic = Ref(Relic) listener = Ref(Relic) }
      body = {
        call = {
          procedure = IncreaseMaxHp args = {
            owner = owner amount = arg(amount)
          }
        }
        if = {
          condition = arg(fullHeal) then = {
            call = {
              procedure = HealToMaximum args = {
                owner = owner
              }
            }
          }
        }
      }
    }
    subscription OnObtained {
      event = RelicObtained reaction = WhenObtained
      instances = where(collection(Relics), r, and(equal(r, relic), and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))))
      instance_order = collectionIndex(Relics, listener)
      priority = 100
    }
    action Obtain {
      role = player
      locals = { owner = Binding }
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = {
        let = { into = owner value = first(type(Player)) }
        call = {
          procedure = ObtainRelic args = {
            owner = owner definition = arg(definition)
          }
        }
      }
    }
  }
}
# MeatOnTheBone.cs: when the combat finishes in victory and the owner's HP is at or below the threshold
# percentage of max HP, heal. A defeat does not heal.

template CombatEndHealRelic {
  parameters = {
    definition = { type = String(length = 64) }
    heal = { type = Int(min = 0, max = 999) }
    threshold = { type = Int(min = 1, max = 100) }
    early = { type = Bool default = false }
  }
  body = {
    procedure WhenCombatEnded {
      parameters = { owner = Ref(Player) victory = Bool listener = Ref(Relic) }
      body = {
        if = {
          condition = and(victory, and(greater(field(owner, Player.Hp), 0), lessOrEqual(multiply(field(owner, Player.Hp), 100), multiply(field(owner, Player.MaxHp), arg(threshold)))))
          then = {
            call = {
              procedure = Heal args = {
                owner = owner amount = arg(heal)
              }
            }
          }
        }
      }
    }
    subscription OnCombatEnded {
      event = CombatVictoryEarly reaction = WhenCombatEnded instances = where(collection(Relics), candidate, and(arg(early), and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition)))))) instance_order = collectionIndex(Relics, listener) priority = 100
    }
    subscription OnCombatVictory {
      event = CombatVictory reaction = WhenCombatEnded instances = where(collection(Relics), candidate, and(not(arg(early)), and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition)))))) instance_order = collectionIndex(Relics, listener) priority = 100
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
