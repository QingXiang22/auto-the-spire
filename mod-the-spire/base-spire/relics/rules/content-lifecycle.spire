using namespace base-spire;
dsl_version = "core/0.3"

template PickupResourceRelic {
  parameters = {
    definition = { type = String(length = 64) }
    gold = { type = Int(min = 0, max = 99999) default = 0 }
    healPercent = { type = Int(min = 0, max = 100) default = 0 }
  }
  body = {
    procedure WhenObtained {
      parameters = { owner = Ref(Player) relic = Ref(Relic) listener = Ref(Relic) }
      body = {
        call = {
          procedure = GainGold args = {
            owner = owner amount = arg(gold)
          }
        }
        call = {
          procedure = Heal args = {
            owner = owner amount = divide(multiply(field(owner, Player.MaxHp), arg(healPercent)), 100)
          }
        }
      }
    }
    subscription Obtained {
      event = RelicObtained reaction = WhenObtained
      instances = where(collection(Relics), r, and(equal(r, relic), and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))))
      instance_order = collectionIndex(Relics, listener)
      priority = 100
    }
    action Obtain {
      role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}

template HandAndRestModifierRelic {
  parameters = {
    definition = { type = String(length = 64) }
    firstTurnDraw = { type = Int(min = 0, max = 10) default = 0 }
    restHeal = { type = Int(min = 0, max = 999) default = 0 }
  }
  body = {
    procedure Draw {
      pure = true parameters = { value = Int owner = Ref(Player) listener = Ref(Relic) }
      result = Int body = {
        if = {
          condition = equal(field(owner, Player.TurnNumber), 1) then = {
            return = { value = add(value, arg(firstTurnDraw)) }
          }
        }
        return = { value = value }
      }
    }
    subscription Draw {
      event = ModifyTurnDraw reaction = Draw instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    procedure Rest {
      pure = true parameters = { value = Int owner = Ref(Player) listener = Ref(Relic) }
      result = Int body = {
        return = { value = add(value, arg(restHeal)) }
        return = { value = value }
      }
    }
    subscription Rest {
      event = ModifyRestHeal reaction = Rest instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = collectionIndex(Relics, listener) priority = 100
    }
    action Obtain {
      role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition)))) body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
# Actual play completions, not hits or distinct card instances. Each relic owns its counter.

template CardCountRelic {
  parameters = {
    definition = { type = String(length = 64) }
    kind = { type = String(length = 16) }
    every = { type = Int(min = 1, max = 999) }
    perTurn = { type = Bool }
    resetAfterStart = { type = Bool default = false }
    energy = { type = Int(min = 0, max = 999) default = 0 }
    block = { type = Int(min = 0, max = 999) default = 0 }
    damage = { type = Int(min = 0, max = 999) default = 0 }
    power = { type = String(length = 64) default = "none" }
    powerKind = { type = String(length = 32) default = "none" }
    stacks = { type = Int(min = 0, max = 999) default = 0 }
  }
  body = {
    procedure Reset {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        if = {
          condition = arg(perTurn) then = {
            set = { target = listener field = Relic.Counter value = 0 }
          }
        }
      }
    }
    subscription CombatReset {
      event = BeforeCombatStart reaction = Reset instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    subscription TurnReset {
      event = BeforePlayerSideTurnStart reaction = ResetBefore instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    procedure ResetBefore {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = { if = { condition = not(arg(resetAfterStart)) then = { call = { procedure = Reset args = { owner = owner listener = listener } } } } }
    }
    procedure ResetAfter {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = { if = { condition = and(arg(resetAfterStart), not(equal(field(owner, Player.TurnNumber), 1))) then = { call = { procedure = Reset args = { owner = owner listener = listener } } } } }
    }
    subscription ResetAfter { event = AfterPlayerSideTurnStart reaction = ResetAfter instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    procedure AfterPlay {
      parameters = { owner = Ref(Player) card = Ref(Card) listener = Ref(Relic) }
      body = {
        if = {
          condition = and(field(owner, Player.CombatActive), and(equal(field(card, Card.Kind), arg(kind)), greater(field(owner, Player.Hp), 0))) then = {
            set = { target = listener field = Relic.Counter value = modulo(add(field(listener, Relic.Counter), 1), arg(every)) }
            if = {
              condition = equal(field(listener, Relic.Counter), 0) then = {
                if = {
                  condition = greater(arg(energy), 0) then = {
                    call = {
                      procedure = GainEnergy args = {
                        owner = owner amount = arg(energy)
                      }
                    }
                  }
                }
                if = {
                  condition = greater(arg(block), 0) then = {
                    call = {
                      procedure = GainUnpoweredBlock args = {
                        owner = owner amount = arg(block)
                      }
                    }
                  }
                }
                if = {
                  condition = greater(arg(stacks), 0) then = {
                    call = {
                      procedure = ApplyPlayerPower args = {
                        owner = owner definition = arg(power) stacks = arg(stacks)
                      }
                    }
                  }
                }
                if = {
                  condition = greater(arg(damage), 0) then = {
                    call = { procedure = DamageAllEnemiesFromPlayer args = { owner = owner amount = arg(damage) } }
                  }
                }
              }
            }
          }
        }
      }
    }
    subscription Played {
      event = AfterCardPlayed reaction = AfterPlay instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, true) priority = 0
    }
    action Obtain {
      role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}

template TurnEndDamageRelic {
  parameters = {
    definition = { type = String(length = 64) }
    turn = { type = Int(min = 1, max = 999) }
    damage = { type = Int(min = 0, max = 999) }
  }
  body = {
    entity State { fields = { Relic = { type = Ref(Relic) } Armed = { type = Bool default = false } } }
    procedure Acquired {
      parameters = { owner = Ref(Player) relic = Ref(Relic) } locals = { state = Binding }
      body = { if = { condition = equal(field(relic, Relic.DefinitionId), arg(definition)) then = {
        create = { type = State scope = entityScope(owner) into = state fields = { Relic = relic } }
      } } }
    }
    subscription Acquired { event = RelicObtained reaction = Acquired }
    procedure Removed {
      parameters = { owner = Ref(Player) relic = Ref(Relic) }
      body = { forEach = { query = where(type(State), s, equal(field(s, State.Relic), relic)) item = state body = { destroy = { target = state } } } }
    }
    subscription Removed { event = RelicRemoved reaction = Removed }
    procedure Capture {
      parameters = { owner = Ref(Player) listener = Ref(Relic) } locals = { state = Binding }
      body = {
        let = { into = state value = first(where(type(State), s, equal(field(s, State.Relic), listener))) }
        set = { target = state field = State.Armed value = equal(field(owner, Player.TurnNumber), arg(turn)) }
      }
    }
    procedure Reset {
      parameters = { owner = Ref(Player) listener = Ref(Relic) } locals = { state = Binding }
      body = {
        let = { into = state value = first(where(type(State), s, equal(field(s, State.Relic), listener))) }
        set = { target = state field = State.Armed value = false }
      }
    }
    procedure Finished {
      parameters = { owner = Ref(Player) victory = Bool listener = Ref(Relic) }
      body = { call = { procedure = Reset args = { owner = owner listener = listener } } }
    }
    procedure BeforeTurnEnd {
      parameters = { owner = Ref(Player) listener = Ref(Relic) } locals = { state = Binding }
      body = {
        let = { into = state value = first(where(type(State), s, equal(field(s, State.Relic), listener))) }
        if = { condition = field(state, State.Armed) then = {
          set = { target = state field = State.Armed value = false }
          call = { procedure = DamageAllEnemiesFromPlayer args = { owner = owner amount = arg(damage) } }
        } }
      }
    }
    subscription Started { event = BeforeCombatStart reaction = Reset instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    subscription Finished { event = CombatEnded reaction = Finished instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    subscription Capture { event = AfterPlayerSideTurnStart reaction = Capture instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    subscription TurnEnd { event = BeforePlayerSideTurnEnd reaction = BeforeTurnEnd instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0 }
    action Obtain {
      role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}

template FirstHpLossDrawRelic {
  parameters = {
    definition = { type = String(length = 64) }
    cards = { type = Int(min = 0, max = 10) }
  }
  body = {
    procedure Reset {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        set = { target = listener field = Relic.UsedThisCombat value = false }
      }
    }
    subscription CombatStart {
      event = BeforeCombatStart reaction = Reset instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    procedure AfterHpLoss {
      parameters = { result = Ref(DamageResult) listener = Ref(Relic) }
      locals = { owner = Binding }
      body = {
        let = { into = owner value = field(result, DamageResult.Player) }
        if = {
          condition = and(greater(field(result, DamageResult.Unblocked), 0), and(field(owner, Player.CombatActive), greater(field(owner, Player.Hp), 0))) then = {
            if = {
              condition = and(equal(field(listener, Relic.Holder), owner), and(not(field(listener, Relic.IsMelted)), and(not(field(listener, Relic.UsedThisCombat)), equal(field(listener, Relic.DefinitionId), arg(definition))))) then = {
                set = { target = listener field = Relic.UsedThisCombat value = true }
                call = {
                  procedure = DrawCards args = {
                    owner = owner count = arg(cards)
                  }
                }
              }
            }
          }
        }
      }
    }
    subscription HpLost {
      event = AfterDamageReceived reaction = AfterHpLoss instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), field(result, DamageResult.Player)), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    action Obtain {
      role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
