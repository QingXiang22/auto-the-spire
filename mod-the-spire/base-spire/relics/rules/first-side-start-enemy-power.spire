using namespace base-spire;
dsl_version = "core/0.3"
# First-player-side debuff before block clearing and starting draw.

template FirstSideStartEnemyPowerRelic {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    stacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenSideStarts {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      locals = { applied = Binding }
      body = {
        if = { condition = not(equal(field(owner, Player.TurnNumber), 0)) then = { return = {} } }
        forEach = {
          query = where(type(Enemy), enemy, pureCall(EnemyIsActive, enemy)) item = enemy
          body = {
            call = {
              procedure = ApplyPowerWithSource args = {
                player = none enemy = enemy definition = arg(power) stacks = arg(stacks) untilTurnEnd = false applierPlayer = owner applierEnemy = none card = none play = none
              } into = applied
            }
          }
        }
      }
    }
    subscription OnCombatStart {
      event = BeforePlayerSideTurnStart reaction = WhenSideStarts instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
