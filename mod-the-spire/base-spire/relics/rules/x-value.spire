using namespace base-spire;
dsl_version = "core/0.3"

template XValueRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure Modify {
      pure = true
      parameters = { value = Int owner = Ref(Player) card = Ref(Card) listener = Ref(Relic) }
      result = Int
      body = {
        if = { condition = equal(field(card, Card.Owner), field(owner, Player.Owner)) then = {
          return = { value = add(value, arg(amount)) }
        } }
        return = { value = value }
      }
    }
    subscription Modify {
      event = ModifyXValue reaction = Modify
      instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition)))))
      instance_order = collectionIndex(Relics, listener)
      priority = 100
    }
    action Obtain {
      role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = { call = { procedure = ObtainRelic args = { owner = first(type(Player)) definition = arg(definition) } } }
    }
  }
}
