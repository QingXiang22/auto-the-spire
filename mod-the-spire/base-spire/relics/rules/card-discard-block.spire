using namespace base-spire;
dsl_version = "core/0.3"

template CardDiscardBlockRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenCardDiscarded {
      parameters = { owner = Ref(Player) card = Ref(Card) listener = Ref(Relic) }
      body = {
        if = { condition = and(field(owner, Player.CombatActive), not(field(owner, Player.EnemyPhase))) then = {
          call = { procedure = GainUnpoweredBlock args = { owner = owner amount = arg(amount) } }
        } }
      }
    }
    subscription OnCardDiscarded {
      event = CardDiscarded reaction = WhenCardDiscarded
      instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition)))))
      instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = {
        call = { procedure = ObtainRelic args = { owner = first(type(Player)) definition = arg(definition) } }
      }
    }
  }
}
