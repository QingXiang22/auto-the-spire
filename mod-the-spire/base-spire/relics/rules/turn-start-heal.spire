using namespace base-spire;
dsl_version = "core/0.3"
# BloodVial.cs: AfterPlayerTurnStartLate on the owner's first turn, heal two HP (clamped to MaxHp).

template TurnStartHealRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
    turn = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenPlayerTurnStartLate {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        if = {
          condition = equal(field(owner, Player.TurnNumber), arg(turn))
          then = {
            call = {
              procedure = Heal args = {
                owner = owner amount = arg(amount)
              }
            }
          }
        }
      }
    }
    subscription OnPlayerTurnStartLate {
      event = AfterPlayerTurnStartLate reaction = WhenPlayerTurnStartLate instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = collectionIndex(Relics, listener) priority = 100
    }
    action Obtain {
      role = player
      requires = not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition)))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
