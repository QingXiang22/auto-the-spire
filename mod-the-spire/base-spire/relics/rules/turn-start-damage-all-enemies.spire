using namespace base-spire;
dsl_version = "core/0.3"
# MercuryHourglass.cs: AfterPlayerTurnStart on the owner, unpowered damage to every hittable enemy.

template TurnStartDamageAllEnemiesRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenPlayerTurnStarts {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        call = { procedure = DamageAllEnemiesFromPlayer args = { owner = owner amount = arg(amount) } }
      }
    }
    subscription OnPlayerTurnStart {
      event = AfterPlayerTurnStart reaction = WhenPlayerTurnStarts instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
