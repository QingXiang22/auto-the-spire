using namespace base-spire;
dsl_version = "core/0.3"

template AfterShuffleBlockRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenShuffled {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        call = {
          procedure = GainUnpoweredBlock args = {
            owner = owner amount = arg(amount)
          }
        }
      }
    }
    subscription OnShuffle {
      event = AfterShuffle reaction = WhenShuffled instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = collectionIndex(Relics, listener) priority = 100
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition))))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
