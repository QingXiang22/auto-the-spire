using namespace base-spire;
dsl_version = "core/0.3"

# A relic that deals unpowered damage to every hittable enemy when its owner's
# card reaches the exhaust pile. The CardExhausted event is emitted after the
# move, so listeners observe the exhausted card in its destination pile.
template CardExhaustDamageRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenCardExhausted {
      parameters = { owner = Ref(Player) card = Ref(Card) listener = Ref(Relic) }
      body = {
        call = {
          procedure = DamageAllEnemiesFromPlayer args = {
            owner = owner amount = arg(amount)
          }
        }
      }
    }
    subscription OnCardExhausted {
      event = CardExhausted reaction = WhenCardExhausted
      instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition)))))
      instance_order = pureCall(RelicHookOrder, listener, false) priority = 0
    }
    action Obtain {
      role = player
      requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), arg(definition))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
