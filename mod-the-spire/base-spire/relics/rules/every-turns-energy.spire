using namespace base-spire;
dsl_version = "core/0.3"
# HappyFlower.cs: on every owner turn start the instance counter advances modulo `turns`; at zero,
# gain energy. The source keeps TurnsSeen across combats ([SavedProperty]), so the counter is not
# reset by the development lifecycle.

template EveryTurnsEnergyRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
    turns = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenTurnStarted {
      parameters = { owner = Ref(Player) listener = Ref(Relic) }
      body = {
        set = { target = listener field = Relic.Counter value = modulo(add(field(listener, Relic.Counter), 1), arg(turns)) }
        if = {
          condition = equal(field(listener, Relic.Counter), 0)
          then = {
            call = {
              procedure = GainEnergy args = {
                owner = owner amount = arg(amount)
              }
            }
          }
        }
      }
    }
    subscription OnTurnStart {
      event = AfterSideTurnStarted reaction = WhenTurnStarted instances = where(collection(Relics), candidate, and(equal(field(candidate, Relic.Holder), owner), and(not(field(candidate, Relic.IsMelted)), equal(field(candidate, Relic.DefinitionId), arg(definition))))) instance_order = collectionIndex(Relics, listener) priority = 100
    }
    action Obtain {
      role = player
      requires = not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition)))))
      body = {
        call = {
          procedure = ObtainRelic args = {
            owner = first(type(Player)) definition = arg(definition)
          }
        }
      }
    }
  }
}
