using namespace base-spire;
dsl_version = "core/0.3"

template WingedBootsContent { body = {
  procedure FreeTravel {
    pure = true parameters = { value = Bool owner = Ref(Player) listener = Ref(Relic) } result = Bool
    body = { return = { value = or(value, less(field(listener, Relic.Counter), 3)) } }
  }
  subscription FreeTravel {
    event = ShouldAllowFreeTravel reaction = FreeTravel
    instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), "base-spire:winged-boots"))))
    instance_order = collectionIndex(Relics, listener)
  }
  procedure Entered {
    parameters = { owner = Ref(Player) visit = Ref(RunVisit) listener = Ref(Relic) }
    locals = { previous = Binding } body = {
      let = { into = previous value = field(visit, RunVisit.PreviousNode) }
      if = { condition = or(isNone(previous), greaterOrEqual(field(listener, Relic.Counter), 3)) then = { return = {} } }
      if = { condition = not(exists(where(relation(MapChildren, previous), n, equal(n, field(visit, RunVisit.Node))))) then = {
        set = { target = listener field = Relic.Counter value = add(field(listener, Relic.Counter), 1) }
      } }
    }
  }
  subscription Entered {
    event = NormalRoomEntered reaction = Entered
    instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), "base-spire:winged-boots"))))
    instance_order = collectionIndex(Relics, listener)
  }
  procedure Removed {
    parameters = { owner = Ref(Player) relic = Ref(Relic) } locals = { run = Binding } body = {
      if = { condition = not(equal(field(relic, Relic.DefinitionId), "base-spire:winged-boots")) then = { return = {} } }
      let = { into = run value = field(owner, Player.CurrentRun) }
      if = { condition = not(isNone(run)) then = {
        if = { condition = equal(field(run, Run.Phase), "map") then = { call = { procedure = RefreshNormalMapChoices args = { owner = owner run = run } } } }
      } }
    }
  }
  subscription Removed { event = RelicRemoved reaction = Removed }
  action Obtain {
    role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), "base-spire:winged-boots")))
    body = { call = { procedure = ObtainRelic args = { owner = first(type(Player)) definition = "base-spire:winged-boots" } } }
  }
} }
use WingedBoots { template = WingedBootsContent }
