using namespace base-spire;
dsl_version = "core/0.3"

template CursedPearlContent { body = {
  procedure Obtained {
    parameters = { owner = Ref(Player) relic = Ref(Relic) listener = Ref(Relic) }
    locals = { card = Binding } body = {
      call = { procedure = CreateCardInstance args = { owner = owner definition = "base-spire:greed" } into = card }
      call = { procedure = AcquirePermanentCard args = { owner = owner card = card } }
      call = { procedure = GainGoldWithSource args = { owner = owner amount = 333 source = "base-spire:cursed-pearl" } }
    }
  }
  subscription Obtained {
    event = RelicObtained reaction = Obtained
    instances = where(collection(Relics), r, and(equal(r, relic), and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), "base-spire:cursed-pearl")))))
    instance_order = collectionIndex(Relics, listener) priority = 100
  }
  action Obtain {
    role = player requires = and(not(field(first(type(Player)), Player.CombatActive)), and(greater(field(first(type(Player)), Player.Hp), 0), and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), "base-spire:cursed-pearl")))))
    body = { call = { procedure = ObtainRelic args = { owner = first(type(Player)) definition = "base-spire:cursed-pearl" } } }
  }
} }
use CursedPearl { template = CursedPearlContent }
