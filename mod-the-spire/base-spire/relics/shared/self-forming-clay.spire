using namespace base-spire;
dsl_version = "core/0.3"

# SelfFormingClay.cs: each positive unblocked damage result during combat adds three deferred block.
template SelfFormingClayModule {
  body = {
    procedure Damaged {
      parameters = { result = Ref(DamageResult) listener = Ref(Relic) }
      locals = { owner = Binding }
      body = {
        let = { into = owner value = field(result, DamageResult.Player) }
        if = { condition = and(field(owner, Player.CombatActive), greater(field(result, DamageResult.Unblocked), 0)) then = {
          call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:self-forming-clay" stacks = 3 } }
        } }
      }
    }
    subscription Damaged {
      event = AfterDamageReceived reaction = Damaged
      instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), field(result, DamageResult.Player)), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), "base-spire:self-forming-clay"))))
      instance_order = pureCall(RelicHookOrder, listener, false)
    }
    action Obtain {
      role = player requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), not(pureCall(HasOwnedRelic, first(type(Player)), "base-spire:self-forming-clay")))
      body = { call = { procedure = ObtainRelic args = { owner = first(type(Player)) definition = "base-spire:self-forming-clay" } } }
    }
  }
}
use SelfFormingClay { template = SelfFormingClayModule }
