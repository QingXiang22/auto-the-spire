<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <ProjectReference Include="../../../core-the-spire/Core.TheSpire/Core.TheSpire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Content\*.encounters.json" LogicalName="BaseSpire.Content.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Content\*.acts.json" LogicalName="BaseSpire.Content.%(Filename)%(Extension)" />
    <EmbeddedResource Include="ContentSource\*.spire" LogicalName="BaseSpire.ContentSource.%(Filename)%(Extension)" />
    <!-- B-05b 的作者前端文本：切片内容的作者表示，编译到通用 IR（与程序化包同一运行时）。 -->
    <EmbeddedResource Include="Slice\Content\*.author" LogicalName="BaseSpire.SliceAuthor.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
