package base-spire {
  affliction Hexed {
    addKeywords = [Ethereal]
  }

  power Hex {
    isDebuff = true
    trigger = afterCardEnteredCombat
    effect = afflictCards(Hexed, target=self, onlyIfUnafflicted=true)
    removeWhenApplierDies = true
    events = [event(type=power_removed, owner=target, power=Hex,
      effect=clearAffliction(Hexed, target=self))]
  }

  enemy SpectralKnight {
    hp = variants(default=range(93, 93), tough=range(97, 97))
    moves = actions(
      spectralKnightHex = sequence(
        applyPower(Hex, 2, target=firstEnemy),
        afflictCards(Hexed, target=firstEnemy, onlyIfUnafflicted=true)
      ),
      spectralKnightSoulSlash = attack(variants(default=15, deadly=17), target=player),
      spectralKnightSoulFlame = repeat(3, attack(variants(default=3, deadly=4), target=player))
    )
    behavior = graph(start=spectralKnightHex, edges=[
      edge(spectralKnightHex, spectralKnightSoulSlash),
      edge(spectralKnightSoulSlash, chooseWithLimits(
        candidate(spectralKnightSoulSlash, weight=2),
        candidate(spectralKnightSoulFlame, cooldown=1)
      )),
      edge(spectralKnightSoulFlame, chooseWithLimits(
        candidate(spectralKnightSoulSlash, weight=2),
        candidate(spectralKnightSoulFlame, cooldown=1)
      ))
    ])
  }

  power HighVoltage {
    trigger = afterEnemyTurnEnd
    effect = applyScaledPower(Strength, 0, 1,
      count=targetPowerAmount(HighVoltage, target=self), target=self)
  }
  power Stock {
    trigger = afterOwnerDeath
    effect = respawnSelf(Stock, startingAction=axebotBootUp)
  }
  enemy Fabricator {
    hp = variants(default=range(150, 150), tough=range(155, 155))
    moves = actions(
      fabricatorMakeBots = sequence(
        summonRandomEnemy([Guardbot, Noisebot], avoidPrevious=true,
          additionalPowers=[power(Minion, 1)], maxLivingEnemies=5),
        summonRandomEnemy([Zapbot, Stabbot], avoidPrevious=true,
          additionalPowers=[power(Minion, 1)], maxLivingEnemies=5)
      ),
      fabricatorStrike = sequence(
        attack(variants(default=18, deadly=21), target=player),
        summonRandomEnemy([Zapbot, Stabbot], avoidPrevious=true,
          additionalPowers=[power(Minion, 1)], maxLivingEnemies=5)
      ),
      fabricatorDisintegrate = attack(variants(default=11, deadly=13), target=player)
    )
    behavior = chooseWithLimits(
      candidate(fabricatorMakeBots, when=metric(LivingAllies, LessThan, 4)),
      candidate(fabricatorStrike, when=metric(LivingAllies, LessThan, 4)),
      candidate(fabricatorDisintegrate, when=metric(LivingAllies, AtLeast, 4))
    )
  }
  enemy Axebot {
    hp = variants(default=range(40, 44), tough=range(42, 46))
    startingPowers = [power(Stock, 2)]
    moves = actions(
      axebotBootUp = sequence(gainBlock(10), applyPower(Strength, 1, target=self)),
      axebotOneTwo = repeat(2, attack(variants(default=5, deadly=6), target=player)),
      axebotSharpen = applyPower(Strength, 4, target=self),
      axebotHammerUppercut = sequence(
        attack(variants(default=8, deadly=10), target=player),
        applyPower(Weak, 1, target=player),
        applyPower(Frail, 1, target=player)
      )
    )
    behavior = startWithChoice(
      chooseWithLimits(
        candidate(axebotOneTwo, weight=2),
        candidate(axebotSharpen, weight=1, cooldown=1),
        candidate(axebotHammerUppercut, weight=2)
      ),
      then=graph(start=axebotOneTwo, edges=[
        edge(axebotBootUp, chooseWithLimits(
          candidate(axebotOneTwo, weight=2),
          candidate(axebotSharpen, weight=1, cooldown=1),
          candidate(axebotHammerUppercut, weight=2)
        )),
        edge(axebotOneTwo, chooseWithLimits(
          candidate(axebotOneTwo, weight=2),
          candidate(axebotSharpen, weight=1, cooldown=1),
          candidate(axebotHammerUppercut, weight=2)
        )),
        edge(axebotSharpen, chooseWithLimits(
          candidate(axebotOneTwo, weight=2),
          candidate(axebotSharpen, weight=1, cooldown=1),
          candidate(axebotHammerUppercut, weight=2)
        )),
        edge(axebotHammerUppercut, chooseWithLimits(
          candidate(axebotOneTwo, weight=2),
          candidate(axebotSharpen, weight=1, cooldown=1),
          candidate(axebotHammerUppercut, weight=2)
        ))
      ])
    )
  }
  enemy Zapbot {
    hp = variants(default=range(18, 23), tough=range(19, 24))
    moves = actions(zapbotAttack = attack(variants(default=14, deadly=15), target=player))
    behavior = loop(zapbotAttack)
    startingPowers = [power(HighVoltage, 2)]
  }
  enemy Stabbot {
    hp = variants(default=range(18, 23), tough=range(19, 24))
    moves = actions(stabbotAttack = sequence(
      attack(variants(default=11, deadly=12), target=player),
      applyPower(Frail, 1, target=player)
    ))
    behavior = loop(stabbotAttack)
  }
  enemy Guardbot {
    hp = variants(default=range(16, 20), tough=range(17, 21))
    moves = actions(guardbotGuard = gainBlock(15, target=otherAllies, onlyEnemy=Fabricator))
    behavior = loop(guardbotGuard)
  }
  enemy Noisebot {
    hp = variants(default=range(18, 23), tough=range(19, 24))
    moves = actions(noisebotConfuse = sequence(
      addCards(Dazed, pile=discard, target=self, position=Random),
      addCards(Dazed, pile=draw, target=self, position=Random)
    ))
    behavior = loop(noisebotConfuse)
  }
}
