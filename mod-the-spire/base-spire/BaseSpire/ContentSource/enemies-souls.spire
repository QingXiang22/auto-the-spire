package base-spire {
  power Intangible {
    trigger = afterOwnerTurnEnd
    decrementOnTrigger = true
    incomingDamageCap = 1
  }

  enemy SoulNexus {
    hp = variants(default=range(254, 254), tough=range(234, 234))
    moves = actions(
      soulNexusSoulBurn = attack(variants(default=29, deadly=31), target=player),
      soulNexusMaelstrom = repeat(4, attack(variants(default=6, deadly=7), target=player)),
      soulNexusDrainLife = action(intent=Attack, effect=sequence(
        attack(variants(default=18, deadly=19), target=player),
        applyPower(Vulnerable, 2, target=player),
        applyPower(Weak, 2, target=player)
      ))
    )
    behavior = graph(start=soulNexusSoulBurn, edges=[
      edge(soulNexusSoulBurn, chooseWithoutRepeat(
        soulNexusSoulBurn, soulNexusMaelstrom, soulNexusDrainLife)),
      edge(soulNexusMaelstrom, chooseWithoutRepeat(
        soulNexusSoulBurn, soulNexusMaelstrom, soulNexusDrainLife)),
      edge(soulNexusDrainLife, chooseWithoutRepeat(
        soulNexusSoulBurn, soulNexusMaelstrom, soulNexusDrainLife))
    ])
  }

  enemy SoulFysh {
    hp = variants(default=range(211, 211), tough=range(221, 221))
    moves = actions(
      soulFyshBeckon = sequence(
        addCards(Beckon, pile=draw, target=player, position=random),
        addCards(Beckon, pile=discard, target=player)
      ),
      soulFyshDeGas = attack(variants(default=16, deadly=17), target=player),
      soulFyshGaze = sequence(
        attack(variants(default=7, deadly=8), target=player),
        addCards(Beckon, pile=discard, target=player)
      ),
      soulFyshFade = applyPower(Intangible, 2, target=self),
      soulFyshScream = sequence(
        attack(variants(default=13, deadly=15), target=player),
        applyPower(Vulnerable, 3, target=player)
      )
    )
    behavior = cycle(
      soulFyshBeckon,
      soulFyshDeGas,
      soulFyshGaze,
      soulFyshFade,
      soulFyshScream
    )
  }
}
