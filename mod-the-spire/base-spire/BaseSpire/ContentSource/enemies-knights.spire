package base-spire {
  enemy MysteriousKnight {
    hp = variants(default=range(101, 101), tough=range(108, 108))
    startingPowers = [power(Strength, 6), power(PlatingPower, 6)]
    moves = actions(
      mysteriousKnightWarChant = applyPower(Strength, 3, target=self),
      mysteriousKnightFlail = repeat(2, attack(variants(default=9, deadly=10), target=player)),
      mysteriousKnightRam = attack(variants(default=15, deadly=17), target=player)
    )
    behavior = startWith(mysteriousKnightRam, then=chooseWithLimits(
      candidate(mysteriousKnightWarChant, weight=1, maxConsecutive=1),
      candidate(mysteriousKnightFlail, weight=2),
      candidate(mysteriousKnightRam, weight=2)
    ))
  }
}
