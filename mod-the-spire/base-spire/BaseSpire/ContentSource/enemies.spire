package base-spire {
  power Artifact {
    role = Artifact
  }

  power TerritorialPower {
    trigger = afterEnemyTurnEnd
    effect = applyScaledPower(Strength, 0, 1,
      count=targetPowerAmount(TerritorialPower, target=self), target=self)
  }

  power SlipperyPower {
    events = [event(type=hp_loss, owner=target, positiveAmount=true,
      effect=decrementPower(SlipperyPower))]
  }

  power IllusionPower {}

  power SoarPower {
    incomingDamageModifiers = [modifier(multiplier=0.5, require=[move], exclude=[unpowered])]
  }

  power TangledPower {
    isDebuff = true
    removeAfterOwnerTurnEnd = true
    cardRule = cardRule(type=attack, costDelta=1)
  }

  power ConstrictPower {
    isDebuff = true
    removeWhenApplierDies = true
    on = [trigger(event=afterOwnerTurnEnd,
      effect=scaledAttack(0, 1,
        count=targetPowerAmount(ConstrictPower, target=self),
        target=self, properties=[unpowered]))]
  }

  power Slow {
    variables = [variable(SlowAmount, 0)]
    trigger = afterCardPlayed
    effect = modifyPowerVariable(Slow, SlowAmount, 1)
    on = [trigger(event=afterOwnerTurnStart,
      effect=modifyPowerVariable(Slow, SlowAmount, 0, operation=Set))]
    incomingDamageModifiers = [modifier(multiplier=1, require=[move], exclude=[unpowered],
      variable=SlowAmount, perVariable=0.1)]
    isDebuff = true
  }

  power Infested {
    trigger = afterOwnerDeath
    effect = summonEnemy(Wriggler, count=4, startingAction=wrigglerSpawned)
  }

  power HardToKill {
    damageCapPerStack = 1
  }

  power Thorns {
    events = [event(type=before_damage, owner=target, ownerTurnOnly=false, positiveAmount=true,
      require=[move], exclude=[unpowered],
      effect=scaledAttack(0, 1, count=targetPowerAmount(Thorns, target=self),
        target=target, properties=[unpowered]))]
  }

  power Frail {
    trigger = afterEnemyTurnEnd
    decrementOnTrigger = true
    skipFirstWhenAppliedToPlayer = true
    blockGainMultiplier = 0.75
    isDebuff = true
  }

  power Ritual {
    trigger = afterEnemyTurnEnd
    effect = grantPower(Strength, sourceStacks)
    skipFirstWhenAppliedToEnemy = true
  }

  enemy DampCultist {
    hp = variants(default=range(52, 54), tough=range(51, 53))
    moves = actions(
      dampCultistIncantation = applyPower(Ritual, variants(default=5, deadly=6), target=self),
      dampCultistDarkStrike = attack(variants(default=1, deadly=3), target=player)
    )
    behavior = startWith(dampCultistIncantation, then=loop(dampCultistDarkStrike))
  }

  enemy CalcifiedCultist {
    hp = variants(default=range(38, 41), tough=range(39, 42))
    moves = actions(
      calcifiedCultistIncantation = applyPower(Ritual, 2, target=self),
      calcifiedCultistDarkStrike = attack(variants(default=9, deadly=11), target=player)
    )
    behavior = startWith(calcifiedCultistIncantation, then=loop(calcifiedCultistDarkStrike))
  }

  enemy FuzzyWurmCrawler {
    hp = variants(default=range(55, 57), tough=range(58, 59))
    moves = actions(
      fuzzyWurmFirstAcidGoop = attack(variants(default=4, deadly=6), target=player),
      fuzzyWurmInhale = applyPower(Strength, 7, target=self),
      fuzzyWurmAcidGoop = attack(variants(default=4, deadly=6), target=player)
    )
    behavior = cycle(fuzzyWurmFirstAcidGoop, fuzzyWurmInhale, fuzzyWurmAcidGoop)
  }

  enemy ShrinkerBeetle {
    hp = variants(default=range(38, 40), tough=range(40, 42))
    moves = actions(
      shrinkerBeetleShrink = applyPower(Shrink, -1, target=player),
      shrinkerBeetleChomp = attack(variants(default=7, deadly=8), target=player),
      shrinkerBeetleStomp = attack(variants(default=13, deadly=14), target=player)
    )
    behavior = startWith(shrinkerBeetleShrink,
      then=cycle(shrinkerBeetleChomp, shrinkerBeetleStomp))
  }

  enemy Nibbit {
    hp = variants(default=range(42, 46), tough=range(44, 48))
    moves = actions(
      nibbitButt = attack(variants(default=12, deadly=13), target=player),
      nibbitSlice = sequence(
        attack(variants(default=6, deadly=7), target=player),
        gainBlock(variants(default=5, tough=6))
      ),
      nibbitHiss = applyPower(Strength, variants(default=2, deadly=3), target=self)
    )
    behavior = cycle(nibbitButt, nibbitSlice, nibbitHiss)
  }

  enemy LeafSlimeSmall {
    hp = variants(default=range(11, 15), tough=range(12, 16))
    moves = actions(
      leafSmallTackle = attack(variants(default=3, deadly=4), target=player),
      leafSmallGoop = addCards(Slimed, pile=discard, target=player)
    )
    behavior = loop(chooseWithoutRepeat(leafSmallTackle, leafSmallGoop))
  }

  enemy TwigSlimeSmall {
    hp = variants(default=range(7, 11), tough=range(8, 12))
    moves = actions(
      twigSmallTackle = attack(variants(default=4, deadly=5), target=player)
    )
    behavior = loop(twigSmallTackle)
  }

  enemy LeafSlimeMedium {
    hp = variants(default=range(32, 35), tough=range(33, 36))
    moves = actions(
      leafMediumClumpShot = attack(variants(default=8, deadly=9), target=player),
      leafMediumStickyShot = addCards(Slimed, pile=discard, count=2, target=player)
    )
    behavior = startWith(leafMediumStickyShot,
      then=cycle(leafMediumClumpShot, leafMediumStickyShot))
  }

  enemy TwigSlimeMedium {
    hp = variants(default=range(26, 29), tough=range(27, 29))
    moves = actions(
      twigMediumClumpShot = attack(variants(default=11, deadly=12), target=player),
      twigMediumStickyShot = addCards(Slimed, pile=discard, target=player)
    )
    behavior = startWith(twigMediumStickyShot, then=loop(chooseWithLimits(
      candidate(twigMediumClumpShot, maxConsecutive=2),
      candidate(twigMediumStickyShot, maxConsecutive=1)
    )))
  }

  enemy AxeRubyRaider {
    hp = variants(default=range(20, 22), tough=range(21, 23))
    moves = actions(
      axeSwingOne = sequence(attack(variants(default=5, deadly=6), target=player),
        gainBlock(variants(default=5, deadly=6))),
      axeSwingTwo = sequence(attack(variants(default=5, deadly=6), target=player),
        gainBlock(variants(default=5, deadly=6))),
      axeBigSwing = attack(variants(default=12, deadly=13), target=player)
    )
    behavior = cycle(axeSwingOne, axeSwingTwo, axeBigSwing)
  }

  enemy AssassinRubyRaider {
    hp = variants(default=range(18, 23), tough=range(19, 24))
    moves = actions(assassinKillshot = attack(variants(default=10, deadly=11), target=player))
    behavior = loop(assassinKillshot)
  }

  enemy BruteRubyRaider {
    hp = variants(default=range(30, 33), tough=range(31, 34))
    moves = actions(
      bruteBeat = attack(variants(default=7, deadly=8), target=player),
      bruteRoar = applyPower(Strength, 3, target=self)
    )
    behavior = cycle(bruteBeat, bruteRoar)
  }

  enemy CrossbowRubyRaider {
    hp = variants(default=range(18, 21), tough=range(19, 22))
    moves = actions(
      crossbowFire = attack(variants(default=14, deadly=16), target=player),
      crossbowReload = gainBlock(3)
    )
    behavior = startWith(crossbowReload, then=cycle(crossbowFire, crossbowReload))
  }

  enemy TrackerRubyRaider {
    hp = variants(default=range(21, 25), tough=range(22, 26))
    moves = actions(
      trackerTrack = applyPower(Frail, 2, target=player),
      trackerHounds = repeat(variants(default=8, deadly=9), attack(1, target=player))
    )
    behavior = startWith(trackerTrack, then=loop(trackerHounds))
  }

  enemy BowlbugEgg {
    hp = variants(default=range(21, 22), tough=range(23, 24))
    moves = actions(
      bowlbugEggBite = sequence(
        attack(variants(default=7, deadly=8), target=player),
        gainBlock(variants(default=7, deadly=8))
      )
    )
    behavior = loop(bowlbugEggBite)
  }

  enemy BowlbugNectar {
    hp = variants(default=range(35, 38), tough=range(36, 39))
    moves = actions(
      bowlbugNectarThrash = attack(3, target=player),
      bowlbugNectarBuff = applyPower(Strength, variants(default=15, deadly=16), target=self),
      bowlbugNectarThrashAgain = attack(3, target=player)
    )
    behavior = startWith(bowlbugNectarThrash,
      then=startWith(bowlbugNectarBuff, then=loop(bowlbugNectarThrashAgain)))
  }

  enemy BowlbugSilk {
    hp = variants(default=range(40, 43), tough=range(41, 44))
    moves = actions(
      bowlbugSilkThrash = repeat(2, attack(variants(default=4, deadly=5), target=player)),
      bowlbugSilkToxicSpit = applyPower(Weak, 1, target=player)
    )
    behavior = startWith(bowlbugSilkToxicSpit,
      then=cycle(bowlbugSilkThrash, bowlbugSilkToxicSpit))
  }

  enemy DevotedSculptor {
    hp = variants(default=range(162, 162), tough=range(172, 172))
    moves = actions(
      sculptorForbiddenIncantation = applyPower(Ritual, 9, target=self),
      sculptorSavage = attack(variants(default=12, deadly=15), target=player)
    )
    behavior = startWith(sculptorForbiddenIncantation, then=loop(sculptorSavage))
  }

  enemy FlailKnight {
    hp = variants(default=range(101, 101), tough=range(108, 108))
    moves = actions(
      flailKnightWarChant = applyPower(Strength, 3, target=self),
      flailKnightFlail = repeat(2, attack(variants(default=9, deadly=10), target=player)),
      flailKnightRam = attack(variants(default=15, deadly=17), target=player)
    )
    behavior = startWith(flailKnightRam, then=chooseWithLimits(
      candidate(flailKnightWarChant, weight=1, maxConsecutive=1),
      candidate(flailKnightFlail, weight=2),
      candidate(flailKnightRam, weight=2)
    ))
  }

  enemy SewerClam {
    hp = variants(default=range(58, 58), tough=range(56, 56))
    startingPowers = [power(PlatingPower, variants(default=8, tough=9))]
    moves = actions(
      sewerClamPressurize = applyPower(Strength, 4, target=self),
      sewerClamJet = attack(variants(default=10, deadly=11), target=player)
    )
    behavior = cycle(sewerClamJet, sewerClamPressurize)
  }

  enemy SnappingJaxfruit {
    hp = variants(default=range(34, 36), tough=range(31, 33))
    moves = actions(
      snappingJaxfruitEnergyOrb = sequence(
        attack(variants(default=3, deadly=4), target=player),
        applyPower(Strength, 2, target=self)
      )
    )
    behavior = loop(snappingJaxfruitEnergyOrb)
  }

  enemy Flyconid {
    hp = variants(default=range(51, 53), tough=range(47, 49))
    moves = actions(
      flyconidVulnerableSpores = applyPower(Vulnerable, 2, target=player),
      flyconidFrailSpores = sequence(
        attack(variants(default=8, deadly=9), target=player),
        applyPower(Frail, 2, target=player)
      ),
      flyconidSmash = attack(variants(default=11, deadly=12), target=player)
    )
    behavior = startWithChoice(
      chooseWithLimits(
        candidate(flyconidFrailSpores, weight=2),
        candidate(flyconidSmash, weight=1)
      ),
      then=chooseWithLimits(
        candidate(flyconidVulnerableSpores, weight=3, maxConsecutive=1),
        candidate(flyconidFrailSpores, weight=2, maxConsecutive=1),
        candidate(flyconidSmash, weight=3, maxConsecutive=1)
      )
    )
  }

  enemy Chomper {
    hp = variants(default=range(63, 67), tough=range(60, 64))
    startingPowers = [power(Artifact, 2)]
    moves = actions(
      chomperClamp = repeat(2, attack(variants(default=8, deadly=9), target=player)),
      chomperScreech = addCards(Dazed, count=3, pile=discard, target=player)
    )
    behavior = cycle(chomperClamp, chomperScreech)
  }

  enemy Byrdonis {
    hp = variants(default=range(90, 90), tough=range(81, 84))
    startingPowers = [power(TerritorialPower, 1)]
    moves = actions(
      byrdonisSwoop = attack(variants(default=17, deadly=19), target=player),
      byrdonisPeck = repeat(variants(default=3, deadly=3),
        attack(variants(default=3, deadly=4), target=player))
    )
    behavior = cycle(byrdonisSwoop, byrdonisPeck)
  }

  enemy PunchConstruct {
    hp = variants(default=range(60, 60), tough=range(55, 55))
    startingPowers = [power(Artifact, 1)]
    moves = actions(
      punchConstructReady = gainBlock(10),
      punchConstructFastPunch = sequence(
        repeat(2, attack(variants(default=5, deadly=6), target=player)),
        applyPower(Frail, 1, target=player)
      ),
      punchConstructStrongPunch = attack(variants(default=14, deadly=16), target=player)
    )
    behavior = cycle(punchConstructReady, punchConstructFastPunch, punchConstructStrongPunch)
  }

  enemy Mawler {
    hp = variants(default=range(76, 76), tough=range(72, 72))
    moves = actions(
      mawlerRipAndTear = attack(variants(default=14, deadly=16), target=player),
      mawlerRoar = applyPower(Vulnerable, 3, target=player),
      mawlerClaw = repeat(2, attack(variants(default=4, deadly=5), target=player))
    )
    behavior = startWith(mawlerClaw, then=chooseWithLimits(
      candidate(mawlerRipAndTear, maxConsecutive=1),
      candidate(mawlerRoar, maxUsesPerCombat=1),
      candidate(mawlerClaw, maxConsecutive=1)
    ))
  }

  enemy Seapunk {
    hp = variants(default=range(47, 49), tough=range(44, 46))
    moves = actions(
      seapunkSeaKick = attack(variants(default=11, deadly=13), target=player),
      seapunkSpinningKick = repeat(4, attack(2, target=player)),
      seapunkBubbleBurp = sequence(
        gainBlock(variants(default=7, tough=8)),
        applyPower(Strength, variants(default=1, deadly=2), target=self)
      )
    )
    behavior = cycle(seapunkSeaKick, seapunkSpinningKick, seapunkBubbleBurp)
  }

  enemy Inklet {
    hp = variants(default=range(12, 18), tough=range(11, 17))
    startingPowers = [power(SlipperyPower, 1)]
    moves = actions(
      inkletJab = attack(variants(default=3, deadly=4), target=player),
      inkletWhirlwind = repeat(3, attack(variants(default=2, deadly=3), target=player)),
      inkletPiercingGaze = attack(variants(default=10, deadly=11), target=player)
    )
    behavior = graph(start=inkletJab, edges=[
      edge(inkletJab, chooseWithLimits(
        candidate(inkletPiercingGaze, maxConsecutive=1),
        candidate(inkletWhirlwind, maxConsecutive=1)
      )),
      edge(inkletPiercingGaze, inkletJab),
      edge(inkletWhirlwind, inkletJab)
    ])
  }

  enemy FrogKnight {
    hp = variants(default=range(191, 191), tough=range(199, 199))
    startingPowers = [power(PlatingPower, variants(default=15, tough=19))]
    moves = actions(
      frogKnightForTheQueen = applyPower(Strength, 5, target=self),
      frogKnightStrikeDownEvil = attack(variants(default=21, deadly=23), target=player),
      frogKnightTongueLash = sequence(
        attack(variants(default=13, deadly=14), target=player),
        applyPower(Frail, 2, target=player)
      ),
      frogKnightBeetleCharge = attack(variants(default=35, deadly=40), target=player)
    )
    behavior = graph(start=frogKnightTongueLash, edges=[
      edge(frogKnightTongueLash, frogKnightStrikeDownEvil),
        edge(frogKnightStrikeDownEvil, frogKnightForTheQueen),
        edge(frogKnightForTheQueen, chooseByCondition(
        candidate(frogKnightBeetleCharge,
          when=metric(EnemyHp, LessThan, variants(default=95, tough=99)), maxUsesPerCombat=1),
        candidate(frogKnightTongueLash, when=metric(Turn, AtLeast, 0))
      )),
      edge(frogKnightBeetleCharge, frogKnightTongueLash)
    ])
  }

  enemy HauntedShip {
    hp = variants(default=range(63, 63), tough=range(67, 67))
    moves = actions(
      hauntedShipSwipe = attack(variants(default=13, deadly=14), target=player),
      hauntedShipStomp = repeat(3, attack(variants(default=4, deadly=5), target=player)),
      hauntedShipHaunt = sequence(
        applyPower(Weak, 3, target=player),
        addCards(Dazed, count=5, pile=discard, target=player)
      )
    )
    behavior = startWith(hauntedShipHaunt, then=cycle(hauntedShipSwipe, hauntedShipStomp))
  }

  enemy EyeWithTeeth {
    hp = variants(default=range(6, 6))
    startingPowers = [power(IllusionPower, 1)]
    moves = actions(
      eyeWithTeethDistract = addCards(Dazed, count=3, pile=discard, target=player)
    )
    behavior = loop(eyeWithTeethDistract)
  }

  enemy Fogmog {
    hp = variants(default=range(74, 74), tough=range(78, 78))
    moves = actions(
      fogmogIllusion = summonEnemy(EyeWithTeeth),
      fogmogSwipe = sequence(
        attack(variants(default=8, deadly=9), target=player),
        applyPower(Strength, 1, target=self)
      ),
      fogmogSwipeRandom = sequence(
        attack(variants(default=8, deadly=9), target=player),
        applyPower(Strength, 1, target=self)
      ),
      fogmogHeadbutt = attack(variants(default=14, deadly=16), target=player)
    )
    behavior = graph(start=fogmogIllusion, edges=[
      edge(fogmogIllusion, fogmogSwipe),
      edge(fogmogSwipe, chooseWithLimits(
        candidate(fogmogSwipeRandom, weight=2, maxConsecutive=1),
        candidate(fogmogHeadbutt, weight=3, maxConsecutive=1)
      )),
      edge(fogmogSwipeRandom, fogmogHeadbutt),
      edge(fogmogHeadbutt, fogmogSwipe)
    ])
  }

  enemy OwlMagistrate {
    hp = variants(default=range(231, 231), tough=range(247, 247))
    moves = actions(
      owlMagistrateScrutiny = attack(variants(default=16, deadly=17), target=player),
      owlMagistratePeckAssault = repeat(6, attack(4, target=player)),
      owlMagistrateJudicialFlight = applyPower(SoarPower, 1, target=self),
      owlMagistrateVerdict = sequence(
        attack(variants(default=33, deadly=36), target=player),
        applyPower(Vulnerable, 4, target=player),
        removePower(SoarPower)
      )
    )
    behavior = cycle(owlMagistrateScrutiny, owlMagistratePeckAssault,
      owlMagistrateJudicialFlight, owlMagistrateVerdict)
  }

  enemy LouseProgenitor {
    hp = variants(default=range(134, 136), tough=range(138, 141))
    startingBlock = variants(default=14, tough=18)
    moves = actions(
      louseProgenitorWeb = sequence(
        attack(variants(default=9, deadly=10), target=player),
        applyPower(Frail, 2, target=player)
      ),
      louseProgenitorCurlAndGrow = sequence(
        gainBlock(variants(default=14, tough=18)),
        applyPower(Strength, 5, target=self)
      ),
      louseProgenitorPounce = attack(variants(default=14, deadly=16), target=player)
    )
    behavior = cycle(louseProgenitorWeb, louseProgenitorCurlAndGrow, louseProgenitorPounce)
  }

  enemy CubexConstruct {
    hp = variants(default=range(65, 65), tough=range(70, 70))
    startingBlock = 13
    startingPowers = [power(Artifact, 1)]
    moves = actions(
      cubexChargeUp = applyPower(Strength, 2, target=self),
      cubexRepeaterBlast = sequence(
        attack(variants(default=7, deadly=8), target=player),
        applyPower(Strength, 2, target=self)
      ),
      cubexRepeaterBlastAgain = sequence(
        attack(variants(default=7, deadly=8), target=player),
        applyPower(Strength, 2, target=self)
      ),
      cubexExpelBlast = repeat(2, attack(variants(default=5, deadly=6), target=player))
    )
    behavior = graph(start=cubexChargeUp, edges=[
      edge(cubexChargeUp, cubexRepeaterBlast),
      edge(cubexRepeaterBlast, cubexRepeaterBlastAgain),
      edge(cubexRepeaterBlastAgain, cubexExpelBlast),
      edge(cubexExpelBlast, cubexRepeaterBlast)
    ])
  }

  enemy VineShambler {
    hp = variants(default=range(61, 61), tough=range(64, 64))
    moves = actions(
      vineShamblerSwipe = repeat(2, attack(variants(default=6, deadly=7), target=player)),
      vineShamblerGraspingVines = sequence(
        attack(variants(default=8, deadly=9), target=player),
        applyPower(TangledPower, 1, target=player)
      ),
      vineShamblerChomp = attack(variants(default=16, deadly=18), target=player)
    )
    behavior = cycle(vineShamblerSwipe, vineShamblerGraspingVines, vineShamblerChomp)
  }

  enemy SlitheringStrangler {
    hp = variants(default=range(53, 55), tough=range(54, 56))
    moves = actions(
      stranglerConstrict = applyPower(ConstrictPower, 3, target=player),
      stranglerThwack = sequence(
        attack(variants(default=7, deadly=8), target=player),
        gainBlock(5)
      ),
      stranglerLash = attack(variants(default=12, deadly=13), target=player)
    )
    behavior = graph(start=stranglerConstrict, edges=[
      edge(stranglerConstrict, chooseWithLimits(
        candidate(stranglerThwack), candidate(stranglerLash))),
      edge(stranglerThwack, stranglerConstrict),
      edge(stranglerLash, stranglerConstrict)
    ])
  }

  enemy BygoneEffigy {
    hp = variants(default=range(127, 127), tough=range(132, 132))
    startingPowers = [power(Slow, 1)]
    moves = actions(
      bygoneSleep = sequence(),
      bygoneWake = applyPower(Strength, 10, target=self),
      bygoneSlash = attack(variants(default=13, deadly=15), target=player)
    )
    behavior = graph(start=bygoneSleep, edges=[
      edge(bygoneSleep, bygoneWake),
      edge(bygoneWake, bygoneSlash),
      edge(bygoneSlash, bygoneSlash)
    ])
  }

  enemy Wriggler {
    hp = variants(default=range(17, 21), tough=range(18, 22))
    moves = actions(
      wrigglerSpawned = sequence(),
      wrigglerBite = attack(variants(default=6, deadly=7), target=player),
      wrigglerWriggle = sequence(
        addCards(Infection, pile=discard, count=1, target=player),
        applyPower(Strength, 2, target=self)
      )
    )
    behavior = graph(start=wrigglerSpawned, edges=[
      edge(wrigglerSpawned, chooseByCondition(
        candidate(wrigglerBite, when=any([
          metric(EnemyIndex, Equal, 1), metric(EnemyIndex, Equal, 3)
        ])),
        candidate(wrigglerWriggle, when=any([
          metric(EnemyIndex, Equal, 2), metric(EnemyIndex, Equal, 4)
        ]))
      )),
      edge(wrigglerBite, wrigglerWriggle),
      edge(wrigglerWriggle, wrigglerBite)
    ])
  }

  enemy PhrogParasite {
    hp = variants(default=range(61, 64), tough=range(66, 68))
    startingPowers = [power(Infested, 1)]
    moves = actions(
      phrogInfect = addCards(Infection, pile=discard, count=3, target=player),
      phrogLash = repeat(4, attack(variants(default=4, deadly=5), target=player))
    )
    behavior = cycle(phrogInfect, phrogLash)
  }

  enemy Exoskeleton {
    hp = variants(default=range(24, 28), tough=range(25, 29))
    startingPowers = [power(HardToKill, 9)]
    moves = actions(
      exoskeletonSkitter = repeat(variants(default=3, deadly=4), attack(1, target=player)),
      exoskeletonMandibles = attack(variants(default=8, deadly=9), target=player),
      exoskeletonEnrage = applyPower(Strength, 2, target=self)
    )
    behavior = graph(start=exoskeletonSkitter, edges=[
      edge(exoskeletonSkitter, chooseWithoutRepeat(exoskeletonSkitter, exoskeletonMandibles)),
      edge(exoskeletonMandibles, exoskeletonEnrage),
      edge(exoskeletonEnrage, chooseWithoutRepeat(exoskeletonSkitter, exoskeletonMandibles))
    ])
  }

  enemy Myte {
    hp = variants(default=range(61, 67), tough=range(64, 69))
    moves = actions(
      myteToxic = addCards(Toxic, pile=hand, count=2, target=player),
      myteBite = attack(variants(default=13, deadly=15), target=player),
      myteSuck = sequence(
        attack(variants(default=4, deadly=6), target=player),
        applyPower(Strength, variants(default=2, deadly=3), target=self)
      )
    )
    behavior = cycle(myteToxic, myteBite, myteSuck)
  }

  enemy SpinyToad {
    hp = variants(default=range(116, 119), tough=range(121, 124))
    moves = actions(
      spinyToadSpikes = applyPower(Thorns, 5, target=self),
      spinyToadExplosion = sequence(
        attack(variants(default=23, deadly=25), target=player),
        applyPower(Thorns, -5, target=self)
      ),
      spinyToadLash = attack(variants(default=17, deadly=19), target=player)
    )
    behavior = cycle(spinyToadSpikes, spinyToadExplosion, spinyToadLash)
  }
}
