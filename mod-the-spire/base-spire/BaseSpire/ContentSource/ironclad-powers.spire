package base-spire {
  power OneTwoPunchPower {
    cardRule = cardRule(type=attack, extraPlays=1, consumeOnPlayCount=true)
    removeAfterOwnerTurnEnd = true
  }

  power CorruptionPower {
    cardRule = cardRule(type=skill, cost=0, resultPile=exhaust)
  }

  power FreeAttackPower {
    cardRule = cardRule(type=attack, cost=0, consumeOnPlay=true)
  }

  power NoEnergyGainPower {
    preventEnergyGain = true
    removeAfterOwnerTurnEnd = true
  }

  power FeelNoPain {
    trigger = afterCardExhausted
    effect = gainBlock(1, perPowerStack=FeelNoPain)
  }

  power RagePower {
    trigger = afterCardPlayed
    whenCardType = attack
    effect = gainBlock(1, perPowerStack=RagePower)
    removeAfterPlayerTurnEnd = true
  }

  power JugglingPower {
    trigger = afterCardPlayed
    whenCardType = attack
    effect = if(cardPlaysThisTurn(3, type=attack, phase=started),
      cloneCard(count=scaled(0, 1, count=targetPowerAmount(JugglingPower, target=self))))
  }

  power FlameBarrierPower {
    removeAfterOpponentTurnEnd = true
    events = [event(type=damage, owner=target, require=[move], exclude=[unpowered],
      positiveAmount=false, effect=scaledAttack(0, 1,
        count=targetPowerAmount(FlameBarrierPower, target=self), target=selectedTarget,
        properties=[unpowered]))]
  }

  power JuggernautPower {
    events = [event(type=block, owner=source,
      effect=randomAttack(scaled(0, 1, count=targetPowerAmount(JuggernautPower, target=self)),
        properties=[unpowered]))]
  }

  power RupturePower {
    trigger = afterCardPlayed
    effect = applyScaledPower(Strength, 0, 1,
      count=takePowerEventAmount(RupturePower), target=self)
    events = [
      event(type=damage, owner=target, ownerTurnOnly=true, deferToCardPlayed=true,
        effect=applyScaledPower(Strength, 0, 1,
          count=targetPowerAmount(RupturePower, target=self), target=self)),
      event(type=hp_loss, owner=target, ownerTurnOnly=true, deferToCardPlayed=true,
        effect=applyScaledPower(Strength, 0, 1,
          count=targetPowerAmount(RupturePower, target=self), target=self))
    ]
  }

  power PyrePower {
    maxEnergyPerStack = 1
  }

  power CrueltyPower {
    vulnerableMultiplierPercentPerStack = 1
  }

  power SetupStrikePower {
    onStackChange = grantPower(Strength, stackDelta)
    onExpire = grantPower(Strength, negativeSourceStacks)
    removeAfterOwnerTurnEnd = true
  }

  power ManglePower {
    onStackChange = grantPower(Strength, negativeStackDelta)
    onExpire = grantPower(Strength, sourceStacks)
    removeAfterOwnerTurnEnd = true
  }
}
