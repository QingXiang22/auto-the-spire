using namespace base-spire;
dsl_version = "core/0.3"

entity Player {
  owner = Owner
  fields = {
    Owner = { type = Participant default = participant(1) }
    # Development baseline: Ironclad's StartingHp in sts2/src/Core/Models/Characters/Ironclad.cs.
    Hp = { type = Int(min = 0, max = 999999) default = 80 }
    MaxHp = { type = Int(min = 0, max = 999999) default = 80 }
    Energy = { type = Int(min = 0, max = 999) default = 0 }
    MaxEnergy = { type = Int(min = 0, max = 999) default = 3 }
    TurnNumber = { type = Int(min = 0, max = 999) default = 0 }
    # Development turn gate. Vanilla tracks PlayerTurnPhase instead; that lifecycle is not migrated.
    TurnOpen = { type = Bool default = false }
    Block = { type = Int(min = 0, max = 999) default = 0 }
    DrawBlocked = { type = Bool default = false }
    CombatActive = { type = Bool default = false }
    # Development combat outcome: none while it runs, then victory or defeat. Run settlement, rewards and
    # the true engine terminal are not migrated.
    CombatOutcome = { type = String(length = 16) default = "none" }
    # Development stand-ins for the source's per-turn combat history (Spite, EvilEye). Both reset at turn start.
    LostHpThisTurn = { type = Bool default = false }
    ExhaustedCardThisTurn = { type = Bool default = false }
    # Development room state: "none" outside a room, or the room kind while the room is being visited.
    Room = { type = String(length = 16) default = "none" }
    # One-shot room options (campfire rest) set this until the room is left.
    RoomUsed = { type = Bool default = false }
    # Set while a campfire forge is waiting for the card choice.
    PendingForge = { type = Bool default = false }
    # Opt-in permanent deck for this development scope. A normal character setup is not migrated.
    UsesRunDeck = { type = Bool default = false }
    CharacterId = { type = String(length = 64) default = "none" }
    CurrentRun = { type = Ref(Run) optional = true }
    AutoDrawPerTurn = { type = Int(min = 0, max = 10) default = 0 }
    AttackDepth = { type = Int(min = 0, max = 99) default = 0 visibility = Hidden }
    DamageDepth = { type = Int(min = 0, max = 99) default = 0 visibility = Hidden }
    PlayDepth = { type = Int(min = 0, max = 99) default = 0 visibility = Hidden }
    PlaySequence = { type = Int default = 0 }
    CardActionNumber = { type = Int default = 0 visibility = Hidden }
    CurrentPlay = { type = Ref(CardPlayRecord) optional = true visibility = Hidden }
    CurrentCard = { type = Ref(Card) optional = true visibility = Hidden }
    LastDrawn = { type = Ref(Card) optional = true visibility = Hidden }
    HpLossCount = { type = Int default = 0 }
    EnemyPhase = { type = Bool default = false }
    # Run currency. Ironclad StartingGold is 99 in sts2/src/Core/Models/Characters/Ironclad.cs.
    Gold = { type = Int(min = 0, max = 99999) default = 99 }
    # The development reward screen stores its roll until explicitly claimed or closed.
    GoldRewardPending = { type = Bool default = false }
    GoldRewardAmount = { type = Int(min = 0, max = 99999) default = 0 }
    CardRewardPending = { type = Bool default = false }
    CurrentRewardSet = { type = Ref(CombatRewardSet) optional = true }
    DevelopmentRewardVisit = { type = Int(min = 0) default = 0 visibility = Hidden }
    PotionRewardOdds = { type = Int(min = 0, max = 4294967295) default = 1053609165 visibility = Hidden }
    CardRarityOffset = { type = Int(min = 0, max = 4294967295) default = 3175926989 visibility = Hidden }
  }
}

# Development damage target. Vanilla monster behaviour, intents and encounters are migrated only as far as the
# enemy content templates implement them; instances are created by explicit development actions.
entity Enemy {
  owner = Owner
  fields = {
    Owner = { type = Participant default = participant(1) }
    DefinitionId = { type = String(length = 64) }
    Hp = { type = Int(min = 0, max = 999999) default = 0 }
    MaxHp = { type = Int(min = 0, max = 999999) default = 0 }
    Block = { type = Int(min = 0, max = 999) default = 0 }
    # Development move position inside the enemy's own rotation; the enemy content template owns the meaning.
    MoveIndex = { type = Int(min = 0, max = 9) default = 0 }
    # Saved source node for migrated move graphs; observations never roll another move.
    MoveId = { type = String(length = 64) default = "none" }
    # Public development intent name ("none", "attack", "buff", ...); no intent damage value is published.
    Intent = { type = String(length = 32) default = "none" }
  }
}

# Development power instance. Vanilla powers attach to a Creature; this scope keeps either a player or an
# enemy holder, so the two holder references are optional and exactly one is set. Definitions own behavior
# and private state; this entity stores only shared instance and application-lifetime facts.
entity Power {
  owner = Owner
  fields = {
    Owner = { type = Participant default = participant(1) }
    DefinitionId = { type = String(length = 64) }
    Definition = { type = Ref(PowerBlueprint) visibility = Hidden }
    HolderPlayer = { type = Ref(Player) optional = true }
    HolderEnemy = { type = Ref(Enemy) optional = true }
    Stacks = { type = Int(min = -999, max = 999) default = 0 }
    ApplierPlayer = { type = Ref(Player) optional = true visibility = Hidden }
    ApplierEnemy = { type = Ref(Enemy) optional = true visibility = Hidden }
    SourceCard = { type = Ref(Card) optional = true visibility = Hidden }
    SourcePlay = { type = Ref(CardPlayRecord) optional = true visibility = Hidden }
    # Source PowerCmd.Apply grace: a debuff applied to the player skips its first duration tick.
    SkipTick = { type = Bool default = false }
    # Powers whose lifetime is the current player turn (FlameBarrierPower) are removed at its end.
    ExpiresAtTurnEnd = { type = Bool default = false }
  }
}
collection Powers { element = Power ordered = true }
