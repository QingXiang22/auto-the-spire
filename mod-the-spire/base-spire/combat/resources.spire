using namespace base-spire;
dsl_version = "core/0.3"

procedure GetMaxEnergy {
  pure = true parameters = { owner = Ref(Player) } result = Int
  body = { return = { value = foldEvent(ModifyMaxEnergy, field(owner, Player.MaxEnergy), owner) } }
}

# CombatManager.ResetPlayerEnergy: resetting/refilling is not PlayerCmd.GainEnergy.
procedure ResetTurnEnergy {
  parameters = { owner = Ref(Player) }
  body = {
    if = { condition = not(foldEvent(ShouldResetEnergy, true, owner)) then = {
      set = { target = owner field = Player.Energy value = minimum(999, add(field(owner, Player.Energy), pureCall(GetMaxEnergy, owner))) }
    } else = { set = { target = owner field = Player.Energy value = minimum(999, pureCall(GetMaxEnergy, owner)) } } }
  }
}

# CreatureCmd.Heal: heal and clamp to MaxHp. Revive, healing modifiers and death are not migrated.
procedure Heal {
  parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999999) }
  body = {
    set = { target = owner field = Player.Hp value = minimum(field(owner, Player.MaxHp), add(field(owner, Player.Hp), amount)) }
  }
}
procedure HealToMaximum {
  parameters = { owner = Ref(Player) }
  body = { call = { procedure = Heal args = { owner = owner amount = maximum(0, subtract(field(owner, Player.MaxHp), field(owner, Player.Hp))) } } }
}
procedure GainGold {
  parameters = { owner = Ref(Player) amount = Int(min = 0, max = 99999) }
  body = { set = { target = owner field = Player.Gold value = minimum(99999, add(field(owner, Player.Gold), amount)) } }
}

# PlayerCmd.GainEnergy: add energy without clamping to MaxEnergy.
procedure GainEnergy {
  parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999) }
  body = {
    if = { condition = foldEvent(ShouldGainEnergy, true, owner) then = { set = { target = owner field = Player.Energy value = minimum(999, add(field(owner, Player.Energy), amount)) } } }
  }
}

procedure IncreaseMaxHp {
  parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999) }
  body = {
    set = { target = owner field = Player.MaxHp value = add(field(owner, Player.MaxHp), amount) }
    call = { procedure = Heal args = { owner = owner amount = amount } }
  }
}
