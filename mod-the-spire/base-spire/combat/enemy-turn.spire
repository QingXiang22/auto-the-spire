using namespace base-spire;
dsl_version = "core/0.3"

# Enemy attack (source DamageCmd.Attack(...).FromMonster, a powered attack). Modifier participants run in the
# source order: the attacker's additive Strength and x0.75 Weak, then the defender's x1.5 Vulnerable, with
# one final integer floor after Colossus. Enemy Strength/Weak are read from Powers held by the attacking enemy; the player's Vulnerable
# from Powers held by the defending player. Block absorbs first and the player HP floor stays zero.
procedure DamagePlayerPowered {
 parameters = { attacker = Ref(Enemy) owner = Ref(Player) amount = Int(min = 0, max = 999) }
 body = {
  call = { procedure = EnemyAttack args = { attacker = attacker defender = owner amount = amount hits = 1 } }
 }
}

procedure EnemyAttack {
  parameters = { attacker = Ref(Enemy) defender = Ref(Player) amount = Int(min = 0, max = 999) hits = Int }
  locals = { attack = Binding }
  body = {
    if = { condition = less(hits, 0) then = { fail = { message = "Negative attack hit count" } } }
    create = { type = Attack scope = entityScope(defender) into = attack collection = Attacks fields = { Enemy = attacker Defender = defender Amount = amount Hits = hits Mode = "single" } }
    call = { procedure = ExecuteAttack args = { attack = attack } }
  }
}

# Clear block for all participants before AfterBlockCleared and individual enemy turns.
procedure RunEnemyTurn {
  parameters = { owner = Ref(Player) }
  body = {
    set = { target = owner field = Player.EnemyPhase value = true }
    call = { procedure = NotifyCombatSideSwitch }
    forEach = { query = sort(where(type(Enemy), e, pureCall(EnemyIsOnSide, e)), e, field(e, Enemy.SpawnOrder)) item = enemy body = {
      call = { procedure = SnapshotPowerTurnStart args = { player = none enemy = enemy } }
    } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforeEnemySideTurnStart payload = { owner = owner } } } }
    forEach = { query = sort(where(type(Enemy), e, pureCall(EnemyIsOnSide, e)), e, field(e, Enemy.SpawnOrder)) item = enemy body = {
      call = { procedure = ClearCombatantBlock args = { player = none enemy = enemy } }
    } }
    forEach = { query = sort(where(type(Enemy), e, pureCall(EnemyIsOnSide, e)), e, field(e, Enemy.SpawnOrder)) item = enemy body = {
      if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterEnemyBlockCleared payload = { owner = owner target = enemy } } } }
    } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterEnemySideTurnStart payload = { owner = owner } } } }
    # forEach captures this list after AfterSideTurnStart and retains its cursor over decisions.
    forEach = { query = sort(where(type(Enemy), e, pureCall(EnemyIsOnSide, e)), e, field(e, Enemy.SpawnOrder)) item = enemy body = {
      if = { condition = not(exists(where(type(Enemy), e, equal(e, enemy)))) then = { fail = { message = "unsupported_capability: fully removed enemy in captured action list" } } }
      if = { condition = field(enemy, Enemy.Escaped) then = { fail = { message = "unsupported_capability: live escape from captured action list" } } }
      if = { condition = pureCall(EnemyIsOnSide, enemy) then = {
        if = { condition = and(not(pureCall(CombatIsOverOrEnding)), and(or(pureCall(EnemyIsActive, enemy), field(enemy, Enemy.Reviving)), not(field(enemy, Enemy.SpawnedThisTurn)))) then = {
          emit = { event = EnemyTurnStarted payload = { owner = owner target = enemy } }
        } }
      } }
    } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforeEnemySideTurnEndVeryEarly payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforeEnemySideTurnEndEarly payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforeEnemySideTurnEnd payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { call = { procedure = ResetCardTurnCosts } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterEnemySideTurnEnd payload = { owner = owner } } } }
    set = { target = owner field = Player.EnemyPhase value = false }
    call = { procedure = NotifyCombatSideSwitch }
  }
}
