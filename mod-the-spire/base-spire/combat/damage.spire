using namespace base-spire;
dsl_version = "core/0.3"

# sts2 Creature.DamageBlockInternal + LoseHpInternal: block absorbs min(Block, amount) first, the rest is
# lost from HP with a floor of 0. Powered modifiers use the separate DamageEnemyPowered operation; death is
# observed as HP reaching zero from above and reported through EnemyDied.
procedure DamageEnemy {
  parameters = { target = Ref(Enemy) amount = Int(min = 0, max = 999999) }
  locals = { blocked = Int before = Int }
  body = {
    let = { into = before value = field(target, Enemy.Hp) }
    let = { into = blocked value = minimum(field(target, Enemy.Block), amount) }
    set = { target = target field = Enemy.Block value = subtract(field(target, Enemy.Block), blocked) }
    set = { target = target field = Enemy.Hp value = maximum(0, subtract(field(target, Enemy.Hp), subtract(amount, blocked))) }
    if = {
      condition = and(greater(before, 0), equal(field(target, Enemy.Hp), 0))
      then = {
        emit = { event = EnemyDied payload = { target = target } }
        call = { procedure = CheckCombatVictory args = { owner = first(type(Player)) } }
      }
    }
  }
}

procedure DamagePlayer {
  parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999999) }
  locals = { blocked = Int }
  body = {
    let = { into = blocked value = minimum(field(owner, Player.Block), amount) }
    set = { target = owner field = Player.Block value = subtract(field(owner, Player.Block), blocked) }
    set = { target = owner field = Player.Hp value = maximum(0, subtract(field(owner, Player.Hp), subtract(amount, blocked))) }
    if = {
      condition = greater(subtract(amount, blocked), 0)
      then = { call = { procedure = RecordPlayerHpLoss args = { owner = owner } } }
    }
    call = { procedure = CheckCombatDefeat args = { owner = owner } }
  }
}

# HP loss that ignores block, matching the source's Unblockable | Unpowered damage used by Offering and
# Bloodletting ("lose HP"). It bypasses block/modifiers but emits positive HP-loss reactions; reaching zero HP
# reports the combat defeat through the shared end check.
procedure LosePlayerHp {
  parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999999) }
  body = {
    set = { target = owner field = Player.Hp value = maximum(0, subtract(field(owner, Player.Hp), amount)) }
    if = {
      condition = greater(amount, 0)
      then = { call = { procedure = RecordPlayerHpLoss args = { owner = owner } } }
    }
    call = { procedure = CheckCombatDefeat args = { owner = owner } }
  }
}

# Powered card attack: additive Strength, attacker Weak, then target Vulnerable plus Cruelty.
# The shared chain retains four decimal places and floors once before block absorption.
procedure DamageEnemyPowered {
  parameters = { target = Ref(Enemy) amount = Int(min = 0, max = 999999) }
  locals = { blocked = Int scaled = Int strength = Int vulnerable = Int before = Int }
  body = {
    let = { into = before value = field(target, Enemy.Hp) }
    let = {
      into = strength
      value = aggregate(where(collection(Powers), power, and(equal(field(power, Power.Kind), "damage-additive"), equal(field(power, Power.HolderPlayer), first(type(Player))))), Sum, power, field(power, Power.Stacks))
    }
    let = {
      into = vulnerable
      value = aggregate(where(collection(Powers), power, and(equal(field(power, Power.Kind), "damage-taken-multiplier"), equal(field(power, Power.HolderEnemy), target))), Sum, power, field(power, Power.Stacks))
    }
    let = { into = scaled value = multiply(maximum(0, add(amount, strength)), 10000) }
    if = { condition = greater(pureCall(PlayerPowerAmount, first(type(Player)), "damage-dealt-multiplier"), 0) then = { let = { into = scaled value = divide(multiply(scaled, 3), 4) } } }
    if = {
      condition = greater(vulnerable, 0)
      then = { let = { into = scaled value = divide(multiply(scaled, add(150, pureCall(PlayerPowerAmount, first(type(Player)), "vulnerable-bonus"))), 100) } }
    }
    let = { into = scaled value = divide(scaled, 10000) }
    let = { into = blocked value = minimum(field(target, Enemy.Block), scaled) }
    set = { target = target field = Enemy.Block value = subtract(field(target, Enemy.Block), blocked) }
    set = { target = target field = Enemy.Hp value = maximum(0, subtract(field(target, Enemy.Hp), subtract(scaled, blocked))) }
    if = {
      condition = and(greater(before, 0), equal(field(target, Enemy.Hp), 0))
      then = {
        emit = { event = EnemyDied payload = { target = target } }
        call = { procedure = CheckCombatVictory args = { owner = first(type(Player)) } }
      }
    }
  }
}

event PlayerHpLost { payload = { owner = Ref(Player) } }
procedure RecordPlayerHpLoss {
  parameters = { owner = Ref(Player) }
  body = {
    set = { target = owner field = Player.LostHpThisTurn value = true }
    set = { target = owner field = Player.HpLossCount value = add(field(owner, Player.HpLossCount), 1) }
    emit = { event = PlayerHpLost payload = { owner = owner } }
  }
}
