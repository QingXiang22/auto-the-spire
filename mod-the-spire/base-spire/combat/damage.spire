using namespace base-spire;
dsl_version = "core/0.3"

# Creature.IsHittable also consults ShouldAllowHitting for living creatures.
event ShouldAllowHittingEnemy { payload = { value = Bool target = Ref(Enemy) } }
procedure EnemyIsActive {
 pure = true parameters = { target = Ref(Enemy) } result = Bool
 body = { return = { value = and(greater(field(target, Enemy.Hp), 0), not(field(target, Enemy.Escaped))) } }
}
procedure EnemyIsHittable {
 pure = true parameters = { target = Ref(Enemy) } result = Bool
 body = {
  if = { condition = not(pureCall(EnemyIsActive, target)) then = { return = { value = false } } }
  return = { value = foldEvent(ShouldAllowHittingEnemy, true, target) }
 }
}

# Compatibility operations use the same result pipeline. A missing source stays missing;
# direct damage never acquires card attribution merely because a card is currently resolving.
procedure DamageEnemy {
 parameters = { target = Ref(Enemy) amount = Int(min = 0, max = 999999) }
 body = { call = { procedure = DamageEnemyWithSource args = { owner = none target = target amount = amount } } }
}
procedure DamageEnemyFromPlayer {
 parameters = { owner = Ref(Player) target = Ref(Enemy) amount = Int(min = 0, max = 999999) }
 body = { call = { procedure = DamageEnemyWithSource args = { owner = owner target = target amount = amount } } }
}
procedure DamageEnemyWithSource {
 parameters = { owner = Binding target = Ref(Enemy) amount = Int(min = 0, max = 999999) }
 locals = { result = Binding boundary = Binding }
 body = {
  let = { into = boundary value = owner }
  if = { condition = isNone(boundary) then = { let = { into = boundary value = first(type(Player)) } } }
  set = { target = boundary field = Player.DamageDepth value = add(field(boundary, Player.DamageDepth), 1) }
  call = { procedure = ResolveEnemyDamage args = { owner = owner target = target card = none play = none attack = none amount = amount powered = false } into = result }
  call = { procedure = PublishDamageResult args = { result = result } }
  call = { procedure = PublishDamageDeath args = { result = result } }
  set = { target = boundary field = Player.DamageDepth value = subtract(field(boundary, Player.DamageDepth), 1) }
  call = { procedure = CheckCombatVictory args = { owner = boundary } }
 }
}
procedure DamageAllEnemiesFromPlayer {
 parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999999) }
 locals = { batch = Binding result = Binding }
 body = {
  if = { condition = not(exists(where(type(Enemy), e, pureCall(EnemyIsHittable, e)))) then = { return = {} } }
  create = { type = DamageBatch scope = entityScope(owner) into = batch fields = { DealerPlayer = owner } }
  set = { target = owner field = Player.DamageDepth value = add(field(owner, Player.DamageDepth), 1) }
  forEach = { query = sort(where(type(Enemy), e, pureCall(EnemyIsHittable, e)), e, field(e, Enemy.SpawnOrder)) item = target body = {
   call = { procedure = ResolveEnemyDamage args = { owner = owner target = target card = none play = none attack = none amount = amount powered = false } into = result }
   set = { target = result field = DamageResult.Batch value = batch }
  } }
  forEach = { query = where(collection(DamageResults), r, equal(field(r, DamageResult.Batch), batch)) item = published body = { call = { procedure = PublishDamageResult args = { result = published } } } }
  forEach = { query = where(collection(DamageResults), r, equal(field(r, DamageResult.Batch), batch)) item = dying body = { call = { procedure = PublishDamageDeath args = { result = dying } } } }
  set = { target = owner field = Player.DamageDepth value = subtract(field(owner, Player.DamageDepth), 1) }
  call = { procedure = CheckCombatVictory args = { owner = owner } }
 }
}
procedure DamageEnemyPowered {
 parameters = { owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) amount = Int(min = 0, max = 999999) }
 body = { call = { procedure = CardAttack args = { owner = owner card = card play = field(owner, Player.CurrentPlay) target = target amount = amount hits = 1 mode = "single" dynamic = false } } }
}
procedure DamagePlayer {
 parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999999) }
 locals = { result = Binding }
 body = {
  call = { procedure = ResolvePlayerDamage args = { owner = owner attacker = none dealerPlayer = none card = none play = none attack = none amount = amount powered = false move = false unblockable = false } into = result }
  call = { procedure = PublishDamageResult args = { result = result } }
 }
}
procedure DamagePlayerFromCard {
 parameters = { owner = Ref(Player) card = Ref(Card) move = Bool amount = Int(min = 0, max = 999999) }
 locals = { result = Binding }
 body = {
  call = { procedure = ResolvePlayerDamage args = { owner = owner attacker = none dealerPlayer = owner card = card play = none attack = none amount = amount powered = false move = move unblockable = false } into = result }
  call = { procedure = PublishDamageResult args = { result = result } }
 }
}
procedure LosePlayerHpFromCard {
 parameters = { owner = Ref(Player) card = Ref(Card) play = Binding amount = Int(min = 0, max = 999999) }
 locals = { result = Binding }
 body = {
  call = { procedure = ResolvePlayerDamage args = { owner = owner attacker = none dealerPlayer = owner card = card play = play attack = none amount = amount powered = false move = true unblockable = true } into = result }
  call = { procedure = PublishDamageResult args = { result = result } }
 }
}
procedure LosePlayerHp {
 parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999999) }
 locals = { result = Binding }
 body = {
  call = { procedure = ResolvePlayerDamage args = { owner = owner attacker = none dealerPlayer = none card = none play = none attack = none amount = amount powered = false move = false unblockable = true } into = result }
  call = { procedure = PublishDamageResult args = { result = result } }
 }
}
procedure LosePlayerHpFromPlayer {
 parameters = { owner = Ref(Player) amount = Int(min = 0, max = 999999) }
 locals = { result = Binding }
 body = {
  call = { procedure = ResolvePlayerDamage args = { owner = owner attacker = none dealerPlayer = owner card = none play = none attack = none amount = amount powered = false move = false unblockable = true } into = result }
  call = { procedure = PublishDamageResult args = { result = result } }
 }
}
procedure RecordPlayerHpLoss {
 parameters = { owner = Ref(Player) }
 body = {
  set = { target = owner field = Player.LostHpThisTurn value = true }
  set = { target = owner field = Player.HpLossCount value = add(field(owner, Player.HpLossCount), 1) }
 }
}
