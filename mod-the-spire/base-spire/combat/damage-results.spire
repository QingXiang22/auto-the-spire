using namespace base-spire;
dsl_version = "core/0.3"

entity DamageBatch { fields = { DealerPlayer = { type = Ref(Player) visibility = Hidden } } }
entity DamageResult {
  fields = {
    Batch = { type = Ref(DamageBatch) optional = true visibility = Hidden }
    Attack = { type = Ref(Attack) optional = true visibility = Hidden }
    Card = { type = Ref(Card) optional = true visibility = Hidden }
    Play = { type = Ref(CardPlayRecord) optional = true visibility = Hidden }
    DealerPlayer = { type = Ref(Player) optional = true visibility = Hidden }
    DealerEnemy = { type = Ref(Enemy) optional = true visibility = Hidden }
    Player = { type = Ref(Player) optional = true visibility = Hidden }
    Enemy = { type = Ref(Enemy) optional = true visibility = Hidden }
    Hit = { type = Int default = 0 }
    Requested = { type = Int }
    Final = { type = Int default = 0 }
    ModifiedScaled = { type = Int default = 0 visibility = Hidden }
    BlockedScaled = { type = Int default = 0 visibility = Hidden }
    HpLossScaled = { type = Int default = 0 visibility = Hidden }
    Blocked = { type = Int default = 0 }
    Unblocked = { type = Int default = 0 }
    Overkill = { type = Int default = 0 }
    Powered = { type = Bool default = false }
    Move = { type = Bool default = false }
    Unblockable = { type = Bool default = false }
    BlockBroken = { type = Bool default = false }
    FullyBlocked = { type = Bool default = false }
    Killed = { type = Bool default = false }
    Published = { type = Bool default = false }
    DeathNotified = { type = Bool default = false }
  }
}
collection DamageResults { element = DamageResult ordered = true }
event DamageResolved { payload = { result = Ref(DamageResult) } }
event BeforeDamageReceived { payload = { result = Ref(DamageResult) } }
event AfterBlockBroken { payload = { result = Ref(DamageResult) } }
event AfterDamageHpLost { payload = { result = Ref(DamageResult) } }
event AfterDamageGiven { payload = { result = Ref(DamageResult) } }
event AfterDamageReceived { payload = { result = Ref(DamageResult) } }
event ModifyHpLoss { payload = { value = Int result = Ref(DamageResult) } }

# Current loaded consumers do not override ModifyHpLost; preserve the fractional input for
# their source identity path. Transfer, prevention and future HP-loss modifiers remain unsupported.
procedure CommitDamageResult {
  parameters = { result = Ref(DamageResult) }
  locals = { before = Int block = Int scaled = Int blocked = Int loss = Int }
  body = {
    let = { into = scaled value = field(result, DamageResult.ModifiedScaled) }
    set = { target = result field = DamageResult.Final value = divide(scaled, 10000) }
    emit = { event = BeforeDamageReceived payload = { result = result } }
    if = { condition = isNone(field(result, DamageResult.Player)) then = {
      let = { into = before value = field(field(result, DamageResult.Enemy), Enemy.Hp) }
      let = { into = block value = field(field(result, DamageResult.Enemy), Enemy.Block) }
    } else = {
      let = { into = before value = field(field(result, DamageResult.Player), Player.Hp) }
      let = { into = block value = field(field(result, DamageResult.Player), Player.Block) }
    } }
    let = { into = blocked value = 0 }
    if = { condition = not(field(result, DamageResult.Unblockable)) then = { let = { into = blocked value = minimum(multiply(block, 10000), scaled) } } }
    set = { target = result field = DamageResult.BlockedScaled value = blocked }
    set = { target = result field = DamageResult.HpLossScaled value = maximum(0, subtract(scaled, blocked)) }
    let = { into = scaled value = foldEvent(ModifyHpLoss, field(result, DamageResult.HpLossScaled), result) }
    set = { target = result field = DamageResult.HpLossScaled value = maximum(0, scaled) }
    let = { into = loss value = minimum(999999999, divide(field(result, DamageResult.HpLossScaled), 10000)) }
    set = { target = result field = DamageResult.Blocked value = divide(blocked, 10000) }
    set = { target = result field = DamageResult.Unblocked value = minimum(before, loss) }
    set = { target = result field = DamageResult.Killed value = and(greater(before, 0), greaterOrEqual(field(result, DamageResult.HpLossScaled), multiply(before, 10000))) }
    if = { condition = field(result, DamageResult.Killed) then = { set = { target = result field = DamageResult.Overkill value = maximum(0, subtract(loss, before)) } } }
    let = { into = block value = subtract(block, divide(blocked, 10000)) }
    set = { target = result field = DamageResult.FullyBlocked value = and(not(field(result, DamageResult.Unblockable)), and(or(greater(blocked, 0), greater(block, 0)), equal(divide(field(result, DamageResult.HpLossScaled), 10000), 0))) }
    set = { target = result field = DamageResult.BlockBroken value = and(greater(blocked, 0), lessOrEqual(block, 0)) }
    if = { condition = isNone(field(result, DamageResult.Player)) then = {
      set = { target = field(result, DamageResult.Enemy) field = Enemy.Block value = block }
      set = { target = field(result, DamageResult.Enemy) field = Enemy.Hp value = maximum(0, subtract(before, loss)) }
    } else = {
      set = { target = field(result, DamageResult.Player) field = Player.Block value = block }
      set = { target = field(result, DamageResult.Player) field = Player.Hp value = maximum(0, subtract(before, loss)) }
    } }
  }
}
procedure ResolveEnemyDamage {
  parameters = { owner = Binding target = Ref(Enemy) card = Binding play = Binding attack = Binding amount = Int powered = Bool }
  locals = { result = Binding scaled = Int hit = Int } result = Binding
  body = {
    if = { condition = not(pureCall(EnemyIsActive, target)) then = { return = { value = none } } }
    let = { into = hit value = 0 }
    if = { condition = not(isNone(attack)) then = { let = { into = hit value = field(attack, Attack.Hit) } } }
    let = { into = scaled value = multiply(maximum(0, amount), 10000) }
    if = { condition = powered then = { let = { into = scaled value = pureCall(CalculatePoweredCardDamageScaled, owner, card, target, attack, play, amount, false) } } }
    create = { type = DamageResult scope = entityScope(target) into = result collection = DamageResults fields = {
      Attack = attack Card = card Play = play DealerPlayer = owner Enemy = target Hit = hit Requested = amount Powered = powered Move = not(isNone(attack)) ModifiedScaled = scaled
    } }
    call = { procedure = CommitDamageResult args = { result = result } }
    return = { value = result }
  }
}
procedure ResolvePlayerDamage {
  parameters = { owner = Ref(Player) attacker = Binding dealerPlayer = Binding card = Binding play = Binding attack = Binding amount = Int powered = Bool move = Bool unblockable = Bool }
  locals = { result = Binding scaled = Int hit = Int } result = Binding
  body = {
    if = { condition = lessOrEqual(field(owner, Player.Hp), 0) then = { return = { value = none } } }
    let = { into = hit value = 0 }
    if = { condition = not(isNone(attack)) then = { let = { into = hit value = field(attack, Attack.Hit) } } }
    let = { into = scaled value = amount }
    if = { condition = and(powered, not(isNone(attacker))) then = { let = { into = scaled value = foldEvent(ModifyEnemyAttackAdditive, scaled, owner, attacker) } } }
    let = { into = scaled value = multiply(scaled, 10000) }
    if = { condition = and(powered, not(isNone(attacker))) then = {
      let = { into = scaled value = foldEvent(ModifyEnemyAttackMultiplier, scaled, owner, attacker) }
      let = { into = scaled value = foldEvent(ModifyIncomingAttackMultiplier, scaled, owner, attacker) }
    } }
    create = { type = DamageResult scope = entityScope(owner) into = result collection = DamageResults fields = {
      Attack = attack Card = card Play = play DealerEnemy = attacker DealerPlayer = dealerPlayer Player = owner Hit = hit Requested = amount Powered = powered Move = move Unblockable = unblockable ModifiedScaled = maximum(0, scaled)
    } }
    call = { procedure = CommitDamageResult args = { result = result } }
    return = { value = result }
  }
}
procedure PublishDamageResult {
  parameters = { result = Binding }
  body = {
    if = { condition = not(isNone(result)) then = {
      if = { condition = not(field(result, DamageResult.Published)) then = {
        set = { target = result field = DamageResult.Published value = true }
        if = { condition = field(result, DamageResult.BlockBroken) then = { emit = { event = AfterBlockBroken payload = { result = result } } } }
        if = { condition = greater(field(result, DamageResult.Unblocked), 0) then = { emit = { event = AfterDamageHpLost payload = { result = result } } } }
        if = { condition = not(isNone(field(result, DamageResult.Player))) then = {
          if = { condition = greater(field(result, DamageResult.Unblocked), 0) then = {
            call = { procedure = RecordPlayerHpLoss args = { owner = field(result, DamageResult.Player) } }
          } }
        } }
        emit = { event = AfterDamageGiven payload = { result = result } }
        if = { condition = isNone(field(result, DamageResult.Player)) then = {
          if = { condition = or(not(field(result, DamageResult.Killed)), greater(field(field(result, DamageResult.Enemy), Enemy.Hp), 0)) then = { emit = { event = AfterDamageReceived payload = { result = result } } } }
        } else = {
          if = { condition = or(not(field(result, DamageResult.Killed)), greater(field(field(result, DamageResult.Player), Player.Hp), 0)) then = { emit = { event = AfterDamageReceived payload = { result = result } } } }
        } }
        emit = { event = DamageResolved payload = { result = result } }
        if = { condition = not(isNone(field(result, DamageResult.Player))) then = { call = { procedure = CheckCombatDefeat args = { owner = field(result, DamageResult.Player) } } } }
      } }
    } }
  }
}
procedure PublishDamageDeath {
  parameters = { result = Binding }
  body = {
    if = { condition = not(isNone(result)) then = {
      if = { condition = and(field(result, DamageResult.Killed), and(not(field(result, DamageResult.DeathNotified)), not(isNone(field(result, DamageResult.Enemy))))) then = {
        set = { target = result field = DamageResult.DeathNotified value = true }
        forEach = { query = where(type(Player), p, field(p, Player.CombatActive)) item = owner body = {
          set = { target = owner field = Player.EnemyDiedInCombat value = true }
        } }
        emit = { event = EnemyDied payload = { target = field(result, DamageResult.Enemy) } }
        if = { condition = and(field(field(result, DamageResult.Enemy), Enemy.Illusion), not(field(field(result, DamageResult.Enemy), Enemy.Reviving))) then = {
          set = { target = field(result, DamageResult.Enemy) field = Enemy.Reviving value = true }
          set = { target = field(result, DamageResult.Enemy) field = Enemy.MoveId value = "REVIVE_MOVE" }
          set = { target = field(result, DamageResult.Enemy) field = Enemy.Intent value = "heal" }
        } else = {
          call = { procedure = RemoveEnemyPowersOnDeath args = { target = field(result, DamageResult.Enemy) } }
        } }
      } }
    } }
  }
}
procedure PublishDamageBatch {
  parameters = { attack = Ref(Attack) hit = Int }
  body = {
    forEach = { query = where(collection(DamageResults), r, and(equal(field(r, DamageResult.Attack), attack), equal(field(r, DamageResult.Hit), hit))) item = result body = {
      call = { procedure = PublishDamageResult args = { result = result } }
    } }
    forEach = { query = where(collection(DamageResults), r, and(equal(field(r, DamageResult.Attack), attack), equal(field(r, DamageResult.Hit), hit))) item = result body = {
      call = { procedure = PublishDamageDeath args = { result = result } }
    } }
  }
}
