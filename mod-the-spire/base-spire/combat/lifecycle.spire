using namespace base-spire;
dsl_version = "core/0.3"

# Shared combat boundaries, also used by the supported normal first-visit path.
event BeforeCombatStart { payload = { owner = Ref(Player) } }
event PlayerDied { payload = { owner = Ref(Player) } }
# Hook phases use distinct dispatch snapshots; energy/block hooks observe the previous turn number.
event BeforePlayerSideTurnStart { payload = { owner = Ref(Player) } }
event AfterBlockCleared { payload = { owner = Ref(Player) } }
event AfterEnergyReset { payload = { owner = Ref(Player) } }
event BeforeHandDraw { payload = { owner = Ref(Player) } }
event AfterPlayerTurnStartEarly { payload = { owner = Ref(Player) } }
event AfterPlayerTurnStart { payload = { owner = Ref(Player) } }
event AfterPlayerTurnStartLate { payload = { owner = Ref(Player) } }
event AfterPlayerSideTurnStart { payload = { owner = Ref(Player) } }
event BeforePlayerSideTurnEndVeryEarly { payload = { owner = Ref(Player) } }
event BeforePlayerSideTurnEndEarly { payload = { owner = Ref(Player) } }
event BeforePlayerSideTurnEnd { payload = { owner = Ref(Player) } }
event AfterPlayerSideTurnEnd { payload = { owner = Ref(Player) } }
event BeforeEnemySideTurnStart { payload = { owner = Ref(Player) } }
event AfterEnemySideTurnStart { payload = { owner = Ref(Player) } }
event BeforeEnemySideTurnEndVeryEarly { payload = { owner = Ref(Player) } }
event BeforeEnemySideTurnEndEarly { payload = { owner = Ref(Player) } }
event BeforeEnemySideTurnEnd { payload = { owner = Ref(Player) } }
event AfterEnemyBlockCleared { payload = { owner = Ref(Player) target = Ref(Enemy) } }
# Confirmed ordinary death notification, before the supported source Power cleanup. The instance
# remains available to damage/play references; complete death prevention/removal hooks are not migrated.
event EnemyDied { payload = { target = Ref(Enemy) } }
event EnemyEscaped { payload = { owner = Ref(Player) target = Ref(Enemy) } }
event EnemyAddedToCombat { payload = { owner = Ref(Player) target = Ref(Enemy) } }
event EnemyRemoving { payload = { target = Ref(Enemy) } }
# The development combat finished: victory when no hittable enemy remains, defeat when the player reaches 0 HP.
event AfterCombatEnd { payload = { owner = Ref(Player) } }
event CombatEnded { payload = { owner = Ref(Player) victory = Bool } }
event CombatVictory { payload = { owner = Ref(Player) victory = Bool } }
event CombatVictoryEarly { payload = { owner = Ref(Player) victory = Bool } }
# One enemy's turn. The enemy content template subscribes and filters by its DefinitionId.
event EnemyTurnStarted { payload = { owner = Ref(Player) target = Ref(Enemy) } }
# The enemy phase finished; source duration tick-down happens here rather than at the player's end of turn.
event AfterEnemySideTurnEnd { payload = { owner = Ref(Player) } }

procedure RemoveCombatEnemy {
  parameters = { target = Ref(Enemy) }
  body = {
    forEach = { query = where(collection(Powers), p, equal(field(p, Power.HolderEnemy), target)) item = power body = {
      call = { procedure = RemovePower args = { power = power } }
    } }
    call = { procedure = ClearEnemyMoves args = { target = target } }
    emit = { event = EnemyRemoving payload = { target = target } }
    destroy = { target = target }
  }
}
procedure EscapeEnemy {
  parameters = { owner = Ref(Player) target = Ref(Enemy) }
  body = {
    if = { condition = or(not(field(owner, Player.CombatActive)), not(pureCall(EnemyIsActive, target))) then = { return = {} } }
    # Source Escape removes the current powers before detaching the still-living creature.
    forEach = { query = where(collection(Powers), p, equal(field(p, Power.HolderEnemy), target)) item = power body = {
      call = { procedure = RemovePower args = { power = power } }
    } }
    set = { target = target field = Enemy.Escaped value = true }
    set = { target = owner field = Player.CombatTimedOut value = true }
    emit = { event = EnemyEscaped payload = { owner = owner target = target } }
    call = { procedure = CheckCombatVictory args = { owner = owner } }
  }
}

# Source order: finish the outer effect, close combat, notify end, clean the normal combat, notify victory,
# then commit the normal visit and offer rewards. A
# combat without targets is never silently won; defeat is evaluated on every player HP loss.
procedure CheckCombatVictory {
  parameters = { owner = Ref(Player) }
  body = {
    call = { procedure = CheckCombatDefeat args = { owner = owner } }
    if = { condition = or(greater(field(owner, Player.DamageDepth), 0), greater(field(owner, Player.EffectDepth), 0)) then = { return = {} } }
    if = {
      condition = and(and(greater(field(owner, Player.Hp), 0), equal(field(owner, Player.AttackDepth), 0)), and(equal(field(owner, Player.PlayDepth), 0), and(field(owner, Player.CombatActive), equal(field(owner, Player.CombatOutcome), "none"))))
      then = {
        if = {
          condition = and(or(field(owner, Player.EnemyDiedInCombat), field(owner, Player.CombatTimedOut)), and(exists(type(Enemy)), not(exists(where(type(Enemy), enemy, pureCall(EnemyIsActive, enemy))))))
          then = {
            set = { target = owner field = Player.CombatOutcome value = "victory" }
            set = { target = owner field = Player.TurnOpen value = false }
            set = { target = owner field = Player.CombatActive value = false }
            call = { procedure = RefreshDrawPermissions }
            emit = { event = CombatEnded payload = { owner = owner victory = true } }
            emit = { event = AfterCombatEnd payload = { owner = owner } }
            call = { procedure = ClearNormalCombat args = { owner = owner } }
            emit = { event = CombatVictoryEarly payload = { owner = owner victory = true } }
            emit = { event = CombatVictory payload = { owner = owner victory = true } }
            call = { procedure = SettleNormalCombat args = { owner = owner victory = true } }
          }
        }
      }
    }
  }
}
procedure CheckCombatDefeat {
  parameters = { owner = Ref(Player) }
  body = {
    if = { condition = or(not(field(owner, Player.CombatActive)), not(equal(field(owner, Player.CombatOutcome), "none"))) then = { return = {} } }
    if = { condition = greater(field(owner, Player.Hp), 0) then = { return = {} } }
    if = { condition = field(owner, Player.DeathResolving) then = { return = {} } }
    if = { condition = not(field(owner, Player.DeathResolved)) then = {
      set = { target = owner field = Player.DeathResolving value = true }
      set = { target = owner field = Player.TurnOpen value = false }
      emit = { event = PlayerDied payload = { owner = owner } }
      call = { procedure = RemovePowersOnDeath args = { player = owner enemy = none } }
      set = { target = owner field = Player.DeathResolved value = true }
      set = { target = owner field = Player.DeathResolving value = false }
    } }
    # Death callbacks retain the combat and outer action references. Only the outer boundary commits.
    if = { condition = or(greater(field(owner, Player.DamageDepth), 0), or(greater(field(owner, Player.EffectDepth), 0), or(greater(field(owner, Player.AttackDepth), 0), greater(field(owner, Player.PlayDepth), 0)))) then = { return = {} } }
    set = { target = owner field = Player.CombatOutcome value = "defeat" }
    set = { target = owner field = Player.CombatActive value = false }
    call = { procedure = RefreshDrawPermissions }
    set = { target = owner field = Player.Room value = "none" }
    set = { target = owner field = Player.RoomUsed value = false }
    emit = { event = CombatEnded payload = { owner = owner victory = false } }
    call = { procedure = SettleNormalCombat args = { owner = owner victory = false } }
  }
}

procedure BeginDevelopmentCombat {
  parameters = { owner = Ref(Player) }
  body = {
    if = {
      condition = field(owner, Player.CombatActive)
      then = { fail = { message = "Development combat is already active" } }
    }
    if = {
      condition = not(and(equal(field(owner, Player.Room), "none"), greater(field(owner, Player.Hp), 0)))
      then = { fail = { message = "Development combat requires a living player outside any room" } }
    }
    call = { procedure = ClearCombatPowers }
    call = { procedure = ResetCardCombatCosts }
    set = { target = owner field = Player.EnemyPhase value = false }
    set = { target = owner field = Player.CardsGeneratedThisCombat value = 0 }
    call = { procedure = BuildCombatDeck args = { owner = owner } }
    set = { target = owner field = Player.PendingForge value = false }
    set = { target = owner field = Player.Block value = 0 }
    set = { target = owner field = Player.TurnNumber value = 0 }
    set = { target = owner field = Player.Energy value = 0 }
    set = { target = owner field = Player.TurnOpen value = false }
    set = { target = owner field = Player.CombatOutcome value = "none" }
    set = { target = owner field = Player.DeathResolving value = false }
    set = { target = owner field = Player.DeathResolved value = false }
    set = { target = owner field = Player.CombatTimedOut value = false }
    set = { target = owner field = Player.EnemyDiedInCombat value = false }
    set = { target = owner field = Player.Room value = "battle" }
    set = { target = owner field = Player.RoomUsed value = false }
    set = { target = owner field = Player.CombatActive value = true }
    call = { procedure = RefreshDrawPermissions }
    if = { condition = greater(field(owner, Player.AutoDrawPerTurn), 0) then = {
      shuffle = { collection = DrawPile stream = "base-spire:run:shuffle" }
    } }
    call = { procedure = SortEncounterEnemies }
    call = { procedure = ResetCombatEnemyMoves args = { owner = owner } }
    call = { procedure = NotifyCurrentCombatRoomEntered args = { owner = owner } }
    forEach = { query = sort(where(type(Enemy), e, pureCall(EnemyIsActive, e)), e, field(e, Enemy.SpawnOrder)) item = enemy body = {
      emit = { event = EnemyAddedToCombat payload = { owner = owner target = enemy } }
    } }
    emit = { event = BeforeCombatStart payload = { owner = owner } }
  }
}
procedure EndDevelopmentCombat {
  parameters = { owner = Ref(Player) }
  body = {
    if = { condition = pureCall(HasDevelopmentEventCombat, owner) then = { fail = { message = "Event combat must finish through its real outcome" } } }
    if = { condition = not(isNone(field(owner, Player.CurrentRun))) then = { fail = { message = "Normal combat must finish through its real outcome" } } }
    if = {
      condition = not(field(owner, Player.CombatActive))
      then = { fail = { message = "Development combat is not active" } }
    }
    set = { target = owner field = Player.CombatActive value = false }
    call = { procedure = RefreshDrawPermissions }
    set = { target = owner field = Player.TurnOpen value = false }
    set = { target = owner field = Player.Room value = "none" }
    set = { target = owner field = Player.RoomUsed value = false }
    call = { procedure = ClearCombatPowers }
  }
}

# BeforeSideTurnStart precedes block reset. AfterEnergyReset still sees the old TurnNumber;
# SetupPlayerTurn then increments it before BeforeHandDraw and the starting draw.
procedure BeginDevelopmentTurn {
  parameters = { owner = Ref(Player) }
  body = {
    if = { condition = not(field(owner, Player.CombatActive)) then = { fail = { message = "Development combat is not active" } } }
    if = { condition = field(owner, Player.TurnOpen) then = { fail = { message = "Development turn is already open" } } }
    set = { target = owner field = Player.EffectDepth value = add(field(owner, Player.EffectDepth), 1) }
    set = { target = owner field = Player.LostHpThisTurn value = false }
    set = { target = owner field = Player.ExhaustedCardThisTurn value = false }
    call = { procedure = SnapshotPowerTurnStart args = { player = owner enemy = none } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforePlayerSideTurnStart payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = {
      forEach = { query = sort(where(type(Enemy), e, pureCall(EnemyIsActive, e)), e, field(e, Enemy.SpawnOrder)) item = enemy body = {
        call = { procedure = SelectNextEnemyMove args = { target = enemy } }
      } }
    } }
    if = { condition = greater(field(owner, Player.TurnNumber), 0) then = {
      call = { procedure = ClearCombatantBlock args = { player = owner enemy = none } }
    } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterBlockCleared payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { call = { procedure = ResetTurnEnergy args = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterEnergyReset payload = { owner = owner } } } }
    set = { target = owner field = Player.TurnNumber value = add(field(owner, Player.TurnNumber), 1) }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforeHandDraw payload = { owner = owner } } } }
    if = { condition = and(not(pureCall(CombatIsOverOrEnding)), greater(field(owner, Player.AutoDrawPerTurn), 0)) then = {
      call = { procedure = DrawDevelopmentTurnHand args = { owner = owner } }
    } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterPlayerTurnStartEarly payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterPlayerTurnStart payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterPlayerTurnStartLate payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterPlayerSideTurnStart payload = { owner = owner } } } }
    set = { target = owner field = Player.EffectDepth value = subtract(field(owner, Player.EffectDepth), 1) }
    call = { procedure = CheckCombatVictory args = { owner = owner } }
    if = { condition = and(field(owner, Player.CombatActive), not(pureCall(CombatIsOverOrEnding))) then = {
      set = { target = owner field = Player.TurnOpen value = true }
    } }
  }
}
# Auto-post-play precedes the three BeforeSideTurnEnd stages, hand effects/flush and side-end.
# Each stage checks ending at entry; callbacks already in that stage keep their snapshot.
procedure EndDevelopmentTurn {
  parameters = { owner = Ref(Player) }
  body = {
    if = { condition = not(field(owner, Player.CombatActive)) then = { fail = { message = "Development combat is not active" } } }
    if = { condition = not(field(owner, Player.TurnOpen)) then = { fail = { message = "Development turn is not open" } } }
    set = { target = owner field = Player.TurnOpen value = false }
    set = { target = owner field = Player.EffectDepth value = add(field(owner, Player.EffectDepth), 1) }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterAutoPostPlayPhaseEntered payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforePlayerSideTurnEndVeryEarly payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforePlayerSideTurnEndEarly payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = BeforePlayerSideTurnEnd payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { call = { procedure = FinishTurnHand args = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { call = { procedure = ResetCardTurnCosts } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterPlayerSideTurnEnd payload = { owner = owner } } } }
    if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { call = { procedure = RunEnemyTurn args = { owner = owner } } } }
    set = { target = owner field = Player.EffectDepth value = subtract(field(owner, Player.EffectDepth), 1) }
    call = { procedure = CheckCombatVictory args = { owner = owner } }
  }
}

procedure EndTurn {
  parameters = { owner = Ref(Player) }
  body = {
    call = { procedure = EndDevelopmentTurn args = { owner = owner } }
    if = { condition = and(field(owner, Player.CombatActive), and(not(pureCall(CombatIsOverOrEnding)), not(field(owner, Player.TurnOpen)))) then = {
      call = { procedure = BeginDevelopmentTurn args = { owner = owner } }
    } }
  }
}

action EndTurn {
  role = player
  requires = and(field(first(type(Player)), Player.CombatActive), field(first(type(Player)), Player.TurnOpen))
  body = { call = { procedure = EndTurn args = { owner = first(type(Player)) } } }
}
action BeginDevelopmentCombat {
  role = player
  requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), and(not(field(first(type(Player)), Player.CombatActive)), and(equal(field(first(type(Player)), Player.Room), "none"), greater(field(first(type(Player)), Player.Hp), 0))))
  body = { call = { procedure = BeginDevelopmentCombat args = { owner = first(type(Player)) } } }
}
action EndDevelopmentCombat {
  role = player
  requires = and(field(first(type(Player)), Player.CombatActive), pureCall(CanUseDevelopmentActions, first(type(Player))))
  body = { call = { procedure = EndDevelopmentCombat args = { owner = first(type(Player)) } } }
}
action BeginDevelopmentTurn {
  role = player
  requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), and(field(first(type(Player)), Player.CombatActive), not(field(first(type(Player)), Player.TurnOpen))))
  body = { call = { procedure = BeginDevelopmentTurn args = { owner = first(type(Player)) } } }
}
action EndDevelopmentTurn {
  role = player
  requires = and(pureCall(CanUseDevelopmentActions, first(type(Player))), and(field(first(type(Player)), Player.CombatActive), field(first(type(Player)), Player.TurnOpen)))
  body = { call = { procedure = EndDevelopmentTurn args = { owner = first(type(Player)) } } }
}
