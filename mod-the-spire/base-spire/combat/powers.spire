using namespace base-spire;
dsl_version = "core/0.3"
# Shared acquisition only publishes lifecycle hooks; power listeners own merge policies and reactions.

procedure ApplyPlayerPower {
  parameters = { owner = Ref(Player) definition = String(length = 64) kind = String(length = 32) stacks = Int(min = -999, max = 999) }
  locals = { existing = Binding }
  body = {
    let = {
      into = existing
      value = first(where(collection(Powers), power, and(equal(field(power, Power.DefinitionId), definition), equal(field(power, Power.HolderPlayer), owner))))
    }
    if = {
      condition = isNone(existing)
      then = {
        create = {
          type = Power scope = entityScope(owner) into = existing collection = Powers
          fields = { Owner = field(owner, Player.Owner) DefinitionId = definition Kind = kind HolderPlayer = owner Stacks = stacks SkipTick = true }
        }
      }
      else = {
        set = { target = existing field = Power.Stacks value = foldEvent(ModifyPowerStacks, add(field(existing, Power.Stacks), stacks), existing, stacks) } } }
    emit = {
      event = PlayerPowerApplied payload = { owner = owner power = existing amount = stacks } }

  }
}
procedure ApplyEnemyPower {
  parameters = { target = Ref(Enemy) definition = String(length = 64) kind = String(length = 32) stacks = Int(min = -999, max = 999) }
  locals = { existing = Binding }
  body = {
    let = {
      into = existing
      value = first(where(collection(Powers), power, and(equal(field(power, Power.DefinitionId), definition), equal(field(power, Power.HolderEnemy), target))))
    }
    if = {
      condition = isNone(existing)
      then = {
        create = {
          type = Power scope = frameScope() into = existing collection = Powers
          fields = { DefinitionId = definition Kind = kind HolderEnemy = target Stacks = stacks }
        }
      }
      else = { set = { target = existing field = Power.Stacks value = add(field(existing, Power.Stacks), stacks) } }
    }
    emit = {
      event = EnemyPowerApplied payload = { target = target power = existing amount = stacks }
                  }
                }
}

# Applies a player power whose lifetime is the current player turn (source FlameBarrierPower is removed at the
# end of the turn). Stack merging behaves like ApplyPlayerPower but both paths mark the instance.
procedure ApplyPlayerPowerUntilTurnEnd {
  parameters = { owner = Ref(Player) definition = String(length = 64) kind = String(length = 32) stacks = Int(min = -999, max = 999) }
  locals = { existing = Binding }
  body = {
    let = {
      into = existing
      value = first(where(collection(Powers), power, and(equal(field(power, Power.DefinitionId), definition), equal(field(power, Power.HolderPlayer), owner))))
    }
    if = {
      condition = isNone(existing)
      then = {
        create = {
          type = Power scope = entityScope(owner) into = existing collection = Powers
          fields = { Owner = field(owner, Player.Owner) DefinitionId = definition Kind = kind HolderPlayer = owner Stacks = stacks SkipTick = true ExpiresAtTurnEnd = true }
        }
      }
      else = {
        set = { target = existing field = Power.Stacks value = add(field(existing, Power.Stacks), stacks) }
        set = { target = existing field = Power.ExpiresAtTurnEnd value = true }
      }
    }
  }
}
# Combat teardown. Source Player.AfterCombatEnd calls Creature.RemoveAllPowersInternalExcept(), so no power
# survives into the next combat; the development combat end clears the whole power collection.
procedure ClearCombatPowers {
  body = {
    forEach = {
      query = collection(Powers) item = power
      body = {
        removeFromCollection = { collection = Powers item = power }
        destroy = { target = power }
      }
    }
  }
}
