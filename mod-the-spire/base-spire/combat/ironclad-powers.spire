using namespace base-spire;
dsl_version = "core/0.3"

# Shared power reactions are selected by modifier role. All mutable state belongs to Engine entities.
procedure ExhaustPowerReactions {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  locals = { block = Int draws = Int }
  body = {
    let = { into = block value = pureCall(PlayerPowerAmount, owner, "block-on-exhaust") }
    let = { into = draws value = pureCall(PlayerPowerAmount, owner, "draw-on-exhaust") }
    if = { condition = greater(block, 0) then = { call = { procedure = GainUnpoweredBlock args = { owner = owner amount = block } } } }
    if = { condition = greater(draws, 0) then = { call = { procedure = DrawCards args = { owner = owner count = draws } } } }
  }
}
subscription ExhaustPowerReactions { event = CardExhausted reaction = ExhaustPowerReactions }
procedure HpLossPowerReactions {
  parameters = { owner = Ref(Player) }
  locals = { strength = Int damage = Int }
  body = {
    if = { condition = not(field(owner, Player.EnemyPhase)) then = {
      let = { into = strength value = pureCall(PlayerPowerAmount, owner, "hp-loss-strength") }
      if = { condition = greater(strength, 0) then = {
        if = { condition = isNone(field(owner, Player.CurrentPlay)) then = { call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:strength-power" kind = "damage-additive" stacks = strength } } } else = { set = { target = field(owner, Player.CurrentPlay) field = CardPlayRecord.RuptureGain value = add(field(field(owner, Player.CurrentPlay), CardPlayRecord.RuptureGain), strength) } } }
      } }
      let = { into = damage value = pureCall(PlayerPowerAmount, owner, "hp-loss-area-damage") }
      if = { condition = greater(damage, 0) then = {
        forEach = { query = where(type(Enemy), e, greater(field(e, Enemy.Hp), 0)) item = e body = { call = { procedure = DamageEnemy args = { target = e amount = damage } } } }
      } }
    } }
  }
}
subscription HpLossPowerReactions { event = PlayerHpLost reaction = HpLossPowerReactions }
procedure BlockPowerReactions {
  parameters = { owner = Ref(Player) amount = Int }
  locals = { target = Binding damage = Int }
  body = {
    let = { into = damage value = pureCall(PlayerPowerAmount, owner, "block-random-damage") }
    if = { condition = and(greater(amount, 0), greater(damage, 0)) then = {
      call = { procedure = RandomLivingEnemy into = target }
      if = { condition = not(isNone(target)) then = { call = { procedure = DamageEnemy args = { target = target amount = damage } } } }
    } }
  }
}
subscription BlockPowerReactions { event = PlayerBlockGained reaction = BlockPowerReactions }
procedure BeforePlayPowerReactions {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  body = {
    if = { condition = equal(field(card, Card.Kind), "attack") then = {
      call = { procedure = ReducePower args = { owner = owner kind = "free-attack" } }
      forEach = { query = where(type(Card), c, and(and(field(c, Card.DiscountsOnAttack), equal(field(c, Card.Owner), field(owner, Player.Owner))), less(collectionIndex(RunDeck, c), 0))) item = c body = {
        set = { target = c field = Card.Cost value = maximum(0, subtract(field(c, Card.Cost), 1)) }
        set = { target = c field = Card.TurnCostDiscount value = add(field(c, Card.TurnCostDiscount), 1) }
        set = { target = c field = Card.CostResetAtTurnEnd value = true }
      } }
    } }
  }
}
subscription BeforePlayPowerReactions { event = BeforeCardPlayed reaction = BeforePlayPowerReactions }
procedure AfterPlayPowerReactions {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  locals = { amount = Int copy = Binding }
  body = {
    let = { into = amount value = field(field(owner, Player.CurrentPlay), CardPlayRecord.RuptureGain) }
    if = { condition = greater(amount, 0) then = { call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:strength-power" kind = "damage-additive" stacks = amount } } } }
    if = { condition = equal(field(card, Card.Kind), "attack") then = {
      let = { into = amount value = pureCall(PlayerPowerAmount, owner, "attack-block") }
      if = { condition = greater(amount, 0) then = { call = { procedure = GainUnpoweredBlock args = { owner = owner amount = amount } } } }
      forEach = { query = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "third-attack-copy"))) item = p body = {
        set = { target = p field = Power.Counter value = add(field(p, Power.Counter), 1) }
        if = { condition = equal(field(p, Power.Counter), 3) then = {
          repeat = { count = field(p, Power.Stacks) body = {
            call = { procedure = CloneCombatCard args = { owner = owner source = card } into = copy }
            call = { procedure = AddGeneratedToHand args = { card = copy } }
          } }
        } }
      } }
    } }
  }
}
subscription AfterPlayPowerReactions { event = AfterCardPlayed reaction = AfterPlayPowerReactions }
procedure BeforeTurnPowerReactions {
  parameters = { owner = Ref(Player) }
  locals = { chosen = Binding }
  body = {
    repeat = { count = pureCall(PlayerPowerAmount, owner, "upgrade-discard-attacks") body = {
      if = { condition = exists(where(collection(DiscardPile), c, equal(field(c, Card.Kind), "attack"))) then = {
        samplePick = { stream = "base-spire:run:combat_card_selection" candidates = where(collection(DiscardPile), c, equal(field(c, Card.Kind), "attack")) into = chosen }
        removeFromCollection = { collection = DiscardPile item = chosen }
        call = { procedure = AddGeneratedToHand args = { card = chosen } }
        if = { condition = and(field(chosen, Card.CanUpgrade), not(field(chosen, Card.Upgraded))) then = { call = { procedure = UpgradeCard args = { card = chosen } } } }
      } }
    } }
  }
}
procedure SideStartPowerReactions {
  parameters = { owner = Ref(Player) }
  locals = { strength = Int }
  body = {
    let = { into = strength value = pureCall(PlayerPowerAmount, owner, "turn-strength") }
    if = { condition = greater(strength, 0) then = { call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:strength-power" kind = "damage-additive" stacks = strength } } } }
    if = { condition = greater(field(owner, Player.TurnNumber), 1) then = { call = { procedure = ReducePower args = { owner = owner kind = "plating" } } } }
  }
}
subscription SideStartPowerReactions { event = AfterSideTurnStarted reaction = SideStartPowerReactions }
procedure TurnStartPowerReactions {
  parameters = { owner = Ref(Player) }
  body = {
    forEach = { query = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), or(equal(field(p, Power.Kind), "turn-self-damage-block"), equal(field(p, Power.Kind), "hp-loss-area-damage")))) item = p body = {
      call = { procedure = LosePlayerHp args = { owner = owner amount = field(p, Power.SelfDamage) } }
      if = { condition = equal(field(p, Power.Kind), "turn-self-damage-block") then = { call = { procedure = GainUnpoweredBlock args = { owner = owner amount = field(p, Power.Stacks) } } } }
    } }
  }
}
subscription TurnStartPowerReactions { event = AfterPlayerTurnStart reaction = TurnStartPowerReactions }
procedure BeforeTurnEndPowerReactions {
  parameters = { owner = Ref(Player) }
  locals = { chosen = Binding }
  body = {
    call = { procedure = GainUnpoweredBlock args = { owner = owner amount = pureCall(PlayerPowerAmount, owner, "plating") } }
    forEach = { query = where(collection(ExhaustPile), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), field(c, Card.AutoFromExhaustAtTurnEnd))) item = c body = {
      call = { procedure = AutoPlayCard args = { owner = owner card = c forceExhaust = false } }
    } }
    repeat = { count = pureCall(PlayerPowerAmount, owner, "end-turn-auto-attack") body = {
      if = { condition = and(field(owner, Player.CombatActive), exists(where(collection(Hand), c, equal(field(c, Card.Kind), "attack")))) then = {
        samplePick = { stream = "base-spire:run:shuffle" candidates = where(collection(Hand), c, equal(field(c, Card.Kind), "attack")) into = chosen }
        call = { procedure = AutoPlayCard args = { owner = owner card = chosen forceExhaust = false } }
      } }
    } }
  }
}
procedure SideEndPowerReactions {
  parameters = { owner = Ref(Player) }
  body = {
    forEach = { query = where(collection(Powers), p, equal(field(p, Power.HolderPlayer), owner)) item = p body = {
      if = { condition = equal(field(p, Power.Kind), "remove-strength") then = { call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:strength-power" kind = "damage-additive" stacks = subtract(0, field(p, Power.Stacks)) } } destroy = { target = p } } else = {
        if = { condition = field(p, Power.ExpiresBeforeEnemy) then = { destroy = { target = p } } else = { if = { condition = equal(field(p, Power.Kind), "third-attack-copy") then = { set = { target = p field = Power.Counter value = 0 } } } } }
      } }
    } }
  }
}
procedure EnemyEndPowerReactions {
  parameters = { owner = Ref(Player) }
  body = {
    forEach = { query = where(collection(Powers), p, and(equal(field(p, Power.Kind), "restore-strength"), not(isNone(field(p, Power.HolderEnemy))))) item = p body = {
      call = { procedure = ApplyEnemyPower args = { target = field(p, Power.HolderEnemy) definition = "base-spire:strength-power" kind = "damage-additive" stacks = field(p, Power.Stacks) } }
      destroy = { target = p }
    } }
    call = { procedure = ReducePower args = { owner = owner kind = "halve-vulnerable-attacks" } }
  }
}
subscription EnemyEndPowerReactions { event = AfterEnemyTurnEnded reaction = EnemyEndPowerReactions }
procedure EarlyDrawPowerReactions {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  body = { if = { condition = and(field(card, Card.StrikeTag), greater(pureCall(PlayerPowerAmount, owner, "autoplay-drawn-strikes"), 0)) then = {
    call = { procedure = AutoPlayCard args = { owner = owner card = card forceExhaust = false } }
  } } }
}
