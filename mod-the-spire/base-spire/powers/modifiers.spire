using namespace base-spire;
dsl_version = "core/0.3"

procedure Strength {
  pure = true parameters = { value = Int owner = Ref(Player) card = Binding target = Binding listener = Ref(Power) }
  result = Int body = {
    return = { value = add(value, field(listener, Power.Stacks)) }
    return = { value = value }
  }
}

subscription Strength {
  event = ModifyAttackAdditive reaction = Strength instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "damage-additive"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure Weak {
  pure = true parameters = { value = Int owner = Ref(Player) card = Binding target = Binding listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = divide(multiply(value, 3), 4) }
      }
    }
    return = { value = value }
  }
}

subscription Weak {
  event = ModifyAttackMultiplier reaction = Weak instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "damage-dealt-multiplier"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure Vulnerable {
  pure = true parameters = { value = Int owner = Ref(Player) card = Binding target = Binding listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(listener, Power.HolderEnemy), target), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = divide(multiply(value, add(150, pureCall(PlayerPowerAmount, owner, "vulnerable-bonus"))), 100) }
      }
    }
    return = { value = value }
  }
}

subscription Vulnerable {
  event = ModifyAttackMultiplier reaction = Vulnerable instances = where(collection(Powers), p, equal(field(p, Power.Kind), "damage-taken-multiplier")) instance_order = collectionIndex(Powers, listener) priority = 10
}

procedure EnemyStrength {
  pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = equal(field(listener, Power.HolderEnemy), attacker) then = {
        return = { value = add(value, field(listener, Power.Stacks)) }
      }
    }
    return = { value = value }
  }
}

subscription EnemyStrength {
  event = ModifyEnemyAttackAdditive reaction = EnemyStrength instances = where(collection(Powers), p, equal(field(p, Power.Kind), "damage-additive")) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure EnemyWeak {
  pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(listener, Power.HolderEnemy), attacker), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = divide(multiply(value, 3), 4) }
      }
    }
    return = { value = value }
  }
}

subscription EnemyWeak {
  event = ModifyEnemyAttackMultiplier reaction = EnemyWeak instances = where(collection(Powers), p, equal(field(p, Power.Kind), "damage-dealt-multiplier")) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure PlayerVulnerable {
  pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = divide(multiply(value, 3), 2) }
      }
    }
    return = { value = value }
  }
}

subscription PlayerVulnerable {
  event = ModifyIncomingAttackMultiplier reaction = PlayerVulnerable instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "damage-taken-multiplier"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure Colossus {
  pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(greater(field(listener, Power.Stacks), 0), greater(pureCall(EnemyPowerAmount, attacker, "damage-taken-multiplier"), 0)) then = {
        return = { value = divide(value, 2) }
      }
    }
    return = { value = value }
  }
}

subscription Colossus {
  event = ModifyIncomingAttackMultiplier reaction = Colossus instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "halve-vulnerable-attacks"))) instance_order = collectionIndex(Powers, listener) priority = 10
}

procedure Dexterity {
  pure = true parameters = { value = Int owner = Ref(Player) listener = Ref(Power) }
  result = Int body = {
    return = { value = add(value, field(listener, Power.Stacks)) }
    return = { value = value }
  }
}

subscription Dexterity {
  event = ModifyBlockAdditive reaction = Dexterity instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "block-additive"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure Frail {
  pure = true parameters = { value = Int owner = Ref(Player) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = divide(multiply(value, 3), 4) }
      }
    }
    return = { value = value }
  }
}

subscription Frail {
  event = ModifyBlockMultiplier reaction = Frail instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "block-dealt-multiplier"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure Unmovable {
  pure = true parameters = { value = Int owner = Ref(Player) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = less(aggregate(where(collection(CardPlays), r, and(equal(field(r, CardPlayRecord.Turn), field(owner, Player.TurnNumber)), not(equal(r, field(owner, Player.CurrentPlay))))), Sum, r, field(r, CardPlayRecord.PoweredBlocks)), field(listener, Power.Stacks)) then = {
        return = { value = multiply(value, 2) }
      }
    }
    return = { value = value }
  }
}

subscription Unmovable {
  event = ModifyBlockMultiplier reaction = Unmovable instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "early-block-double"))) instance_order = collectionIndex(Powers, listener) priority = 10
}

procedure CorruptionCost {
  pure = true parameters = { value = Int owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "skill"), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = 0 }
      }
    }
    return = { value = value }
  }
}

subscription CorruptionCost {
  event = ModifyCardCost reaction = CorruptionCost instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "corruption"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure FreeAttackCost {
  pure = true parameters = { value = Int owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(greater(field(listener, Power.Stacks), 0), and(equal(field(card, Card.Kind), "attack"), or(greaterOrEqual(collectionIndex(Hand, card), 0), greaterOrEqual(collectionIndex(InPlay, card), 0)))) then = {
        return = { value = 0 }
      }
    }
    return = { value = value }
  }
}

subscription FreeAttackCost {
  event = ModifyCardCost reaction = FreeAttackCost instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "free-attack"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure Pyre {
  pure = true parameters = { value = Int owner = Ref(Player) listener = Ref(Power) }
  result = Int body = {
    return = { value = add(value, field(listener, Power.Stacks)) }
    return = { value = value }
  }
}

subscription Pyre {
  event = ModifyMaxEnergy reaction = Pyre instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "max-energy"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure Barricade {
  pure = true parameters = { value = Bool owner = Ref(Player) listener = Ref(Power) }
  result = Bool body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = false }
      }
    }
    return = { value = value }
  }
}

subscription Barricade {
  event = ShouldClearBlock reaction = Barricade instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "retain-block"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure NoEnergy {
  pure = true parameters = { value = Bool owner = Ref(Player) listener = Ref(Power) }
  result = Bool body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = false }
      }
    }
    return = { value = value }
  }
}

subscription NoEnergy {
  event = ShouldGainEnergy reaction = NoEnergy instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "no-energy-gain"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure NoDraw {
  pure = true parameters = { value = Bool owner = Ref(Player) listener = Ref(Power) }
  result = Bool body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = false }
      }
    }
    return = { value = value }
  }
}

subscription NoDraw {
  event = ShouldDraw reaction = NoDraw instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "no-draw"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure CorruptionExhaust {
  pure = true parameters = { value = Bool owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  result = Bool body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "skill"), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = true }
      }
    }
    return = { value = value }
  }
}

subscription CorruptionExhaust {
  event = ShouldExhaustSkill reaction = CorruptionExhaust instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "corruption"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure OneTwoPunch {
  pure = true parameters = { value = Int owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "attack"), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = maximum(value, 2) }
      }
    }
    return = { value = value }
  }
}

subscription OneTwoPunch {
  event = ModifyPlayCount reaction = OneTwoPunch instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), "repeat-next-attack"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure SinglePowerStacks {
  pure = true parameters = { value = Int power = Ref(Power) amount = Int listener = Ref(Power) }
  result = Int body = {
    return = { value = subtract(value, amount) }
  }
}

subscription SinglePowerStacks {
  event = ModifyPowerStacks reaction = SinglePowerStacks instances = where(collection(Powers), p, and(equal(p, power), or(equal(field(p, Power.Kind), "corruption"), equal(field(p, Power.Kind), "autoplay-drawn-strikes"))))
}
