using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template RupturePowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:rupture-power" } }

entity Pending { fields = { Power = { type = Ref(Power) visibility = Hidden } Play = { type = Ref(CardPlayRecord) visibility = Hidden } Amount = { type = Int default = 0 visibility = Hidden } } }
procedure LostHp {
 parameters = { owner = Ref(Player) result = Ref(DamageResult) listener = Ref(Power) } locals = { pending = Binding sourcePlay = Binding }
 body = { if = { condition = and(not(field(owner, Player.EnemyPhase)), and(greater(field(result, DamageResult.Unblocked), 0), greater(field(listener, Power.Stacks), 0))) then = {
  let = { into = sourcePlay value = field(result, DamageResult.Play) }
  if = { condition = isNone(sourcePlay) then = {
   call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:strength-power" stacks = field(listener, Power.Stacks) } }
  } else = {
   let = { into = pending value = first(where(type(Pending), s, and(equal(field(s, Pending.Power), listener), equal(field(s, Pending.Play), sourcePlay)))) }
   if = { condition = isNone(pending) then = { create = { type = Pending scope = entityScope(listener) into = pending fields = { Power = listener Play = sourcePlay } } } }
   set = { target = pending field = Pending.Amount value = add(field(pending, Pending.Amount), field(listener, Power.Stacks)) }
  } }
 } } }
}
subscription LostHp { event = PlayerDamaged reaction = LostHp instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:rupture-power"))) instance_order = collectionIndex(Powers, listener) priority = 0 }
procedure Completed {
 parameters = { owner = Ref(Player) card = Ref(Card) play = Ref(CardPlayRecord) listener = Ref(Power) }
 body = { forEach = { query = where(type(Pending), s, and(equal(field(s, Pending.Power), listener), equal(field(s, Pending.Play), play))) item = pending body = {
  call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:strength-power" stacks = field(pending, Pending.Amount) } }
  destroy = { target = pending }
 } } }
}
subscription Completed { event = AfterCardExecution reaction = Completed instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:rupture-power"))) instance_order = collectionIndex(Powers, listener) priority = -100 }
procedure Removed { parameters = { power = Ref(Power) } body = { forEach = { query = where(type(Pending), s, equal(field(s, Pending.Power), power)) item = pending body = { destroy = { target = pending } } } } }
subscription Removed { event = PowerRemoved reaction = Removed }

} }
use RupturePower { template = RupturePowerModule }
