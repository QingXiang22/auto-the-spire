using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template ThornsPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:thorns-power" } }

procedure Thorns {
  parameters = { owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        call = {
          procedure = DamageEnemy args = {
            target = attacker amount = field(listener, Power.Stacks)
          }
        }
      }
    }
  }
}

subscription Thorns {
  event = BeforePlayerAttacked reaction = Thorns instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:thorns-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}
} }
use ThornsPower { template = ThornsPowerModule }
