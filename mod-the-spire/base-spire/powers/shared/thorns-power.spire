using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template ThornsPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:thorns-power" } }

procedure Thorns {
  parameters = { result = Ref(DamageResult) listener = Ref(Power) }
  body = {
    if = {
      condition = and(field(result, DamageResult.Powered), and(not(isNone(field(result, DamageResult.DealerEnemy))), greater(field(listener, Power.Stacks), 0))) then = {
        call = {
          procedure = DamageEnemyFromPlayer args = { owner = field(result, DamageResult.Player)
            target = field(result, DamageResult.DealerEnemy) amount = field(listener, Power.Stacks)
          }
        }
      }
    }
  }
}

subscription Thorns {
  event = BeforeDamageReceived reaction = Thorns instances = where(collection(Powers), p, and(not(isNone(field(result, DamageResult.Player))), and(equal(field(p, Power.HolderPlayer), field(result, DamageResult.Player)), equal(field(p, Power.DefinitionId), "base-spire:thorns-power")))) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}
} }
use ThornsPower { template = ThornsPowerModule }
