using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template StrengthPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:strength-power" allowNegative = true } }

procedure Strength {
  pure = true parameters = { value = Int owner = Ref(Player) card = Binding target = Binding listener = Ref(Power) }
  result = Int body = {
    return = { value = add(value, field(listener, Power.Stacks)) }
    return = { value = value }
  }
}

subscription Strength {
  event = ModifyAttackAdditive reaction = Strength instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:strength-power"))) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}

procedure EnemyStrength {
  pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = equal(field(listener, Power.HolderEnemy), attacker) then = {
        return = { value = add(value, field(listener, Power.Stacks)) }
      }
    }
    return = { value = value }
  }
}

subscription EnemyStrength {
  event = ModifyEnemyAttackAdditive reaction = EnemyStrength instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:strength-power")) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}
} }
use StrengthPower { template = StrengthPowerModule }
