using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template JuggernautPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:juggernaut-power" } }

procedure Juggernaut {
  parameters = { gain = Ref(BlockGain) listener = Ref(Power) }
  locals = { target = Binding }
  body = {
    if = {
      condition = and(greater(field(gain, BlockGain.AmountMicros), 0), greater(field(listener, Power.Stacks), 0)) then = {
        call = { procedure = RandomLivingEnemy into = target }
        if = {
          condition = not(isNone(target)) then = {
            call = {
              procedure = DamageEnemyFromPlayer args = { owner = field(listener, Power.HolderPlayer)
                target = target amount = field(listener, Power.Stacks)
              }
            }
          }
        }
      }
    }
  }
}

subscription Juggernaut {
  event = AfterBlockGained reaction = Juggernaut instances = where(collection(Powers), p, and(and(not(isNone(field(gain, BlockGain.Player))), equal(field(p, Power.HolderPlayer), field(gain, BlockGain.Player))), equal(field(p, Power.DefinitionId), "base-spire:juggernaut-power"))) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}
} }
use JuggernautPower { template = JuggernautPowerModule }
