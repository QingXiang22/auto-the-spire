using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template JuggernautPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:juggernaut-power" } }

procedure Juggernaut {
  parameters = { owner = Ref(Player) amount = Int listener = Ref(Power) }
  locals = { target = Binding }
  body = {
    if = {
      condition = and(greater(amount, 0), greater(field(listener, Power.Stacks), 0)) then = {
        call = { procedure = RandomLivingEnemy into = target }
        if = {
          condition = not(isNone(target)) then = {
            call = {
              procedure = DamageEnemyFromPlayer args = { owner = owner
                target = target amount = field(listener, Power.Stacks)
              }
            }
          }
        }
      }
    }
  }
}

subscription Juggernaut {
  event = PlayerBlockGained reaction = Juggernaut instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:juggernaut-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}
} }
use JuggernautPower { template = JuggernautPowerModule }
