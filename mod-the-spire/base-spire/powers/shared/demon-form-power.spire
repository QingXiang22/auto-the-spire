using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template DemonFormPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:demon-form" } }

procedure DemonForm {
  parameters = { owner = Ref(Player) listener = Ref(Power) }
  body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        call = {
          procedure = ApplyPlayerPower args = {
            owner = owner definition = "base-spire:strength-power" stacks = field(listener, Power.Stacks)
          }
        }
      }
    }
  }
}

subscription DemonForm {
  event = AfterPlayerSideTurnStart reaction = DemonForm instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:demon-form"))) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}
} }
use DemonFormPower { template = DemonFormPowerModule }
