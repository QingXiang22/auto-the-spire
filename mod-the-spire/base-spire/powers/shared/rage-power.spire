using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template RagePowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:rage-power" } }

procedure Rage {
  parameters = { owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "attack"), greater(field(listener, Power.Stacks), 0)) then = {
        call = {
          procedure = GainUnpoweredBlock args = {
            owner = owner amount = field(listener, Power.Stacks)
          }
        }
      }
    }
  }
}

subscription Rage {
  event = AfterCardPlayed reaction = Rage instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:rage-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}
procedure Expire { parameters = { owner = Ref(Player) listener = Ref(Power) } body = { call = { procedure = RemovePower args = { power = listener } } } }
subscription Expire { event = AfterPlayerSideEnd reaction = Expire instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:rage-power"))) instance_order = collectionIndex(Powers, listener) priority = 10 }

} }
use RagePower { template = RagePowerModule }
