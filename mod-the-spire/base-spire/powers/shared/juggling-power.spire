using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template JugglingPowerModule { body = {
  entity State { fields = { Power = { type = Ref(Power) visibility = Hidden } Value = { type = Int default = 0 visibility = Hidden } } }
  procedure Created { parameters = { power = Ref(Power) listener = Ref(Power) } locals = { state = Binding } body = { create = { type = State scope = entityScope(power) into = state fields = { Power = power } } } }
  subscription Created { event = PowerCreated reaction = Created instances = where(collection(Powers), p, and(equal(p, power), equal(field(p, Power.DefinitionId), "base-spire:juggling-power"))) instance_order = collectionIndex(Powers, listener) }
  procedure Removed { parameters = { power = Ref(Power) } body = { forEach = { query = where(type(State), s, equal(field(s, State.Power), power)) item = state body = { destroy = { target = state } } } } }
  subscription Removed { event = PowerRemoved reaction = Removed }
  use Definition { template = PowerDefinition args = { definition = "base-spire:juggling-power" } }

procedure SetupStrike {
  parameters = { owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  locals = { copy = Binding }
  body = {
    if = {
      condition = equal(field(card, Card.Kind), "attack") then = {
        set = { target = first(where(type(State), s, equal(field(s, State.Power), listener))) field = State.Value value = add(field(first(where(type(State), s, equal(field(s, State.Power), listener))), State.Value), 1) }
        if = {
          condition = equal(field(first(where(type(State), s, equal(field(s, State.Power), listener))), State.Value), 3) then = {
            repeat = {
              count = field(listener, Power.Stacks) body = {
                call = { procedure = CloneCombatCardToPile args = { owner = owner source = card to = "hand" reason = "generate" } into = copy }
              }
            }
          }
        }
      }
    }
  }
}

subscription SetupStrike {
  event = AfterCardPlayed reaction = SetupStrike instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:juggling-power"))) instance_order = pureCall(PowerHookOrder, listener, true) priority = 0
}

procedure SetupReset {
  parameters = { owner = Ref(Player) listener = Ref(Power) }
  body = {
    set = { target = first(where(type(State), s, equal(field(s, State.Power), listener))) field = State.Value value = 0 }
  }
}

subscription SetupReset {
  event = AfterPlayerSideTurnEnd reaction = SetupReset instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:juggling-power"))) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}
procedure Applied { parameters = { power = Ref(Power) amount = Int created = Bool listener = Ref(Power) } body = { set = { target = first(where(type(State), s, equal(field(s, State.Power), power))) field = State.Value value = pureCall(AttacksPlayedThisTurn, field(power, Power.HolderPlayer)) } } }
subscription Applied { event = AfterPowerApplied reaction = Applied instances = where(collection(Powers), p, and(equal(p, power), equal(field(p, Power.DefinitionId), "base-spire:juggling-power"))) instance_order = pureCall(PowerHookOrder, listener, false) }

} }
use JugglingPower { template = JugglingPowerModule }
