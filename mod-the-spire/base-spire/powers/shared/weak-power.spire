using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template WeakPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:weak-power" powerType = "debuff" } }

procedure Weak {
  pure = true parameters = { value = Int owner = Ref(Player) card = Binding target = Binding listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = divide(multiply(value, 3), 4) }
      }
    }
    return = { value = value }
  }
}

subscription Weak {
  event = ModifyAttackMultiplier reaction = Weak instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:weak-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure EnemyWeak {
  pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(listener, Power.HolderEnemy), attacker), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = divide(multiply(value, foldEvent(ModifyEnemyWeakMultiplier, 75, owner, attacker)), 100) }
      }
    }
    return = { value = value }
  }
}

subscription EnemyWeak {
  event = ModifyEnemyAttackMultiplier reaction = EnemyWeak instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:weak-power")) instance_order = collectionIndex(Powers, listener) priority = 0
}
procedure Duration { parameters = { owner = Ref(Player) listener = Ref(Power) } body = { call = { procedure = TickPowerDuration args = { power = listener } } } }
subscription Duration { event = AfterEnemyTurnEnded reaction = Duration instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:weak-power")) instance_order = pureCall(PowerSideTurnEndOrder, listener) priority = 0 }

} }
use WeakPower { template = WeakPowerModule }
