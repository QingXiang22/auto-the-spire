using namespace base-spire;
dsl_version = "core/0.3"

template TangledPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:tangled-power" powerType = "debuff" } }
  procedure Mark { parameters = { card = Ref(Card) } locals = { attachment = Binding } body = {
    if = { condition = and(equal(field(card, Card.Kind), "attack"), not(exists(where(type(CardAttachment), a, and(equal(field(a, CardAttachment.Card), card), equal(field(a, CardAttachment.Kind), "affliction")))))) then = {
      create = { type = CardAttachment scope = entityScope(card) into = attachment fields = { Owner = field(card, Card.Owner) Card = card DefinitionId = "base-spire:entangled" Kind = "affliction" Amount = 1 } }
    } }
  } }
  procedure Apply { parameters = { power = Ref(Power) amount = Int created = Bool listener = Ref(Power) } body = {
    if = { condition = equal(power, listener) then = {
      forEach = { query = where(type(Card), c, and(equal(field(c, Card.Owner), field(field(power, Power.HolderPlayer), Player.Owner)), less(collectionIndex(RunDeck, c), 0))) item = card body = { call = { procedure = Mark args = { card = card } } } }
    } }
  } }
  subscription Apply { event = AfterPowerApplied reaction = Apply instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:tangled-power")) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0 }
  procedure Entered { parameters = { owner = Ref(Player) card = Ref(Card) clone = Bool listener = Ref(Power) } body = {
    if = { condition = equal(owner, field(listener, Power.HolderPlayer)) then = { call = { procedure = Mark args = { card = card } } } }
  } }
  subscription Entered { event = CardEnteredCombat reaction = Entered instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:tangled-power")) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0 }
  procedure Cost { pure = true parameters = { value = Int owner = Ref(Player) card = Ref(Card) listener = Ref(Power) } result = Int body = {
    if = { condition = and(equal(owner, field(listener, Power.HolderPlayer)), and(not(field(card, Card.IsX)), exists(where(type(CardAttachment), a, and(equal(field(a, CardAttachment.Card), card), equal(field(a, CardAttachment.DefinitionId), "base-spire:entangled")))))) then = { return = { value = add(value, field(listener, Power.Stacks)) } } }
    return = { value = value }
  } }
  subscription Cost { event = ModifyCardCost reaction = Cost instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:tangled-power")) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0 }
  procedure Expire { parameters = { owner = Ref(Player) listener = Ref(Power) } body = {
    if = { condition = equal(owner, field(listener, Power.HolderPlayer)) then = { call = { procedure = RemovePower args = { power = listener } } } }
  } }
  subscription Expire { event = AfterPlayerSideTurnEnd reaction = Expire instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:tangled-power")) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0 }
  procedure Clean { parameters = { power = Ref(Power) } body = {
    if = { condition = equal(field(power, Power.DefinitionId), "base-spire:tangled-power") then = {
      forEach = { query = where(type(CardAttachment), a, and(equal(field(a, CardAttachment.Owner), field(field(power, Power.HolderPlayer), Player.Owner)), equal(field(a, CardAttachment.DefinitionId), "base-spire:entangled"))) item = attachment body = {
        emit = { event = CardAttachmentRemoved payload = { attachment = attachment } }
        destroy = { target = attachment }
      } }
    } }
  } }
  subscription Clean { event = PowerRemoved reaction = Clean }
} }
use TangledPower { template = TangledPowerModule }
