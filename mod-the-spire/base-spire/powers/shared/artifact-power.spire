using namespace base-spire;
dsl_version = "core/0.3"

# Locked ArtifactPower: Try may succeed without changing zero to another value.
template ArtifactPowerContent { body = {
 use Definition { template = PowerDefinition args = { definition = "base-spire:artifact-power" } }
 procedure ShouldBlock {
  pure = true parameters = { change = Ref(PowerAmountChange) listener = Ref(Power) } result = Bool
  body = { return = { value = and(and(equal(field(change, PowerAmountChange.Player), field(listener, Power.HolderPlayer)), equal(field(change, PowerAmountChange.Enemy), field(listener, Power.HolderEnemy))), equal(pureCall(PowerTypeForAmount, field(change, PowerAmountChange.Definition), field(change, PowerAmountChange.Amount)), "debuff")) } }
 }
 procedure Receive {
  parameters = { change = Ref(PowerAmountChange) listener = Ref(Power) }
  body = { if = { condition = pureCall(ShouldBlock, change, listener) then = {
   call = { procedure = RecordPowerAmountModifier args = { change = change power = listener amount = 0 } }
  } } }
 }
 subscription Receive {
  event = PowerAmountReceiving reaction = Receive
  instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:artifact-power"))
  instance_order = pureCall(PowerHookOrder, listener, false)
 }
 procedure Consume {
  parameters = { change = Ref(PowerAmountChange) listener = Ref(Power) }
  body = { call = { procedure = ModifyPowerAmount args = { power = listener delta = -1 } } }
 }
 subscription Consume {
  event = AfterModifyingPowerAmountReceived reaction = Consume
  instances = where(collection(Powers), p, and(equal(field(p, Power.DefinitionId), "base-spire:artifact-power"), exists(where(type(PowerAmountModifier), r, and(equal(field(r, PowerAmountModifier.Change), change), equal(field(r, PowerAmountModifier.Power), p))))))
  instance_order = pureCall(PowerHookOrder, listener, false)
 }
} }
use ArtifactPower { template = ArtifactPowerContent }
