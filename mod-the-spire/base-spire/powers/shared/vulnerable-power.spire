using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template VulnerablePowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:vulnerable-power" powerType = "debuff" } }

procedure Vulnerable {
  pure = true parameters = { value = Int owner = Ref(Player) card = Binding target = Binding listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(listener, Power.HolderEnemy), target), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = divide(multiply(value, add(foldEvent(ModifyVulnerableMultiplier, 150, owner, card, target), pureCall(PlayerPowerAmount, owner, "base-spire:cruelty-power"))), 100) }
      }
    }
    return = { value = value }
  }
}

subscription Vulnerable {
  event = ModifyAttackMultiplier reaction = Vulnerable instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:vulnerable-power")) instance_order = collectionIndex(Powers, listener) priority = 10
}

procedure PlayerVulnerable {
  pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = divide(multiply(value, 3), 2) }
      }
    }
    return = { value = value }
  }
}

subscription PlayerVulnerable {
  event = ModifyIncomingAttackMultiplier reaction = PlayerVulnerable instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:vulnerable-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}
procedure Duration { parameters = { owner = Ref(Player) listener = Ref(Power) } body = { call = { procedure = TickPowerDuration args = { power = listener } } } }
subscription Duration { event = AfterEnemyTurnEnded reaction = Duration instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:vulnerable-power")) instance_order = pureCall(PowerSideTurnEndOrder, listener) priority = 0 }

} }
use VulnerablePower { template = VulnerablePowerModule }
