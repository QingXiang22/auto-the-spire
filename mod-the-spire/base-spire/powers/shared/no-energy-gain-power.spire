using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template NoEnergyGainPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:no-energy-gain" } }

procedure NoEnergy {
  pure = true parameters = { value = Bool owner = Ref(Player) listener = Ref(Power) }
  result = Bool body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = false }
      }
    }
    return = { value = value }
  }
}

subscription NoEnergy {
  event = ShouldGainEnergy reaction = NoEnergy instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:no-energy-gain"))) instance_order = collectionIndex(Powers, listener) priority = 0
}
procedure Expire { parameters = { owner = Ref(Player) listener = Ref(Power) } body = { call = { procedure = RemovePower args = { power = listener } } } }
subscription Expire { event = AfterPlayerSideEnd reaction = Expire instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:no-energy-gain"))) instance_order = collectionIndex(Powers, listener) priority = 10 }

} }
use NoEnergyGainPower { template = NoEnergyGainPowerModule }
