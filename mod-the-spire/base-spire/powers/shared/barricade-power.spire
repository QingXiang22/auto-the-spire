using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template BarricadePowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:barricade" stackType = "single" } }

procedure Barricade {
  pure = true parameters = { value = Bool owner = Ref(Player) listener = Ref(Power) }
  result = Bool body = {
    if = {
      condition = greater(field(listener, Power.Stacks), 0) then = {
        return = { value = false }
      }
    }
    return = { value = value }
  }
}

subscription Barricade {
  event = ShouldClearBlock reaction = Barricade instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:barricade"))) instance_order = pureCall(PowerHookOrder, listener, true) priority = 0
}
} }
use BarricadePower { template = BarricadePowerModule }
