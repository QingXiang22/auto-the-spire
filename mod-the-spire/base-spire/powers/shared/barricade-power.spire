using namespace base-spire;
dsl_version = "core/0.3"

template BarricadePowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:barricade" stackType = "single" } }
  procedure AllowsClear {
    pure = true parameters = { player = Binding enemy = Binding listener = Ref(Power) } result = Bool
    body = { return = { value = not(and(equal(field(listener, Power.HolderPlayer), player), equal(field(listener, Power.HolderEnemy), enemy))) } }
  }
  procedure Query {
    pure = true parameters = { value = Bool player = Binding enemy = Binding listener = Ref(Power) } result = Bool
    body = { return = { value = and(value, pureCall(AllowsClear, player, enemy, listener)) } }
  }
  subscription Query {
    event = ShouldClearBlock reaction = Query
    instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:barricade"))
    instance_order = pureCall(PowerHookOrder, listener, true)
  }
  procedure Check {
    parameters = { check = Ref(BlockClearCheck) listener = Ref(Power) }
    body = { if = { condition = and(field(check, BlockClearCheck.ShouldClear), not(pureCall(AllowsClear, field(check, BlockClearCheck.Player), field(check, BlockClearCheck.Enemy), listener))) then = {
      call = { procedure = RecordBlockClearPreventer args = { check = check power = listener relic = none } }
    } } }
  }
  subscription Check {
    event = BlockClearChecking reaction = Check
    instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:barricade"))
    instance_order = pureCall(PowerHookOrder, listener, true)
  }
} }
use BarricadePower { template = BarricadePowerModule }
