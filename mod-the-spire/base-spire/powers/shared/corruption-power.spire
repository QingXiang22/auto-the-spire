using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template CorruptionPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:corruption-power" stackType = "single" } }

procedure CorruptionCost {
  pure = true parameters = { value = Int owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "skill"), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = 0 }
      }
    }
    return = { value = value }
  }
}

subscription CorruptionCost {
  event = ModifyCardCost reaction = CorruptionCost instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:corruption-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}

procedure CorruptionExhaust {
  pure = true parameters = { value = Bool owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  result = Bool body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "skill"), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = true }
      }
    }
    return = { value = value }
  }
}

subscription CorruptionExhaust {
  event = ShouldExhaustSkill reaction = CorruptionExhaust instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:corruption-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}
} }
use CorruptionPower { template = CorruptionPowerModule }
