using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template CorruptionPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:corruption-power" stackType = "single" } }

procedure CorruptionCost {
  pure = true parameters = { value = Int owner = Ref(Player) card = Ref(Card) listener = Ref(Power) }
  result = Int body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "skill"), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = 0 }
      }
    }
    return = { value = value }
  }
}

subscription CorruptionCost {
  event = ModifyCardCost reaction = CorruptionCost instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:corruption-power"))) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}

procedure CorruptionExhaust {
  pure = true parameters = { value = String(length = 16) owner = Ref(Player) card = Ref(Card) auto = Bool paidEnergy = Int energyValue = Int rawX = Int listener = Ref(Power) }
  result = String(length = 16) body = {
    if = {
      condition = and(equal(field(card, Card.Kind), "skill"), greater(field(listener, Power.Stacks), 0)) then = {
        return = { value = "exhaust" }
      }
    }
    return = { value = value }
  }
}

subscription CorruptionExhaust {
  event = ModifyCardPlayResultPile reaction = CorruptionExhaust instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:corruption-power"))) instance_order = pureCall(PowerHookOrder, listener, false) priority = 0
}
procedure CaptureCorruptionResult {
  parameters = { preparation = Ref(CardPlayPreparation) listener = Ref(Power) }
  body = {
    call = { procedure = SetCardPlayResultPile args = {
      preparation = preparation
      value = pureCall(CorruptionExhaust, field(preparation, CardPlayPreparation.ResultPile), field(preparation, CardPlayPreparation.Player), field(preparation, CardPlayPreparation.Card), field(preparation, CardPlayPreparation.Auto), field(preparation, CardPlayPreparation.PaidEnergy), field(preparation, CardPlayPreparation.EnergyValue), field(preparation, CardPlayPreparation.RawX), listener)
      power = listener relic = none
    } }
  }
}
subscription CaptureCorruptionResult {
  event = CardPlayResultModifying reaction = CaptureCorruptionResult
  instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), field(preparation, CardPlayPreparation.Player)), equal(field(p, Power.DefinitionId), "base-spire:corruption-power")))
  instance_order = pureCall(PowerHookOrder, listener, false)
}
} }
use CorruptionPower { template = CorruptionPowerModule }
