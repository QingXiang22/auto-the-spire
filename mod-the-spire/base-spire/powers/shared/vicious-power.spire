using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template ViciousPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:vicious-power" } }

procedure Vicious {
  parameters = { target = Ref(Enemy) power = Ref(Power) amount = Int listener = Ref(Power) }
  body = {
    if = {
      condition = and(equal(field(power, Power.DefinitionId), "base-spire:vulnerable-power"), greater(amount, 0)) then = {
        call = {
          procedure = DrawCards args = {
            owner = field(listener, Power.HolderPlayer) count = maximum(0, field(listener, Power.Stacks))
          }
        }
      }
    }
  }
}

subscription Vicious {
  event = EnemyPowerApplied reaction = Vicious instances = where(collection(Powers), p, equal(field(p, Power.DefinitionId), "base-spire:vicious-power")) instance_order = collectionIndex(Powers, listener) priority = 0
}
} }
use ViciousPower { template = ViciousPowerModule }
