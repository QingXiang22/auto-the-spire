using namespace base-spire;
dsl_version = "core/0.3"

# Development-scope model; source identity and unsupported boundaries stay in powers/catalog.json.
template PyrePowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:pyre-power" } }

procedure Pyre {
  pure = true parameters = { value = Int owner = Ref(Player) listener = Ref(Power) }
  result = Int body = {
    return = { value = add(value, field(listener, Power.Stacks)) }
    return = { value = value }
  }
}

subscription Pyre {
  event = ModifyMaxEnergy reaction = Pyre instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:pyre-power"))) instance_order = collectionIndex(Powers, listener) priority = 0
}
} }
use PyrePower { template = PyrePowerModule }
