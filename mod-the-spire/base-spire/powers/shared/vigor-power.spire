using namespace base-spire;
dsl_version = "core/0.3"

template VigorPowerModule { body = {
  use Definition { template = PowerDefinition args = { definition = "base-spire:vigor-power" } }
  entity State { fields = { Power = { type = Ref(Power) visibility = Hidden } Attack = { type = Ref(Attack) optional = true visibility = Hidden } StartedStacks = { type = Int default = 0 } } }
  procedure Created { parameters = { power = Ref(Power) listener = Ref(Power) } locals = { state = Binding } body = {
    create = { type = State scope = entityScope(power) into = state fields = { Power = power } }
  } }
  subscription Created { event = PowerCreated reaction = Created instances = where(collection(Powers), p, and(equal(p, power), equal(field(p, Power.DefinitionId), "base-spire:vigor-power"))) }
  procedure Before { parameters = { attack = Ref(Attack) listener = Ref(Power) } locals = { state = Binding } body = {
    let = { into = state value = first(where(type(State), s, equal(field(s, State.Power), listener))) }
    if = { condition = and(field(attack, Attack.Powered), isNone(field(state, State.Attack))) then = {
      set = { target = state field = State.Attack value = attack }
      set = { target = state field = State.StartedStacks value = field(listener, Power.Stacks) }
    } }
  } }
  subscription Before { event = BeforeAttack reaction = Before instances = where(collection(Powers), p, and(or(and(not(isNone(field(attack, Attack.Player))), equal(field(p, Power.HolderPlayer), field(attack, Attack.Player))), and(not(isNone(field(attack, Attack.Enemy))), equal(field(p, Power.HolderEnemy), field(attack, Attack.Enemy)))), equal(field(p, Power.DefinitionId), "base-spire:vigor-power"))) instance_order = collectionIndex(Powers, listener) }
  procedure Damage { pure = true parameters = { amount = Int owner = Ref(Player) card = Binding target = Binding attack = Binding play = Binding preview = Bool listener = Ref(Power) } result = Int
    locals = { state = Binding active = Binding } body = {
      let = { into = state value = first(where(type(State), s, equal(field(s, State.Power), listener))) }
      let = { into = active value = field(state, State.Attack) }
      if = { condition = or(isNone(active), and(equal(field(active, Attack.Player), owner), or(isNone(card), equal(card, field(active, Attack.Card))))) then = {
        return = { value = add(amount, field(listener, Power.Stacks)) }
      } }
      return = { value = amount }
    }
  }
  subscription Damage { event = ModifyCardDamageAdditive reaction = Damage instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), "base-spire:vigor-power"))) instance_order = collectionIndex(Powers, listener) }
  procedure EnemyDamage { pure = true parameters = { value = Int owner = Ref(Player) attacker = Ref(Enemy) listener = Ref(Power) } result = Int body = { return = { value = add(value, field(listener, Power.Stacks)) } } }
  subscription EnemyDamage { event = ModifyEnemyAttackAdditive reaction = EnemyDamage instances = where(collection(Powers), p, and(equal(field(p, Power.HolderEnemy), attacker), equal(field(p, Power.DefinitionId), "base-spire:vigor-power"))) instance_order = collectionIndex(Powers, listener) }
  procedure After { parameters = { attack = Ref(Attack) listener = Ref(Power) } locals = { state = Binding used = Int } body = {
    let = { into = state value = first(where(type(State), s, equal(field(s, State.Power), listener))) }
    if = { condition = equal(field(state, State.Attack), attack) then = {
      let = { into = used value = field(state, State.StartedStacks) }
      set = { target = state field = State.Attack value = none }
      set = { target = state field = State.StartedStacks value = 0 }
      call = { procedure = ModifyPowerAmount args = { power = listener delta = subtract(0, used) } }
    } }
  } }
  subscription After { event = AfterAttack reaction = After instances = where(collection(Powers), p, and(or(and(not(isNone(field(attack, Attack.Player))), equal(field(p, Power.HolderPlayer), field(attack, Attack.Player))), and(not(isNone(field(attack, Attack.Enemy))), equal(field(p, Power.HolderEnemy), field(attack, Attack.Enemy)))), equal(field(p, Power.DefinitionId), "base-spire:vigor-power"))) instance_order = collectionIndex(Powers, listener) }
  procedure Removed { parameters = { power = Ref(Power) } body = { forEach = { query = where(type(State), s, equal(field(s, State.Power), power)) item = state body = { destroy = { target = state } } } } }
  subscription Removed { event = PowerRemoved reaction = Removed }
} }
use VigorPower { template = VigorPowerModule }
