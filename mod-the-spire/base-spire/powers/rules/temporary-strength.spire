using namespace base-spire;
dsl_version = "core/0.3"

template TemporaryStrengthPowerContent {
 parameters = { definition = { type = String(length = 64) } sign = { type = Int } powerType = { type = String(length = 8) } }
 body = {
  use Definition { template = PowerDefinition args = { definition = arg(definition) powerType = arg(powerType) } }
  procedure BeforeCreated {
   parameters = { player = Binding enemy = Binding definition = String(length = 64) amount = Int applierPlayer = Binding applierEnemy = Binding card = Binding play = Binding listener = Ref(PowerBlueprint) }
   locals = { applied = Binding }
   body = { call = { procedure = ApplyPowerWithSource args = { player = player enemy = enemy definition = "base-spire:strength-power" stacks = multiply(arg(sign), amount) untilTurnEnd = false applierPlayer = applierPlayer applierEnemy = applierEnemy card = card play = play } into = applied } }
  }
  subscription BeforeCreated {
   event = BeforePowerCreated reaction = BeforeCreated
   instances = where(collection(PowerLibrary), b, and(equal(field(b, PowerBlueprint.DefinitionId), definition), equal(definition, arg(definition))))
   instance_order = collectionIndex(PowerLibrary, listener)
  }
  procedure Changed {
   parameters = { power = Ref(Power) delta = Int applierPlayer = Binding applierEnemy = Binding card = Binding play = Binding listener = Ref(Power) }
   locals = { applied = Binding }
   body = {
    # BeforeApplied already performed the initial amount, exactly as TemporaryStrengthPower.
    if = { condition = not(equal(delta, field(listener, Power.Stacks))) then = {
     call = { procedure = ApplyPowerWithSource args = { player = field(listener, Power.HolderPlayer) enemy = field(listener, Power.HolderEnemy) definition = "base-spire:strength-power" stacks = multiply(arg(sign), delta) untilTurnEnd = false applierPlayer = applierPlayer applierEnemy = applierEnemy card = card play = play } into = applied }
    } }
   }
  }
  subscription Changed {
   event = PowerAmountChanged reaction = Changed
   instances = where(collection(Powers), p, and(equal(p, power), equal(field(p, Power.DefinitionId), arg(definition))))
   instance_order = collectionIndex(Powers, listener)
  }
  procedure Expire {
   parameters = { owner = Ref(Player) listener = Ref(Power) }
   locals = { player = Binding enemy = Binding amount = Int applied = Binding }
   body = {
    let = { into = player value = field(listener, Power.HolderPlayer) }
    let = { into = enemy value = field(listener, Power.HolderEnemy) }
    let = { into = amount value = multiply(arg(sign), field(listener, Power.Stacks)) }
    call = { procedure = RemovePower args = { power = listener } }
    call = { procedure = ApplyPowerWithSource args = { player = player enemy = enemy definition = "base-spire:strength-power" stacks = subtract(0, amount) untilTurnEnd = false applierPlayer = player applierEnemy = enemy card = none play = none } into = applied }
   }
  }
  subscription PlayerEnd {
   event = AfterPlayerSideEnd reaction = Expire
   instances = where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.DefinitionId), arg(definition))))
   instance_order = pureCall(PowerSideTurnEndOrder, listener)
  }
  subscription EnemyEnd {
   event = AfterEnemyTurnEnded reaction = Expire
   instances = where(collection(Powers), p, and(not(isNone(field(p, Power.HolderEnemy))), equal(field(p, Power.DefinitionId), arg(definition))))
   instance_order = pureCall(PowerSideTurnEndOrder, listener)
  }
 }
}
