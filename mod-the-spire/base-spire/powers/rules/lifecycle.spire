using namespace base-spire;
dsl_version = "core/0.3"

procedure RemovePower {
 parameters = { power = Ref(Power) }
 body = {
  if = { condition = greaterOrEqual(collectionIndex(Powers, power), 0) then = {
   removeFromCollection = { collection = Powers item = power }
   call = { procedure = RefreshDrawPermissions }
   emit = { event = PowerRemoved payload = { power = power } }
   destroy = { target = power }
  } }
 }
}
procedure PowerSideTurnEndOrder {
 pure = true parameters = { power = Ref(Power) } result = Int
 locals = { group = Int }
 body = {
  let = { into = group value = 0 }
  if = { condition = not(isNone(field(power, Power.HolderEnemy))) then = {
   let = { into = group value = add(field(field(power, Power.HolderEnemy), Enemy.SpawnOrder), 1) }
  } }
  return = { value = add(multiply(group, add(count(collection(Powers)), 1)), collectionIndex(Powers, power)) }
 }
}
procedure RemoveEnemyPowersOnDeath {
 parameters = { target = Ref(Enemy) }
 body = {
  if = { condition = field(target, Enemy.DeathResolved) then = { return = {} } }
  if = { condition = greater(field(target, Enemy.Hp), 0) then = { fail = { message = "Power death cleanup requires a confirmed zero-HP enemy" } } }
  # All currently loaded Powers use both source default removal policies. Retention/veto
  # consumers must implement their source queries before being added to this package.
  set = { target = target field = Enemy.DeathResolved value = true }
  forEach = { query = where(collection(Powers), p, equal(field(p, Power.HolderEnemy), target)) item = power body = {
   call = { procedure = RemovePower args = { power = power } }
  } }
 }
}
procedure ModifyPowerAmount {
 parameters = { power = Ref(Power) delta = Int }
 body = { call = { procedure = ModifyPowerAmountWithSource args = { power = power delta = delta applierPlayer = none applierEnemy = none card = none play = none } } }
}
procedure ModifyPowerAmountWithSource {
 parameters = { power = Ref(Power) delta = Int applierPlayer = Binding applierEnemy = Binding card = Binding play = Binding }
 body = {
  set = { target = power field = Power.Stacks value = add(field(power, Power.Stacks), delta) }
  call = { procedure = RefreshDrawPermissions }
  if = { condition = not(equal(delta, 0)) then = { emit = { event = PowerAmountChanged payload = { power = power delta = delta applierPlayer = applierPlayer applierEnemy = applierEnemy card = card play = play } } } }
  if = { condition = or(equal(field(power, Power.Stacks), 0), and(not(field(field(power, Power.Definition), PowerBlueprint.AllowNegative)), less(field(power, Power.Stacks), 0))) then = {
   call = { procedure = RemovePower args = { power = power } }
  } }
 }
}
procedure ApplyPowerWithSource {
 parameters = { player = Binding enemy = Binding definition = String(length = 64) stacks = Int(min = -999, max = 999) untilTurnEnd = Bool applierPlayer = Binding applierEnemy = Binding card = Binding play = Binding }
 locals = { entry = Binding power = Binding created = Bool delta = Int actual = Int } result = Binding
 body = {
  let = { into = entry value = first(where(collection(PowerLibrary), d, equal(field(d, PowerBlueprint.DefinitionId), definition))) }
  if = { condition = isNone(entry) then = { fail = { message = "Unknown Power definition" } } }
  if = { condition = equal(isNone(player), isNone(enemy)) then = { fail = { message = "Power requires exactly one holder" } } }
  if = { condition = and(not(isNone(applierPlayer)), not(isNone(applierEnemy))) then = { fail = { message = "Power requires at most one applier" } } }
  if = { condition = not(isNone(enemy)) then = {
   if = { condition = or(field(enemy, Enemy.DeathResolved), field(enemy, Enemy.Escaped)) then = { return = { value = none } } }
  } }
  if = { condition = not(foldEvent(ShouldApplyPower, true, player, enemy, definition, applierPlayer, applierEnemy, card, play)) then = { return = { value = none } } }
  let = { into = actual value = stacks }
  if = { condition = or(not(isNone(applierPlayer)), not(isNone(applierEnemy))) then = {
    let = { into = actual value = foldEvent(ModifyPowerGiven, actual, player, enemy, definition, applierPlayer, applierEnemy, card, play) }
  } }
  let = { into = actual value = foldEvent(ModifyPowerReceived, actual, player, enemy, definition, applierPlayer, applierEnemy, card, play) }
  let = { into = power value = first(where(collection(Powers), p, and(equal(field(p, Power.DefinitionId), definition), or(and(not(isNone(player)), equal(field(p, Power.HolderPlayer), player)), and(not(isNone(enemy)), equal(field(p, Power.HolderEnemy), enemy)))))) }
  if = { condition = equal(field(entry, PowerBlueprint.InstanceMode), "independent") then = { let = { into = power value = none } } }
  if = { condition = equal(field(entry, PowerBlueprint.InstanceMode), "per-applier") then = {
    let = { into = power value = first(where(collection(Powers), p, and(equal(field(p, Power.DefinitionId), definition), and(and(equal(field(p, Power.HolderPlayer), player), equal(field(p, Power.HolderEnemy), enemy)), and(equal(field(p, Power.ApplierPlayer), applierPlayer), equal(field(p, Power.ApplierEnemy), applierEnemy)))))) }
  } }
  let = { into = created value = isNone(power) }
  if = { condition = created then = {
   if = { condition = or(equal(actual, 0), and(not(field(entry, PowerBlueprint.AllowNegative)), less(actual, 0))) then = { return = { value = none } } }
   emit = { event = BeforePowerCreated payload = { player = player enemy = enemy definition = definition amount = actual applierPlayer = applierPlayer applierEnemy = applierEnemy card = card play = play } }
   create = { type = Power scope = frameScope() into = power collection = Powers fields = {
    DefinitionId = definition Definition = entry HolderPlayer = player HolderEnemy = enemy Stacks = actual
    ExpiresAtTurnEnd = untilTurnEnd ApplierPlayer = applierPlayer ApplierEnemy = applierEnemy SourceCard = card SourcePlay = play
   } }
   if = { condition = not(isNone(player)) then = {
    set = { target = power field = Power.Owner value = field(player, Player.Owner) }
    set = { target = power field = Power.SkipTick value = field(entry, PowerBlueprint.Debuff) }
   } }
   call = { procedure = RefreshDrawPermissions }
   emit = { event = PowerCreated payload = { power = power } }
  } else = {
   let = { into = delta value = actual }
   if = { condition = field(entry, PowerBlueprint.SingleStack) then = { let = { into = delta value = 0 } } }
   let = { into = delta value = subtract(foldEvent(ModifyPowerStacks, add(field(power, Power.Stacks), delta), power, delta), field(power, Power.Stacks)) }
   call = { procedure = ModifyPowerAmountWithSource args = { power = power delta = delta applierPlayer = applierPlayer applierEnemy = applierEnemy card = card play = play } }
   if = { condition = untilTurnEnd then = { if = { condition = greaterOrEqual(collectionIndex(Powers, power), 0) then = { set = { target = power field = Power.ExpiresAtTurnEnd value = true } } } } }
  } }
  if = { condition = greaterOrEqual(collectionIndex(Powers, power), 0) then = {
   emit = { event = PowerApplied payload = { power = power amount = actual created = created } }
   if = { condition = not(isNone(player)) then = { emit = { event = PlayerPowerApplied payload = { owner = player power = power amount = actual } } } else = { emit = { event = EnemyPowerApplied payload = { target = enemy power = power amount = actual } } } }
   return = { value = power }
  } }
  return = { value = none }
 }
}
procedure ApplyPower {
 parameters = { player = Binding enemy = Binding definition = String(length = 64) stacks = Int(min = -999, max = 999) untilTurnEnd = Bool }
 locals = { power = Binding } result = Binding
 body = {
  call = { procedure = ApplyPowerWithSource args = { player = player enemy = enemy definition = definition stacks = stacks untilTurnEnd = untilTurnEnd applierPlayer = none applierEnemy = none card = none play = none } into = power }
  return = { value = power }
 }
}
procedure ApplyPlayerPower {
 parameters = { owner = Ref(Player) definition = String(length = 64) stacks = Int(min = -999, max = 999) }
 locals = { power = Binding } body = {
  call = { procedure = ApplyPower args = { player = owner enemy = none definition = definition stacks = stacks untilTurnEnd = false } into = power }
 }
}
procedure ApplyEnemyPower {
 parameters = { target = Ref(Enemy) definition = String(length = 64) stacks = Int(min = -999, max = 999) }
 locals = { power = Binding } body = {
  call = { procedure = ApplyPower args = { player = none enemy = target definition = definition stacks = stacks untilTurnEnd = false } into = power }
 }
}
procedure ApplyPlayerPowerUntilTurnEnd {
 parameters = { owner = Ref(Player) definition = String(length = 64) stacks = Int(min = -999, max = 999) }
 locals = { power = Binding } body = {
  call = { procedure = ApplyPower args = { player = owner enemy = none definition = definition stacks = stacks untilTurnEnd = true } into = power }
 }
}
procedure ConsumePower { parameters = { power = Ref(Power) } body = { call = { procedure = ModifyPowerAmount args = { power = power delta = -1 } } } }
procedure TickPowerDuration {
 parameters = { power = Ref(Power) }
 body = { if = { condition = field(power, Power.SkipTick) then = { set = { target = power field = Power.SkipTick value = false } } else = { call = { procedure = ConsumePower args = { power = power } } } } }
}
procedure ExpireTurnPower { parameters = { owner = Ref(Player) listener = Ref(Power) } body = { call = { procedure = RemovePower args = { power = listener } } } }
subscription ExpireTurnPower { event = AfterPlayerTurnFinished reaction = ExpireTurnPower instances = where(collection(Powers), p, field(p, Power.ExpiresAtTurnEnd)) instance_order = collectionIndex(Powers, listener) }
procedure ClearCombatPowers { body = { forEach = { query = collection(Powers) item = power body = { call = { procedure = RemovePower args = { power = power } } } } } }

procedure ApplyPlayerPowerFromCard {
 parameters = { owner = Ref(Player) card = Ref(Card) play = Binding definition = String(length = 64) stacks = Int(min = -999, max = 999) }
 locals = { power = Binding } body = {
  call = { procedure = ApplyPowerWithSource args = { player = owner enemy = none definition = definition stacks = stacks untilTurnEnd = false applierPlayer = owner applierEnemy = none card = card play = play } into = power }
 }
}

procedure ApplyEnemyPowerFromCard {
 parameters = { owner = Ref(Player) card = Ref(Card) play = Binding target = Ref(Enemy) definition = String(length = 64) stacks = Int(min = -999, max = 999) }
 locals = { power = Binding } body = {
  call = { procedure = ApplyPowerWithSource args = { player = none enemy = target definition = definition stacks = stacks untilTurnEnd = false applierPlayer = owner applierEnemy = none card = card play = play } into = power }
 }
}

procedure ApplyPlayerPowerFromCardUntilTurnEnd {
 parameters = { owner = Ref(Player) card = Ref(Card) play = Binding definition = String(length = 64) stacks = Int(min = -999, max = 999) }
 locals = { power = Binding } body = {
  call = { procedure = ApplyPowerWithSource args = { player = owner enemy = none definition = definition stacks = stacks untilTurnEnd = true applierPlayer = owner applierEnemy = none card = card play = play } into = power }
 }
}
