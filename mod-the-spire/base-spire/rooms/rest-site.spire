using namespace base-spire;
dsl_version = "core/0.3"

event AfterRestSiteSmith { payload = { owner = Ref(Player) } }

procedure CanUseUnusedRestSite {
  pure = true
  parameters = { owner = Ref(Player) }
  result = Bool
  body = {
    return = {
      value = and(equal(field(owner, Player.Room), "rest-site"), and(not(field(owner, Player.CombatActive)), and(greater(field(owner, Player.Hp), 0), and(not(field(owner, Player.RoomUsed)), not(field(owner, Player.PendingForge))))))
    }
  }
}

procedure EnterDevelopmentRestSite {
  parameters = { owner = Ref(Player) }
  body = {
    if = {
      condition = not(and(equal(field(owner, Player.Room), "none"), and(not(field(owner, Player.CombatActive)), greater(field(owner, Player.Hp), 0))))
      then = { fail = { message = "A rest site requires a living player outside any room and combat" } }
    }
    set = { target = owner field = Player.Room value = "rest-site" }
    set = { target = owner field = Player.RoomUsed value = false }
    set = { target = owner field = Player.PendingForge value = false }
  }
}
procedure RequireUnusedRestSite {
  parameters = { owner = Ref(Player) }
  body = {
    if = {
      condition = not(pureCall(CanUseUnusedRestSite, owner))
      then = { fail = { message = "A living player must be at an unused rest site with no choice pending" } }
    }
  }
}
procedure RestAtDevelopmentCampfire {
  parameters = { owner = Ref(Player) }
  body = {
    call = { procedure = RequireUnusedRestSite args = { owner = owner } }
    call = { procedure = HealWithSource args = { owner = owner source = "base-spire:rest-site" amount = foldEvent(ModifyRestHeal, divide(multiply(field(owner, Player.MaxHp), 30), 100), owner)
      } }
    set = { target = owner field = Player.RoomUsed value = true }
  }
}
# SmithRestSiteOption chooses from Owner.Deck, allows cancellation and only spends the room option on
# success. The engine freezes the candidate list and suspends all other actions until the answer arrives.
procedure ForgeAtDevelopmentCampfire {
  parameters = { owner = Ref(Player) }
  locals = { chosen = Binding }
  body = {
    call = { procedure = RequireUnusedRestSite args = { owner = owner } }
    if = {
      condition = not(pureCall(HasUpgradablePermanentCards, owner))
      then = { fail = { message = "There are no upgradable permanent cards" } }
    }
    set = { target = owner field = Player.PendingForge value = true }
    call = { procedure = SelectPermanentCard args = { owner = owner purpose = "upgrade" enchantment = "" cancelable = true } into = chosen }
    if = {
      condition = not(isNone(chosen)) then = {
        call = { procedure = UpgradeCard args = { card = chosen } }
        set = { target = owner field = Player.RoomUsed value = true }
        emit = { event = AfterRestSiteSmith payload = { owner = owner } }
      }
    }
    set = { target = owner field = Player.PendingForge value = false }
  }
}
procedure LeaveDevelopmentRoom {
  parameters = { owner = Ref(Player) }
  body = {
    if = {
      condition = not(and(equal(field(owner, Player.Room), "rest-site"), and(field(owner, Player.RoomUsed), and(not(field(owner, Player.PendingForge)), not(field(owner, Player.CombatActive))))))
      then = { fail = { message = "Finish the rest site option before leaving; rewards use CloseDevelopmentRewards" } }
    }
    set = { target = owner field = Player.Room value = "none" }
    set = { target = owner field = Player.RoomUsed value = false }
    set = { target = owner field = Player.PendingForge value = false }
  }
}

action EnterDevelopmentRestSite {
  role = player
  requires = and(equal(field(first(type(Player)), Player.Room), "none"), and(not(field(first(type(Player)), Player.CombatActive)), greater(field(first(type(Player)), Player.Hp), 0)))
  body = { call = { procedure = EnterDevelopmentRestSite args = { owner = first(type(Player)) } } }
}
action RestAtDevelopmentCampfire {
  role = player
  requires = pureCall(CanUseUnusedRestSite, first(type(Player)))
  body = { call = { procedure = RestAtDevelopmentCampfire args = { owner = first(type(Player)) } } }
}
action ForgeAtDevelopmentCampfire {
  role = player
  requires = and(pureCall(CanUseUnusedRestSite, first(type(Player))), pureCall(HasUpgradablePermanentCards, first(type(Player))))
  body = { call = { procedure = ForgeAtDevelopmentCampfire args = { owner = first(type(Player)) } } }
}
action LeaveDevelopmentRoom {
  role = player
  requires = and(equal(field(first(type(Player)), Player.Room), "rest-site"), and(field(first(type(Player)), Player.RoomUsed), and(not(field(first(type(Player)), Player.PendingForge)), not(field(first(type(Player)), Player.CombatActive)))))
  body = { call = { procedure = LeaveDevelopmentRoom args = { owner = first(type(Player)) } } }
}
