using namespace base-spire;
dsl_version = "core/0.3"

# Fully unlocked single-player: MassiveScroll requires multiplayer.
procedure BuildSourceNeowPool {
  parameters = { visit = Ref(NeowVisit) }
  body = {
    call = { procedure = AddNeowPoolEntry args = { visit = visit definition = "base-spire:cursed-pearl" group = "curse" position = 0 } }
    call = { procedure = AddNeowPoolEntry args = { visit = visit definition = "base-spire:hefty-tablet" group = "curse" position = 1 } }
    call = { procedure = AddNeowPoolEntry args = { visit = visit definition = "base-spire:large-capsule" group = "curse" position = 2 } }
