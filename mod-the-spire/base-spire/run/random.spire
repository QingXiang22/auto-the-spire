using namespace base-spire;
dsl_version = "core/0.3"

procedure SourceRunSeed { pure = true result = Int body = {
  if = { condition = startsWith(gameSeed(), "old") then = { return = { value = hash32(substring(gameSeed(), 3)) } } }
  return = { value = hash64(gameSeed()) }
} }
procedure SourceStreamSeed {
  pure = true parameters = { root = Int name = String(length = 64) } result = Int
  body = { return = { value = uint64Add(root, hash64(name)) } }
}
procedure SourceContentSeed {
  pure = true parameters = { slot = Int entry = String(length = 128) mixin = Int } result = Int
  body = { return = { value = uint64Add(uint64Add(uint64Add(pureCall(SourceRunSeed), slot), hash64(entry)), mixin) } }
}
procedure SetupSourceRandom { body = {
  seedStream64 = { stream = "base-spire:run:up_front" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "up_front") }
  seedStream64 = { stream = "base-spire:run:shuffle" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "shuffle") }
  seedStream64 = { stream = "base-spire:run:unknown_map_point" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "unknown_map_point") }
  seedStream64 = { stream = "base-spire:run:combat_card_generation" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "combat_card_generation") }
  seedStream64 = { stream = "base-spire:run:combat_potion_generation" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "combat_potion_generation") }
  seedStream64 = { stream = "base-spire:run:combat_card_selection" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "combat_card_selection") }
  seedStream64 = { stream = "base-spire:run:combat_energy_costs" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "combat_energy_costs") }
  seedStream64 = { stream = "base-spire:run:combat_targets" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "combat_targets") }
  seedStream64 = { stream = "base-spire:run:monster_ai" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "monster_ai") }
  seedStream64 = { stream = "base-spire:run:niche" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "niche") }
  seedStream64 = { stream = "base-spire:run:combat_orbs" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "combat_orbs") }
  seedStream64 = { stream = "base-spire:run:treasure_room_relics" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "treasure_room_relics") }
  seedStream64 = { stream = "base-spire:player:rewards" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "rewards") }
  seedStream64 = { stream = "base-spire:player:shops" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "shops") }
  seedStream64 = { stream = "base-spire:player:transformations" seed = pureCall(SourceStreamSeed, pureCall(SourceRunSeed), "transformations") }
} }

# Source Rng.NextGaussianInt: Box-Muller sine branch and ties-to-even rounding.
# Two raw words per attempt; rejected attempts keep their actual stream consumption.
procedure SourceGaussianInt {
  parameters = { stream = String(length = 128) mean = Int deviation = Int min = Int max = Int }
  result = Int
  locals = { left = Int right = Int d = Int angle = Int normal = Int result = Int }
  body = {
    if = { condition = greater(min, max) then = { fail = { message = "Gaussian minimum exceeds maximum" } } }
    repeat = { count = 100000 body = {
      sampleInt = { stream = stream min = 0 max = 9007199254740992 into = left }
      sampleInt = { stream = stream min = 0 max = 9007199254740992 into = right }
      let = { into = d value = float64Subtract(float64(1), float64Divide(float64(left), float64(9007199254740992))) }
      let = { into = angle value = float64Subtract(float64(1), float64Divide(float64(right), float64(9007199254740992))) }
      let = { into = normal value = float64Multiply(float64Sqrt(float64Multiply(float64(-2), float64Log(d))), float64Sin(float64Multiply(float64Multiply(4614256656552045848, float64(2)), angle))) }
      let = { into = result value = float64RoundToInt(float64Add(float64(mean), float64Multiply(float64(deviation), normal))) }
      if = { condition = and(greaterOrEqual(result, min), lessOrEqual(result, max)) then = { return = { value = result } } }
    } }
    fail = { message = "Gaussian rejection sampling exceeded its execution limit" }
  }
}
