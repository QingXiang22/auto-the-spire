using namespace base-spire;
dsl_version = "core/0.3"

# A declared mechanism-development setup, not Ironclad's deck or a normal Run.
procedure SetupDevelopmentDraw {
  locals = { owner = Binding card = Binding }
  body = {
    create = { type = Player scope = frameScope() into = owner }
    repeat = {
      count = 3
      body = { create = { type = Card scope = frameScope() into = card collection = DiscardPile } }
    }
  }
}
