using namespace base-spire;
dsl_version = "core/0.3"

# Development potion instance. Vanilla potions live in three shared slots, are consumed on use, and carry their
# rarity and usage window; only identity and the three-slot inventory are migrated here.
entity Potion {
  owner = Owner
  fields = {
    Owner = { type = Participant default = participant(1) }
    DefinitionId = { type = String(length = 64) }
  }
}
collection Potions { element = Potion capacity = 3 ordered = true }
# Emitted while the potion is still in the inventory, before it is consumed.
event PotionUsed { payload = { owner = Ref(Player) potion = Ref(Potion) } }
event PotionUsedOnTarget { payload = { owner = Ref(Player) potion = Ref(Potion) target = Ref(Enemy) } }
