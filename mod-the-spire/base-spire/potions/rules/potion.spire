using namespace base-spire;
dsl_version = "core/0.3"

# Effect listeners run while the owned potion remains in inventory, before consumption.
# Unsupported effects are rejected; supported effects respect source usage window and target kind.
procedure UsePotionCommon {
  parameters = { owner = Ref(Player) potion = Ref(Potion) }
  body = {
    if = {
      condition = less(collectionIndex(Potions, potion), 0)
      then = { fail = { message = "Potion is not in the inventory" } }
    }
    if = { condition = not(equal(field(potion, Potion.Owner), field(owner, Player.Owner))) then = { fail = { message = "Potion belongs to another player" } } }
    if = { condition = not(field(potion, Potion.EffectSupported)) then = { fail = { message = "unsupported_capability: potion effect is not implemented" } } }
    if = { condition = and(equal(field(potion, Potion.Usage), "combat"), not(field(owner, Player.CombatActive))) then = { fail = { message = "Potion requires combat" } } }
  }
}
procedure ConsumePotion {
  parameters = { potion = Ref(Potion) }
  body = {
    removeFromCollection = { collection = Potions item = potion }
    destroy = { target = potion }
  }
}
procedure UsePotion {
  parameters = { owner = Ref(Player) potion = Ref(Potion) }
  body = {
    call = { procedure = UsePotionCommon args = { owner = owner potion = potion } }
    if = { condition = equal(field(potion, Potion.Target), "enemy") then = { fail = { message = "Potion requires a target" } } }
    set = { target = owner field = Player.EffectDepth value = add(field(owner, Player.EffectDepth), 1) }
    emit = { event = PotionUsed payload = { owner = owner potion = potion } }
    call = { procedure = ConsumePotion args = { potion = potion } }
    set = { target = owner field = Player.EffectDepth value = subtract(field(owner, Player.EffectDepth), 1) }
    call = { procedure = CheckCombatVictory args = { owner = owner } }
  }
}
procedure UsePotionOnTarget {
  parameters = { owner = Ref(Player) potion = Ref(Potion) }
  body = {
    call = { procedure = UsePotionCommon args = { owner = owner potion = potion } }
    if = { condition = not(equal(field(potion, Potion.Target), "enemy")) then = { fail = { message = "Potion does not target an enemy" } } }
    set = { target = owner field = Player.EffectDepth value = add(field(owner, Player.EffectDepth), 1) }
    emit = {
      event = PotionUsedOnTarget
      payload = { owner = owner potion = potion target = first(where(type(Enemy), enemy, pureCall(EnemyIsActive, enemy))) }
    }
    call = { procedure = ConsumePotion args = { potion = potion } }
    set = { target = owner field = Player.EffectDepth value = subtract(field(owner, Player.EffectDepth), 1) }
    call = { procedure = CheckCombatVictory args = { owner = owner } }
  }
}

action UsePotion {
  role = player
  parameters = { potion = Ref(Potion) }
  candidates = { parameter = potion query = where(collection(Potions), p, and(field(p, Potion.EffectSupported), and(not(equal(field(p, Potion.Target), "enemy")), or(equal(field(p, Potion.Usage), "anytime"), field(first(type(Player)), Player.CombatActive))))) }
  body = { call = { procedure = UsePotion args = { owner = first(type(Player)) potion = potion } } }
}
action UsePotionOnTarget {
  role = player
  parameters = { potion = Ref(Potion) }
  candidates = { parameter = potion query = where(collection(Potions), p, and(field(p, Potion.EffectSupported), equal(field(p, Potion.Target), "enemy"))) }
  requires = and(field(first(type(Player)), Player.CombatActive), exists(where(type(Enemy), enemy, pureCall(EnemyIsActive, enemy))))
  body = { call = { procedure = UsePotionOnTarget args = { owner = first(type(Player)) potion = potion } } }
}
