using namespace base-spire;
dsl_version = "core/0.3"

# Shared development encounter pieces. A source encounter spawns its monster list; this scope has no battle or
# room yet, so an encounter content file only exposes a Spawn action. Initial HP uses the source minimum
# because the roll inside the source range is part of the (unmigrated) run RNG.
procedure SpawnDevelopmentEnemy {
  parameters = { definition = String(length = 64) hp = Int(min = 1, max = 9999) }
  locals = { target = Binding }
  body = {
    create = {
      type = Enemy scope = frameScope() into = target
      fields = { DefinitionId = definition Hp = hp MaxHp = hp MoveIndex = 0 Intent = "attack" }
    }
  }
}
# definition is the encounter identity (it names the generated symbols); enemyDefinition and hp describe the
# single monster the source encounter spawns.
template SingleEnemyEncounter {
  parameters = {
    definition = { type = String(length = 64) }
    enemyDefinition = { type = String(length = 64) }
    hp = { type = Int(min = 1, max = 9999) }
  }
  body = {
    action Spawn {
      role = player
      body = { call = { procedure = SpawnDevelopmentEnemy args = { definition = arg(enemyDefinition) hp = arg(hp) } } }
    }
  }
}
