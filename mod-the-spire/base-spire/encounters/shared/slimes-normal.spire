using namespace base-spire;
dsl_version = "core/0.3"

# Source Overgrowth MonsterEncounters: SlimesNormal. TwigSlimeM and LeafSlimeM first, then two small slimes
# whose leaf/twig order comes from one source NextBool draw.
procedure SpawnSourceSlimesNormal {
  parameters = { totalFloor = Int }
  locals = { stream = String(length = 128) leafFirst = Int target = Binding }
  body = {
    call = { procedure = BeginSourceEncounterRandom args = { totalFloor = totalFloor entry = "SLIMES_NORMAL" } into = stream }
    sampleInt = { stream = stream min = 0 max = 2 into = leafFirst }
    call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:twig-slime-m" min = 26 max = 28 } into = target }
    call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:leaf-slime-m" min = 32 max = 35 } into = target }
    if = { condition = equal(leafFirst, 0) then = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:leaf-slime-s" min = 11 max = 15 } into = target }
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:twig-slime-s" min = 7 max = 11 } into = target }
    } else = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:twig-slime-s" min = 7 max = 11 } into = target }
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:leaf-slime-s" min = 11 max = 15 } into = target }
    } }
  }
}
use SlimesNormal { template = SlimesNormalFormation }

template SlimesNormalFormation { body = {
  action Spawn {
    role = player
    requires = pureCall(CanSpawnDevelopmentEnemies, first(type(Player)))
    body = { call = { procedure = SpawnSourceSlimesNormal args = { totalFloor = 0 } } }
  }
} }
