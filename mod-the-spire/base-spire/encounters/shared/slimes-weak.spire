using namespace base-spire;
dsl_version = "core/0.3"

# Locked Overgrowth.CreateSlimesWeak: A, remaining B (including singleton draw), medium.
procedure SpawnSourceSlimesWeak {
  parameters = { totalFloor = Int }
  locals = { small = Int singleton = Int medium = Int target = Binding }
  body = {
    seedStream64 = { stream = "base-spire:encounter:monsters" seed = pureCall(SourceContentSeed, totalFloor, "SLIMES_WEAK", 0) }
    sampleInt = { stream = "base-spire:encounter:monsters" min = 0 max = 2 into = small }
    sampleInt = { stream = "base-spire:encounter:monsters" min = 0 max = 1 into = singleton }
    sampleInt = { stream = "base-spire:encounter:monsters" min = 0 max = 2 into = medium }
    if = { condition = equal(small, 0) then = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:leaf-slime-s" min = 11 max = 15 } into = target }
    } else = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:twig-slime-s" min = 7 max = 11 } into = target }
    } }
    if = { condition = equal(medium, 0) then = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:leaf-slime-m" min = 32 max = 35 } into = target }
    } else = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:twig-slime-m" min = 26 max = 28 } into = target }
    } }
    if = { condition = equal(small, 0) then = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:twig-slime-s" min = 7 max = 11 } into = target }
    } else = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:leaf-slime-s" min = 11 max = 15 } into = target }
    } }
  }
}
