using namespace base-spire;
dsl_version = "core/0.3"

# Source Overgrowth MonsterEncounters: FlyconidNormal, one medium slime chosen from LeafSlimeM/TwigSlimeM
# and then Flyconid.
procedure SpawnFlyconidNormal {
  parameters = { totalFloor = Int }
  locals = { stream = String(length = 128) medium = Int target = Binding }
  body = {
    call = { procedure = BeginSourceEncounterRandom args = { totalFloor = totalFloor entry = "FLYCONID_NORMAL" } into = stream }
    sampleInt = { stream = stream min = 0 max = 2 into = medium }
    if = { condition = equal(medium, 0) then = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:leaf-slime-m" min = 32 max = 35 } into = target }
    } else = {
      call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:twig-slime-m" min = 26 max = 28 } into = target }
    } }
    call = { procedure = CreateSourceEncounterEnemy args = { definition = "base-spire:flyconid" min = 47 max = 49 } into = target }
  }
}
use FlyconidNormal { template = FlyconidNormalFormation }

template FlyconidNormalFormation { body = {
  action Spawn {
    role = player
    requires = pureCall(CanSpawnDevelopmentEnemies, first(type(Player)))
    body = { call = { procedure = SpawnFlyconidNormal args = { totalFloor = 0 } } }
  }
} }
