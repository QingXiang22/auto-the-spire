using namespace base-spire;
dsl_version = "core/0.3"

# Wound.cs: status, unplayable, no upgrade and no playable effect.
use Wound { template = CardDefinition args = { definition = "base-spire:wound" sourceEntry = "WOUND" kind = "status" rarity = "status" cost = -1 upgradedCost = -1 targeted = false exhausts = false leavesPlay = false } }
template WoundContent { body = {
  procedure Created { parameters = { card = Ref(Card) } body = {
    if = { condition = equal(field(card, Card.DefinitionId), "base-spire:wound") then = { set = { target = card field = Card.CanUpgrade value = false } } }
  } }
  subscription Created { event = CardCreated reaction = Created }
  procedure Keyword { pure = true parameters = { value = Bool card = Ref(Card) keyword = String(length = 16) } result = Bool body = {
    return = { value = or(value, and(equal(field(card, Card.DefinitionId), "base-spire:wound"), equal(keyword, "unplayable"))) }
  } }
  subscription Keyword { event = ModifyCardKeyword reaction = Keyword }
  procedure Execute { parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) } body = { fail = { message = "Wound cannot be played" } } }
  dispatchCase Execute { dispatch = ExecuteCardBody key = "base-spire:wound" procedure = Execute }
  procedure Damage { pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int body = { return = { value = 0 } } }
  dispatchCase Damage { dispatch = ReadCardDamage key = "base-spire:wound" procedure = Damage }
} }
use WoundBehavior { template = WoundContent }
