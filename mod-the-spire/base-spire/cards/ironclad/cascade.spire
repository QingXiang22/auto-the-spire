using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Cascade.cs; SHA-256 retained in cards/catalog.json.
use Cascade { template = CardDefinition args = { sourceEntry = "CASCADE" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:cascade" cost = 0 upgradedCost = 0 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false isX = true } }
use CascadeEffect1 { template = AutoplayTopEffect args = { definition = "base-spire:cascade" xCost = true } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure CascadeBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = CascadeEffect1.Apply args = { play = play  owner = owner card = card } }
  }
}
dispatchCase CascadeBody { dispatch = ExecuteCardBody key = "base-spire:cascade" procedure = CascadeBody }

use CascadeDamageValue { template = StaticCardDamage args = { definition = "base-spire:cascade" } }
