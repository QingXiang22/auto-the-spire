using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Vicious.cs; SHA-256 retained in cards/catalog.json.
use Vicious { template = CardDefinition args = { sourceEntry = "VICIOUS" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:vicious" cost = 1 upgradedCost = 1 kind = "power" strikeTag = false targeted = false exhausts = false leavesPlay = true } }
use ViciousEffect1 { template = ApplySelfPowerEffect args = { definition = "base-spire:vicious" power = "base-spire:vicious-power" stacks = 1 upgradedStacks = 2 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ViciousBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = ViciousEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase ViciousBody { dispatch = ExecuteCardBody key = "base-spire:vicious" procedure = ViciousBody }

procedure ViciousDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase ViciousDamageValue { dispatch = ReadCardDamage key = "base-spire:vicious" procedure = ViciousDamageValue }
