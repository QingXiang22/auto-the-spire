using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Brand.cs; SHA-256 retained in cards/catalog.json.
use Brand { template = CardDefinition args = { sourceEntry = "BRAND" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:brand" cost = 0 upgradedCost = 0 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }
use BrandEffect1 { template = LoseHpEffect args = { definition = "base-spire:brand" hp = 1 upgradedHp = 1 } }
use BrandEffect2 { template = SelectExhaustEffect args = { definition = "base-spire:brand" } }
use BrandEffect3 { template = ApplySelfPowerEffect args = { definition = "base-spire:brand" power = "base-spire:strength-power" stacks = 1 upgradedStacks = 2 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure BrandBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = BrandEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = BrandEffect2.Apply args = { play = play  owner = owner card = card } }
    call = { procedure = BrandEffect3.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase BrandBody { dispatch = ExecuteCardBody key = "base-spire:brand" procedure = BrandBody }

use BrandDamageValue { template = StaticCardDamage args = { definition = "base-spire:brand" } }
