using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/SecondWind.cs; SHA-256 retained in cards/catalog.json.

use SecondWind { template = CardDefinition args = { sourceEntry = "SECOND_WIND" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:second-wind" cost = 1 upgradedCost = 1 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure SecondWindBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = ExhaustNonAttackCardsForBlock args = { owner = owner block = pureCall(CardUpgradeValue, card, 5, 7) } }
  }
}
dispatchCase SecondWindBody { dispatch = ExecuteCardBody key = "base-spire:second-wind" procedure = SecondWindBody }

use SecondWindDamageValue { template = StaticCardDamage args = { definition = "base-spire:second-wind" } }
