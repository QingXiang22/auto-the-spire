using namespace base-spire;
dsl_version = "core/0.3"

# Source: Break.cs: cost 1, DamageVar(20, Move) then VulnerablePower 5 on the target; OnUpgrade adds
# 10 damage and 2 Vulnerable.
use Break {
  template = CardDefinition
  args = { sourceEntry = "BREAK" rarity = "ancient" inIroncladPool = true generatable = false baseDamage = 20 upgradedBaseDamage = 30 kind = "attack" strikeTag = false definition = "base-spire:break" cost = 1 upgradedCost = 1 targeted = true exhausts = false leavesPlay = false }
}
use BreakDamage {
  template = AttackEffect
  args = { definition = "base-spire:break" hits = 1 }
}
use BreakVulnerable {
  template = ApplyEnemyPowerEffect
  args = { definition = "base-spire:break" power = "base-spire:vulnerable-power" stacks = 5 upgradedStacks = 7 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure BreakBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = BreakDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
    call = { procedure = BreakVulnerable.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase BreakBody { dispatch = ExecuteCardBody key = "base-spire:break" procedure = BreakBody }

use BreakDamageValue { template = StaticCardDamage args = { definition = "base-spire:break" } }
