using namespace base-spire;
dsl_version = "core/0.3"

# Source: FlameBarrier.cs: cost 2, BlockVar(12, Move) then FlameBarrierPower 4 (unpowered damage back);
# OnUpgrade adds 4 block and 2 damage back.
template ApplySelfPowerUntilTurnEndEffect {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    stacks = { type = Int(min = 1, max = 999) }
    upgradedStacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedStacks) } }
              else = { let = { into = amount value = arg(stacks) } }
            }
            call = { procedure = ApplyPlayerPowerFromCardUntilTurnEnd args = { card = card play = play  owner = owner definition = arg(power) stacks = amount } }
          }
        }
      }
    }

  }
}

use FlameBarrier {
  template = CardDefinition
  args = { sourceEntry = "FLAME_BARRIER" rarity = "uncommon" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:flame-barrier" cost = 2 upgradedCost = 2 targeted = false exhausts = false leavesPlay = false }
}
use FlameBarrierBlock {
  template = BlockEffect
  args = { definition = "base-spire:flame-barrier" block = 12 upgradedBlock = 16 }
}
use FlameBarrierThorns {
  template = ApplySelfPowerUntilTurnEndEffect
  args = { definition = "base-spire:flame-barrier" power = "base-spire:thorns-power" stacks = 4 upgradedStacks = 6 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure FlameBarrierBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = FlameBarrierBlock.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = FlameBarrierThorns.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase FlameBarrierBody { dispatch = ExecuteCardBody key = "base-spire:flame-barrier" procedure = FlameBarrierBody }

use FlameBarrierDamageValue { template = StaticCardDamage args = { definition = "base-spire:flame-barrier" } }
