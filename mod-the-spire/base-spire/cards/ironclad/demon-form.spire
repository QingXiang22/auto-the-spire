using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/DemonForm.cs; SHA-256 retained in cards/catalog.json.
use DemonForm { template = CardDefinition args = { sourceEntry = "DEMON_FORM" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:demon-form" cost = 3 upgradedCost = 3 kind = "power" strikeTag = false targeted = false exhausts = false leavesPlay = true } }
use DemonFormEffect1 { template = ApplySelfPowerEffect args = { definition = "base-spire:demon-form" power = "base-spire:demon-form" stacks = 2 upgradedStacks = 3 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure DemonFormBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = DemonFormEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase DemonFormBody { dispatch = ExecuteCardBody key = "base-spire:demon-form" procedure = DemonFormBody }

procedure DemonFormDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase DemonFormDamageValue { dispatch = ReadCardDamage key = "base-spire:demon-form" procedure = DemonFormDamageValue }
