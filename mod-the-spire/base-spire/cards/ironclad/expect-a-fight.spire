using namespace base-spire;
dsl_version = "core/0.3"

# Source: reference/sts2-sim/src/Sts2Sim.Core/Models/Cards/ExpectAFight.cs; source digest is retained in the independent Ironclad metadata fixture.
use ExpectAFight { template = CardDefinition args = { sourceEntry = "EXPECT_AFIGHT" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:expect-a-fight" cost = 3 upgradedCost = 3 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ExpectAFightBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    if = { condition = field(card, Card.Upgraded) then = {
      call = { procedure = GainBlock args = { owner = owner amount = add(16, multiply(8, maximum(0, pureCall(PlayerPowerAmount, owner, "base-spire:strength-power")))) } }
    } else = {
      call = { procedure = GainBlock args = { owner = owner amount = add(15, multiply(5, maximum(0, pureCall(PlayerPowerAmount, owner, "base-spire:strength-power")))) } }
    } }
  }
}
dispatchCase ExpectAFightBody { dispatch = ExecuteCardBody key = "base-spire:expect-a-fight" procedure = ExpectAFightBody }

procedure ExpectAFightDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase ExpectAFightDamageValue { dispatch = ReadCardDamage key = "base-spire:expect-a-fight" procedure = ExpectAFightDamageValue }
