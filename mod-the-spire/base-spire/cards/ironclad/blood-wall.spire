using namespace base-spire;
dsl_version = "core/0.3"

# Source: BloodWall.cs: cost 2, Skill, Self, HpLossVar(2) as unblockable unpowered damage then BlockVar(16, Move);
# OnUpgrade adds 4 block.
use BloodWall {
  template = CardDefinition
  args = { sourceEntry = "BLOOD_WALL" rarity = "common" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:blood-wall" cost = 2 upgradedCost = 2 targeted = false exhausts = false leavesPlay = false }
}
use BloodWallLoseHp {
  template = LoseHpEffect
  args = { definition = "base-spire:blood-wall" hp = 2 upgradedHp = 2 }
}
use BloodWallBlock {
  template = BlockEffect
  args = { definition = "base-spire:blood-wall" block = 16 upgradedBlock = 20 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure BloodWallBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = BloodWallLoseHp.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = BloodWallBlock.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase BloodWallBody { dispatch = ExecuteCardBody key = "base-spire:blood-wall" procedure = BloodWallBody }

procedure BloodWallDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase BloodWallDamageValue { dispatch = ReadCardDamage key = "base-spire:blood-wall" procedure = BloodWallDamageValue }
