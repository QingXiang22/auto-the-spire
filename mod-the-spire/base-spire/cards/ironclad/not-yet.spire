using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/NotYet.cs; SHA-256 retained in cards/catalog.json.
template HealEffect {
  parameters = { definition = { type = String(length = 64) } heal = { type = Int } upgradedHeal = { type = Int } }
  body = {
    procedure Apply {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = { if = { condition = equal(field(card, Card.DefinitionId), arg(definition)) then = {
let = { into = amount value = pureCall(CardUpgradeValue, card, arg(heal), arg(upgradedHeal)) }
call = { procedure = Heal args = { owner = owner amount = amount } }
      } } }
    }

  }
}

use NotYet { template = CardDefinition args = { sourceEntry = "NOT_YET" rarity = "rare" inIroncladPool = true generatable = false definition = "base-spire:not-yet" cost = 2 upgradedCost = 2 kind = "skill" strikeTag = false targeted = false exhausts = true leavesPlay = false } }
use NotYetEffect1 { template = HealEffect args = { definition = "base-spire:not-yet" heal = 10 upgradedHeal = 13 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure NotYetBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = NotYetEffect1.Apply args = { play = play  owner = owner card = card } }
  }
}
dispatchCase NotYetBody { dispatch = ExecuteCardBody key = "base-spire:not-yet" procedure = NotYetBody }

use NotYetDamageValue { template = StaticCardDamage args = { definition = "base-spire:not-yet" } }
