using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/FightMe.cs; SHA-256 retained in cards/catalog.json.
use FightMe { template = CardDefinition args = { rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:fight-me" cost = 2 upgradedCost = 2 kind = "attack" strikeTag = false targeted = true exhausts = false leavesPlay = false baseDamage = 5 upgradedBaseDamage = 6 } }
use FightMeEffect1 { template = ComputedAttackEffect args = { definition = "base-spire:fight-me" hits = 2 upgradedHits = 2 hitScale = "fixed" } }
use FightMeEffect2 { template = TargetedSelfPowerEffect args = { definition = "base-spire:fight-me" power = "base-spire:strength-power" kind = "damage-additive" stacks = 3 upgradedStacks = 4 } }
use FightMeEffect3 { template = ApplyEnemyPowerEffect args = { definition = "base-spire:fight-me" power = "base-spire:strength-power" kind = "damage-additive" stacks = 1 upgradedStacks = 1 } }
