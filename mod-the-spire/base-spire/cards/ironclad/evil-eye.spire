using namespace base-spire;
dsl_version = "core/0.3"

# Source: EvilEye.cs: cost 1, BlockVar(8, Move), gains its block once, or twice when a card was exhausted
# this turn; OnUpgrade adds 3 block.

use EvilEye {
  template = CardDefinition
  args = { sourceEntry = "EVIL_EYE" rarity = "uncommon" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:evil-eye" cost = 1 upgradedCost = 1 targeted = false exhausts = false leavesPlay = false }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure EvilEyeBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  locals = { gains = Int }
  body = {
    let = { into = gains value = pureCall(PlayerCombatFlagValue, owner, "exhausted-card", 1, 2) }
    repeat = { count = gains body = {
      call = { procedure = GainBlock args = { owner = owner amount = pureCall(CardUpgradeValue, card, 8, 11) } }
    } }
  }
}
dispatchCase EvilEyeBody { dispatch = ExecuteCardBody key = "base-spire:evil-eye" procedure = EvilEyeBody }

use EvilEyeDamageValue { template = StaticCardDamage args = { definition = "base-spire:evil-eye" } }
