using namespace base-spire;
dsl_version = "core/0.3"

# Source: PommelStrike.cs: cost 1, DamageVar(9, Move) plus CardsVar(1); OnUpgrade adds 1 damage and 1 card.
use PommelStrike {
  template = CardDefinition
  args = { sourceEntry = "POMMEL_STRIKE" rarity = "common" inIroncladPool = true generatable = true baseDamage = 9 upgradedBaseDamage = 10 kind = "attack" strikeTag = true definition = "base-spire:pommel-strike" cost = 1 upgradedCost = 1 targeted = true exhausts = false leavesPlay = false }
}
use PommelStrikeDamage {
  template = AttackEffect
  args = { definition = "base-spire:pommel-strike" hits = 1 }
}
use PommelStrikeDraw {
  template = DrawEffect
  args = { definition = "base-spire:pommel-strike" cards = 1 upgradedCards = 2 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure PommelStrikeBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = PommelStrikeDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
    call = { procedure = PommelStrikeDraw.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase PommelStrikeBody { dispatch = ExecuteCardBody key = "base-spire:pommel-strike" procedure = PommelStrikeBody }

use PommelStrikeDamageValue { template = StaticCardDamage args = { definition = "base-spire:pommel-strike" } }
