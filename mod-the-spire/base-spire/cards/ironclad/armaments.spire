using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Armaments.cs; SHA-256 retained in cards/catalog.json.

use Armaments { template = CardDefinition args = { sourceEntry = "ARMAMENTS" rarity = "common" inIroncladPool = true generatable = true definition = "base-spire:armaments" cost = 1 upgradedCost = 1 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }
use ArmamentsEffect1 { template = BlockEffect args = { definition = "base-spire:armaments" block = 5 upgradedBlock = 5 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ArmamentsBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = ArmamentsEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = UpgradeHandCards args = { owner = owner all = field(card, Card.Upgraded) } }
  }
}
dispatchCase ArmamentsBody { dispatch = ExecuteCardBody key = "base-spire:armaments" procedure = ArmamentsBody }

use ArmamentsDamageValue { template = StaticCardDamage args = { definition = "base-spire:armaments" } }
