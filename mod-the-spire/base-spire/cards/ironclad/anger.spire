using namespace base-spire;
dsl_version = "core/0.3"

# Source: Anger.cs: cost 0, DamageVar(6, Move), OnUpgrade adds 2, and OnPlay adds a clone to the discard pile.
template AddCopyEffect {  parameters = { definition = { type = String(length = 64) } }
  body = {
    procedure WhenPlayedOnTarget {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }
      locals = { copy = Binding }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            call = { procedure = CloneCombatCard args = { owner = owner source = card } into = copy }
            call = { procedure = MoveCombatCard args = { owner = owner card = copy to = "discard" reason = "clone" } }
          }
        }
      }
    }

  }
}

use Anger {
  template = CardDefinition
  args = { sourceEntry = "ANGER" rarity = "common" inIroncladPool = true generatable = true baseDamage = 6 upgradedBaseDamage = 8 kind = "attack" strikeTag = false definition = "base-spire:anger" cost = 0 upgradedCost = 0 targeted = true exhausts = false leavesPlay = false }
}
use AngerDamage {
  template = AttackEffect
  args = { definition = "base-spire:anger" hits = 1 }
}
use AngerCopy {
  template = AddCopyEffect
  args = { definition = "base-spire:anger" }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure AngerBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = AngerDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
    call = { procedure = AngerCopy.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase AngerBody { dispatch = ExecuteCardBody key = "base-spire:anger" procedure = AngerBody }

procedure AngerDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase AngerDamageValue { dispatch = ReadCardDamage key = "base-spire:anger" procedure = AngerDamageValue }
