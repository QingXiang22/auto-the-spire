using namespace base-spire;
dsl_version = "core/0.3"

# Source: Bludgeon.cs: cost 3, DamageVar(32, Move), TargetType.AnyEnemy, OnUpgrade adds 10 damage.
use Bludgeon {
  template = CardDefinition
  args = { sourceEntry = "BLUDGEON" rarity = "uncommon" inIroncladPool = true generatable = true baseDamage = 32 upgradedBaseDamage = 42 kind = "attack" strikeTag = false definition = "base-spire:bludgeon" cost = 3 upgradedCost = 3 targeted = true exhausts = false leavesPlay = false }
}
use BludgeonDamage {
  template = AttackEffect
  args = { definition = "base-spire:bludgeon" hits = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure BludgeonBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = BludgeonDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase BludgeonBody { dispatch = ExecuteCardBody key = "base-spire:bludgeon" procedure = BludgeonBody }

procedure BludgeonDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase BludgeonDamageValue { dispatch = ReadCardDamage key = "base-spire:bludgeon" procedure = BludgeonDamageValue }
