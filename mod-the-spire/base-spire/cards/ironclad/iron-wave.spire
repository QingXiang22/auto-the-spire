using namespace base-spire;
dsl_version = "core/0.3"

# Source: IronWave.cs: cost 1, BlockVar(5, Move) then DamageVar(5, Move) in OnPlay; OnUpgrade adds 2 to both.
use IronWave {
  template = CardDefinition
  args = { sourceEntry = "IRON_WAVE" rarity = "common" inIroncladPool = true generatable = true baseDamage = 5 upgradedBaseDamage = 7 kind = "attack" strikeTag = false definition = "base-spire:iron-wave" cost = 1 upgradedCost = 1 targeted = true exhausts = false leavesPlay = false }
}
use IronWaveBlock {
  template = BlockEffect
  args = { definition = "base-spire:iron-wave" block = 5 upgradedBlock = 7 }
}
use IronWaveDamage {
  template = AttackEffect
  args = { definition = "base-spire:iron-wave" hits = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure IronWaveBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = IronWaveBlock.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = IronWaveDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase IronWaveBody { dispatch = ExecuteCardBody key = "base-spire:iron-wave" procedure = IronWaveBody }

procedure IronWaveDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase IronWaveDamageValue { dispatch = ReadCardDamage key = "base-spire:iron-wave" procedure = IronWaveDamageValue }
