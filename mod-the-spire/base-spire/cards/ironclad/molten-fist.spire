using namespace base-spire;
dsl_version = "core/0.3"

# Source: MoltenFist.cs: cost 1, CardKeyword.Exhaust, DamageVar(10, Move) then Vulnerable applied equal to
# the target's current Vulnerable stacks (doubling it); OnUpgrade adds 4 damage.

use MoltenFist {
  template = CardDefinition
  args = { sourceEntry = "MOLTEN_FIST" rarity = "common" inIroncladPool = true generatable = true baseDamage = 10 upgradedBaseDamage = 14 kind = "attack" strikeTag = false definition = "base-spire:molten-fist" cost = 1 upgradedCost = 1 targeted = true exhausts = true leavesPlay = false }
}
use MoltenFistDamage {
  template = AttackEffect
  args = { definition = "base-spire:molten-fist" hits = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure MoltenFistBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = MoltenFistDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
    call = { procedure = AmplifyEnemyPowerFromCard args = { owner = owner card = card play = play target = target definition = "base-spire:vulnerable-power" multiplier = 2 } }
  }
}
dispatchCase MoltenFistBody { dispatch = ExecuteCardBody key = "base-spire:molten-fist" procedure = MoltenFistBody }

use MoltenFistDamageValue { template = StaticCardDamage args = { definition = "base-spire:molten-fist" } }
