using namespace base-spire;
dsl_version = "core/0.3"

# Source: Taunt.cs: cost 1, Skill, AnyEnemy, BlockVar(7, Move) then VulnerablePower 1 on the target;
# OnUpgrade adds 1 block and 1 Vulnerable. A targeted skill, so its block resolves before the debuff.
use Taunt {
  template = CardDefinition
  args = { sourceEntry = "TAUNT" rarity = "common" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:taunt" cost = 1 upgradedCost = 1 targeted = true exhausts = false leavesPlay = false }
}
use TauntBlock {
  template = BlockEffect
  args = { definition = "base-spire:taunt" block = 7 upgradedBlock = 8 }
}
use TauntVulnerable {
  template = ApplyEnemyPowerEffect
  args = { definition = "base-spire:taunt" power = "base-spire:vulnerable-power" stacks = 1 upgradedStacks = 2 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure TauntBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = TauntBlock.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = TauntVulnerable.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase TauntBody { dispatch = ExecuteCardBody key = "base-spire:taunt" procedure = TauntBody }

procedure TauntDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase TauntDamageValue { dispatch = ReadCardDamage key = "base-spire:taunt" procedure = TauntDamageValue }
