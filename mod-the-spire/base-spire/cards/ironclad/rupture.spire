using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Rupture.cs; SHA-256 retained in cards/catalog.json.
use Rupture { template = CardDefinition args = { sourceEntry = "RUPTURE" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:rupture" cost = 1 upgradedCost = 1 kind = "power" strikeTag = false targeted = false exhausts = false leavesPlay = true } }
use RuptureEffect1 { template = ApplySelfPowerEffect args = { definition = "base-spire:rupture" power = "base-spire:rupture-power" stacks = 1 upgradedStacks = 2 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure RuptureBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = RuptureEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase RuptureBody { dispatch = ExecuteCardBody key = "base-spire:rupture" procedure = RuptureBody }

procedure RuptureDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase RuptureDamageValue { dispatch = ReadCardDamage key = "base-spire:rupture" procedure = RuptureDamageValue }
