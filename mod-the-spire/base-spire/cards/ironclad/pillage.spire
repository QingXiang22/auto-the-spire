using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Pillage.cs; SHA-256 retained in cards/catalog.json.
template DrawUntilNonAttackEffect {
  parameters = { definition = { type = String(length = 64) }  }
  body = {
    procedure Apply {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }
      locals = { drawing = Bool drawn = Binding }
      body = { if = { condition = equal(field(card, Card.DefinitionId), arg(definition)) then = {
let = { into = drawing value = true }
repeat = { count = 10 body = { if = { condition = drawing then = {
  call = { procedure = DrawOne args = { owner = owner fromHandDraw = false } }
  let = { into = drawn value = field(owner, Player.LastDrawn) }
  if = { condition = isNone(drawn) then = { let = { into = drawing value = false } } else = {
    if = { condition = not(equal(field(drawn, Card.Kind), "attack")) then = { let = { into = drawing value = false } } }
  } }
} } } }
      } } }
    }

  }
}

use Pillage { template = CardDefinition args = { sourceEntry = "PILLAGE" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:pillage" cost = 1 upgradedCost = 1 kind = "attack" strikeTag = false targeted = true exhausts = false leavesPlay = false baseDamage = 6 upgradedBaseDamage = 9 } }
use PillageEffect1 { template = ComputedAttackEffect args = { definition = "base-spire:pillage" hits = 1 upgradedHits = 1 hitScale = "fixed" } }
use PillageEffect2 { template = DrawUntilNonAttackEffect args = { definition = "base-spire:pillage" } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure PillageBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = PillageEffect1.Apply args = { play = play  owner = owner card = card target = target } }
    call = { procedure = PillageEffect2.Apply args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase PillageBody { dispatch = ExecuteCardBody key = "base-spire:pillage" procedure = PillageBody }

use PillageDamageValue { template = StaticCardDamage args = { definition = "base-spire:pillage" } }
