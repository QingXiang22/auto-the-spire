using namespace base-spire;
dsl_version = "core/0.3"

# Source: Uppercut.cs: cost 2, DamageVar(13, Move) then the "Power" var (1) applied as WeakPower and
# VulnerablePower; OnUpgrade raises the power var by 1 so both debuffs become 2.
use Uppercut {
  template = CardDefinition
  args = { sourceEntry = "UPPERCUT" rarity = "uncommon" inIroncladPool = true generatable = true baseDamage = 13 upgradedBaseDamage = 13 kind = "attack" strikeTag = false definition = "base-spire:uppercut" cost = 2 upgradedCost = 2 targeted = true exhausts = false leavesPlay = false }
}
use UppercutDamage {
  template = AttackEffect
  args = { definition = "base-spire:uppercut" hits = 1 }
}
use UppercutWeak {
  template = ApplyEnemyPowerEffect
  args = { definition = "base-spire:uppercut" power = "base-spire:weak-power" stacks = 1 upgradedStacks = 2 }
}
use UppercutVulnerable {
  template = ApplyEnemyPowerEffect
  args = { definition = "base-spire:uppercut" power = "base-spire:vulnerable-power" stacks = 1 upgradedStacks = 2 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure UppercutBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = UppercutDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
    call = { procedure = UppercutWeak.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
    call = { procedure = UppercutVulnerable.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase UppercutBody { dispatch = ExecuteCardBody key = "base-spire:uppercut" procedure = UppercutBody }

use UppercutDamageValue { template = StaticCardDamage args = { definition = "base-spire:uppercut" } }
