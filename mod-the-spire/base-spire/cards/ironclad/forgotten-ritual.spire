using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/ForgottenRitual.cs; SHA-256 retained in cards/catalog.json.

use ForgottenRitual { template = CardDefinition args = { sourceEntry = "FORGOTTEN_RITUAL" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:forgotten-ritual" cost = 1 upgradedCost = 1 kind = "skill" strikeTag = false targeted = false exhausts = true leavesPlay = false } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ForgottenRitualBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    if = { condition = pureCall(PlayerCombatFlag, owner, "exhausted-card") then = { call = { procedure = GainEnergy args = { owner = owner amount = pureCall(CardUpgradeValue, card, 3, 4) } } } }
  }
}
dispatchCase ForgottenRitualBody { dispatch = ExecuteCardBody key = "base-spire:forgotten-ritual" procedure = ForgottenRitualBody }

use ForgottenRitualDamageValue { template = StaticCardDamage args = { definition = "base-spire:forgotten-ritual" } }
