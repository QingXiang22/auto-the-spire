using namespace base-spire;
dsl_version = "core/0.3"

# Source: HowlFromBeyond.cs: cost 3, 16/21 damage to all enemies. No innate Exhaust keyword;
# if it is in ExhaustPile at the end-of-turn auto-post-play phase, it plays itself for free.
use HowlFromBeyond {
  template = CardDefinition
  args = { sourceEntry = "HOWL_FROM_BEYOND" rarity = "uncommon" inIroncladPool = true generatable = true baseDamage = 16 upgradedBaseDamage = 21 kind = "attack" strikeTag = false definition = "base-spire:howl-from-beyond" cost = 3 upgradedCost = 3 targeted = false exhausts = false leavesPlay = false }
}
use HowlFromBeyondDamage {
  template = AttackAllEnemiesEffect
  args = { definition = "base-spire:howl-from-beyond" hits = 1 upgradedHits = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure HowlFromBeyondBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = HowlFromBeyondDamage.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase HowlFromBeyondBody { dispatch = ExecuteCardBody key = "base-spire:howl-from-beyond" procedure = HowlFromBeyondBody }

use HowlFromBeyondDamageValue { template = StaticCardDamage args = { definition = "base-spire:howl-from-beyond" } }

procedure HowlFromBeyondAutoExhausted {
  parameters = { owner = Ref(Player) listener = Ref(Card) }
  body = { call = { procedure = AutoPlayCard args = { owner = owner card = listener forceExhaust = false } } }
}

subscription HowlFromBeyondAutoExhausted {
  event = AfterAutoPostPlayPhaseEntered reaction = HowlFromBeyondAutoExhausted
  instances = where(collection(ExhaustPile), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), equal(field(c, Card.DefinitionId), "base-spire:howl-from-beyond")))
  instance_order = pureCall(CardHookOrder, listener, false) priority = 0
}
