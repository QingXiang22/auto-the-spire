using namespace base-spire;
dsl_version = "core/0.3"

# Source: HowlFromBeyond.cs: cost 3, DamageVar(16, Move) to all enemies, CardKeyword.Exhaust; OnUpgrade adds
# 5 damage. The source also auto-plays this card when it is exhausted by another effect, which is not migrated.
use HowlFromBeyond {
  template = CardDefinition
  args = { definition = "base-spire:howl-from-beyond" cost = 3 upgradedCost = 3 targeted = false exhausts = true leavesPlay = false }
}
use HowlFromBeyondDamage {
  template = AttackAllEnemiesEffect
  args = { definition = "base-spire:howl-from-beyond" damage = 16 upgradedDamage = 21 hits = 1 upgradedHits = 1 }
}
