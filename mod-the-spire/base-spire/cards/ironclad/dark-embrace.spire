using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/DarkEmbrace.cs; SHA-256 retained in cards/catalog.json.
use DarkEmbrace { template = CardDefinition args = { sourceEntry = "DARK_EMBRACE" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:dark-embrace" cost = 2 upgradedCost = 1 kind = "power" strikeTag = false targeted = false exhausts = false leavesPlay = true } }
use DarkEmbraceEffect1 { template = ApplySelfPowerEffect args = { definition = "base-spire:dark-embrace" power = "base-spire:dark-embrace-power" stacks = 1 upgradedStacks = 1 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure DarkEmbraceBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = DarkEmbraceEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase DarkEmbraceBody { dispatch = ExecuteCardBody key = "base-spire:dark-embrace" procedure = DarkEmbraceBody }

procedure DarkEmbraceDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase DarkEmbraceDamageValue { dispatch = ReadCardDamage key = "base-spire:dark-embrace" procedure = DarkEmbraceDamageValue }
