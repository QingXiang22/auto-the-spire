using namespace base-spire;
dsl_version = "core/0.3"

# Source: Breakthrough.cs: cost 1, HpLossVar(1) as unblockable unpowered damage then DamageVar(9, Move) to all
# enemies; OnUpgrade adds 4 damage. The HP loss is declared first so it happens before the attack.
use Breakthrough {
  template = CardDefinition
  args = { sourceEntry = "BREAKTHROUGH" rarity = "common" inIroncladPool = true generatable = true baseDamage = 9 upgradedBaseDamage = 13 kind = "attack" strikeTag = false definition = "base-spire:breakthrough" cost = 1 upgradedCost = 1 targeted = false exhausts = false leavesPlay = false }
}
use BreakthroughLoseHp {
  template = LoseHpEffect
  args = { definition = "base-spire:breakthrough" hp = 1 upgradedHp = 1 }
}
use BreakthroughDamage {
  template = AttackAllEnemiesEffect
  args = { definition = "base-spire:breakthrough" hits = 1 upgradedHits = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure BreakthroughBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = BreakthroughLoseHp.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = BreakthroughDamage.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase BreakthroughBody { dispatch = ExecuteCardBody key = "base-spire:breakthrough" procedure = BreakthroughBody }

use BreakthroughDamageValue { template = StaticCardDamage args = { definition = "base-spire:breakthrough" } }
