using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/FiendFire.cs; SHA-256 retained in cards/catalog.json.

use FiendFire { template = CardDefinition args = { sourceEntry = "FIEND_FIRE" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:fiend-fire" cost = 2 upgradedCost = 2 kind = "attack" strikeTag = false targeted = true exhausts = true leavesPlay = false baseDamage = 7 upgradedBaseDamage = 10 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure FiendFireBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  locals = { hits = Int }
  body = {
    call = { procedure = ExhaustHandCards args = { owner = owner } into = hits }
    call = { procedure = CardAttack args = { owner = owner card = card play = play target = target amount = pureCall(CardBaseDamage, owner, card, target) hits = hits mode = "single" dynamic = true } }
  }
}
dispatchCase FiendFireBody { dispatch = ExecuteCardBody key = "base-spire:fiend-fire" procedure = FiendFireBody }

use FiendFireDamageValue { template = StaticCardDamage args = { definition = "base-spire:fiend-fire" } }
