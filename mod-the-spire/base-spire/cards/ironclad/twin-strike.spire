using namespace base-spire;
dsl_version = "core/0.3"

# Source: TwinStrike.cs: cost 1, DamageVar(5, Move) with WithHitCount(2), OnUpgrade adds 2 per hit.
use TwinStrike {
  template = CardDefinition
  args = { sourceEntry = "TWIN_STRIKE" rarity = "common" inIroncladPool = true generatable = true baseDamage = 5 upgradedBaseDamage = 7 kind = "attack" strikeTag = true definition = "base-spire:twin-strike" cost = 1 upgradedCost = 1 targeted = true exhausts = false leavesPlay = false }
}
use TwinStrikeDamage {
  template = AttackEffect
  args = { definition = "base-spire:twin-strike" hits = 2 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure TwinStrikeBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = TwinStrikeDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase TwinStrikeBody { dispatch = ExecuteCardBody key = "base-spire:twin-strike" procedure = TwinStrikeBody }

procedure TwinStrikeDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase TwinStrikeDamageValue { dispatch = ReadCardDamage key = "base-spire:twin-strike" procedure = TwinStrikeDamageValue }
