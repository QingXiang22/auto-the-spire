using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Cruelty.cs; SHA-256 retained in cards/catalog.json.
use Cruelty { template = CardDefinition args = { sourceEntry = "CRUELTY" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:cruelty" cost = 1 upgradedCost = 1 kind = "power" strikeTag = false targeted = false exhausts = false leavesPlay = true } }
use CrueltyEffect1 { template = ApplySelfPowerEffect args = { definition = "base-spire:cruelty" power = "base-spire:cruelty-power" stacks = 25 upgradedStacks = 50 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure CrueltyBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = CrueltyEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase CrueltyBody { dispatch = ExecuteCardBody key = "base-spire:cruelty" procedure = CrueltyBody }

procedure CrueltyDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase CrueltyDamageValue { dispatch = ReadCardDamage key = "base-spire:cruelty" procedure = CrueltyDamageValue }
