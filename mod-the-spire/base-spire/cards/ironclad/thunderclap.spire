using namespace base-spire;
dsl_version = "core/0.3"

# Source: Thunderclap.cs: cost 1, Attack, AllEnemies, DamageVar(4, Move) to every enemy then Vulnerable 1
# to every enemy; OnUpgrade adds 3 damage. The damage effect is declared first so the debuff lands after it.
use Thunderclap {
  template = CardDefinition
  args = { sourceEntry = "THUNDERCLAP" rarity = "common" inIroncladPool = true generatable = true baseDamage = 4 upgradedBaseDamage = 7 kind = "attack" strikeTag = false definition = "base-spire:thunderclap" cost = 1 upgradedCost = 1 targeted = false exhausts = false leavesPlay = false }
}
use ThunderclapDamage {
  template = AttackAllEnemiesEffect
  args = { definition = "base-spire:thunderclap" hits = 1 upgradedHits = 1 }
}
use ThunderclapVulnerable {
  template = ApplyAllEnemiesPowerEffect
  args = { definition = "base-spire:thunderclap" power = "base-spire:vulnerable-power" stacks = 1 upgradedStacks = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ThunderclapBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = ThunderclapDamage.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = ThunderclapVulnerable.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase ThunderclapBody { dispatch = ExecuteCardBody key = "base-spire:thunderclap" procedure = ThunderclapBody }

procedure ThunderclapDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase ThunderclapDamageValue { dispatch = ReadCardDamage key = "base-spire:thunderclap" procedure = ThunderclapDamageValue }
