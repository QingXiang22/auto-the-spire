using namespace base-spire;
dsl_version = "core/0.3"

# Source: Spite.cs: cost 0, DamageVar(5, Move) with RepeatVar(2); it hits once normally and Repeat times when
# the owner lost HP this turn. OnUpgrade raises Repeat by 1 (three hits when triggered).

use Spite {
  template = CardDefinition
  args = { sourceEntry = "SPITE" rarity = "uncommon" inIroncladPool = true generatable = true baseDamage = 5 upgradedBaseDamage = 5 kind = "attack" strikeTag = false definition = "base-spire:spite" cost = 0 upgradedCost = 0 targeted = true exhausts = false leavesPlay = false }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure SpiteBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = CardAttack args = { owner = owner card = card play = play target = target amount = pureCall(CardBaseDamage, owner, card, target) hits = pureCall(PlayerCombatFlagValue, owner, "lost-hp", 1, pureCall(CardUpgradeValue, card, 2, 3)) mode = "single" dynamic = false } }
  }
}
dispatchCase SpiteBody { dispatch = ExecuteCardBody key = "base-spire:spite" procedure = SpiteBody }

use SpiteDamageValue { template = StaticCardDamage args = { definition = "base-spire:spite" } }
