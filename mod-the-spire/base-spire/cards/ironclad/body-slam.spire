using namespace base-spire;
dsl_version = "core/0.3"

# Source: BodySlam.cs: cost 1 and OnUpgrade lowers the cost by 1; damage equals the player's block.

use BodySlam {
  template = CardDefinition
  args = { sourceEntry = "BODY_SLAM" rarity = "common" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "attack" strikeTag = false definition = "base-spire:body-slam" cost = 1 upgradedCost = 0 targeted = true exhausts = false leavesPlay = false }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure BodySlamBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = CardAttack args = { owner = owner card = card play = play target = target amount = field(owner, Player.Block) hits = 1 mode = "single" dynamic = false } }
  }
}
dispatchCase BodySlamBody { dispatch = ExecuteCardBody key = "base-spire:body-slam" procedure = BodySlamBody }

dispatchCase BodySlamDamageValue { dispatch = ReadCardDamage key = "base-spire:body-slam" procedure = ReadCardDamageFromBlock }
