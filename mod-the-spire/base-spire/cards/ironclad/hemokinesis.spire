using namespace base-spire;
dsl_version = "core/0.3"

# Source: Hemokinesis.cs: cost 1, HpLossVar(2) as unblockable unpowered damage then DamageVar(15, Move) on the
# target; OnUpgrade adds 5 damage. Order matters: the HP loss happens before the attack.
use Hemokinesis {
  template = CardDefinition
  args = { sourceEntry = "HEMOKINESIS" rarity = "uncommon" inIroncladPool = true generatable = true baseDamage = 15 upgradedBaseDamage = 20 kind = "attack" strikeTag = false definition = "base-spire:hemokinesis" cost = 1 upgradedCost = 1 targeted = true exhausts = false leavesPlay = false }
}
use HemokinesisLoseHp {
  template = LoseHpEffect
  args = { definition = "base-spire:hemokinesis" hp = 2 upgradedHp = 2 }
}
use HemokinesisDamage {
  template = AttackEffect
  args = { definition = "base-spire:hemokinesis" hits = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure HemokinesisBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = HemokinesisLoseHp.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = HemokinesisDamage.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase HemokinesisBody { dispatch = ExecuteCardBody key = "base-spire:hemokinesis" procedure = HemokinesisBody }

procedure HemokinesisDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase HemokinesisDamageValue { dispatch = ReadCardDamage key = "base-spire:hemokinesis" procedure = HemokinesisDamageValue }
