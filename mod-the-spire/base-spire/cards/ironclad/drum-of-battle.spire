using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/DrumOfBattle.cs; SHA-256 retained in cards/catalog.json.

use DrumOfBattle { template = CardDefinition args = { sourceEntry = "DRUM_OF_BATTLE" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:drum-of-battle" cost = 1 upgradedCost = 1 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }
use DrumOfBattleEffect1 { template = DrawEffect args = { definition = "base-spire:drum-of-battle" cards = 2 upgradedCards = 2 } }
use DrumOfBattleEffect2 { template = ExhaustEnergyReaction args = { definition = "base-spire:drum-of-battle" energy = 2 upgradedEnergy = 3 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure DrumOfBattleBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = DrumOfBattleEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase DrumOfBattleBody { dispatch = ExecuteCardBody key = "base-spire:drum-of-battle" procedure = DrumOfBattleBody }

use DrumOfBattleDamageValue { template = StaticCardDamage args = { definition = "base-spire:drum-of-battle" } }
