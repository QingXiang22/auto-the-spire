using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Dominate.cs; SHA-256 retained in cards/catalog.json.
template DominateStrengthEffect {
  parameters = { definition = { type = String(length = 64) }  }
  body = {
    procedure Apply {
      parameters = { owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }

      body = { if = { condition = equal(field(card, Card.DefinitionId), arg(definition)) then = {
call = { procedure = ApplyPlayerPower args = { owner = owner definition = "base-spire:strength-power" stacks = pureCall(EnemyPowerAmount, target, "base-spire:vulnerable-power") } }
      } } }
    }
    subscription Apply { event = CardPlayedOnTarget reaction = Apply }
  }
}

use Dominate { template = CardDefinition args = { sourceEntry = "DOMINATE" rarity = "uncommon" inIroncladPool = true generatable = true definition = "base-spire:dominate" cost = 1 upgradedCost = 1 kind = "skill" strikeTag = false targeted = true exhausts = true leavesPlay = false } }
use DominateEffect1 { template = ApplyEnemyPowerEffect args = { definition = "base-spire:dominate" power = "base-spire:vulnerable-power" stacks = 1 upgradedStacks = 2 } }
use DominateEffect2 { template = DominateStrengthEffect args = { definition = "base-spire:dominate" } }
