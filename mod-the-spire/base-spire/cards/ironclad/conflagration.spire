using namespace base-spire;
dsl_version = "core/0.3"

# Source: Conflagration.cs: cost 1, DamageVar(2, Move) with RepeatVar(4) hits on all enemies;
# OnUpgrade raises Repeat by 1 so the upgraded card hits five times.
use Conflagration {
  template = CardDefinition
  args = { sourceEntry = "CONFLAGRATION" rarity = "rare" inIroncladPool = true generatable = true baseDamage = 2 upgradedBaseDamage = 2 kind = "attack" strikeTag = false definition = "base-spire:conflagration" cost = 1 upgradedCost = 1 targeted = false exhausts = false leavesPlay = false }
}
use ConflagrationDamage {
  template = AttackAllEnemiesEffect
  args = { definition = "base-spire:conflagration" hits = 4 upgradedHits = 5 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ConflagrationBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = ConflagrationDamage.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase ConflagrationBody { dispatch = ExecuteCardBody key = "base-spire:conflagration" procedure = ConflagrationBody }

use ConflagrationDamageValue { template = StaticCardDamage args = { definition = "base-spire:conflagration" } }
