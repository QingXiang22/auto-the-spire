using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Stoke.cs; SHA-256 retained in cards/catalog.json.

use Stoke { template = CardDefinition args = { sourceEntry = "STOKE" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:stoke" cost = 1 upgradedCost = 1 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure StokeBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  locals = { size = Int }
  body = {
    call = { procedure = ExhaustHandCards args = { owner = owner } into = size }
    call = { procedure = GenerateCardsToHand args = { owner = owner count = size attacksOnly = false upgraded = field(card, Card.Upgraded) } }
  }
}
dispatchCase StokeBody { dispatch = ExecuteCardBody key = "base-spire:stoke" procedure = StokeBody }

use StokeDamageValue { template = StaticCardDamage args = { definition = "base-spire:stoke" } }
