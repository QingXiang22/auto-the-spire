using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/PrimalForce.cs; SHA-256 retained in cards/catalog.json.
template TransformHandAttacksEffect {
  parameters = { definition = { type = String(length = 64) }  }
  body = {
    procedure Apply {
      parameters = { owner = Ref(Player) card = Ref(Card) }
      locals = { replacement = Binding }
      body = { if = { condition = equal(field(card, Card.DefinitionId), arg(definition)) then = {
forEach = { query = where(collection(Hand), c, equal(field(c, Card.Kind), "attack")) item = c body = {
  call = { procedure = CreateCombatCard args = { owner = owner definition = "base-spire:giant-rock" } into = replacement }
  if = { condition = field(card, Card.Upgraded) then = { call = { procedure = UpgradeCard args = { card = replacement } } } }
  removeFromCollection = { collection = Hand item = c }
  addToCollection = { collection = RemovedFromCombat item = c }
  call = { procedure = AddGeneratedToHand args = { card = replacement } }
} }
      } } }
    }
    subscription Apply { event = CardPlayed reaction = Apply }
  }
}

use PrimalForce { template = CardDefinition args = { sourceEntry = "PRIMAL_FORCE" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:primal-force" cost = 0 upgradedCost = 0 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }
use PrimalForceEffect1 { template = TransformHandAttacksEffect args = { definition = "base-spire:primal-force" } }
