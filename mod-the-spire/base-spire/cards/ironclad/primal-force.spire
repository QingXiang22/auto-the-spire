using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/PrimalForce.cs; SHA-256 retained in cards/catalog.json.

use PrimalForce { template = CardDefinition args = { sourceEntry = "PRIMAL_FORCE" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:primal-force" cost = 0 upgradedCost = 0 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure PrimalForceBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = TransformHandCards args = { owner = owner kind = "attack" replacementDefinition = "base-spire:giant-rock" upgraded = field(card, Card.Upgraded) } }
  }
}
dispatchCase PrimalForceBody { dispatch = ExecuteCardBody key = "base-spire:primal-force" procedure = PrimalForceBody }

use PrimalForceDamageValue { template = StaticCardDamage args = { definition = "base-spire:primal-force" } }
