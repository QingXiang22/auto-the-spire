using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/OneTwoPunch.cs; SHA-256 retained in cards/catalog.json.
use OneTwoPunch { template = CardDefinition args = { sourceEntry = "ONE_TWO_PUNCH" rarity = "rare" inIroncladPool = true generatable = true definition = "base-spire:one-two-punch" cost = 1 upgradedCost = 1 kind = "skill" strikeTag = false targeted = false exhausts = false leavesPlay = false } }
use OneTwoPunchEffect1 { template = ApplySelfPowerEffect args = { definition = "base-spire:one-two-punch" power = "base-spire:one-two-punch-power" stacks = 1 upgradedStacks = 2 } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure OneTwoPunchBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = OneTwoPunchEffect1.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase OneTwoPunchBody { dispatch = ExecuteCardBody key = "base-spire:one-two-punch" procedure = OneTwoPunchBody }

procedure OneTwoPunchDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase OneTwoPunchDamageValue { dispatch = ReadCardDamage key = "base-spire:one-two-punch" procedure = OneTwoPunchDamageValue }
