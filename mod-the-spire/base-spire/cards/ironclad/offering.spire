using namespace base-spire;
dsl_version = "core/0.3"

# Source: Offering.cs: cost 0, HpLossVar(6) as Unblockable | Unpowered damage, EnergyVar(2), CardsVar(3),
# CardKeyword.Exhaust; OnUpgrade adds 2 cards.
use Offering {
  template = CardDefinition
  args = { sourceEntry = "OFFERING" rarity = "rare" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:offering" cost = 0 upgradedCost = 0 targeted = false exhausts = true leavesPlay = false }
}
use OfferingLoseHp {
  template = LoseHpEffect
  args = { definition = "base-spire:offering" hp = 6 upgradedHp = 6 }
}
use OfferingEnergy {
  template = EnergyEffect
  args = { definition = "base-spire:offering" energy = 2 upgradedEnergy = 2 }
}
use OfferingDraw {
  template = DrawEffect
  args = { definition = "base-spire:offering" cards = 3 upgradedCards = 5 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure OfferingBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = OfferingLoseHp.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = OfferingEnergy.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = OfferingDraw.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase OfferingBody { dispatch = ExecuteCardBody key = "base-spire:offering" procedure = OfferingBody }

use OfferingDamageValue { template = StaticCardDamage args = { definition = "base-spire:offering" } }
