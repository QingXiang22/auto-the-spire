using namespace base-spire;
dsl_version = "core/0.3"

# Source: ShrugItOff.cs: cost 1, BlockVar(8, Move) plus CardsVar(1); OnUpgrade adds 3 block only.
use ShrugItOff {
  template = CardDefinition
  args = { sourceEntry = "SHRUG_IT_OFF" rarity = "common" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:shrug-it-off" cost = 1 upgradedCost = 1 targeted = false exhausts = false leavesPlay = false }
}
use ShrugItOffBlock {
  template = BlockEffect
  args = { definition = "base-spire:shrug-it-off" block = 8 upgradedBlock = 11 }
}
use ShrugItOffDraw {
  template = DrawEffect
  args = { definition = "base-spire:shrug-it-off" cards = 1 upgradedCards = 1 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ShrugItOffBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = ShrugItOffBlock.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = ShrugItOffDraw.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase ShrugItOffBody { dispatch = ExecuteCardBody key = "base-spire:shrug-it-off" procedure = ShrugItOffBody }

procedure ShrugItOffDamageValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  body = {
    return = { value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
  }
}
dispatchCase ShrugItOffDamageValue { dispatch = ReadCardDamage key = "base-spire:shrug-it-off" procedure = ShrugItOffDamageValue }
