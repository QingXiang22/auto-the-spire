using namespace base-spire;
dsl_version = "core/0.3"

# Source: Tremble.cs: cost 1, Skill, AnyEnemy, CardKeyword.Exhaust, VulnerablePower 3 on the target;
# OnUpgrade adds 1 Vulnerable.
use Tremble {
  template = CardDefinition
  args = { sourceEntry = "TREMBLE" rarity = "common" inIroncladPool = true generatable = true baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:tremble" cost = 1 upgradedCost = 1 targeted = true exhausts = true leavesPlay = false }
}
use TrembleVulnerable {
  template = ApplyEnemyPowerEffect
  args = { definition = "base-spire:tremble" power = "base-spire:vulnerable-power" stacks = 3 upgradedStacks = 4 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure TrembleBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = TrembleVulnerable.WhenPlayedOnTarget args = { play = play  owner = owner card = card target = target } }
  }
}
dispatchCase TrembleBody { dispatch = ExecuteCardBody key = "base-spire:tremble" procedure = TrembleBody }

use TrembleDamageValue { template = StaticCardDamage args = { definition = "base-spire:tremble" } }
