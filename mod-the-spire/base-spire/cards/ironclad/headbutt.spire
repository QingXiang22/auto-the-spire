using namespace base-spire;
dsl_version = "core/0.3"

# Source: sts2/src/Core/Models/Cards/Headbutt.cs; SHA-256 retained in cards/catalog.json.

use Headbutt { template = CardDefinition args = { sourceEntry = "HEADBUTT" rarity = "common" inIroncladPool = true generatable = true definition = "base-spire:headbutt" cost = 1 upgradedCost = 1 kind = "attack" strikeTag = false targeted = true exhausts = false leavesPlay = false baseDamage = 9 upgradedBaseDamage = 12 } }
use HeadbuttEffect1 { template = ComputedAttackEffect args = { definition = "base-spire:headbutt" hits = 1 upgradedHits = 1 hitScale = "fixed" } }

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure HeadbuttBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = HeadbuttEffect1.Apply args = { play = play  owner = owner card = card target = target } }
    call = { procedure = MoveSelectedDiscardCard args = { owner = owner to = "draw-top" reason = "return" } }
  }
}
dispatchCase HeadbuttBody { dispatch = ExecuteCardBody key = "base-spire:headbutt" procedure = HeadbuttBody }

use HeadbuttDamageValue { template = StaticCardDamage args = { definition = "base-spire:headbutt" } }
