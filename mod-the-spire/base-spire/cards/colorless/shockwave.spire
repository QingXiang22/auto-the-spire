using namespace base-spire;
dsl_version = "core/0.3"

# Source: Shockwave.cs: cost 2, CardKeyword.Exhaust, applies the "Power" var (3) as WeakPower and
# VulnerablePower to every enemy; OnUpgrade raises the power var by 2 so both debuffs become 5.
use Shockwave {
  template = CardDefinition
  args = { sourceEntry = "SHOCKWAVE" rarity = "uncommon" baseDamage = 0 upgradedBaseDamage = 0 kind = "skill" strikeTag = false definition = "base-spire:shockwave" cost = 2 upgradedCost = 2 targeted = false exhausts = true leavesPlay = false }
}
use ShockwaveWeak {
  template = ApplyAllEnemiesPowerEffect
  args = { definition = "base-spire:shockwave" power = "base-spire:weak-power" stacks = 3 upgradedStacks = 5 }
}
use ShockwaveVulnerable {
  template = ApplyAllEnemiesPowerEffect
  args = { definition = "base-spire:shockwave" power = "base-spire:vulnerable-power" stacks = 3 upgradedStacks = 5 }
}

# The definition owns this ordered body; lifecycle notifications do not dispatch card effects.
procedure ShockwaveBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = ShockwaveWeak.WhenPlayed args = { play = play  owner = owner card = card } }
    call = { procedure = ShockwaveVulnerable.WhenPlayed args = { play = play  owner = owner card = card } }
  }
}
dispatchCase ShockwaveBody { dispatch = ExecuteCardBody key = "base-spire:shockwave" procedure = ShockwaveBody }

use ShockwaveDamageValue { template = StaticCardDamage args = { definition = "base-spire:shockwave" } }
