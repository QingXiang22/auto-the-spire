using namespace base-spire;
dsl_version = "core/0.3"

# Source: reference/sts2-sim/src/Sts2Sim.Core/Models/Cards/Whistle.cs; 2 cost, 33 damage (44 upgraded),
# then CreatureCmd.Stun, and CardKeyword.Exhaust.
use Whistle {
  template = CardDefinition
  args = { sourceEntry = "WHISTLE" rarity = "ancient" baseDamage = 33 upgradedBaseDamage = 44 kind = "attack" strikeTag = false generatable = false definition = "base-spire:whistle" cost = 2 upgradedCost = 2 targeted = true exhausts = true leavesPlay = false }
}
use WhistleDamage { template = AttackEffect args = { definition = "base-spire:whistle" hits = 1 } }

procedure WhistleBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
  body = {
    call = { procedure = WhistleDamage.WhenPlayedOnTarget args = { play = play owner = owner card = card target = target } }
    call = { procedure = StunEnemy args = { target = target } }
  }
}
dispatchCase WhistleBody { dispatch = ExecuteCardBody key = "base-spire:whistle" procedure = WhistleBody }

use WhistleDamageValue { template = StaticCardDamage args = { definition = "base-spire:whistle" } }
