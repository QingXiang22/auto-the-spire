using namespace base-spire;
dsl_version = "core/0.3"

# Minimal permanent acquisition for actual migrated definitions. Pool selection, acquire modifiers and
# normal character initialization are not migrated. The definition template supplies the card fields.
procedure HasUpgradablePermanentCards {
  pure = true
  parameters = { owner = Ref(Player) }
  result = Bool
  body = {
    return = {
      value = exists(where(collection(RunDeck), candidate, and(equal(field(candidate, Card.Owner), field(owner, Player.Owner)), and(field(candidate, Card.CanUpgrade), not(field(candidate, Card.Upgraded))))))
    }
  }
}
procedure ObtainPermanentCard {
  parameters = {
    owner = Ref(Player) definition = String(length = 64) cost = Int(min = 0, max = 9)
    targeted = Bool exhausts = Bool leavesPlay = Bool
  }
  locals = { card = Binding }
  body = {
    if = {
      condition = not(and(equal(field(owner, Player.Room), "none"), and(not(field(owner, Player.CombatActive)), greater(field(owner, Player.Hp), 0))))
      then = { fail = { message = "Development permanent acquisition requires a living player outside a room and combat" } }
    }
    create = {
      type = Card scope = entityScope(owner) into = card collection = RunDeck
      fields = {
        Owner = field(owner, Player.Owner) DefinitionId = definition Label = definition Cost = cost
        CanUpgrade = true Targeted = targeted Exhausts = exhausts LeavesPlay = leavesPlay
      }
    }
    set = { target = owner field = Player.UsesRunDeck value = true }
    emit = { event = CardObtained payload = { owner = owner card = card } }
  }
}

# The next combat cleans up all the owner's old non-permanent cards, including generated and exhausted
# cards, before creating new copies. Nothing is copied back. Initial sorting/shuffling and automatic draw
# remain unsupported: copies enter DrawPile in permanent order and Draw is still an explicit action.
procedure BuildCombatDeck {
  parameters = { owner = Ref(Player) }
  locals = { copy = Binding }
  body = {
    if = {
      condition = field(owner, Player.UsesRunDeck)
      then = {
        forEach = {
          query = where(type(Card), candidate, and(equal(field(candidate, Card.Owner), field(owner, Player.Owner)), less(collectionIndex(RunDeck, candidate), 0)))
          item = previous
          body = { destroy = { target = previous } }
        }
        forEach = {
          query = where(collection(RunDeck), candidate, equal(field(candidate, Card.Owner), field(owner, Player.Owner)))
          item = permanent
          body = {
            create = {
              type = Card scope = entityScope(owner) into = copy collection = DrawPile
              fields = {
                Owner = field(owner, Player.Owner) DefinitionId = field(permanent, Card.DefinitionId)
                Label = field(permanent, Card.Label) Cost = field(permanent, Card.Cost)
                Upgraded = field(permanent, Card.Upgraded) CanUpgrade = field(permanent, Card.CanUpgrade)
                Targeted = field(permanent, Card.Targeted) Exhausts = field(permanent, Card.Exhausts)
                LeavesPlay = field(permanent, Card.LeavesPlay) PermanentSource = permanent
              }
            }
          }
        }
      }
    }
  }
}
