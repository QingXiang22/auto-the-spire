}

# Flagged single-target attack (Spite.cs): the hit count depends on a per-turn history flag. Flag values are
# "lost-hp" (LostHpThisTurn) and "exhausted-card" (ExhaustedCardThisTurn); both reset at turn start.
template FlaggedHitsAttackEffect {
  parameters = {
    definition = { type = String(length = 64) }
    damage = { type = Int(min = 0, max = 999) }
    upgradedDamage = { type = Int(min = 0, max = 999) }
    hits = { type = Int(min = 1, max = 9) }
    flaggedHits = { type = Int(min = 1, max = 9) }
    upgradedFlaggedHits = { type = Int(min = 1, max = 9) }
    flag = { type = String(length = 32) }
  }
  body = {
    procedure WhenPlayedOnTarget {
      parameters = { owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }
      locals = { amount = Int count = Int flagged = Bool }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedDamage) } }
              else = { let = { into = amount value = arg(damage) } }
            }
            if = {
              condition = equal(arg(flag), "lost-hp")
              then = { let = { into = flagged value = field(owner, Player.LostHpThisTurn) } }
              else = { let = { into = flagged value = field(owner, Player.ExhaustedCardThisTurn) } }
            }
            if = {
              condition = flagged
              then = {
                if = {
                  condition = field(card, Card.Upgraded)
                  then = { let = { into = count value = arg(upgradedFlaggedHits) } }
                  else = { let = { into = count value = arg(flaggedHits) } }
                }
              }
              else = { let = { into = count value = arg(hits) } }
            }
            repeat = {
              count = count
              body = { call = { procedure = DamageEnemyPowered args = { target = target amount = amount } } }
            }
          }
        }
      }
    }
    subscription OnCardPlayedOnTarget { event = CardPlayedOnTarget reaction = WhenPlayedOnTarget }
  }
}
# Flagged block (EvilEye.cs): gains its block once, or twice when the flag is set.
template FlaggedBlockMultiplierEffect {
  parameters = {
    definition = { type = String(length = 64) }
    block = { type = Int(min = 0, max = 999) }
    upgradedBlock = { type = Int(min = 0, max = 999) }
    flag = { type = String(length = 32) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int flagged = Bool }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedBlock) } }
              else = { let = { into = amount value = arg(block) } }
            }
            if = {
              condition = equal(arg(flag), "lost-hp")
              then = { let = { into = flagged value = field(owner, Player.LostHpThisTurn) } }
              else = { let = { into = flagged value = field(owner, Player.ExhaustedCardThisTurn) } }
            }
            if = {
              condition = flagged
              then = { call = { procedure = GainBlock args = { owner = owner amount = multiply(amount, 2) } } }
              else = { call = { procedure = GainBlock args = { owner = owner amount = amount } } }
            }
          }
        }
      }
    }
    subscription OnCardPlayed { event = CardPlayed reaction = WhenPlayed }
  }
}

# Single-target attack whose hit count depends on the target already being Vulnerable (Dismantle.cs):
# one hit normally, vulnerableHits when the target holds a damage-taken-multiplier power.
template VulnerableHitsAttackEffect {
  parameters = {
    definition = { type = String(length = 64) }
    damage = { type = Int(min = 0, max = 999) }
    upgradedDamage = { type = Int(min = 0, max = 999) }
    hits = { type = Int(min = 1, max = 9) }
    vulnerableHits = { type = Int(min = 1, max = 9) }
  }
  body = {
    procedure WhenPlayedOnTarget {
      parameters = { owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }
      locals = { amount = Int count = Int vulnerable = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedDamage) } }
              else = { let = { into = amount value = arg(damage) } }
            }
            let = {
              into = vulnerable
              value = aggregate(where(collection(Powers), power, and(equal(field(power, Power.Kind), "damage-taken-multiplier"), equal(field(power, Power.HolderEnemy), target))), Sum, power, field(power, Power.Stacks))
            }
            if = {
              condition = greater(vulnerable, 0)
              then = { let = { into = count value = arg(vulnerableHits) } }
              else = { let = { into = count value = arg(hits) } }
            }
            repeat = {
              count = count
              body = { call = { procedure = DamageEnemyPowered args = { target = target amount = amount } } }
            }
          }
        }
      }
    }
    subscription OnCardPlayedOnTarget { event = CardPlayedOnTarget reaction = WhenPlayedOnTarget }
  }
}
# Applies the target's current Vulnerable stacks again (MoltenFist.cs), doubling them. It runs after the
# card's own damage because the content file declares the attack effect first.
template AmplifyVulnerableEffect {
  parameters = { definition = { type = String(length = 64) } }
  body = {
    procedure WhenPlayedOnTarget {
      parameters = { owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }
      locals = { vulnerable = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            let = {
              into = vulnerable
              value = aggregate(where(collection(Powers), power, and(equal(field(power, Power.Kind), "damage-taken-multiplier"), equal(field(power, Power.HolderEnemy), target))), Sum, power, field(power, Power.Stacks))
            }
            if = {
              condition = greater(vulnerable, 0)
              then = {
                call = { procedure = ApplyEnemyPower args = { target = target definition = "base-spire:vulnerable-power" kind = "damage-taken-multiplier" stacks = vulnerable } }
              }
            }
          }
        }
      }
    }
    subscription OnCardPlayedOnTarget { event = CardPlayedOnTarget reaction = WhenPlayedOnTarget }
  }
}

# Self buff whose lifetime is the current turn (FlameBarrier.cs FlameBarrierPower). It expires after the
# enemy phase so the retaliation still applies during the enemies' attacks.
template ApplySelfPowerUntilTurnEndEffect {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    kind = { type = String(length = 32) }
    stacks = { type = Int(min = 1, max = 999) }
    upgradedStacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedStacks) } }
              else = { let = { into = amount value = arg(stacks) } }
            }
            call = { procedure = ApplyPlayerPowerUntilTurnEnd args = { owner = owner definition = arg(power) kind = arg(kind) stacks = amount } }
          }
        }
      }
    }
    subscription OnCardPlayed { event = CardPlayed reaction = WhenPlayed }
  }
}
