using namespace base-spire;
dsl_version = "core/0.3"

# Composable card effect templates. A content file combines one CardDefinition with the effects it needs;
# every effect filters on Card.DefinitionId, so several effects can share one card.
# Targeted effects subscribe to CardPlayedOnTarget, which PlayAttackCard emits after CardPlayed, matching
# the source order where a card gains block before it deals damage (IronWave.cs OnPlay).
template AttackEffect {
  parameters = {
    definition = { type = String(length = 64) }
    hits = { type = Int(min = 1, max = 9) }
  }
  body = {
    procedure WhenPlayedOnTarget {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            let = { into = amount value = pureCall(CardBaseDamage, owner, card, target) }
            call = { procedure = CardAttack args = { owner = owner card = card play = play target = target amount = amount hits = arg(hits) mode = "single" dynamic = false } }
          }
        }
      }
    }

  }
}
template BlockEffect {
  parameters = {
    definition = { type = String(length = 64) }
    block = { type = Int(min = 0, max = 999) }
    upgradedBlock = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedBlock) } }
              else = { let = { into = amount value = arg(block) } }
            }
            call = { procedure = GainBlock args = { owner = owner amount = amount } }
          }
        }
      }
    }

  }
}
template DrawEffect {
  parameters = {
    definition = { type = String(length = 64) }
    cards = { type = Int(min = 0, max = 9) }
    upgradedCards = { type = Int(min = 0, max = 9) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedCards) } }
              else = { let = { into = amount value = arg(cards) } }
            }
            call = { procedure = DrawCards args = { owner = owner count = amount } }
          }
        }
      }
    }

  }
}
# BodySlam.cs: CalculatedDamageVar(ValueProp.Move).WithMultiplier(card => card.Owner.Creature.Block),
# so the damage equals the player's block when the card resolves.
# Anger.cs: after the attack, a clone of the played card is added to the discard pile. The clone keeps the
# upgraded state and is a combat-only card; permanent deck copies are not migrated.
# Shared "gain energy" card effect (Bloodletting.cs, Offering.cs). GainEnergy does not clamp to MaxEnergy.
template EnergyEffect {
  parameters = {
    definition = { type = String(length = 64) }
    energy = { type = Int(min = 0, max = 9) }
    upgradedEnergy = { type = Int(min = 0, max = 9) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedEnergy) } }
              else = { let = { into = amount value = arg(energy) } }
            }
            call = { procedure = GainEnergy args = { owner = owner amount = amount } }
          }
        }
      }
    }

  }
}
# AoE attack effect for cards that hit every enemy (Thunderclap.cs, Breakthrough.cs, Conflagration.cs). It
# watches the untargeted CardPlayed event and resolves each hit separately on every hittable development
# target, so block absorbs per target. hits and upgradedHits allow the upgrade to add hits instead of damage.
template AttackAllEnemiesEffect {
  parameters = {
    definition = { type = String(length = 64) }
    hits = { type = Int(min = 1, max = 9) }
    upgradedHits = { type = Int(min = 1, max = 9) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int count = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {

            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = count value = arg(upgradedHits) } }
              else = { let = { into = count value = arg(hits) } }
            }
            call = { procedure = CardAttack args = { owner = owner card = card play = play target = none amount = 0 hits = count mode = "all" dynamic = true } }
          }
        }
      }
    }

  }
}
# Shared debuff effect for single-target cards (Bash.cs, Uppercut.cs). It subscribes to the same event as
# AttackEffect, so a content file that declares the attack effect first keeps the source order of
# "deal damage, then apply the power" (listeners run in declaration order).
template ApplyEnemyPowerEffect {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    stacks = { type = Int(min = 1, max = 999) }
    upgradedStacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenPlayedOnTarget {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedStacks) } }
              else = { let = { into = amount value = arg(stacks) } }
            }
            call = { procedure = ApplyEnemyPowerFromCard args = { card = card play = play owner = owner  target = target definition = arg(power) stacks = amount } }
          }
        }
      }
    }

  }
}
# Shared debuff effect for cards that hit every enemy (Shockwave.cs). Death and escaped enemies are not
# migrated, so "hittable" is the development target with Hp above zero.
template ApplyAllEnemiesPowerEffect {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    stacks = { type = Int(min = 1, max = 999) }
    upgradedStacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedStacks) } }
              else = { let = { into = amount value = arg(stacks) } }
            }
            forEach = {
              query = where(type(Enemy), enemy, pureCall(EnemyIsActive, enemy)) item = enemy
              body = { call = { procedure = ApplyEnemyPowerFromCard args = { card = card play = play owner = owner  target = enemy definition = arg(power) stacks = amount } } }
            }
          }
        }
      }
    }

  }
}
# Shared self-buff effect for cards that power the player up (Flex.cs, Inflame.cs). No migrated card uses it
# yet, so Strength and Dexterity are exercised by explicit development probes.
template ApplySelfPowerEffect {
  parameters = {
    definition = { type = String(length = 64) }
    power = { type = String(length = 64) }
    stacks = { type = Int(min = 1, max = 999) }
    upgradedStacks = { type = Int(min = 1, max = 999) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedStacks) } }
              else = { let = { into = amount value = arg(stacks) } }
            }
            call = { procedure = ApplyPlayerPowerFromCard args = { card = card play = play  owner = owner definition = arg(power) stacks = amount } }
          }
        }
      }
    }

  }
}
template LoseHpEffect {
  parameters = {
    definition = { type = String(length = 64) }
    hp = { type = Int(min = 0, max = 999) }
    upgradedHp = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenPlayed {
      parameters = { play = Binding  owner = Ref(Player) card = Ref(Card) }
      locals = { amount = Int }
      body = {
        if = {
          condition = equal(field(card, Card.DefinitionId), arg(definition))
          then = {
            if = {
              condition = field(card, Card.Upgraded)
              then = { let = { into = amount value = arg(upgradedHp) } }
              else = { let = { into = amount value = arg(hp) } }
            }
            call = { procedure = LosePlayerHpFromCard args = { card = card play = play  owner = owner amount = amount } }
          }
        }
      }
    }

  }
}

# Flagged single-target attack (Spite.cs): the hit count depends on a per-turn history flag. Flag values are
# "lost-hp" (LostHpThisTurn) and "exhausted-card" (ExhaustedCardThisTurn); both reset at turn start.
# Flagged block (EvilEye.cs): gains its block once, or twice when the flag is set.

# Single-target attack whose hit count depends on the target already being Vulnerable (Dismantle.cs):
# one hit normally, vulnerableHits when the target holds a damage-taken-multiplier power.
# Applies the target's current Vulnerable stacks again (MoltenFist.cs), doubling them. It runs after the
# card's own damage because the content file declares the attack effect first.

# Self buff whose lifetime is the current turn (FlameBarrier.cs FlameBarrierPower). It expires after the
# enemy phase so the retaliation still applies during the enemies' attacks.
