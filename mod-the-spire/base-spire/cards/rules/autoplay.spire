using namespace base-spire;
dsl_version = "core/0.3"

entity AutoPlayBatch { fields = { Owner = { type = Ref(Player) visibility = Hidden } Play = { type = Ref(CardPlayRecord) optional = true visibility = Hidden } } }
entity AutoPlayEntry { fields = { Batch = { type = Ref(AutoPlayBatch) visibility = Hidden } Card = { type = Ref(Card) visibility = Hidden } } }

# Source CardPileCmd.AutoPlayFromDrawPile first collects/moves all selected cards, then executes them.
# Entries belong to a particular batch so nested autoplays cannot consume the parent's remaining cards.
procedure AutoPlayFromDrawPile {
  parameters = { owner = Ref(Player) play = Binding count = Int forceExhaust = Bool }
  locals = { batch = Binding next = Binding entry = Binding }
  body = {
    if = { condition = pureCall(CombatIsEnding) then = { return = {} } }
    create = { type = AutoPlayBatch scope = entityScope(owner) into = batch fields = { Owner = owner Play = play } }
    repeat = { count = maximum(0, count) body = {
      call = { procedure = ReshuffleDiscard args = { owner = owner } }
      let = { into = next value = first(collection(DrawPile)) }
      if = { condition = not(isNone(next)) then = {
        if = { condition = not(pureCall(ExecuteCardBody.Contains, field(next, Card.DefinitionId))) then = { fail = { message = "Unsupported card in autoplay batch" } } }
        removeFromCollection = { collection = DrawPile item = next }
        addToCollection = { collection = InPlay item = next }
        create = { type = AutoPlayEntry scope = entityScope(batch) into = entry fields = { Batch = batch Card = next } }
      } }
    } }
    forEach = { query = where(type(AutoPlayEntry), e, equal(field(e, AutoPlayEntry.Batch), batch)) item = item body = {
      let = { into = next value = field(item, AutoPlayEntry.Card) }
      if = { condition = greater(field(owner, Player.Hp), 0) then = {
        set = { target = next field = Card.ForceExhaust value = forceExhaust }
        # Source assigns the flag even when ending; preloaded cards then remain in Play.
        if = { condition = not(pureCall(CombatIsEnding)) then = {
          call = { procedure = ResolveAutoCard args = { owner = owner card = next forceExhaust = forceExhaust prepared = true } }
        } }
      } }
      destroy = { target = item }
    } }
    destroy = { target = batch }
  }
}

procedure AutoPlayExhaustedCards {
  parameters = { owner = Ref(Player) definition = String(length = 64) forceExhaust = Bool }
  body = {
    forEach = { query = where(collection(ExhaustPile), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), equal(field(c, Card.DefinitionId), definition))) item = c body = {
      call = { procedure = AutoPlayCard args = { owner = owner card = c forceExhaust = forceExhaust } }
    } }
  }
}
