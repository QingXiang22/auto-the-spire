using namespace base-spire;
dsl_version = "core/0.3"

procedure EnsureManualCardPlayable {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  body = {
    if = { condition = not(pureCall(ExecuteCardBody.Contains, field(card, Card.DefinitionId))) then = { fail = { message = "Unknown card body" } } }
    if = { condition = not(pureCall(CardPlayAllowed, owner, card, false)) then = { fail = { message = "Card play is blocked by its keyword or a listener" } } }
    if = { condition = not(and(field(owner, Player.CombatActive), field(owner, Player.TurnOpen))) then = { fail = { message = "Development combat turn is not active" } } }
    if = { condition = or(less(collectionIndex(Hand, card), 0), not(equal(field(card, Card.Owner), field(owner, Player.Owner)))) then = { fail = { message = "Card is not in the owner's hand" } } }
    if = { condition = less(field(owner, Player.Energy), pureCall(GetCardEnergyCost, owner, card)) then = { fail = { message = "Not enough energy to play the card" } } }
  }
}
procedure FinishCardPlay {
  parameters = { owner = Ref(Player) card = Ref(Card) resultPile = String(length = 16) }
  body = {
    if = { condition = greaterOrEqual(collectionIndex(InPlay, card), 0) then = {
      if = { condition = equal(resultPile, "exhaust") then = {
        call = { procedure = ExhaustCombatCard args = { owner = owner card = card causedByEthereal = false } }
      } else = {
        call = { procedure = MoveCombatCardWithoutNotification args = { owner = owner card = card to = resultPile } }
      } }
    } }
    call = { procedure = CheckForEmptyHand args = { owner = owner } }
    call = { procedure = ExpireCardCostModifiers args = { card = card boundary = "play" } }
  }
}
# Capture resources once, move synchronously, pay, resolve location/count callbacks, then execute each play.
procedure ResolveCardEffects {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding auto = Bool spendResources = Bool forceExhaust = Bool }
  locals = { preparation = Binding record = Binding previousRecord = Binding previousCard = Binding count = Int index = Int number = Int rawX = Int energyValue = Int paidEnergy = Int resultPile = String(length = 16) stopped = Bool }
  body = {
    let = { into = previousRecord value = field(owner, Player.CurrentPlay) }
    let = { into = previousCard value = field(owner, Player.CurrentCard) }
    let = { into = energyValue value = maximum(0, pureCall(GetCardEnergyCost, owner, card)) }
    let = { into = rawX value = 0 }
    if = { condition = field(card, Card.IsX) then = { let = { into = rawX value = energyValue } } }
    let = { into = paidEnergy value = 0 }
    if = { condition = spendResources then = { let = { into = paidEnergy value = minimum(energyValue, field(owner, Player.Energy)) } } }
    set = { target = owner field = Player.PlayDepth value = add(field(owner, Player.PlayDepth), 1) }
    set = { target = card field = Card.PaidX value = rawX }
    call = { procedure = MoveCombatCardWithoutNotification args = { owner = owner card = card to = "play" } }
    if = { condition = spendResources then = { set = { target = owner field = Player.Energy value = subtract(field(owner, Player.Energy), paidEnergy) } } }
    if = { condition = greater(paidEnergy, 0) then = { emit = { event = AfterEnergySpent payload = { owner = owner card = card amount = paidEnergy } } } }
    call = { procedure = PrepareCardPlay args = { owner = owner card = card target = target auto = auto paidEnergy = paidEnergy energyValue = energyValue rawX = rawX forceExhaust = forceExhaust } into = preparation }
    let = { into = count value = field(preparation, CardPlayPreparation.Count) }
    let = { into = resultPile value = field(preparation, CardPlayPreparation.ResultPile) }
    let = { into = index value = 0 }
    let = { into = stopped value = false }
    set = { target = owner field = Player.CardActionNumber value = add(field(owner, Player.CardActionNumber), 1) }
    let = { into = number value = field(owner, Player.CardActionNumber) }
    set = { target = owner field = Player.EffectDepth value = add(field(owner, Player.EffectDepth), 1) }
    repeat = { count = maximum(0, count) body = {
      if = { condition = not(stopped) then = {
        set = { target = owner field = Player.PlaySequence value = add(field(owner, Player.PlaySequence), 1) }
        create = { type = CardPlayRecord scope = entityScope(owner) into = record collection = CardPlays fields = {
          Owner = field(owner, Player.Owner) Card = card Kind = field(card, Card.Kind)
          Turn = field(owner, Player.TurnNumber) EnemyPhase = field(owner, Player.EnemyPhase) Sequence = field(owner, Player.PlaySequence)
          ActionNumber = number ParentPlay = previousRecord Target = target IsAutoPlay = auto
          PaidEnergy = paidEnergy RawX = rawX ResultPile = resultPile PlayIndex = index PlayCount = count
        } }
        set = { target = owner field = Player.CurrentPlay value = record }
        set = { target = owner field = Player.CurrentCard value = card }
        emit = { event = BeforeCardPlayed payload = { owner = owner card = card } }
        emit = { event = BeforeCardExecution payload = { owner = owner card = card play = record } }
        set = { target = record field = CardPlayRecord.Started value = true }
        call = { procedure = ExecuteCardBody args = { key = field(card, Card.DefinitionId) owner = owner card = card target = target play = record } }
        emit = { event = ExecuteCardEnchantment payload = { owner = owner card = card play = record } }
        emit = { event = ExecuteCardAffliction payload = { owner = owner card = card play = record } }
        set = { target = record field = CardPlayRecord.Finished value = true }
        emit = { event = AfterCardExecution payload = { owner = owner card = card play = record } }
        emit = { event = AfterCardPlayed payload = { owner = owner card = card } }
        if = { condition = lessOrEqual(field(owner, Player.Hp), 0) then = { let = { into = stopped value = true } } }
      } }
      let = { into = index value = add(index, 1) }
    } }
    set = { target = owner field = Player.EffectDepth value = subtract(field(owner, Player.EffectDepth), 1) }
    call = { procedure = FinishCardPlay args = { owner = owner card = card resultPile = resultPile } }
    call = { procedure = ClearCardPlayPreparation args = { preparation = preparation } }
    set = { target = owner field = Player.CurrentPlay value = previousRecord }
    set = { target = owner field = Player.CurrentCard value = previousCard }
    set = { target = owner field = Player.PlayDepth value = subtract(field(owner, Player.PlayDepth), 1) }
    call = { procedure = CheckCombatVictory args = { owner = owner } }
  }
}
procedure ResolvePaidCard {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding }
  body = {
    call = { procedure = EnsureManualCardPlayable args = { owner = owner card = card } }
    if = { condition = and(field(card, Card.Targeted), isNone(target)) then = { fail = { message = "A targeted card requires a living enemy" } } }
    if = { condition = not(isNone(target)) then = { if = { condition = not(pureCall(EnemyIsActive, target)) then = { fail = { message = "Target is no longer alive" } } } } }
    call = { procedure = ResolveCardEffects args = { owner = owner card = card target = target auto = false spendResources = true forceExhaust = false } }
  }
}
procedure ResolveAutoCard {
  parameters = { owner = Ref(Player) card = Ref(Card) forceExhaust = Bool prepared = Bool }
  locals = { target = Binding }
  body = {
    if = { condition = not(pureCall(ExecuteCardBody.Contains, field(card, Card.DefinitionId))) then = { fail = { message = "Unknown card body" } } }
    if = { condition = and(field(owner, Player.CombatActive), and(greater(field(owner, Player.Hp), 0), exists(where(type(Enemy), e, pureCall(EnemyIsActive, e))))) then = {
      if = { condition = or(greaterOrEqual(collectionIndex(RunDeck, card), 0), and(not(prepared), greaterOrEqual(collectionIndex(InPlay, card), 0))) then = { fail = { message = "Cannot autoplay a permanent or already resolving card" } } }
      if = { condition = or(not(equal(field(card, Card.Owner), field(owner, Player.Owner))), not(or(greaterOrEqual(collectionIndex(Hand, card), 0), or(greaterOrEqual(collectionIndex(DrawPile, card), 0), or(greaterOrEqual(collectionIndex(DiscardPile, card), 0), or(greaterOrEqual(collectionIndex(ExhaustPile, card), 0), and(prepared, greaterOrEqual(collectionIndex(InPlay, card), 0)))))))) then = { fail = { message = "Autoplay requires an owned hand, draw, discard or exhausted card" } } }
      if = { condition = not(pureCall(CardPlayAllowed, owner, card, true)) then = {
        call = { procedure = MoveCombatCardWithoutNotification args = { owner = owner card = card to = "play" } }
        # A refused autoplay has no play preparation, result modifiers or until-played cleanup.
        # Source MoveToResultPileWithoutPlaying ignores Power type and retains the one-shot flag.
        if = { condition = or(forceExhaust, or(field(card, Card.ForceExhaust), pureCall(CardHasKeyword, card, "exhaust"))) then = {
          call = { procedure = ExhaustCombatCard args = { owner = owner card = card causedByEthereal = false } }
        } else = {
          call = { procedure = MoveCombatCardWithoutNotification args = { owner = owner card = card to = "discard" } }
        } }
        return = { }
      } }
      let = { into = target value = none }
      if = { condition = field(card, Card.Targeted) then = { call = { procedure = RandomLivingEnemy into = target } } }
      call = { procedure = ResolveCardEffects args = { owner = owner card = card target = target auto = true spendResources = false forceExhaust = forceExhaust } }
    } }
  }
}
procedure AutoPlayCard {
  parameters = { owner = Ref(Player) card = Ref(Card) forceExhaust = Bool }
  body = { call = { procedure = ResolveAutoCard args = { owner = owner card = card forceExhaust = forceExhaust prepared = false } } }
}

procedure PlayCard {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  body = {
    if = { condition = field(card, Card.Targeted) then = { fail = { message = "Use a targeted card play operation" } } }
    call = { procedure = ResolvePaidCard args = { owner = owner card = card target = none } }
  }
}
# Compatibility entry for existing development scripts; clients may explicitly select any living target.
procedure PlayAttackCard {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  body = { call = { procedure = ResolvePaidCard args = { owner = owner card = card target = first(sort(where(type(Enemy), e, pureCall(EnemyIsActive, e)), e, field(e, Enemy.SpawnOrder))) } } }
}
procedure PlayTargetedCard {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  locals = { target = Binding }
  body = {
    call = { procedure = EnsureManualCardPlayable args = { owner = owner card = card } }
    if = { condition = not(field(card, Card.Targeted)) then = { fail = { message = "This card does not select an enemy" } } }
    if = { condition = not(exists(where(type(Enemy), e, pureCall(EnemyIsActive, e)))) then = { fail = { message = "No living target" } } }
    decide = { participant = field(owner, Player.Owner) kind = EntityRef prompt = "Choose the target" into = target min = 1 max = 1 candidates = sort(where(type(Enemy), e, pureCall(EnemyIsActive, e)), e, field(e, Enemy.SpawnOrder)) }
    call = { procedure = ResolvePaidCard args = { owner = owner card = card target = target } }
  }
}
procedure UpgradeCard {
  parameters = { card = Ref(Card) }
  body = {
    if = { condition = or(not(field(card, Card.CanUpgrade)), field(card, Card.Upgraded)) then = { fail = { message = "The card cannot be upgraded" } } }
    set = { target = card field = Card.Upgraded value = true }
    emit = { event = CardUpgraded payload = { card = card } }
  }
}
action PlayCardFromHand {
  role = player parameters = { card = Ref(Card) }
  candidates = { parameter = card query = where(collection(Hand), c, not(field(c, Card.Targeted))) }
  requires = and(pureCall(CardPlayAllowed, first(type(Player)), card, false), and(and(field(first(type(Player)), Player.CombatActive), field(first(type(Player)), Player.TurnOpen)), greaterOrEqual(field(first(type(Player)), Player.Energy), pureCall(GetCardEnergyCost, first(type(Player)), card))))
  body = { call = { procedure = PlayCard args = { owner = first(type(Player)) card = card } } }
}
action PlayAttackFromHand {
  role = player parameters = { card = Ref(Card) }
  candidates = { parameter = card query = where(collection(Hand), c, field(c, Card.Targeted)) }
  requires = and(pureCall(CardPlayAllowed, first(type(Player)), card, false), and(and(field(first(type(Player)), Player.CombatActive), field(first(type(Player)), Player.TurnOpen)), and(greaterOrEqual(field(first(type(Player)), Player.Energy), pureCall(GetCardEnergyCost, first(type(Player)), card)), exists(where(type(Enemy), e, pureCall(EnemyIsActive, e))))))
  body = { call = { procedure = PlayAttackCard args = { owner = first(type(Player)) card = card } } }
}
action PlayTargetedCard {
  role = player parameters = { card = Ref(Card) }
  candidates = { parameter = card query = where(collection(Hand), c, field(c, Card.Targeted)) }
  requires = and(pureCall(CardPlayAllowed, first(type(Player)), card, false), and(and(field(first(type(Player)), Player.CombatActive), field(first(type(Player)), Player.TurnOpen)), and(greaterOrEqual(field(first(type(Player)), Player.Energy), pureCall(GetCardEnergyCost, first(type(Player)), card)), exists(where(type(Enemy), e, pureCall(EnemyIsActive, e))))))
  body = { call = { procedure = PlayTargetedCard args = { owner = first(type(Player)) card = card } } }
}
action UpgradeCardInHand {
  role = player
  requires = pureCall(CanUseDevelopmentActions, first(type(Player))) parameters = { card = Ref(Card) }
  candidates = { parameter = card query = where(collection(Hand), c, and(field(c, Card.CanUpgrade), not(field(c, Card.Upgraded)))) }
  body = { call = { procedure = UpgradeCard args = { card = card } } }
}
procedure WhenCardExhausted {
  parameters = { owner = Ref(Player) card = Ref(Card) causedByEthereal = Bool }
  body = { set = { target = owner field = Player.ExhaustedCardThisTurn value = true } }
}
subscription OnCardExhausted { event = CardExhausted reaction = WhenCardExhausted }
