using namespace base-spire;
dsl_version = "core/0.3"

procedure PlayerPowerAmount {
  pure = true parameters = { owner = Ref(Player) kind = String(length = 32) } result = Int
  body = { return = { value = aggregate(where(collection(Powers), p, and(equal(field(p, Power.HolderPlayer), owner), equal(field(p, Power.Kind), kind))), Sum, p, field(p, Power.Stacks)) } }
}
procedure EnemyPowerAmount {
  pure = true parameters = { target = Ref(Enemy) kind = String(length = 32) } result = Int
  body = { return = { value = aggregate(where(collection(Powers), p, and(equal(field(p, Power.HolderEnemy), target), equal(field(p, Power.Kind), kind))), Sum, p, field(p, Power.Stacks)) } }
}
procedure GetCardEnergyCost {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) } result = Int
  body = {
    if = { condition = field(card, Card.IsX) then = { return = { value = field(owner, Player.Energy) } } }
    return = { value = foldEvent(ModifyCardCost, field(card, Card.Cost), owner, card) }
  }
}
procedure ResolveEnergyXValue {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) } result = Int
  body = {
    if = { condition = not(field(card, Card.IsX)) then = { return = { value = 0 } } }
    return = { value = foldEvent(ModifyXValue, field(card, Card.PaidX), owner, card) }
  }
}
procedure RemoveFromCombatPiles {
  parameters = { card = Ref(Card) }
  body = {
    if = { condition = greaterOrEqual(collectionIndex(Hand, card), 0) then = { removeFromCollection = { collection = Hand item = card } } }
    if = { condition = greaterOrEqual(collectionIndex(DrawPile, card), 0) then = { removeFromCollection = { collection = DrawPile item = card } } }
    if = { condition = greaterOrEqual(collectionIndex(DiscardPile, card), 0) then = { removeFromCollection = { collection = DiscardPile item = card } } }
    if = { condition = greaterOrEqual(collectionIndex(InPlay, card), 0) then = { removeFromCollection = { collection = InPlay item = card } } }
    if = { condition = greaterOrEqual(collectionIndex(ExhaustPile, card), 0) then = { removeFromCollection = { collection = ExhaustPile item = card } } }
    if = { condition = greaterOrEqual(collectionIndex(RemovedFromCombat, card), 0) then = { removeFromCollection = { collection = RemovedFromCombat item = card } } }
  }
}
procedure ExhaustCombatCard {
  parameters = { owner = Ref(Player) card = Ref(Card) }
  body = {
    if = {
      condition = or(greaterOrEqual(collectionIndex(RunDeck, card), 0), or(greaterOrEqual(collectionIndex(ExhaustPile, card), 0), not(equal(field(card, Card.Owner), field(owner, Player.Owner)))))
      then = { fail = { message = "Only an owned non-exhausted combat card may be exhausted" } }
    }
    if = { condition = not(or(or(greaterOrEqual(collectionIndex(Hand, card), 0), greaterOrEqual(collectionIndex(DrawPile, card), 0)), or(greaterOrEqual(collectionIndex(DiscardPile, card), 0), greaterOrEqual(collectionIndex(InPlay, card), 0)))) then = { fail = { message = "Exhaust requires a card in an active combat pile" } } }
    call = { procedure = RemoveFromCombatPiles args = { card = card } }
    addToCollection = { collection = ExhaustPile item = card }
    emit = { event = CardExhausted payload = { owner = owner card = card } }
  }
}
procedure SelectHandCard {
  parameters = { owner = Ref(Player) upgradeOnly = Bool }
  locals = { selected = Binding } result = Binding
  body = {
    let = { into = selected value = first(where(collection(Hand), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), or(not(upgradeOnly), and(field(c, Card.CanUpgrade), not(field(c, Card.Upgraded))))))) }
    if = {
      condition = greater(count(where(collection(Hand), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), or(not(upgradeOnly), and(field(c, Card.CanUpgrade), not(field(c, Card.Upgraded))))))), 1)
      then = { decide = { participant = field(owner, Player.Owner) kind = EntityRef prompt = "Choose a card in hand" into = selected min = 1 max = 1 candidates = where(collection(Hand), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), or(not(upgradeOnly), and(field(c, Card.CanUpgrade), not(field(c, Card.Upgraded)))))) } }
    }
    return = { value = selected }
  }
}
procedure SelectDiscardCard {
  parameters = { owner = Ref(Player) } locals = { selected = Binding } result = Binding
  body = {
    let = { into = selected value = first(where(collection(DiscardPile), c, equal(field(c, Card.Owner), field(owner, Player.Owner)))) }
    if = { condition = greater(count(where(collection(DiscardPile), c, equal(field(c, Card.Owner), field(owner, Player.Owner)))), 1) then = { decide = { participant = field(owner, Player.Owner) kind = EntityRef prompt = "Choose a card from the discard pile" into = selected min = 1 max = 1 candidates = where(collection(DiscardPile), c, equal(field(c, Card.Owner), field(owner, Player.Owner))) } } }
    return = { value = selected }
  }
}
procedure ResetCardTurnCosts {
  body = {
    forEach = { query = where(type(Card), c, field(c, Card.CostResetAtTurnEnd)) item = card body = {
      set = { target = card field = Card.Cost value = field(card, Card.BaseCost) }
      set = { target = card field = Card.CostResetAtTurnEnd value = false }
      set = { target = card field = Card.FreeUntilPlayed value = false }
      set = { target = card field = Card.TurnCostDiscount value = 0 }
    } }
  }
}
procedure ClearCardPlayHistory {
  parameters = { owner = Ref(Player) }
  body = {
    set = { target = owner field = Player.CurrentPlay value = none }
    set = { target = owner field = Player.CurrentCard value = none }
    set = { target = owner field = Player.LastDrawn value = none }
    set = { target = owner field = Player.HpLossCount value = 0 }
    set = { target = owner field = Player.PlaySequence value = 0 }
    forEach = { query = collection(CardPlays) item = record body = { destroy = { target = record } } }
  }
}
procedure AttacksPlayedThisTurn {
  pure = true parameters = { owner = Ref(Player) } result = Int
  body = { return = { value = count(where(collection(CardPlays), r, and(equal(field(r, CardPlayRecord.Owner), field(owner, Player.Owner)), and(equal(field(r, CardPlayRecord.Kind), "attack"), equal(field(r, CardPlayRecord.Turn), field(owner, Player.TurnNumber)))))) } }
}

procedure CreateCardInstance {
  parameters = { owner = Ref(Player) definition = String(length = 64) }
  locals = { card = Binding } result = Binding
  body = {
    if = { condition = not(exists(where(collection(CardLibrary), b, equal(field(b, CardBlueprint.DefinitionId), definition)))) then = { fail = { message = "unsupported_capability: card definition is not executable in this package" } } }
    create = { type = Card scope = entityScope(owner) into = card fields = { Owner = field(owner, Player.Owner) DefinitionId = definition Label = definition } }
    emit = { event = CardCreated payload = { card = card } }
    return = { value = card }
  }
}
procedure CreateCombatCard {
  parameters = { owner = Ref(Player) definition = String(length = 64) }
  locals = { card = Binding } result = Binding
  body = {
    call = { procedure = CreateCardInstance args = { owner = owner definition = definition } into = card }
    emit = { event = CardEnteredCombat payload = { owner = owner card = card clone = false } }
    return = { value = card }
  }
}
procedure CloneCombatCard {
  parameters = { owner = Ref(Player) source = Ref(Card) }
  locals = { copy = Binding } result = Binding
  body = {
    create = { type = Card scope = entityScope(owner) into = copy fields = {
      Owner = field(owner, Player.Owner) DefinitionId = field(source, Card.DefinitionId) Label = field(source, Card.Label)
      Kind = field(source, Card.Kind) StrikeTag = field(source, Card.StrikeTag) IsX = field(source, Card.IsX)
      Rarity = field(source, Card.Rarity)
      SourceEntry = field(source, Card.SourceEntry)
      Cost = field(source, Card.Cost) BaseCost = field(source, Card.BaseCost) CostResetAtTurnEnd = field(source, Card.CostResetAtTurnEnd)
      FreeUntilPlayed = field(source, Card.FreeUntilPlayed) TurnCostDiscount = field(source, Card.TurnCostDiscount)
      BaseDamage = field(source, Card.BaseDamage) DamageGrowth = field(source, Card.DamageGrowth)
      DamageScale = field(source, Card.DamageScale) DamageFactor = field(source, Card.DamageFactor)
      DiscountsOnAttack = field(source, Card.DiscountsOnAttack) Innate = field(source, Card.Innate)
      AutoFromExhaustAtTurnEnd = field(source, Card.AutoFromExhaustAtTurnEnd)
      Targeted = field(source, Card.Targeted) Exhausts = field(source, Card.Exhausts) LeavesPlay = field(source, Card.LeavesPlay)
      Upgraded = field(source, Card.Upgraded) CanUpgrade = field(source, Card.CanUpgrade)
    } }
    emit = { event = CardEnteredCombat payload = { owner = owner card = copy clone = true } }
    return = { value = copy }
  }
}
procedure AddGeneratedToHand {
  parameters = { card = Ref(Card) }
  body = { if = { condition = less(count(collection(Hand)), 10) then = { addToCollection = { collection = Hand item = card } } else = { addToCollection = { collection = DiscardPile item = card } } } }
}
procedure CardBaseDamage {
  pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int
  locals = { amount = Int units = Int }
  body = {
    let = { into = amount value = add(field(card, Card.BaseDamage), field(card, Card.DamageGrowth)) }
    let = { into = units value = 0 }
    if = { condition = equal(field(card, Card.DamageScale), "exhaust-count") then = { let = { into = units value = count(collection(ExhaustPile)) } } }
    if = { condition = equal(field(card, Card.DamageScale), "strike-count") then = {
      let = { into = units value = count(where(type(Card), c, and(and(field(c, Card.StrikeTag), equal(field(c, Card.Owner), field(owner, Player.Owner))), and(less(collectionIndex(RunDeck, c), 0), less(collectionIndex(RemovedFromCombat, c), 0))))) }
    } }
    if = { condition = and(equal(field(card, Card.DamageScale), "vulnerable-count"), not(isNone(target))) then = { let = { into = units value = pureCall(EnemyPowerAmount, target, "damage-taken-multiplier") } } }
    if = { condition = equal(field(card, Card.DamageScale), "block") then = { return = { value = field(owner, Player.Block) } } }
    return = { value = add(amount, multiply(units, field(card, Card.DamageFactor))) }
  }
}
procedure ReducePower {
  parameters = { owner = Ref(Player) kind = String(length = 32) }
  locals = { p = Binding }
  body = {
    let = { into = p value = first(where(collection(Powers), q, and(equal(field(q, Power.HolderPlayer), owner), equal(field(q, Power.Kind), kind)))) }
    if = { condition = not(isNone(p)) then = {
      set = { target = p field = Power.Stacks value = subtract(field(p, Power.Stacks), 1) }
      if = { condition = lessOrEqual(field(p, Power.Stacks), 0) then = { destroy = { target = p } } }
    } }
  }
}
procedure RandomHandCard {
  parameters = { owner = Ref(Player) attacksOnly = Bool } locals = { picked = Binding } result = Binding
  body = {
    let = { into = picked value = none }
    if = { condition = exists(where(collection(Hand), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), or(not(attacksOnly), equal(field(c, Card.Kind), "attack"))))) then = {
      samplePick = { stream = "base-spire:run:combat_card_selection" candidates = where(collection(Hand), c, and(equal(field(c, Card.Owner), field(owner, Player.Owner)), or(not(attacksOnly), equal(field(c, Card.Kind), "attack")))) into = picked }
    } }
    return = { value = picked }
  }
}
procedure RandomLivingEnemy {
  locals = { target = Binding } result = Binding
  body = {
    let = { into = target value = none }
    if = { condition = exists(where(type(Enemy), e, greater(field(e, Enemy.Hp), 0))) then = {
      samplePick = { stream = "base-spire:run:combat_targets" candidates = where(type(Enemy), e, greater(field(e, Enemy.Hp), 0)) into = target }
    } }
    return = { value = target }
  }
}
procedure StompEntered {
  parameters = { owner = Ref(Player) card = Ref(Card) clone = Bool }
  body = { if = { condition = and(field(card, Card.DiscountsOnAttack), not(clone)) then = {
    set = { target = card field = Card.TurnCostDiscount value = count(where(collection(CardPlays), r, and(equal(field(r, CardPlayRecord.Turn), field(owner, Player.TurnNumber)), and(equal(field(r, CardPlayRecord.Kind), "attack"), field(r, CardPlayRecord.Finished))))) }
    set = { target = card field = Card.Cost value = maximum(0, subtract(field(card, Card.Cost), field(card, Card.TurnCostDiscount))) }
    set = { target = card field = Card.CostResetAtTurnEnd value = true }
  } } }
}
subscription StompEntered { event = CardEnteredCombat reaction = StompEntered }
