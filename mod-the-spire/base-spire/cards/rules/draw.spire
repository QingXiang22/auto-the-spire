using namespace base-spire;
dsl_version = "core/0.3"

# Source StableShuffle sorts by ModelId.Entry and upgrade level before Fisher-Yates.
procedure SourceCardSortKey {
  pure = true parameters = { card = Ref(Card) } result = String(length = 128)
  body = {
    if = { condition = field(card, Card.Upgraded) then = { return = { value = concat(field(card, Card.SourceEntry), ":1") } } }
    return = { value = concat(field(card, Card.SourceEntry), ":0") }
  }
}
procedure ReshuffleDiscard {
  parameters = { owner = Ref(Player) }
  body = {
    if = {
      condition = and(not(exists(collection(DrawPile))), exists(collection(DiscardPile)))
      then = {
        forEach = {
          query = sort(collection(DiscardPile), c, pureCall(SourceCardSortKey, c), false, false) item = card
          body = {
            removeFromCollection = { collection = DiscardPile item = card }
            addToCollection = { collection = DrawPile item = card }
          }
        }
        shuffle = { collection = DrawPile stream = "base-spire:run:shuffle" }
        emit = { event = AfterShuffle payload = { owner = owner } }
      }
    }
  }
}
procedure CanDrawCards {
  pure = true parameters = { owner = Ref(Player) fromHandDraw = Bool } result = Bool
  body = {
    if = { condition = not(field(owner, Player.CombatActive)) then = { return = { value = true } } }
    return = { value = foldEvent(ShouldDraw, true, owner, fromHandDraw) }
  }
}
procedure RefreshDrawPermissions {
  body = { forEach = { query = type(Player) item = owner body = {
    set = { target = owner field = Player.DrawBlocked value = not(pureCall(CanDrawCards, owner, false)) }
  } } }
}
# Internal next-card step; the complete Draw command checks ShouldDraw once before its loop.
procedure DrawNextCard {
  parameters = { owner = Ref(Player) fromHandDraw = Bool }
  locals = { drawn = Binding }
  body = {
    set = { target = owner field = Player.LastDrawn value = none }
    if = { condition = not(pureCall(CanExecuteCombatCommand, owner)) then = { return = {} } }
    if = {
      condition = less(count(collection(Hand)), 10)
      then = {
        call = { procedure = ReshuffleDiscard args = { owner = owner } }
        if = { condition = or(not(pureCall(CanExecuteCombatCommand, owner)), greaterOrEqual(count(collection(Hand)), 10)) then = { return = {} } }
        let = { into = drawn value = first(collection(DrawPile)) }
        if = {
          condition = not(isNone(drawn))
          then = {
            call = { procedure = MoveCombatCardWithoutNotification args = { owner = owner card = drawn to = "hand" } }
            set = { target = owner field = Player.LastDrawn value = drawn }
            emit = {
              event = AfterCardDrawnEarly payload = { owner = owner card = drawn } }
            if = { condition = not(pureCall(CombatIsOverOrEnding)) then = { emit = { event = AfterCardDrawn payload = { owner = owner card = drawn } } } }
            set = { target = owner field = Player.LastDrawn value = drawn }
          }
        }
      }
    }
  }
}
procedure DrawOne {
  parameters = { owner = Ref(Player) fromHandDraw = Bool }
  body = { call = { procedure = DrawCardsWithSource args = { owner = owner count = 1 fromHandDraw = fromHandDraw } } }
}
action Draw {
  role = player
  requires = pureCall(CanUseDevelopmentActions, first(type(Player)))
  body = { call = { procedure = DrawOne args = { owner = first(type(Player)) fromHandDraw = false } } }
}
# Shared source Draw command: permission at entry, then live capacity/ending checks per card.
procedure DrawCards {
  parameters = { owner = Ref(Player) count = Int(min = 0) }
  body = { call = { procedure = DrawCardsWithSource args = { owner = owner count = count fromHandDraw = false } } }
}
procedure DrawCardsWithSource {
  parameters = { owner = Ref(Player) count = Int(min = 0) fromHandDraw = Bool }
  body = {
    if = { condition = or(not(pureCall(CanExecuteCombatCommand, owner)), not(pureCall(CanDrawCards, owner, fromHandDraw))) then = {
      set = { target = owner field = Player.LastDrawn value = none }
      return = {}
    } }
    repeat = {
      count = count
      body = {
        if = { condition = or(greaterOrEqual(count(collection(Hand)), 10), not(pureCall(CanExecuteCombatCommand, owner))) then = { return = {} } }
        call = { procedure = DrawNextCard args = { owner = owner fromHandDraw = fromHandDraw } }
        if = { condition = isNone(field(owner, Player.LastDrawn)) then = { return = {} } }
      }
    }
  }
}
action DiscardHand {
  role = player
  requires = pureCall(CanUseDevelopmentActions, first(type(Player)))
  body = {
    forEach = {
      query = collection(Hand) item = card
      body = {
        call = { procedure = DiscardCombatCard args = { owner = first(type(Player)) card = card } }
      }
    }
  }
}

# Source CombatManager: first-turn Innate cards move to the top in traversal order,
# then the ordinary draw path runs before AfterPlayerTurnStart. Enchant bottom-order is unsupported.
procedure DrawDevelopmentTurnHand {
  parameters = { owner = Ref(Player) }
  locals = { amount = Int }
  body = {
    let = { into = amount value = foldEvent(ModifyTurnDraw, field(owner, Player.AutoDrawPerTurn), owner) }
    if = { condition = equal(field(owner, Player.TurnNumber), 1) then = {
        let = { into = amount value = minimum(10, maximum(amount, count(where(collection(DrawPile), card, pureCall(CardHasKeyword, card, "innate"))))) }
      forEach = {
        query = where(collection(DrawPile), card, pureCall(CardHasKeyword, card, "innate")) item = innate
        body = {
          removeFromCollection = { collection = DrawPile item = innate }
          addToCollection = { collection = DrawPile item = innate position = Start }
        }
      }
    } }
    call = { procedure = DrawCardsWithSource args = { owner = owner count = amount fromHandDraw = true } }
  }
}
