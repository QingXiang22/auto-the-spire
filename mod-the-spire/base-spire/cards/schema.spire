using namespace base-spire;
dsl_version = "core/0.3"

entity Card {
  owner = Owner
  fields = {
    Owner = { type = Participant default = participant(1) }
    Label = { type = String(length = 64) default = "development-card" }
    # Runtime definition identity; source rarity and complete pool identity remain in the static catalog.
    DefinitionId = { type = String(length = 64) default = "base-spire:development-card" }
    Cost = { type = Int(min = -1, max = 9) default = 0 }
    Upgraded = { type = Bool default = false }
    # Only migrated definitions implement a single source upgrade; development placeholders do not.
    CanUpgrade = { type = Bool default = false }
    Kind = { type = String(length = 16) default = "skill" }
    Rarity = { type = String(length = 16) default = "none" }
    SourceEntry = { type = String(length = 64) default = "DEVELOPMENT_CARD" }
    StrikeTag = { type = Bool default = false }
    IsX = { type = Bool default = false }
    # Captured energy X; effect bonuses are queried separately through ResolveEnergyXValue.
    PaidX = { type = Int(min = 0, max = 999) default = 0 }
    BaseCost = { type = Int(min = -1, max = 9) default = 0 }
    ForceExhaust = { type = Bool default = false visibility = Hidden }
    DamageGrowth = { type = Int(min = 0, max = 999999) default = 0 }
    BaseDamage = { type = Int(min = 0, max = 999) default = 0 }
    Innate = { type = Bool default = false }
    PermanentSource = { type = Ref(Card) optional = true visibility = Hidden }
    # Development stand-in for vanilla TargetType: targeted cards need an enemy and are played by PlayAttackFromHand.
    Targeted = { type = Bool default = false }
    # Vanilla CardKeyword.Exhaust: the card goes to the exhaust pile instead of the discard pile after resolving.
    Exhausts = { type = Bool default = false }
    # Vanilla CardType.Power: the card leaves play entirely after resolving (see RemovedFromCombat).
    LeavesPlay = { type = Bool default = false }
  }
}
collection RunDeck { element = Card ordered = true }
event CardObtained { payload = { owner = Ref(Player) card = Ref(Card) } }
event AfterCardPlayed { payload = { owner = Ref(Player) card = Ref(Card) } }
event BeforeCardPlayed { payload = { owner = Ref(Player) card = Ref(Card) } }
entity CardPlayRecord {
  owner = Owner
  fields = {
    Owner = { type = Participant default = participant(1) }
    Card = { type = Ref(Card) visibility = Hidden }
    Kind = { type = String(length = 16) }
    Turn = { type = Int }
    EnemyPhase = { type = Bool default = false visibility = Hidden }
    Sequence = { type = Int }
    ActionNumber = { type = Int visibility = Hidden }
    ParentPlay = { type = Ref(CardPlayRecord) optional = true visibility = Hidden }
    Target = { type = Ref(Enemy) optional = true visibility = Hidden }
    IsAutoPlay = { type = Bool default = false visibility = Hidden }
    PaidEnergy = { type = Int default = 0 visibility = Hidden }
    RawX = { type = Int default = 0 visibility = Hidden }
    ResultPile = { type = String(length = 16) visibility = Hidden }
    PlayIndex = { type = Int default = 0 visibility = Hidden }
    PlayCount = { type = Int default = 1 visibility = Hidden }
    Started = { type = Bool default = false visibility = Hidden }
    Finished = { type = Bool default = false }
    # Positive modified gains with Move and this play, including Unpowered|Move.
    PoweredBlocks = { type = Int default = 0 }
  }
}
collection CardPlays { element = CardPlayRecord ordered = true }
dispatch ExecuteCardBody {
  parameters = { owner = Ref(Player) card = Ref(Card) target = Binding play = Ref(CardPlayRecord) }
}
event BeforeCardExecution { payload = { owner = Ref(Player) card = Ref(Card) play = Ref(CardPlayRecord) } }
event AfterCardExecution { payload = { owner = Ref(Player) card = Ref(Card) play = Ref(CardPlayRecord) } }
event ExecuteCardEnchantment { payload = { owner = Ref(Player) card = Ref(Card) play = Ref(CardPlayRecord) } }
event ExecuteCardAffliction { payload = { owner = Ref(Player) card = Ref(Card) play = Ref(CardPlayRecord) } }
collection Hand { element = Card capacity = 10 ordered = true }
collection DrawPile { element = Card ordered = true identity_visible = false order_visible = false }
collection DiscardPile { element = Card ordered = true }
# Cards being resolved, including every repetition; separate CardPlayRecord entities preserve play history.
collection InPlay { element = Card ordered = true }
# Exhausted combat cards, moved here before CardExhausted listeners run.
collection ExhaustPile { element = Card ordered = true }
# Resolved Power instances remain here until the next combat rebuild. RunDeck keeps permanent instances
# separately; putting a combat copy here must never move or overwrite its permanent source.
collection RemovedFromCombat { element = Card ordered = true }
event AfterShuffle { payload = { owner = Ref(Player) } }
event AfterCardDrawn { payload = { owner = Ref(Player) card = Ref(Card) } }
# CardPlayed is for effects that need no chosen target (vanilla TargetType.Self and similar).
event CardPlayed { payload = { owner = Ref(Player) card = Ref(Card) } }
# CardPlayedOnTarget carries the resolved enemy for single-target attack cards.
event CardPlayedOnTarget { payload = { owner = Ref(Player) card = Ref(Card) target = Ref(Enemy) } }
# Emitted after an instance is marked upgraded, so a card definition can apply definition-level upgrades.
event CardUpgraded { payload = { card = Ref(Card) } }
# Emitted when a resolving card with CardKeyword.Exhaust reaches the exhaust pile.
event CardExhausted { payload = { owner = Ref(Player) card = Ref(Card) causedByEthereal = Bool } }

event CardCreated { payload = { card = Ref(Card) } }
event CardEnteredCombat { payload = { owner = Ref(Player) card = Ref(Card) clone = Bool } }
entity CardBlueprint {
  fields = {
    DefinitionId = { type = String(length = 64) }
    Kind = { type = String(length = 16) }
    Rarity = { type = String(length = 16) default = "none" }
    InIroncladPool = { type = Bool default = false }
    Generatable = { type = Bool default = false }
  }
}
collection CardLibrary { element = CardBlueprint ordered = true }

dispatch ReadCardDamage { pure = true parameters = { owner = Ref(Player) card = Ref(Card) target = Binding } result = Int }

event CardCloned { payload = { owner = Ref(Player) source = Ref(Card) card = Ref(Card) } }
event CardCombatCopied { payload = { owner = Ref(Player) source = Ref(Card) card = Ref(Card) } }
event CardRemoving { payload = { card = Ref(Card) } }
