using namespace base-spire;
dsl_version = "core/0.3"

projection PlayerView {
  role = player
  types = { Player = {} Run = {} MapNode = {} RunVisit = {} NeowVisit = {} Card = {} CardAttachment = { identity_from = Card } Relic = {} Enemy = {} Power = {} Potion = {} CombatRewardSet = {} EventVisit = {} }
  collections = true
  relations = true
}
