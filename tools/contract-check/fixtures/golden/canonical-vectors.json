{
  "canonical_version": "net-wire-canon-v1",
  "note": "每个 expect_sha256 由独立的 .NET SHA256 对 expect_text 的 UTF-8 字节计算：canonical-v1..v5 / identity-* 的字节经 base64 传入（fixtures/golden/_hash-vectors-b64.ps1，由 _gen_hash_vectors.py 从手写文本生成），避免非 ASCII 字面量被错误解码。2026-10-01 首版 PowerShell 脚本用非 ASCII 字面量直接计算，canonical-v3/v5 的摘要被错误解码污染，已由 base64 版本与 Get-FileHash 双重确认后修正。",
  "canonical": [
    {
      "id": "canonical-v1",
      "document": {"b": 1, "a": [true, null, "x"]},
      "expect_text": "{\"a\":[true,null,\"x\"],\"b\":1}",
      "expect_sha256": "sha256:54a65415ad370228851a1da4b31b6fd42dc58b19a50d35cae759325f7388ce64",
      "digest_tool": ".NET SHA256 (PowerShell)"
    },
    {
      "id": "canonical-v2",
      "document": {"s": "a\"b\\c\nd\te\u0001f"},
      "expect_text": "{\"s\":\"a\\\"b\\\\c\\nd\\te\\u0001f\"}",
      "expect_sha256": "sha256:58a6f3f7e956012dfe12e838b3c0e7eed1f2a90082a78bc86271b358d4ae0a50",
      "digest_tool": ".NET SHA256 (PowerShell)",
      "covers": "引号/反斜线转义、\\b\\t\\n\\f\\r 常用转义、其余控制字符小写 \\u00xx"
    },
    {
      "id": "canonical-v3",
      "document": {"z": 2, "\u00e9": 1},
      "expect_text": "{\"z\":2,\"\u00e9\":1}",
      "expect_sha256": "sha256:ebf5b3ac2125f90b74510656202151eacb0fa0dcdf14105494181e8969b802d5",
      "digest_tool": ".NET SHA256 (PowerShell)",
      "covers": "对象键按 UTF-8 字节序排序（z 0x7A 在 é 0xC3A9 之前），非 ASCII 不做转义"
    },
    {
      "id": "canonical-v4",
      "document": {"n": -12, "big": 9007199254740991, "o": {}, "a": []},
      "expect_text": "{\"a\":[],\"big\":9007199254740991,\"n\":-12,\"o\":{}}",
      "expect_sha256": "sha256:fd534d7740e0cbdb8e01249f3352a08ccfbbd0d8757548ce8cb2ad659448a145",
      "digest_tool": ".NET SHA256 (PowerShell)",
      "covers": "结构整数最短十进制、空对象/空数组、紧凑无空白"
    },
    {
      "id": "canonical-v5",
      "document": {"slash": "a/b", "text": "\u4e2d\u6587"},
      "expect_text": "{\"slash\":\"a/b\",\"text\":\"\u4e2d\u6587\"}",
      "expect_sha256": "sha256:331df54e6733c4e38a304db14d6f488781ee327c2e4dc19af0ad482dc0c14ddf",
      "digest_tool": ".NET SHA256 (PowerShell)",
      "covers": "不转义 /，保留原 Unicode 且不做归一化"
    }
  ],
  "canonical_reject": [
    {
      "id": "float-literal",
      "document": {"n": 1.0},
      "expect_error": "wire 不含浮点字面量"
    },
    {
      "id": "lone-surrogate",
      "document": {"s": "\ud800"},
      "expect_error": "不合法 Unicode"
    }
  ],
  "decimal": [
    {"id": "plus-leading-zeros", "source": "+0012.5000", "expect": "12.5"},
    {"id": "negative-zero", "source": "-0.000", "expect": "0"},
    {"id": "zero", "source": "0.000", "expect": "0"},
    {"id": "exponent-positive", "source": "1e2", "expect": "100"},
    {"id": "exponent-negative", "source": "1E-3", "expect": "0.001"},
    {"id": "integer-source", "source": 1000, "expect": "1000"},
    {"id": "negative-fraction", "source": "-0.5", "expect": "-0.5"},
    {"id": "leading-zeros", "source": "007", "expect": "7"},
    {"id": "already-canonical", "source": "12.5", "expect": "12.5"},
    {"id": "trailing-zeros", "source": "12.500", "expect": "12.5"}
  ],
  "decimal_accept": ["0", "12.5", "-0.5", "-1", "0.0001", "10", "9007199254740991", "-0.0001"],
  "decimal_reject": [
    "-0",
    "1.0",
    "01",
    "+1",
    "1e2",
    " 1",
    "1 ",
    "0.50",
    "--1",
    ".5",
    "1.",
    "",
    "1,5",
    "NaN",
    "Infinity",
    "00.5",
    "-"
  ],
