    {
      "case_id": "neg-number-value-json-float",
      "description": "精确数值必须是字符串，JSON 浮点字面量在 L0 拒绝",
      "expect": "reject",
      "layers": [
        "L0",
        "L1",
        "L3"
      ],
      "rule_ids": [
        "I-91"
      ],
      "raw_documents": {
        "snapshot": "{\"protocol_version\":\"0.1\",\"ruleset_id\":\"demo:rules-v1\",\"catalog_id\":\"demo:catalog-v1\",\"backend_profile_id\":\"demo:public-v1\",\"session_id\":\"session-A\",\"observation_id\":3,\"status\":\"decision\",\"terminal_result\":null,\"entities\":[{\"instance_id\":\"player-A\",\"kind_id\":\"demo:player\",\"content_state\":\"not_applicable\",\"fields\":[{\"field_id\":\"demo:hp\",\"state\":\"known\",\"value\":45.5}]}],\"relations\":[],\"piles\":[],\"sequences\":[],\"groups\":[],\"legal_actions\":[{\"candidate_id\":\"a1\",\"action_type\":\"demo:end_turn\",\"fields\":[]}]}"
      }
    },
