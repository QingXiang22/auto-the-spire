    },
    {
      "case_id": "neg-seed-exponent",
      "description": "seed 不接受指数与空白",
      "expect": "reject",
      "layers": ["L1", "L4"],
      "rule_ids": ["I-66", "I-76"],
      "documents": {
        "request": {
          "request_id": "r-start-exp",
          "operation": "start",
          "payload": {
            "expected_identity": {"protocol_version": "0.1", "ruleset_id": "demo:rules-v1", "catalog_id": "demo:catalog-v1", "backend_profile_id": "demo:public-v1"},
