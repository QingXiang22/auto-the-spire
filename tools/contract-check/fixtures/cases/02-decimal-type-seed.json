    {
      "case_id": "neg-seed-when-unsupported",
      "description": "protocol L50/L185：后端不支持指定 seed 必须在执行前拒绝",
      "expect": "reject",
      "layers": ["L1", "L4"],
      "rule_ids": ["I-11"],
      "documents": {
        "capabilities": {"$base": "capabilities-demo", "$set": {"seed_control": false}},
        "request": {
          "request_id": "r-start-unsupported",
          "operation": "start",
          "payload": {
            "expected_identity": {"protocol_version": "0.1", "ruleset_id": "demo:rules-v1", "catalog_id": "demo:catalog-v1", "backend_profile_id": "demo:public-v1"},
