            "seed": "1e2"
          }
        }
      }
    },
    {
      "case_id": "neg-seed-negative",
      "description": "seed 是无符号 64 位十进制字符串",
      "expect": "reject",
      "layers": ["L1", "L4"],
      "rule_ids": ["I-66", "I-76"],
      "documents": {
        "request": {
          "request_id": "r-start-neg",
          "operation": "start",
          "payload": {
            "expected_identity": {"protocol_version": "0.1", "ruleset_id": "demo:rules-v1", "catalog_id": "demo:catalog-v1", "backend_profile_id": "demo:public-v1"},
            "scenario_profile": "demo:profile-v1",
            "seed": "-1"
          }
        }
      }
    },
    {
      "case_id": "neg-seed-whitespace",
      "description": "seed 不接受空白",
      "expect": "reject",
      "layers": ["L1", "L4"],
      "rule_ids": ["I-66", "I-76"],
      "documents": {
        "request": {
          "request_id": "r-start-ws",
          "operation": "start",
          "payload": {
            "expected_identity": {"protocol_version": "0.1", "ruleset_id": "demo:rules-v1", "catalog_id": "demo:catalog-v1", "backend_profile_id": "demo:public-v1"},
