          "payload": {
            "expected_identity": {"protocol_version": "0.1", "ruleset_id": "demo:rules-v1", "catalog_id": "demo:catalog-v1", "backend_profile_id": "demo:public-v1"},
            "scenario_profile": "demo:profile-v1",
            "seed": 5
          }
        }
      }
    },
    {
      "case_id": "neg-seed-plus-sign",
      "description": "seed 不接受符号",
