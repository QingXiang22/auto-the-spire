package base-spire {
  power PossessStrengthPower {
    variables = [variable(StolenStrength, 0)]
    trigger = afterOwnerDeath
    effect = applyScaledPower(Strength, 0, 1,
      count=powerVariable(PossessStrengthPower, StolenStrength, target=self), target=player)
  }

  power PossessDexterityPower {
    variables = [variable(StolenDexterity, 0)]
    trigger = afterOwnerDeath
    effect = applyScaledPower(Dexterity, 0, 1,
      count=powerVariable(PossessDexterityPower, StolenDexterity, target=self), target=player)
  }

  enemy TheLost {
    hp = variants(default=range(93, 93), tough=range(99, 99))
    startingPowers = [power(PossessStrengthPower, 1)]
    moves = actions(
      theLostDebilitatingSmog = sequence(
        applyPower(Strength, -2, target=player),
        applyPower(Strength, 2, target=self),
        modifyPowerVariable(PossessStrengthPower, StolenStrength, 2)
      ),
      theLostEyeLasers = repeat(2, attack(variants(default=4, deadly=5), target=player))
    )
    behavior = cycle(theLostDebilitatingSmog, theLostEyeLasers)
  }

  enemy TheForgotten {
    hp = variants(default=range(106, 106), tough=range(111, 111))
    startingPowers = [power(PossessDexterityPower, 1)]
    moves = actions(
      theForgottenMiasma = sequence(
        applyPower(Dexterity, -2, target=player),
        gainBlock(8, target=self),
        applyPower(Dexterity, 2, target=self),
        modifyPowerVariable(PossessDexterityPower, StolenDexterity, 2)
      ),
      theForgottenDread = scaledAttack(variants(default=13, deadly=15), 1,
        count=targetPowerAmount(Dexterity, target=self), target=player)
    )
    behavior = cycle(theForgottenMiasma, theForgottenDread)
  }
}
