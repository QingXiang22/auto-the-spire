using namespace base-spire;
dsl_version = "core/0.3"

# EnergyNextTurnPower.AfterEnergyReset: attempt gain, then remove even if gain is prevented.
procedure GrantDeferredEnergy {
  parameters = { owner = Ref(Player) power = Ref(Power) amount = Int }
  body = {
    call = { procedure = HostGainDeferredEnergy args = { owner = owner amount = amount } }
    destroy = { target = power }
  }
}
