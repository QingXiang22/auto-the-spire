+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Cards;
+using Sts2Sim.Core.Models.Characters;
+using Sts2Sim.Core.Models.Enchantments;
+using Sts2Sim.Core.Runs;
+using Sts2Sim.Core.Tests.Models.Cards;
+
+namespace Sts2Sim.Core.Tests.Models.Enchantments;
+
+[Collection("ModelDb")]
+public sealed class SlumberingEssenceTests : IDisposable
+{
+    public SlumberingEssenceTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    [Theory]
+    [InlineData(PileType.Hand, true, 0)]
+    [InlineData(PileType.Hand, false, 1)]
+    [InlineData(PileType.Draw, true, 1)]
+    public async Task BeforeFlush_ReducesCostOnlyForTheOwnersHandCard(
+        PileType pile, bool flushedPlayerOwnsCard, int expectedCost)
+    {
+        var run = new RunState($"task-slumbering-{pile}-{flushedPlayerOwnsCard}", new Overgrowth());
+        Player owner = Player.CreateForNewRun(ModelDb.Character<Regent>(), run);
+        Player other = Player.CreateForNewRun(ModelDb.Character<Silent>(), run);
+        run.AddPlayer(owner);
+        run.AddPlayer(other);
+        var combatState = new CombatState(run);
+        foreach (Player player in run.Players)
+        {
+            player.ResetCombatState();
+            combatState.AddPlayerCreature(player.Creature);
+        }
+
+        var card = (StrikeRegent)ModelDb.Card<StrikeRegent>().MutableClone();
+        card.AssignOwner(owner);
+        CardPileCmd.Add(card, pile);
+        await CardCmd.Enchant<SlumberingEssence>(card, 1m);
+        Assert.Equal(1, card.EnergyCost);
+
+        await Hook.BeforeFlush(combatState, flushedPlayerOwnsCard ? owner : other);
+
+        Assert.Equal(expectedCost, card.EnergyCost);
+    }
+
+    [Fact]
+    public async Task BeforeFlush_CostModifierExpiresWhenTheCardIsPlayed()
+    {
+        (var player, var room) = await Task11CombatTestSupport.CreateCombatAsync("task-slumbering-played");
+        StrikeRegent card = Task11CombatTestSupport.AddToHand<StrikeRegent>(player);
+        await CardCmd.Enchant<SlumberingEssence>(card, 1m);
+        await Hook.BeforeFlush(room.Engine.State, player);
+        Assert.Equal(0, card.EnergyCost);
+
+        await room.Engine.PlayCardAsync(player, card, room.Engine.State.HittableEnemies.Single());
+
+        // 原版是 WhenPlayed 过期的本地修饰符（CardEnergyCost.AddUntilPlayed），打出后应被清掉。
+        Assert.Equal(1, card.EnergyCost);
+    }
+}
