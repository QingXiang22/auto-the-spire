--- /dev/null
+++ b/tests/Sts2Sim.Core.Tests/Models/Enchantments/NutritiousSoupTests.cs
@@ -0,0 +1,71 @@
+using Sts2Sim.Core.Commands;
+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Content.Acts;
+using Sts2Sim.Core.Entities.Cards;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Cards;
+using Sts2Sim.Core.Models.Characters;
+using Sts2Sim.Core.Models.Enchantments;
+using Sts2Sim.Core.Models.Relics;
+using Sts2Sim.Core.Runs;
+
+namespace Sts2Sim.Core.Tests.Models.Enchantments;
+
+[Collection("ModelDb")]
+public sealed class NutritiousSoupTests : IDisposable
+{
+    public NutritiousSoupTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    [Fact]
+    public async Task AfterObtained_EnchantsExactlyTheEnchantableBasicStrikeCards()
+    {
+        var run = new RunState("task-nutritious-soup", new Overgrowth());
+        Player player = Player.CreateForNewRun(ModelDb.Character<Regent>(), run);
+        run.AddPlayer(player);
+        foreach (CardModel starter in player.Deck.Cards.ToArray())
+        {
+            CardPileCmd.Remove(starter);
+        }
+
+        CardModel basicStrikeA = await AddToDeck<StrikeRegent>(player);
+        CardModel basicStrikeB = await AddToDeck<StrikeRegent>(player);
+        CardModel commonStrike = await AddToDeck<BlightStrike>(player);
+        CardModel basicDefend = await AddToDeck<DefendRegent>(player);
+        CardModel alreadyEnchantedStrike = await AddToDeck<StrikeIronclad>(player);
+        await CardCmd.Enchant<Glam>(alreadyEnchantedStrike, 1m);
+        var relic = (NutritiousSoup)ModelDb.Relic<NutritiousSoup>().MutableClone();
+        relic.AssignOwner(player);
+
+        await relic.AfterObtained();
+
+        foreach (CardModel enchanted in new[] { basicStrikeA, basicStrikeB })
+        {
+            Assert.IsType<TezcatarasEmber>(Assert.Single(enchanted.Enchantments));
+            Assert.Equal(0, enchanted.EnergyCost);
+            Assert.True(enchanted.HasKeyword(CardKeyword.Eternal));
+        }
+
+        // 非 Basic、非 Strike、以及已被别的附魔占据的卡都不能被再次附魔。
+        Assert.Empty(commonStrike.Enchantments);
+        Assert.Equal(1, commonStrike.EnergyCost);
+        Assert.Empty(basicDefend.Enchantments);
+        Assert.Equal(1, basicDefend.EnergyCost);
+        Assert.IsType<Glam>(Assert.Single(alreadyEnchantedStrike.Enchantments));
+        Assert.Equal(1, alreadyEnchantedStrike.EnergyCost);
+    }
+
+    private static async Task<CardModel> AddToDeck<TCard>(Player player) where TCard : CardModel
+    {
+        var card = (CardModel)ModelDb.Card<TCard>().MutableClone();
+        card.AssignOwner(player);
+        await CardPileCmd.AddToDeck(card);
+        return card;
+    }
+}
