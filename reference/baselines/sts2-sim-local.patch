+using Sts2Sim.Core.Commands;
+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Content.Acts;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Cards;
+using Sts2Sim.Core.Models.Characters;
+using Sts2Sim.Core.Models.Relics;
+using Sts2Sim.Core.Rewards;
+using Sts2Sim.Core.Rooms;
+using Sts2Sim.Core.Runs;
+
+namespace Sts2Sim.Core.Tests.Models.Relics;
+
+/// <summary>
+/// Driftwood 让每个卡牌奖励可以重掷一次。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Relics.Driftwood.TryModifyRewardsLate</c>、
+/// <c>MegaCrit.Sts2.Core.Rewards.CardReward.CanReroll</c>/<c>Reroll</c>、
+/// <c>MegaCrit.Sts2.Core.Entities.CardRewardAlternatives.CardRewardAlternative.Generate</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class DriftwoodTests : IDisposable
+{
+    public DriftwoodTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    private static (Player Player, RunState RunState) CreatePlayer(string seed)
+    {
+        var runState = new RunState(seed, new Overgrowth());
+        Player player = Player.CreateForNewRun(ModelDb.Character<Regent>(), runState);
+        runState.AddPlayer(player);
+        return (player, runState);
+    }
+
+    private static async Task<RewardsSet> GenerateMonsterRewardsAsync(Player player, RunState runState)
+    {
+        RewardsSet rewards = RewardsSet.GenerateFor(player, RoomType.Monster, runState);
+        // 走到卡牌槽位：金币与药水都是自动领取的。
+        await rewards.Gold.Take();
+        if (rewards.Potion is { IsResolved: false } potion)
+        {
+            await potion.Take();
+        }
+
+        return rewards;
+    }
+
+    [Fact]
+    public async Task Driftwood_MarksEveryCardRewardRerollable()
+    {
+        (Player withDriftwood, RunState withDriftwoodRun) = CreatePlayer("driftwood-yes");
+        await RelicCmd.Obtain(ModelDb.Relic<Driftwood>(), withDriftwood);
+        (Player without, RunState withoutRun) = CreatePlayer("driftwood-no");
+
+        RewardsSet marked = await GenerateMonsterRewardsAsync(withDriftwood, withDriftwoodRun);
+        RewardsSet plain = await GenerateMonsterRewardsAsync(without, withoutRun);
+
+        Assert.True(marked.Card.CanReroll);
+        Assert.False(plain.Card.CanReroll);
+    }
+
+    [Fact]
+    public async Task Driftwood_RerollOffersRerollCandidateAndKeepsTheRewardUnresolved()
+    {
+        (Player player, RunState runState) = CreatePlayer("driftwood-reroll");
+        await RelicCmd.Obtain(ModelDb.Relic<Driftwood>(), player);
+        RewardsSet rewards = await GenerateMonsterRewardsAsync(player, runState);
+        CardReward card = rewards.Card;
+
+        var choice = Assert.IsType<RewardDecisionClassification.Choice>(
+            RewardDecisionClassifier.Classify(rewards));
+        var reroll = Assert.IsType<RewardDecision.RerollCard>(
+            Assert.Single(choice.Candidates, candidate => candidate is RewardDecision.RerollCard));
+        Assert.Same(card, reroll.Reward);
+
+        CardModel[] before = card.Options.ToArray();
+        reroll.Reward.Reroll();
+
+        // 重掷不结束这次奖励，而且只允许一次。
+        Assert.False(card.IsResolved);
+        Assert.False(card.CanReroll);
+        Assert.Null(card.SelectedOption);
+        Assert.Equal(3, card.Options.Count);
+        Assert.False(before.Select(option => option.Id).SequenceEqual(card.Options.Select(option => option.Id)),
+            "重掷之后必须是一套新的选项。");
+
+        var afterReroll = Assert.IsType<RewardDecisionClassification.Choice>(
+            RewardDecisionClassifier.Classify(rewards));
+        Assert.DoesNotContain(afterReroll.Candidates, candidate => candidate is RewardDecision.RerollCard);
+        Assert.Throws<InvalidOperationException>(card.Reroll);
+    }
+}
