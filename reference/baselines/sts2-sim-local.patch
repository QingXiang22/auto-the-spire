+
+namespace Sts2Sim.Core.Tests.Models.Enchantments;
+
+[Collection("ModelDb")]
+public sealed class TezcatarasEmberTests : IDisposable
+{
+    public TezcatarasEmberTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    [Theory]
+    [InlineData(false, 3)]
+    [InlineData(true, 2)]
+    public async Task Enchant_DropsBaseCostToZeroAndAddsEternal(bool upgraded, int costBeforeEnchant)
+    {
+        // Barricade：3 费，升级 ReduceEnergyCost(1)，即原版 _base 从 3 变为 2。
+        var card = (Barricade)ModelDb.Card<Barricade>().MutableClone();
+        if (upgraded) card.Upgrade();
+        Assert.Equal(costBeforeEnchant, card.EnergyCost);
+
+        await CardCmd.Enchant<TezcatarasEmber>(card, 1m);
+
+        Assert.Equal(0, card.EnergyCost);
+        Assert.Equal(0, card.LocalEnergyCost);
+        Assert.True(card.HasKeyword(CardKeyword.Eternal));
+        Assert.IsType<TezcatarasEmber>(Assert.Single(card.Enchantments));
+    }
+
+    [Theory]
+    [InlineData(ValueProp.Move, 3)]
+    [InlineData(ValueProp.Move | ValueProp.Unpowered, 0)]
+    [InlineData(ValueProp.Unblockable, 0)]
+    public async Task EnchantDamageAdditive_AddsThreeOnlyForPoweredAttacks(
+        ValueProp props, decimal expected)
+    {
+        var card = (StrikeRegent)ModelDb.Card<StrikeRegent>().MutableClone();
+        await CardCmd.Enchant<TezcatarasEmber>(card, 1m);
+        var ember = Assert.IsType<TezcatarasEmber>(card.Enchantments.Single());
+
+        Assert.Equal(expected, ember.EnchantDamageAdditive(6m, props));
+    }
+
+    [Fact]
+    public async Task EnchantedPoweredAttack_DealsThreeExtraDamageThroughTheCombatHook()
+    {
+        (var player, var room) = await Task11CombatTestSupport.CreateCombatAsync("task-ember-damage");
+        StrikeRegent card = Task11CombatTestSupport.AddToHand<StrikeRegent>(player);
+        await CardCmd.Enchant<TezcatarasEmber>(card, 1m);
+        var enemy = room.Engine.State.HittableEnemies.Single();
+        int hpBefore = enemy.CurrentHp;
+
+        await room.Engine.PlayCardAsync(player, card, enemy);
+
+        // StrikeRegent 6 点 + Tezcatara's Ember 的 3 点。
+        Assert.Equal(hpBefore - 9, enemy.CurrentHp);
+    }
+}
