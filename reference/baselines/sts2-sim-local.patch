+
 namespace Sts2Sim.Core.Models.Relics;
-/// <summary>Deviation #212: configured-character reward grid and arbitrary multi-select are not represented.</summary>
-public sealed class SeaGlass : RelicModel { public override RelicRarity Rarity => RelicRarity.Ancient; }
+
+/// <summary>
+/// 逐字移植 <c>MegaCrit.Sts2.Core.Models.Relics.SeaGlass</c>：拾取时从指定角色的卡池里，按
+/// Common/Uncommon/Rare 各抽 <c>Cards</c>/3 = 5 张（统一稀有度、不做稀有度与卡池修饰），
+/// 合成 15 张候选后让玩家任选若干张加入牌组。
+/// 偏离：原版的标题/<c>StringVar("Character")</c> 本地化文本与选择界面提示没有对应面；
+/// 选择本身走本引擎的 <c>ICardSelectionDecisionSource</c>（偏离 #92）。
+/// </summary>
+public class SeaGlass : RelicModel
+{
+    /// <summary>原版 <c>DynamicVars.Cards</c> 为 15，按 Common/Uncommon/Rare 三等分。</summary>
+    private const int TotalCards = 15;
+
+    private ModelId? _characterId;
+
+    public override RelicRarity Rarity => RelicRarity.Ancient;
+
+    public override bool HasUponPickupEffect => true;
+
+    public ModelId? CharacterId
+    {
+        get => _characterId;
+        set
+        {
+            AssertMutable();
+            _characterId = value;
+        }
+    }
+
+    private CharacterModel? Character =>
+        CharacterId is { } id ? ModelDb.GetByIdOrNull<CharacterModel>(id) : null;
+
+    public override async Task AfterObtained()
+    {
+        CharacterModel? character = Character;
+        if (character is null)
+        {
+            // 原版在这里记一条错误日志（可能来自控制台），并回落到 Ironclad。
+            CharacterId = ModelDb.Character<Ironclad>().Id;
+            character = ModelDb.Character<Ironclad>();
+        }
+
+        int cardCount = TotalCards / 3;
+        var cards = new List<CardModel>();
+        foreach (CardRarity rarity in new[] { CardRarity.Common, CardRarity.Uncommon, CardRarity.Rare })
+        {
+            CardCreationOptions options = CardCreationOptions
+                .ForNonCombatWithUniformOdds([character.CardPool], card => card.Rarity == rarity)
+                .WithFlags(CardCreationFlags.NoRarityModification | CardCreationFlags.NoCardPoolModifications);
+            cards.AddRange(CardFactory.CreateForReward(Owner, cardCount, options));
+        }
+
+        IReadOnlyList<CardModel> selected = await CardSelectCmd.SelectCardsAsync(
+            Owner.RunState, Owner, cards, 0, cards.Count, this);
+        foreach (CardModel card in selected)
+        {
+            var copy = (CardModel)card.MutableClone();
+            copy.AssignOwner(Owner);
+            await CardPileCmd.AddToDeck(copy);
+        }
+    }
+}
