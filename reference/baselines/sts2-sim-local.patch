+using Sts2Sim.Core.Entities.Cards;
+using Sts2Sim.Core.ValueProps;
+
+namespace Sts2Sim.Core.Models.Enchantments;
+
+/// <summary>
+/// 逐字移植 <c>MegaCrit.Sts2.Core.Models.Enchantments.TezcatarasEmber</c>：附魔时把卡牌基础费用
+/// 压到 0（<c>UpgradeBy(-GetWithModifiers(CostModifiers.None))</c>）并给卡加
+/// <see cref="CardKeyword.Eternal"/>；对 powered attack 追加 <c>CanonicalVars</c> 里
+/// <c>DamageVar(3m, ValueProp.Move)</c> 的基础值。
+/// 偏离：原版 <c>OnEnchant</c> 由 <c>EnchantmentModel.ModifyCard</c> 在附魔/反序列化时调用，
+/// 本项目沿用同一接缝的既有窄切片 <see cref="EnchantmentModel.OnAttached"/>（与
+/// <see cref="RoyallyApproved"/>、<see cref="Steady"/> 一致，偏离 #146）；
+/// 无 UI 故省略 <c>ExtraHoverTips</c>，本项目也没有 <c>DynamicVars</c>，
+/// 常数 3 直接取原版 <c>CanonicalVars</c> 中 DamageVar 的基础值。
+/// </summary>
+public sealed class TezcatarasEmber : EnchantmentModel
+{
+    private const decimal EnchantDamageBonus = 3m;
+
+    public override void OnAttached(CardModel card)
+    {
+        card.UpgradeEnergyCostBy(-card.BaseEnergyCost);
+        card.AddKeywordInternal(CardKeyword.Eternal);
+    }
+
+    public override decimal EnchantDamageAdditive(decimal amount, ValueProp props) =>
+        props.IsPoweredAttack() ? EnchantDamageBonus : 0m;
+}
