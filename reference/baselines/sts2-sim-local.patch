+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Cards;
+using Sts2Sim.Core.Models.Powers;
+using Sts2Sim.Core.Rooms;
+using Sts2Sim.Core.Tests.Models.Cards;
+
+namespace Sts2Sim.Core.Tests.Models.Cards;
+
+/// <summary>
+/// ExpectAFight（2 费、升级 1 费：获得等于手牌攻击牌数量的能量，然后本回合不能再获得能量）
+/// 与 <see cref="NoEnergyGainPower"/>。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Cards.ExpectAFight</c>、<c>Powers.NoEnergyGainPower</c>、
+/// <c>MegaCrit.Sts2.Core.Commands.PlayerCmd.GainEnergy</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class ExpectAFightTests : IDisposable
+{
+    public ExpectAFightTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    /// <summary>清空手牌后放回 <paramref name="attacks"/> 张攻击牌，使 ExpectAFight 只数到这些。</summary>
+    private static void ArrangeHand(Player player, int attacks)
+    {
+        foreach (CardModel card in player.PlayerCombatState!.Hand.Cards.ToArray())
+        {
+            CardPileCmd.Add(card, PileType.Discard);
+        }
+
+        for (int index = 0; index < attacks; index++)
+        {
+            Task11CombatTestSupport.AddToHand<StrikeIronclad>(player);
+        }
+    }
+
+    [Fact]
+    public async Task ExpectAFight_GainsOneEnergyPerAttackInHandThenBlocksFurtherGain()
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync("expect-a-fight");
+        ArrangeHand(player, attacks: 3);
+        ExpectAFight card = Task11CombatTestSupport.AddToHand<ExpectAFight>(player);
+
+        Assert.Equal(2, card.EnergyCost);
+        player.PlayerCombatState!.Energy = 5;
+        await room.Engine.PlayCardAsync(player, card, null);
+
+        // 费用 2 已经付掉，再加 3 张攻击牌带来的 3 点能量。
+        Assert.Equal(6, player.PlayerCombatState.Energy);
+        Assert.Equal(1m, player.Creature.GetPower<NoEnergyGainPower>()!.Amount);
+
+        // 本回合之后任何 GainEnergy 都被压到 0。
+        await PlayerCmd.GainEnergy(5m, player);
+        Assert.Equal(6, player.PlayerCombatState.Energy);
+    }
+
+    [Fact]
+    public async Task ExpectAFight_Upgraded_CostsOne()
+    {
+        (Player player, _) = await Task11CombatTestSupport.CreateCombatAsync("expect-a-fight-upgrade");
+        ExpectAFight card = Task11CombatTestSupport.AddToHand<ExpectAFight>(player);
+        card.Upgrade();
+
+        Assert.Equal(1, card.EnergyCost);
+    }
+
+    [Fact]
+    public async Task NoEnergyGainPower_DoesNotBlockTheTurnStartEnergyResetAndExpiresAtTurnEnd()
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync("no-energy-reset");
+        CombatState state = room.Engine.State;
+        await PowerCmd.Apply<NoEnergyGainPower>(state, player.Creature, 1m, player.Creature, null);
+
+        // 回合重置不经过 GainEnergy，因此不受该能力影响。
+        player.PlayerCombatState!.Energy = 0;
+        player.PlayerCombatState.ResetEnergy();
+        Assert.Equal(player.PlayerCombatState.MaxEnergy, player.PlayerCombatState.Energy);
+
+        await Hook.AfterSideTurnEnd(state, CombatSide.Player, [player.Creature]);
+        Assert.Null(player.Creature.GetPower<NoEnergyGainPower>());
+    }
+}
