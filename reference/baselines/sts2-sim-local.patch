diff --git a/tests/Sts2Sim.Core.Tests/Models/Cards/ScareTests.cs b/tests/Sts2Sim.Core.Tests/Models/Cards/ScareTests.cs
new file mode 100644
index 0000000..3821676
--- /dev/null
+++ b/tests/Sts2Sim.Core.Tests/Models/Cards/ScareTests.cs
@@ -0,0 +1,60 @@
+using Sts2Sim.Core.Combat;
+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Entities.Cards;
+using Sts2Sim.Core.Entities.Creatures;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Cards;
+using Sts2Sim.Core.Models.Powers;
+using Sts2Sim.Core.Rooms;
+using Sts2Sim.Core.Tests.Models.Cards;
+
+namespace Sts2Sim.Core.Tests.Models.Cards;
+
+/// <summary>
+/// Scare：0 能量 Uncommon Skill（AllEnemies），对所有可命中敌人施加 1 层 Weak，带 Exhaust；升级移除 Exhaust。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Cards.Scare</c>。
+/// 该卡此前被模拟器自造的 <c>Sidestep</c> 顶替（原版与本地化都没有 Sidestep），现已替换。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class ScareTests : IDisposable
+{
+    public ScareTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    [Fact]
+    public async Task Scare_AppliesOneWeakToAllEnemiesAndExhausts()
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync("scare");
+        Scare card = Task11CombatTestSupport.AddToHand<Scare>(player);
+
+        Assert.Equal(CardType.Skill, card.Type);
+        Assert.Equal(CardRarity.Uncommon, card.Rarity);
+        Assert.Equal(TargetType.AllEnemies, card.TargetType);
+        Assert.Equal(0, card.EnergyCost);
+        Assert.True(card.HasKeyword(CardKeyword.Exhaust));
+
+        Creature enemy = room.Engine.State.HittableEnemies.Single();
+        player.PlayerCombatState!.Energy = 99;
+        await room.Engine.PlayCardAsync(player, card, null);
+
+        Assert.Equal(1m, enemy.GetPower<WeakPower>()!.Amount);
+        Assert.Contains(card, player.PlayerCombatState.ExhaustPile.Cards);
+    }
+
+    [Fact]
+    public async Task Scare_Upgraded_RemovesExhaust()
+    {
+        (Player player, _) = await Task11CombatTestSupport.CreateCombatAsync("scare-upgrade");
+        Scare card = Task11CombatTestSupport.AddToHand<Scare>(player);
+
+        card.Upgrade();
+
+        Assert.False(card.HasKeyword(CardKeyword.Exhaust));
+    }
+}
