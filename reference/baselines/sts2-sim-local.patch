new file mode 100644
index 0000000..ae466fc
--- /dev/null
+++ b/src/Sts2Sim.Core/Models/Powers/OutbreakPower.cs
@@ -0,0 +1,51 @@
+using Sts2Sim.Core.Commands;
+using Sts2Sim.Core.Entities.Cards;
+using Sts2Sim.Core.Entities.Creatures;
+using Sts2Sim.Core.Entities.Powers;
+using Sts2Sim.Core.ValueProps;
+
+namespace Sts2Sim.Core.Models.Powers;
+
+/// <summary>
+/// 逐字移植 <c>MegaCrit.Sts2.Core.Models.Powers.OutbreakPower</c>：
+/// 持有者每施加 <c>poisonThreshold</c>=3 次中毒，就对所有可命中敌人造成等于本能力层数的伤害
+/// （<c>ValueProp.Unpowered</c>），并把计数按 3 取余。
+/// 偏离：省略原版的 <c>DisplayAmount</c>/<c>InvokeDisplayAmountChanged</c> 与 <c>Flash</c>（无 UI）。
+/// </summary>
+public sealed class OutbreakPower : PowerModel
+{
+    public const int PoisonThreshold = 3;
+
+    /// <summary>原版 <c>InitInternalData()</c> 里的 <c>Data.timesPoisoned</c>；按值类型字段保存，
+    /// 战斗克隆由 <c>MemberwiseClone</c> 直接复制。</summary>
+    private int _timesPoisoned;
+
+    public override PowerType Type => PowerType.Buff;
+
+    public override PowerStackType StackType => PowerStackType.Counter;
+
+    public override async Task AfterPowerAmountChanged(
+        PowerModel power, decimal amount, Creature? applier, CardModel? cardSource)
+    {
+        if (!ReferenceEquals(applier, Owner) || amount <= 0m || power is not PoisonPower)
+        {
+            return;
+        }
+
+        _timesPoisoned++;
+        if (_timesPoisoned < PoisonThreshold)
+        {
+            return;
+        }
+
+        await CreatureCmd.Damage(
+            Owner.CombatState!,
+            Owner.CombatState!.HittableEnemies,
+            Amount,
+            ValueProp.Unpowered,
+            Owner,
+            null,
+            null);
+        _timesPoisoned %= PoisonThreshold;
+    }
+}
