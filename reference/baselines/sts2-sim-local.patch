+
+/// <summary>
+/// 逐字移植 <c>MegaCrit.Sts2.Core.Models.Relics.ToyBox</c>：拾取时从 <c>RelicFactory</c> 抽
+/// <c>Relics</c>=4 个遗物并标记为涂蜡（<see cref="RelicModel.IsWax"/>）供玩家挑选；此后每
+/// <c>Combats</c>=3 场战斗熔化其中最早的一个，12 场战斗后 4 个全部熔尽、自身用尽。
+/// 偏离（表现层）：省略 <c>ShowCounter</c>/<c>DisplayAmount</c>、<c>Flash</c> 与
+/// <c>Cmd.CustomScaledWait</c> 的激活动画时序。
+/// </summary>
+public sealed class ToyBox : RelicModel
+{
+    private const int RelicsOffered = 4;
+    private const int CombatsPerMelt = 3;
+
+    private int _combatsSeen;
+
+    public override RelicRarity Rarity => RelicRarity.Ancient;
+
+    public override bool HasUponPickupEffect => true;
+
+    public int CombatsSeen
+    {
+        get => _combatsSeen;
+        set
+        {
+            AssertMutable();
+            _combatsSeen = value;
+        }
+    }
+
+    public override bool IsUsedUp => CombatsSeen >= CombatsPerMelt * RelicsOffered;
+
+    public override async Task AfterObtained()
+    {
+        List<Reward> rewards = new();
+        for (int index = 0; index < RelicsOffered; index++)
+        {
+            // 原版 PullNextRelicFromFront(...).ToMutable()；本引擎的对应克隆是 MutableClone()。
+            RelicModel relic = (RelicModel)RelicFactory.PullNextRelicFromFront(Owner).MutableClone();
+            relic.IsWax = true;
+            rewards.Add(new RelicReward(relic, Owner));
+        }
+
+        await RewardsCmd.OfferCustom(Owner, rewards);
+    }
+
+    public override async Task AfterCombatEnd()
+    {
+        CombatsSeen++;
+        if (CombatsSeen % CombatsPerMelt != 0)
+        {
+            return;
+        }
+
+        RelicModel? wax = Owner.Relics.FirstOrDefault(relic => relic.IsWax && !relic.IsMelted);
+        if (wax is not null)
+        {
+            await RelicCmd.Melt(wax);
+        }
+    }
+}
