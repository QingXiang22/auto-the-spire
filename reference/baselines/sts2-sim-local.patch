@@ -0,0 +1,31 @@
+using Sts2Sim.Core.Entities.Cards;
+using Sts2Sim.Core.Entities.Players;
+
+namespace Sts2Sim.Core.Models.Enchantments;
+
+/// <summary>
+/// 逐字移植 <c>MegaCrit.Sts2.Core.Models.Enchantments.SlumberingEssence</c>：弃手牌前，
+/// 如果这张附魔卡在该玩家的手牌里，则给它一个“到打出为止 -1”的能量费用修饰符。
+/// 偏离 #146：原版签名 <c>BeforeFlush(PlayerChoiceContext, Player)</c> 的 choice context
+/// 在无头环境没有对应面，本项目基类只声明 <c>BeforeFlush(Player)</c>；
+/// <c>Card.EnergyCost.AddUntilPlayed(-1)</c> 对应本项目的
+/// <see cref="CardModel.AddEnergyCostUntilPlayed"/>（同为相对、打出后清除的本地修饰符）。
+/// </summary>
+public sealed class SlumberingEssence : EnchantmentModel
+{
+    public override Task BeforeFlush(Player player)
+    {
+        if (player != Owner.Owner)
+        {
+            return Task.CompletedTask;
+        }
+
+        if (Owner.Pile?.Type != PileType.Hand)
+        {
+            return Task.CompletedTask;
+        }
+
+        Owner.AddEnergyCostUntilPlayed(-1);
+        return Task.CompletedTask;
+    }
+}
