diff --git a/tests/Sts2Sim.Core.Tests/Models/Relics/SeaGlassTests.cs b/tests/Sts2Sim.Core.Tests/Models/Relics/SeaGlassTests.cs
new file mode 100644
index 0000000..7945c39
--- /dev/null
+++ b/tests/Sts2Sim.Core.Tests/Models/Relics/SeaGlassTests.cs
@@ -0,0 +1,95 @@
+using Sts2Sim.Core.Combat;
+using Sts2Sim.Core.Commands;
+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Content.Acts;
+using Sts2Sim.Core.Entities.Cards;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Characters;
+using Sts2Sim.Core.Models.Relics;
+using Sts2Sim.Core.Runs;
+
+namespace Sts2Sim.Core.Tests.Models.Relics;
+
+/// <summary>
+/// SeaGlass 从绑定角色的卡池里按 Common/Uncommon/Rare 各抽 5 张，交给玩家任选若干张进牌组。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Relics.SeaGlass.AfterObtained</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class SeaGlassTests : IDisposable
+{
+    public SeaGlassTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    private static RunState CreateRun(string seed, out Player player)
+    {
+        var runState = new RunState(seed, new Overgrowth());
+        player = Player.CreateForNewRun(ModelDb.Character<Regent>(), runState);
+        runState.AddPlayer(player);
+        return runState;
+    }
+
+    [Fact]
+    public async Task SeaGlass_OffersFiveCardsPerRarityFromTheBoundCharacterAndAddsTheChosenOnes()
+    {
+        RunState runState = CreateRun("sea-glass-defect", out Player player);
+        var recorded = new RecordingSelectionSource(take: 2);
+        runState.ConfigureCardSelectionSource(recorded);
+        int deckBefore = player.Deck.Cards.Count;
+
+        var seaGlass = (SeaGlass)ModelDb.Relic<SeaGlass>().MutableClone();
+        seaGlass.CharacterId = ModelDb.Character<Defect>().Id;
+        await RelicCmd.Obtain(seaGlass, player);
+
+        CardSelectionRequest request = Assert.IsType<CardSelectionRequest>(recorded.Request);
+        Assert.Equal(15, request.Candidates.Count);
+        Assert.Equal(0, request.MinCount);
+        Assert.Equal(15, request.MaxCount);
+        Assert.False(request.Cancelable);
+
+        // 每种稀有度各 5 张，且全部来自绑定角色的卡池。
+        IReadOnlyList<CardModel> defectPool = ModelDb.Character<Defect>().CardPool.AllCards;
+        Assert.Equal(
+            new[] { 5, 5, 5 },
+            new[] { CardRarity.Common, CardRarity.Uncommon, CardRarity.Rare }
+                .Select(rarity => request.Candidates.Count(card => card.Rarity == rarity))
+                .ToArray());
+        Assert.All(request.Candidates, card => Assert.Contains(defectPool, pooled => pooled.Id == card.Id));
+
+        Assert.Equal(deckBefore + 2, player.Deck.Cards.Count);
+    }
+
+    [Fact]
+    public async Task SeaGlass_FallsBackToIroncladWhenNoCharacterWasBound()
+    {
+        RunState runState = CreateRun("sea-glass-fallback", out Player player);
+        var recorded = new RecordingSelectionSource(take: 0);
+        runState.ConfigureCardSelectionSource(recorded);
+
+        await RelicCmd.Obtain(ModelDb.Relic<SeaGlass>(), player);
+
+        SeaGlass obtained = Assert.Single(player.Relics.OfType<SeaGlass>());
+        Assert.Equal(ModelDb.Character<Ironclad>().Id, obtained.CharacterId);
+        Assert.All(
+            recorded.Request!.Candidates,
+            card => Assert.Contains(
+                ModelDb.Character<Ironclad>().CardPool.AllCards, pooled => pooled.Id == card.Id));
+    }
+
+    private sealed class RecordingSelectionSource(int take) : ICardSelectionDecisionSource
+    {
+        public CardSelectionRequest? Request { get; private set; }
+
+        public Task<IReadOnlyList<CardModel>> ChooseCardsAsync(CardSelectionRequest request)
+        {
+            Request = request;
+            return Task.FromResult<IReadOnlyList<CardModel>>(
+                request.Candidates.Take(take).ToArray());
+        }
+    }
+}
