+using Sts2Sim.Core.Combat;
+using Sts2Sim.Core.Commands;
+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Entities.Cards;
+using Sts2Sim.Core.Entities.Creatures;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Hooks;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Cards;
+using Sts2Sim.Core.Models.Powers;
+using Sts2Sim.Core.Models.Relics;
+using Sts2Sim.Core.Rooms;
+using Sts2Sim.Core.Tests.Models.Cards;
+using Sts2Sim.Core.ValueProps;
+
+namespace Sts2Sim.Core.Tests.Models.Relics;
+
+/// <summary>
+/// DiamondDiadem：统计本回合出牌数，回合结束时若不超过 2 张就施加
+/// <see cref="DiamondDiademPower"/>（受 powered attack 伤害减半，敌方回合结束移除）。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Relics.DiamondDiadem</c>、
+/// <c>Powers.DiamondDiademPower</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class DiamondDiademTests : IDisposable
+{
+    public DiamondDiademTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    private static async Task<(Player Player, CombatRoom Room, DiamondDiadem Diadem)> SetUpAsync(string seed)
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync(seed);
+        await RelicCmd.Obtain(ModelDb.Relic<DiamondDiadem>(), player);
+        return (player, room, player.Relics.OfType<DiamondDiadem>().Single());
+    }
+
+    private static async Task PlayDefendsAsync(Player player, CombatRoom room, int count)
+    {
+        for (int index = 0; index < count; index++)
+        {
+            player.PlayerCombatState!.Energy = 99;
+            DefendRegent defend = Task11CombatTestSupport.AddToHand<DefendRegent>(player);
+            await room.Engine.PlayCardAsync(player, defend, null);
+        }
+    }
+
+    [Fact]
+    public async Task DiamondDiadem_AppliesTheHalvingPowerOnlyAtOrBelowTheCardThreshold()
+    {
+        (Player player, CombatRoom room, DiamondDiadem diadem) = await SetUpAsync("diadem-threshold");
+        CombatState state = room.Engine.State;
+        Creature enemy = state.HittableEnemies.Single();
+
+        // 打出正好 2 张（阈值是"不超过 2 张"）→ 触发。
+        await PlayDefendsAsync(player, room, 2);
+        Assert.Equal(2, diadem.CardsPlayedThisTurn);
+
+        await Hook.BeforeSideTurnEnd(state, CombatSide.Player, [player.Creature]);
+        Assert.Equal(1m, player.Creature.GetPower<DiamondDiademPower>()!.Amount);
+        Assert.Equal(0, diadem.CardsPlayedThisTurn);
+
+        // 敌方回合结束移除该能力。
+        await Hook.AfterSideTurnEnd(state, CombatSide.Enemy, [enemy]);
+        Assert.Null(player.Creature.GetPower<DiamondDiademPower>());
+
+        // 打出 3 张 → 不触发。
+        await PlayDefendsAsync(player, room, 3);
+        Assert.Equal(3, diadem.CardsPlayedThisTurn);
+
+        await Hook.BeforeSideTurnEnd(state, CombatSide.Player, [player.Creature]);
+        Assert.Null(player.Creature.GetPower<DiamondDiademPower>());
+        Assert.Equal(0, diadem.CardsPlayedThisTurn);
+    }
+
+    [Fact]
+    public async Task DiamondDiademPower_HalvesPoweredAttackDamageButNotUnpoweredDamage()
+    {
+        (Player player, CombatRoom room, DiamondDiadem diadem) = await SetUpAsync("diadem-halve");
+        CombatState state = room.Engine.State;
+        Creature enemy = state.HittableEnemies.Single();
+        Assert.Equal(0, player.Creature.Block);
+
+        // 本回合没出牌 → 回合结束获得减半能力。
+        await Hook.BeforeSideTurnEnd(state, CombatSide.Player, [player.Creature]);
+        Assert.NotNull(player.Creature.GetPower<DiamondDiademPower>());
+
+        int hpBefore = player.Creature.CurrentHp;
+        await CreatureCmd.Damage(state, [player.Creature], 10m, ValueProp.Move, enemy, null, null);
+        Assert.Equal(hpBefore - 5, player.Creature.CurrentHp);
+
+        // 非 powered attack（遗物/药水/power 来源）不减半。
+        hpBefore = player.Creature.CurrentHp;
+        await CreatureCmd.Damage(state, [player.Creature], 10m, ValueProp.Unpowered, enemy, null, null);
+        Assert.Equal(hpBefore - 10, player.Creature.CurrentHp);
+        Assert.Equal(0, diadem.CardsPlayedThisTurn);
+    }
+}
