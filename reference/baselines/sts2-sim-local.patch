+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Events;
+using Sts2Sim.Core.Models.Encounters;
+
+namespace Sts2Sim.Core.Models.Events;
+
+/// <summary>
+/// 逐字移植 <c>MegaCrit.Sts2.Core.Models.Events.TheArchitect</c> 的玩法骨架：最终幕 Boss 之后的胜利事件，
+/// 布局为 <c>Combat</c>、规范遭遇为 <see cref="TheArchitectEventEncounter"/>，选项里只有一个 <c>PROCEED</c>，
+/// 选中即结束这一局（真正的胜利判定由 run 流程在事件结束后完成）。
+///
+/// 偏离（均已在 README 的"已知偏离"范围内或属表现层）：
+/// 1. #204：省略 Ancient 对话/历史（<c>AncientDialogueSet</c>/<c>LoadDialogue</c>）与说话气泡。
+///    因此 <c>GenerateInitialOptions</c> 直接给出 PROCEED，不做 <c>LoadDialogue</c> 里的
+///    <c>Rng.NextItem</c> —— 这一处会改变该事件的随机数消耗，是刻意的、需要登记的偏离。
+/// 2. 省略 <c>OnRoomEnter</c> 的 <c>ScoreUtility.CalculateScore</c> 与 <c>StatsManager</c> 统计
+///    （本引擎没有存档统计模块）。
+/// 3. 省略 <c>WinRun</c> 里按 <c>ArchitectAttackers</c> 播放的攻击演出与联机的
+///    <c>ActChangeSynchronizer.SetLocalPlayerReady</c>（单机、无 UI）。
+/// </summary>
+public sealed class TheArchitect : EventModel
+{
+    public override EventLayoutType LayoutType => EventLayoutType.Combat;
+
+    public override EncounterDefinition? CanonicalEncounter => TheArchitectEventEncounter.Definition;
+
+    protected override IReadOnlyList<EventOption> GenerateInitialOptions() =>
+    [
+        new EventOption("PROCEED", () =>
+        {
+            Finish();
+            return Task.CompletedTask;
+        }),
+    ];
+}
