+        MapPointType.Monster,
+        MapPointType.RestSite,
+        MapPointType.Monster,
+        MapPointType.RestSite,
+        MapPointType.Unknown,
+        MapPointType.Treasure,
+        MapPointType.Unknown,
+        MapPointType.Treasure,
+        MapPointType.Unknown,
+        MapPointType.Shop,
+        MapPointType.Elite,
+        MapPointType.RestSite,
+        MapPointType.Elite,
+        MapPointType.RestSite,
+    ];
+
+    public GoldenCompassTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    private static (Player Player, RunState RunState) CreatePlayer(string seed)
+    {
+        var runState = new RunState(seed, new Overgrowth());
+        Player player = Player.CreateForNewRun(ModelDb.Character<Regent>(), runState);
+        runState.AddPlayer(player);
+        return (player, runState);
+    }
+
+    [Fact]
+    public async Task GoldenCompass_ReplacesTheCurrentActMapWithASingleColumnGoldenPath()
+    {
+        (Player player, RunState runState) = CreatePlayer("golden-compass-map");
+        await RelicCmd.Obtain(ModelDb.Relic<GoldenCompass>(), player);
+
+        GoldenCompass compass = Assert.Single(player.Relics.OfType<GoldenCompass>());
+        Assert.Equal(runState.CurrentActIndex, compass.GoldenPathAct);
+
+        var map = Assert.IsType<GoldenPathActMap>(runState.Map);
+        Assert.Equal(7, map.GetColumnCount());
+        Assert.Equal(17, map.GetRowCount());
+        Assert.Equal(MapPointType.Ancient, map.StartingMapPoint.PointType);
+        Assert.Equal(0, map.StartingMapPoint.coord.row);
+        Assert.Equal(MapPointType.Boss, map.BossMapPoint.PointType);
+        Assert.Equal(17, map.BossMapPoint.coord.row);
+        Assert.Empty(map.GetPointsInRow(0));
+
+        // 黄金路线是一条单列（第 3 列）直线，节点类型与默认表一致。
+        MapPoint[] column = Enumerable.Range(1, 16)
+            .Select(row => Assert.Single(map.GetPointsInRow(row)))
+            .ToArray();
+        Assert.All(column, point => Assert.Equal(3, point.coord.col));
+        Assert.Equal(ExpectedRows, column.Select(point => point.PointType));
+
+        // 连接关系：Ancient → 第 1 行 → … → 第 16 行 → Boss。
+        Assert.Contains(column[0], map.StartingMapPoint.Children);
+        for (int index = 1; index < column.Length; index++)
+        {
+            Assert.Contains(column[index], column[index - 1].Children);
+        }
+
+        Assert.Contains(map.BossMapPoint, column[^1].Children);
+    }
+
+    [Fact]
+    public async Task GoldenCompass_ForcesUnknownPointsToEventsOnlyInTheGoldenAct()
+    {
+        (Player player, RunState runState) = CreatePlayer("golden-compass-unknown");
+        await RelicCmd.Obtain(ModelDb.Relic<GoldenCompass>(), player);
+        GoldenCompass compass = Assert.Single(player.Relics.OfType<GoldenCompass>());
+        var original = new HashSet<RoomType> { RoomType.Monster, RoomType.Shop };
+
+        Assert.Equal(
+            new HashSet<RoomType> { RoomType.Event },
+            compass.ModifyUnknownMapPointRoomTypes(original));
+
+        // 过了那一幕之后不再改写，且入参集合本身不被改动。
+        compass.GoldenPathAct = runState.CurrentActIndex + 1;
+        Assert.Same(original, compass.ModifyUnknownMapPointRoomTypes(original));
+        Assert.Equal(new HashSet<RoomType> { RoomType.Monster, RoomType.Shop }, original);
+    }
+
+    [Fact]
+    public async Task GoldenCompass_OnlyRewritesTheMapOfItsRecordedAct()
+    {
+        (Player player, RunState runState) = CreatePlayer("golden-compass-act-scope");
+        ActMap standard = runState.Map;
+        await RelicCmd.Obtain(ModelDb.Relic<GoldenCompass>(), player);
+        GoldenCompass compass = Assert.Single(player.Relics.OfType<GoldenCompass>());
+
+        Assert.IsType<GoldenPathActMap>(runState.Map);
+        Assert.IsType<GoldenPathActMap>(
+            compass.ModifyGeneratedMap(runState, standard, compass.GoldenPathAct));
+        Assert.Same(standard, compass.ModifyGeneratedMap(runState, standard, compass.GoldenPathAct + 1));
+    }
+}
