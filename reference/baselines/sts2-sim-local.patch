@@ -0,0 +1,122 @@
+using Sts2Sim.Core.Commands;
+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Content.Acts;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Entities.Relics;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Characters;
+using Sts2Sim.Core.Models.Events;
+using Sts2Sim.Core.Models.Relics;
+using Sts2Sim.Core.Rewards;
+using Sts2Sim.Core.Rooms;
+using Sts2Sim.Core.Runs;
+
+namespace Sts2Sim.Core.Tests.Models.Relics;
+
+/// <summary>
+/// ToyBox 的涂蜡遗物发放与定时熔化生命周期。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Relics.ToyBox</c>、
+/// <c>MegaCrit.Sts2.Core.Entities.Players.Player.MeltRelicInternal</c>、
+/// <c>MegaCrit.Sts2.Core.Commands.RelicCmd.Melt</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class ToyBoxTests : IDisposable
+{
+    public ToyBoxTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    private static (RunState Run, Player Player, EventRoom Room) CreateEventRun(string seed)
+    {
+        var run = new RunState(seed, new Overgrowth());
+        Player player = Player.CreateForNewRun(ModelDb.Character<Regent>(), run);
+        run.AddPlayer(player);
+        var room = new EventRoom(() => (Neow)ModelDb.Event<Neow>().MutableClone());
+        run.PushRoom(room);
+        return (run, player, room);
+    }
+
+    [Fact]
+    public async Task ToyBox_OffersFourWaxRelicRewards()
+    {
+        (RunState run, Player player, EventRoom room) = CreateEventRun("toy-box-offer");
+        await room.Enter(run);
+
+        await RelicCmd.Obtain(ModelDb.Relic<ToyBox>(), player);
+
+        Assert.True(room.Event.TryDequeuePendingRewardOffer(out RewardsSet? offer));
+        RelicReward[] choices = offer.ExtraRewards.Cast<RelicReward>().ToArray();
+        Assert.Equal(4, choices.Length);
+        Assert.All(choices, choice => Assert.NotNull(choice.Relic));
+        Assert.All(choices, choice => Assert.True(choice.Relic!.IsWax, "原生 ToyBox 抽出的遗物应当是涂蜡的。"));
+        Assert.Equal(4, choices.Select(choice => choice.Relic!.Id).Distinct().Count());
+    }
+
+    [Fact]
+    public async Task ToyBox_MeltsTheOldestWaxRelicEveryThreeCombats()
+    {
+        (RunState run, Player player, EventRoom room) = CreateEventRun("toy-box-melt");
+        await room.Enter(run);
+        await RelicCmd.Obtain(ModelDb.Relic<ToyBox>(), player);
+        Assert.True(room.Event.TryDequeuePendingRewardOffer(out RewardsSet? offer));
+        foreach (RelicReward reward in offer.ExtraRewards.Cast<RelicReward>())
+        {
+            await reward.Take();
+        }
+
+        ToyBox toyBox = player.Relics.OfType<ToyBox>().Single();
+        RelicModel[] wax = player.Relics.Where(relic => relic.IsWax).ToArray();
+        Assert.Equal(4, wax.Length);
+        Assert.All(wax, relic => Assert.False(relic.IsMelted));
+        Assert.False(toyBox.IsUsedUp);
+
+        for (int combat = 1; combat <= 12; combat++)
+        {
+            await toyBox.AfterCombatEnd();
+
+            int expectedMelted = combat / 3;
+            Assert.Equal(
+                expectedMelted,
+                wax.Count(relic => relic.IsMelted));
+            // 熔化顺序是从背包最前面（也就是最先抽到）的涂蜡遗物开始。
+            for (int index = 0; index < wax.Length; index++)
+            {
+                Assert.Equal(index < expectedMelted, wax[index].IsMelted);
+            }
+
+            Assert.Equal(combat, toyBox.CombatsSeen);
+        }
+
+        Assert.True(toyBox.IsUsedUp);
+    }
+
+    [Fact]
+    public async Task Melt_RejectsANonWaxRelicAndLeavesMeltedRelicsOutOfHookDispatch()
+    {
+        (RunState run, Player player, EventRoom room) = CreateEventRun("toy-box-melt-guards");
+        await room.Enter(run);
+        RelicModel starter = player.Relics.Single(relic => relic.Rarity == RelicRarity.Starter);
+        Assert.False(starter.IsWax);
+
+        await Assert.ThrowsAsync<InvalidOperationException>(() => RelicCmd.Melt(starter));
+        Assert.False(starter.IsMelted);
+
+        await RelicCmd.Obtain(ModelDb.Relic<ToyBox>(), player);
+        Assert.True(room.Event.TryDequeuePendingRewardOffer(out RewardsSet? offer));
+        RelicReward first = offer.ExtraRewards.Cast<RelicReward>().First();
+        await first.Take();
+        RelicModel wax = player.Relics.Single(relic => relic.IsWax);
+
+        Assert.Contains(wax, run.IterateHookListeners(null));
+        await RelicCmd.Melt(wax);
+
+        Assert.True(wax.IsMelted);
+        // 熔化的遗物仍留在背包里，但不再参与 hook（原版 RunState 的 !r.IsMelted 过滤）。
+        Assert.Contains(wax, player.Relics);
+        Assert.DoesNotContain(wax, run.IterateHookListeners(null));
+    }
+}
diff --git a/tests/Sts2Sim.Core.Tests/Models/Relics/UpgradedStarterRelicTests.cs b/tests/Sts2Sim.Core.Tests/Models/Relics/UpgradedStarterRelicTests.cs
