+
+/// <summary>
+/// Outbreak（1 能量 Uncommon Power → <see cref="OutbreakPower"/> 11/升级 +4）与
+/// <see cref="OutbreakPower"/>（每施加 3 次中毒对全体敌人造成等于层数的伤害）。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Cards.Outbreak</c>、<c>Powers.OutbreakPower</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class OutbreakTests : IDisposable
+{
+    public OutbreakTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    [Fact]
+    public async Task Outbreak_IsAOneCostUncommonSelfPowerApplyingOutbreakPower()
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync("outbreak-card");
+        Outbreak card = Task11CombatTestSupport.AddToHand<Outbreak>(player);
+
+        Assert.Equal(CardType.Power, card.Type);
+        Assert.Equal(CardRarity.Uncommon, card.Rarity);
+        Assert.Equal(TargetType.Self, card.TargetType);
+        Assert.Equal(1, card.EnergyCost);
+
+        player.PlayerCombatState!.Energy = 99;
+        await room.Engine.PlayCardAsync(player, card, null);
+
+        Assert.Equal(11m, player.Creature.GetPower<OutbreakPower>()!.Amount);
+    }
+
+    [Fact]
+    public async Task Outbreak_Upgraded_AppliesFourteenLayers()
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync("outbreak-upgrade");
+        Outbreak card = Task11CombatTestSupport.AddToHand<Outbreak>(player);
+        card.Upgrade();
+
+        player.PlayerCombatState!.Energy = 99;
+        await room.Engine.PlayCardAsync(player, card, null);
+
+        Assert.Equal(15m, player.Creature.GetPower<OutbreakPower>()!.Amount);
+    }
+
+    [Theory]
+    [InlineData(2, 0)]
+    [InlineData(3, 11)]
+    [InlineData(6, 22)]
+    public async Task OutbreakPower_DealsItsAmountToAllEnemiesEveryThirdPoisonApplication(
+        int applications, int expectedDamage)
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync(
+            $"outbreak-power-{applications}");
+        CombatState state = room.Engine.State;
+        Creature enemy = state.HittableEnemies.Single();
+        await PowerCmd.Apply<OutbreakPower>(state, player.Creature, 11m, player.Creature, null);
+        int hpBefore = enemy.CurrentHp;
+
+        for (int index = 0; index < applications; index++)
+        {
+            await PowerCmd.Apply<PoisonPower>(state, enemy, 1m, player.Creature, null);
+        }
+
+        Assert.Equal(hpBefore - expectedDamage, enemy.CurrentHp);
+    }
+
+    [Fact]
+    public async Task OutbreakPower_IgnoresPoisonAppliedBySomebodyElseAndNonPoisonPowers()
+    {
+        (Player player, CombatRoom room) = await Task11CombatTestSupport.CreateCombatAsync("outbreak-power-other");
+        CombatState state = room.Engine.State;
+        Creature enemy = state.HittableEnemies.Single();
+        await PowerCmd.Apply<OutbreakPower>(state, player.Creature, 11m, player.Creature, null);
+        int hpBefore = enemy.CurrentHp;
+
+        // 由敌人自己（不是持有者）施加的中毒不计数。
+        for (int index = 0; index < 3; index++)
+        {
+            await PowerCmd.Apply<PoisonPower>(state, enemy, 1m, enemy, null);
+        }
+
+        // 非中毒能力也不计数。
+        await PowerCmd.Apply<WeakPower>(state, enemy, 1m, player.Creature, null);
+
+        Assert.Equal(hpBefore, enemy.CurrentHp);
+    }
+}
