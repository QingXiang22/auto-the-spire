@@ -0,0 +1,148 @@
+using Sts2Sim.Core.Commands;
+using Sts2Sim.Core.Content;
+using Sts2Sim.Core.Content.Acts;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Entities.Relics;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Models.Characters;
+using Sts2Sim.Core.Models.Monsters;
+using Sts2Sim.Core.Models.Orbs;
+using Sts2Sim.Core.Models.Relics;
+using Sts2Sim.Core.Rooms;
+using Sts2Sim.Core.Runs;
+
+namespace Sts2Sim.Core.Tests.Models.Relics;
+
+/// <summary>
+/// TouchOfOrobas 的精炼起始遗物映射，以及五个升级版起始遗物各自的行为。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Relics.{TouchOfOrobas,BlackBlood,RingOfTheDrake,InfusedCore,DivineDestiny,PhylacteryUnbound}</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class UpgradedStarterRelicTests : IDisposable
+{
+    public UpgradedStarterRelicTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes);
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    private static Player NewRun<TCharacter>(string seed) where TCharacter : CharacterModel
+    {
+        var runState = new RunState(seed, new Overgrowth());
+        Player player = Player.CreateForNewRun(ModelDb.Character<TCharacter>(), runState);
+        runState.AddPlayer(player);
+        return player;
+    }
+
+    /// <summary>
+    /// 开战前把起始遗物换成对应的精炼升级版，再进入战斗；这样原来的起始遗物不会先跑一遍自己的开战 hook。
+    /// </summary>
+    private static async Task<(Player Player, TUpgraded Relic)> EnterCombatReplacingStarter<TCharacter, TStarter, TUpgraded>(
+        string seed)
+        where TCharacter : CharacterModel
+        where TStarter : RelicModel
+        where TUpgraded : RelicModel
+    {
+        Player player = NewRun<TCharacter>(seed);
+        await RelicCmd.Replace(player.Relics.Single(relic => relic is TStarter), ModelDb.Relic<TUpgraded>());
+        var room = new CombatRoom(
+            () => (WanderingGrunt)ModelDb.Monster<WanderingGrunt>().MutableClone());
+        await room.Enter((RunState)player.RunState);
+        return (player, player.Relics.OfType<TUpgraded>().Single());
+    }
+
+    [Theory]
+    [InlineData(typeof(Ironclad), typeof(BurningBlood), typeof(BlackBlood))]
+    [InlineData(typeof(Silent), typeof(RingOfTheSnake), typeof(RingOfTheDrake))]
+    [InlineData(typeof(Regent), typeof(DivineRight), typeof(DivineDestiny))]
+    [InlineData(typeof(Necrobinder), typeof(BoundPhylactery), typeof(PhylacteryUnbound))]
+    [InlineData(typeof(Defect), typeof(CrackedCore), typeof(InfusedCore))]
+    public async Task TouchOfOrobas_ReplacesStarterRelicInPlace(
+        Type characterType, Type starterType, Type upgradedType)
+    {
+        var runState = new RunState($"orobas-{characterType.Name}", new Overgrowth());
+        Player player = Player.CreateForNewRun((CharacterModel)ModelDb.Get(characterType), runState);
+        runState.AddPlayer(player);
+        int index = player.Relics.ToList().FindIndex(relic => relic.GetType() == starterType);
+        Assert.True(index >= 0, $"{characterType.Name} should start with {starterType.Name}.");
+
+        await RelicCmd.Obtain(ModelDb.Relic<TouchOfOrobas>(), player);
+
+        Assert.IsType(upgradedType, player.Relics[index]);
+        Assert.DoesNotContain(player.Relics, relic => relic.GetType() == starterType);
+        Assert.Equal(RelicRarity.Starter, player.Relics[index].Rarity);
+    }
+
+    [Fact]
+    public void GetUpgradedStarterRelic_UnmappedRelic_FallsBackToCirclet()
+    {
+        TouchOfOrobas touch = Assert.IsType<TouchOfOrobas>(
+            ModelDb.Relic<TouchOfOrobas>().MutableClone());
+
+        Assert.IsType<Circlet>(touch.GetUpgradedStarterRelic(ModelDb.Relic<Anchor>()));
+    }
+
+    [Theory]
+    [InlineData(1, 7)]
+    [InlineData(2, 7)]
+    [InlineData(3, 7)]
+    [InlineData(4, 5)]
+    public void RingOfTheDrake_AddsTwoDrawForTheFirstThreeTurnsOnly(int turnNumber, int expected)
+    {
+        Player player = NewRun<Silent>($"drake-draw-{turnNumber}");
+        player.ResetCombatState();
+        player.PlayerCombatState!.TurnNumber = turnNumber;
