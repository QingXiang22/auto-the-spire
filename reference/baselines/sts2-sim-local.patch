+using Sts2Sim.Core.Runs;
+using Sts2Sim.Core.ValueProps;
+
+namespace Sts2Sim.Core.Tests.Models.Events;
+
+/// <summary>
+/// 最终幕 Boss 之后的 TheArchitect 胜利事件。
+/// 原版出处：<c>MegaCrit.Sts2.Core.Models.Events.TheArchitect</c>、
+/// <c>Models.Encounters.TheArchitectEventEncounter</c>、<c>Models.Monsters.Architect</c>。
+/// </summary>
+[Collection("ModelDb")]
+public sealed class TheArchitectTests : IDisposable
+{
+    public TheArchitectTests()
+    {
+        ModelDb.ResetForTests();
+        ModelDb.Init(ContentRegistry.AllTypes.Append(typeof(SelfDefeatingProbeMonster)));
+    }
+
+    public void Dispose() => ModelDb.ResetForTests();
+
+    [Fact]
+    public void Architect_HasNineThousandNineHundredNinetyNineHpAndOnlyDoesNothing()
+    {
+        var architect = (Architect)ModelDb.Monster<Architect>().MutableClone();
+        architect.SetUpForCombat();
+
+        Assert.Equal(9999, architect.MinInitialHp);
+        Assert.Equal(9999, architect.MaxInitialHp);
+
+        MoveState nothing = Assert.IsType<MoveState>(architect.MoveStateMachine!.States["NOTHING"]);
+        Assert.Same(nothing, nothing.FollowUpState);
+        Assert.IsType<HiddenIntent>(Assert.Single(nothing.Intents));
+        Assert.Equal(IntentType.Hidden, nothing.Intents[0].IntentType);
+    }
+
+    [Fact]
+    public void TheArchitectEventEncounter_GeneratesExactlyOneArchitect()
+    {
+        IReadOnlyList<(MonsterModel Monster, string? SlotName)> monsters =
+            TheArchitectEventEncounter.Definition.CreateMonsters();
+
+        (MonsterModel monster, string? slot) = Assert.Single(monsters);
+        Assert.IsType<Architect>(monster);
+        Assert.Null(slot);
+    }
+
+    [Fact]
+    public async Task RoomFactory_BuildsADrivableTheArchitectEventRoom()
+    {
+        (RunState run, _) = CreateRun("architect-room-factory", out _);
+
+        var room = Assert.IsType<EventRoom>(RoomFactory.CreateArchitectEventRoom(run));
+        run.PushRoom(room);
+        await room.Enter(run);
+
+        var architect = Assert.IsType<TheArchitect>(room.Event);
+        Assert.Equal(EventLayoutType.Combat, architect.LayoutType);
+        await architect.ChooseOption(Assert.Single(architect.CurrentOptions));
+        Assert.True(architect.IsFinished);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task ClearingTheFinalActBoss_DrivesTheArchitectEventBeforeDeclaringVictory(bool useEngine)
+    {
+        (RunState run, Player player) = CreateRun("architect-final-boss", out var decisions);
+        var recorder = new RunRecorder(() => DateTimeOffset.UnixEpoch);
+
+        RunOutcome outcome;
+        if (useEngine)
+        {
+            outcome = (await new RunEngine(
+                    run,
+                    points => PickFirstByColumn(points),
+                    recorder: recorder)
+                .RunAsync(maxFloors: 5)).Outcome;
+        }
+        else
+        {
+            outcome = (await new RunDriver(run, decisions, recorder: recorder)
+                .RunAsync(maxFloors: 5)).Outcome;
+        }
+
+        Assert.Equal(RunOutcome.Victory, outcome);
+        Assert.True(player.Creature.IsAlive);
+
+        // 直接证据：录制里出现了 TheArchitect 事件那一层，且选的是 PROCEED。
+        EventFloorDetail architect = Assert.Single(
+            recorder.BuildManifest().Floors.Select(floor => floor.Detail).OfType<EventFloorDetail>(),
+            detail => detail.EventName == nameof(TheArchitect));
+        Assert.Equal("PROCEED", architect.OptionChosen);
+    }
+
+    private static (RunState Run, Player Player) CreateRun(string seed, out ArchitectProbeDecisionSource decisions)
+    {
+        var run = new RunState(seed, new ActDefinition[] { new ArchitectProbeAct() });
+        run.Map.StartingMapPoint.PointType = MapPointType.Monster;
+        PickFirstByColumn(run.Map.StartingMapPoint.Children).PointType = MapPointType.Boss;
+        Player player = Player.CreateForNewRun(ModelDb.Character<Regent>(), run);
+        run.AddPlayer(player);
+        decisions = new ArchitectProbeDecisionSource();
+        return (run, player);
+    }
+
+    private static MapPoint PickFirstByColumn(IEnumerable<MapPoint> points) =>
+        points.OrderBy(point => point.coord.col).First();
+
+    /// <summary>只用于把 run 推到"最终幕 Boss 已清"这一步的探针决策源。</summary>
+    private sealed class ArchitectProbeDecisionSource : IRunDecisionSource
+    {
+        public Task<MapPoint> ChooseMapPointAsync(IReadOnlyList<MapPoint> options) =>
+            Task.FromResult(PickFirstByColumn(options));
+
+        public Task<CombatDecision> ChooseCombatActionAsync(CombatState state) =>
+            Task.FromResult<CombatDecision>(new CombatDecision.EndTurn());
+
+        public Task<RewardDecision> ChooseRewardActionAsync(RewardsSet rewards) =>
+            Task.FromResult(RewardDecisionClassifier.ChooseDefault(rewards));
+    }
+
+    /// <summary>单幕测试 Act：所有战斗都用会自杀的探针怪物。</summary>
+    private sealed class ArchitectProbeAct : ActDefinition
+    {
+        private static readonly IReadOnlyList<EncounterDefinition> Encounters =
+        [
+            new EncounterDefinition(
+                () => (MonsterModel)ModelDb.Monster<SelfDefeatingProbeMonster>().MutableClone(),
+                tags: null,
+                isWeak: false,
+                name: "architect-probe-self-defeating"),
+        ];
+
+        public override int Index => 0;
+
+        public override IReadOnlyList<Type> EventPool => Array.Empty<Type>();
+
+        public override IReadOnlyList<Type> AncientPool => [typeof(Neow)];
+
+        public override int BaseNumberOfRooms => 15;
+
+        public override int NumberOfWeakEncounters => 0;
+
+        protected override IReadOnlyList<EncounterDefinition> MonsterEncounters => Encounters;
+
+        protected override IReadOnlyList<EncounterDefinition> EliteEncounters => Encounters;
+
+        protected override IReadOnlyList<EncounterDefinition> BossEncounters => Encounters;
+
+        public override MapPointTypeCounts GetMapPointTypes(Rng mapRng) => new(12, 7);
+    }
+
+    /// <summary>第一回合就自己掉光血量的怪物，让"只结束回合"的探针能打赢 Boss。</summary>
+    private sealed class SelfDefeatingProbeMonster : MonsterModel
+    {
+        public override int MinInitialHp => 1;
+
+        public override int MaxInitialHp => 1;
+
+        protected override MonsterMoveStateMachine GenerateMoveStateMachine()
+        {
+            var expire = new MoveState(
+                "EXPIRE",
+                async _ => await CreatureCmd.LoseHp(
+                    Creature.CombatState!.RunState,
+                    Creature,
+                    Creature.CurrentHp,
+                    ValueProp.Unblockable | ValueProp.Unpowered),
+                new DefendIntent());
+            expire.FollowUpState = expire;
+            return new MonsterMoveStateMachine([expire], expire);
+        }
+    }
+}
