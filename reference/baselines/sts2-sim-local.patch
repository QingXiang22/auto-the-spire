diff --git a/src/Sts2Sim.Core/Models/CardModel.cs b/src/Sts2Sim.Core/Models/CardModel.cs
index 71b1fef..834d757 100644
--- a/src/Sts2Sim.Core/Models/CardModel.cs
+++ b/src/Sts2Sim.Core/Models/CardModel.cs
@@ -92,6 +92,28 @@ public abstract class CardModel : AbstractModel, ICombatStateDescriptionContribu
     /// <summary>Energy cost after ordered card-local changes, before combat-wide cost hooks.</summary>
     public int LocalEnergyCost => ResolveLocalEnergyCost();
 
+    /// <summary>原版 <c>CardEnergyCost._base</c>（即 <c>GetWithModifiers(CostModifiers.None)</c> 返回值）：
+    /// 卡牌“印在纸面上”的基础费用，含升级与其它永久改动，不含卡牌本地修饰符与战斗全局 hook。
+    /// 原版对 <c>CostsX</c> 与负数基础费用都直接返回 <c>_base</c>，这里同义。</summary>
+    internal int BaseEnergyCost => CanonicalEnergyCost - _energyCostUpgradeDelta;
+
+    /// <summary>逐字移植 <c>MegaCrit.Sts2.Core.Entities.Cards.CardEnergyCost.UpgradeBy</c> 的费用预算部分
+    /// （<c>TezcatarasEmber.OnEnchant</c> 用 <c>UpgradeBy(-GetWithModifiers(CostModifiers.None))</c> 把基础费用压到 0）。
+    /// 偏离：省略 <c>WasJustUpgraded</c>（升级预览高亮）与 <c>EnergyCostChanged</c> 事件（本项目无 UI），
+    /// 并省略原版按新基础费用收紧 <c>LocalCostType.Absolute</c> 本地修饰符的那一段——本项目唯一会调用它的
+    /// <c>TezcatarasEmber</c> 只在牌组层面附魔，此时卡上不可能已有绝对型本地费用修饰符。</summary>
+    internal void UpgradeEnergyCostBy(int addend)
+    {
+        AssertMutable();
+        if (IsXEnergyCost || addend == 0)
+        {
+            return;
+        }
+
+        int newBaseCost = Math.Max(BaseEnergyCost + addend, 0);
+        _energyCostUpgradeDelta = CanonicalEnergyCost - newBaseCost;
+    }
+
     /// <summary>Upgraded base costs, excluding card-local changes and combat-wide hooks.</summary>
     internal bool HasPositiveBaseEnergyOrStarCost =>
         (!IsXEnergyCost && CanonicalEnergyCost - _energyCostUpgradeDelta > 0) || CanonicalStarCost > 0;
