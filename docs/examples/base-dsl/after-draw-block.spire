using namespace base-spire;
dsl_version = "core/0.3"

# Teaching rule: a development relic, not an original-game implementation.
template AfterDrawBlockRelic {
  parameters = {
    definition = { type = String(length = 64) }
    amount = { type = Int(min = 0, max = 999) }
  }
  body = {
    procedure WhenDrawn {
      parameters = { owner = Ref(Player) card = Ref(Card) listener = Ref(Relic) }
      body = {
        call = { procedure = GainUnpoweredBlock args = { owner = owner amount = arg(amount) } }
      }
    }
    subscription OnDraw {
      event = AfterCardDrawn
      reaction = WhenDrawn
      instances = where(collection(Relics), r, and(equal(field(r, Relic.Holder), owner), and(not(field(r, Relic.IsMelted)), equal(field(r, Relic.DefinitionId), arg(definition)))))
      instance_order = collectionIndex(Relics, listener)
      priority = 100
    }
    action Obtain {
      role = player
      requires = not(exists(where(collection(Relics), relic, equal(field(relic, Relic.DefinitionId), arg(definition)))))
      body = { call = { procedure = ObtainRelic args = { owner = first(type(Player)) definition = arg(definition) } } }
    }
  }
}
