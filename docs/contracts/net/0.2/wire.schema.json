        "unsupported_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "coverage_ref": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "id",
        "semantic_version",
        "required_declarations",
        "supported_mechanism_ids",
        "unsupported_constraints",
        "coverage_ref"
      ],
      "additionalProperties": false
    },
    "SupportedStructure": {
      "type": "object",
      "properties": {
        "structure": {
          "enum": [
            "Entity",
            "Relation",
            "Pile",
            "Sequence",
            "Group",
            "LegalAction",
            "TerminalResult"
          ]
        },
        "declaration_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        },
        "unsupported_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "structure",
        "declaration_ids",
        "unsupported_constraints"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "entities": {
