{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "net-the-spire 公开协议 v0.2 wire schema",
  "description": "由 docs/contracts/net/0.1/wire.schema.json 派生（见 net-the-spire/tools/emit_wire_schema_0_2.py），只应用 docs/design/net-the-spire/protocol.md §7 列出的 0.2 差异：协议版本常量、start.seed 为非空游戏字符串、start 成功结果多一个实际 seed、以及新增 string 值类型。结构其余部分与 0.1 逐字节相同。",
  "$comment": "ENV-T03：0.2 只对正式单人构建开放，0.1 保留旧切片/作者场景；两版本常量各自精确相等，不自动降级。",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    },
    {
      "$ref": "#/$defs/PublicCatalog"
    },
    {
      "$ref": "#/$defs/PublicSnapshot"
    }
  ],
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1,
      "description": "非空字符串。协议中 id 均为带命名空间的 ID（§1 第 30 行）；命名空间语法未逐字给出。"
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "not": {
        "const": "-0"
      },
      "description": "规范十进制字符串：可选负号；整数部分为 0 或无前导零十进制；小数部分末位非零；绝对值小于 1 允许 0.xxx 与 -0.xxx；负零写 \"0\"；无前导 +、无指数形式、无逗号（contract-artifacts.md §2 第 19 行；protocol.md §2 第 73、77 行）。R-P01 2026-10-01 修正：原模式 ^(0|-?[1-9][0-9]*)(\\.[0-9]*[1-9])?$ 会错误拒绝 contract-artifacts 明确允许的 -0.xxx。"
    },
    "SafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "结构整数：JSON 整数，范围 0 到 2^53-1，超出拒绝配置（§2 第 73 行）。"
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "正整数（§2 第 90 行 multiplicity；也用于 maxItems 类上限）。"
    },
    "NullableNonEmptyString": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonEmptyString"
        },
        {
          "type": "null"
        }
      ],
      "description": "协议标注『可 null』的字符串键（§1 第 42 行）。"
    },
    "IdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      },
      "description": "声明 ID 数组（entity_kinds/kind_id 家族/owner/member/source/target 等）。空表为 []（§1 第 28、30 行）。"
    },
    "FieldIdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      },
      "description": "字段 ID 数组（required_fields/optional_fields，§1 第 45、46 行）。"
    },
    "EntityRefList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      },
      "description": "实体引用（instance_id）数组（§2 第 82、90 行）。"
    },
    "Operation": {
      "enum": [
        "describe",
        "get_catalog",
        "start",
        "attach",
        "observe",
        "step",
        "request_status",
        "close"
      ],
      "description": "控制接口操作名（§4 表 第 168-175 行）。"
    },
    "ValueType": {
      "enum": [
        "number",
        "boolean",
        "category",
        "entity_ref",
        "string"
      ],
      "description": "字段声明 value_type（§1 第 30、40 行；§2 表 第 66-71 行）。0.2 新增 string（§7）：公开字符串原样编码，不是类别词表。"
    },
    "NumberFormat": {
      "enum": [
        "integer",
        "decimal"
      ],
      "description": "number 字段的 number_format（§1 第 30、40 行）。"
    },
    "Visibility": {
      "enum": [
        "public",
        "conditional"
      ],
      "description": "字段声明 visibility（§1 第 40、48 行）。"
    },
    "ContentState": {
      "enum": [
        "known",
        "unknown",
        "unavailable",
        "not_applicable"
      ],
      "description": "Entity.content_state（§2 第 62 行）。"
    },
    "FieldState": {
      "enum": [
        "known",
        "unknown",
        "unavailable"
      ],
      "description": "Field.state（§2 第 64 行）。"
    },
    "SnapshotStatus": {
      "enum": [
        "decision",
        "terminal"
      ],
      "description": "PublicSnapshot.status（§2 第 58 行）。"
    },
    "Outcome": {
      "enum": [
        "win",
        "loss",
        "other"
      ],
      "description": "终局 outcome（§2 第 58 行；§1 第 46 行 terminal_reasons.outcome）。"
    },
    "SessionStatus": {
      "enum": [
        "active",
        "settling",
        "terminal",
        "uncertain",
        "stopped",
        "faulted",
        "closed"
      ],
      "description": "会话状态（§5 第 183 行；§4 observe 结果 session_status 第 172 行）。"
    },
    "AvailabilityState": {
      "enum": [
        "available",
        "unavailable"
      ],
      "description": "field_availability 取值（§1 第 50 行）。"
    },
    "ExecutionState": {
      "enum": [
        "not_started",
        "completed",
        "unknown"
      ],
      "description": "error.execution_state（§6 第 195 行；§5 第 185 行）。"
    },
    "RetryMode": {
      "enum": [
        "correct_input",
        "query_request",
        "stop"
      ],
      "description": "error.retry_mode（§6 第 195、205 行）。"
    },
    "ErrorCode": {
      "enum": [
        "version_mismatch",
        "unsupported_capability",
        "invalid_input",
        "unknown_type",
        "dangling_reference",
        "stale_observation",
        "illegal_candidate",
        "request_conflict",
        "session_busy",
        "capacity_exceeded",
        "session_not_found",
        "session_closed",
        "backend_fault",
        "outcome_unknown"
      ],
      "description": "错误码全集（§6 表 第 197-205 行）。"
    },
    "RequestStatus": {
      "enum": [
        "pending",
        "completed",
        "not_found",
        "outcome_unknown"
      ],
      "description": "request_status 结果 status（§4 第 174 行）。"
    },
    "Identity": {
      "type": "object",
      "description": "identity 四元组（§1 第 28 行）。",
      "required": [
        "protocol_version",
        "ruleset_id",
        "catalog_id",
        "backend_profile_id"
      ],
      "properties": {
        "protocol_version": {
          "const": "0.2",
          "description": "net 协议版本；0.2 与目录/快照必须一致地写 \"0.2\"，与 0.1 精确区分（protocol.md §7）。"
        },
        "ruleset_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "catalog_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "backend_profile_id": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "AppliesTo": {
      "type": "object",
      "description": "字段声明的适用集合（§1 第 40 行）。",
      "required": [
        "entity_kinds",
        "action_types",
        "terminal_reasons"
      ],
      "properties": {
        "entity_kinds": {
          "$ref": "#/$defs/IdList"
        },
        "action_types": {
          "$ref": "#/$defs/IdList"
        },
        "terminal_reasons": {
          "$ref": "#/$defs/IdList"
        }
      },
      "additionalProperties": false
    },
    "EntityKindDeclaration": {
      "type": "object",
      "description": "entity_kinds 声明项（§1 表 第 38 行）。",
      "required": [
        "id",
        "semantic_version",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ContentTypeDeclaration": {
      "type": "object",
      "description": "content_types 声明项（§1 表 第 39 行）。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "kind_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "kind_ids": {
          "$ref": "#/$defs/IdList"
        }
      },
      "additionalProperties": false
    },
    "FieldDeclaration": {
      "type": "object",
      "description": "fields 声明项（§1 表 第 40 行）。类型专用键按 value_type / visibility 条件出现，未列的类型专用键不得混入其他值类型。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "value_type",
        "applies_to",
        "required",
        "visibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "value_type": {
          "$ref": "#/$defs/ValueType"
        },
        "applies_to": {
          "$ref": "#/$defs/AppliesTo"
        },
        "required": {
          "type": "boolean",
          "description": "适用的声明 owner 必须带该字段（§1 第 48 行）。"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "number_format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "category_ids": {
          "$ref": "#/$defs/IdList"
        },
        "target_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "condition_description": {
          "type": "string"
        },
        "visibility_check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "description": "非空；指向场景覆盖表中的提供方机制检查（§1 第 40、48 行）。"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "number"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "required": [
              "number_format"
            ]
          },
          "else": {
            "not": {
              "required": [
                "number_format"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "category"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "required": [
              "category_ids"
            ]
          },
          "else": {
            "not": {
              "required": [
                "category_ids"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "entity_ref"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "required": [
              "target_kind_ids"
            ]
          },
          "else": {
            "not": {
              "required": [
                "target_kind_ids"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "conditional"
              }
            },
            "required": [
              "visibility"
            ]
          },
          "then": {
            "required": [
              "condition_description",
              "visibility_check_ids"
            ]
          },
          "else": {
            "not": {
              "required": [
                "condition_description",
                "visibility_check_ids"
              ]
            }
          }
        }
      ]
    },
    "PositionSchema": {
      "type": "object",
      "description": "位置声明 `{unit, origin, min, max}`，max 可 null（§1 第 41 行）。四个键均为字面列举，按全部 required 处理。",
      "required": [
        "unit",
        "origin",
        "min",
        "max"
      ],
      "properties": {
        "unit": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "origin": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "min": {
          "$ref": "#/$defs/SafeInteger"
        },
        "max": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafeInteger"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RelationTypeDeclaration": {
      "type": "object",
      "description": "relation_types 声明项（§1 表 第 41 行）。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "source_kind_ids",
        "target_kind_ids",
        "position_schema"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "source_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "target_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "position_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PileTypeDeclaration": {
      "type": "object",
      "description": "pile_types 声明项（§1 表 第 42 行）。kind_id 必须声明且不能被两个 pile_type 共用；后两个键无互斥组时为 null。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "kind_id",
        "member_kind_ids",
        "position_schema",
        "exclusive_group_id",
        "membership_scope_field_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "kind_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "member_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "position_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclusive_group_id": {
          "$ref": "#/$defs/NullableNonEmptyString"
        },
        "membership_scope_field_id": {
          "$ref": "#/$defs/NullableNonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "SequenceTypeDeclaration": {
      "type": "object",
      "description": "sequence_types 声明项（§1 表 第 43 行）。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "owner_kind_ids",
        "element_kind_ids",
        "min_count",
        "max_count"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "owner_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "element_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "min_count": {
          "type": "integer",
          "minimum": 0,
          "description": "基数下限。"
        },
        "max_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "基数上限，可 null（§1 第 43、44 行）。"
        }
      },
      "additionalProperties": false
    },
    "GroupTypeDeclaration": {
      "type": "object",
      "description": "group_types 声明项（§1 表 第 44 行）。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "owner_kind_ids",
        "member_kind_ids",
        "min_count",
        "max_count"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "owner_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "member_kind_ids": {
          "$ref": "#/$defs/IdList"
        },
        "min_count": {
          "type": "integer",
          "minimum": 0,
          "description": "基数下限。"
        },
        "max_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "基数上限，可 null（§1 第 44 行）。"
        }
      },
      "additionalProperties": false
    },
    "ActionTypeDeclaration": {
      "type": "object",
      "description": "action_types 声明项（§1 表 第 45 行）。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "required_fields",
        "optional_fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "required_fields": {
          "$ref": "#/$defs/FieldIdList"
        },
        "optional_fields": {
          "$ref": "#/$defs/FieldIdList"
        }
      },
      "additionalProperties": false
    },
    "TerminalReasonDeclaration": {
      "type": "object",
      "description": "terminal_reasons 声明项（§1 表 第 46 行）。",
      "required": [
        "id",
        "semantic_version",
        "description",
        "outcome",
        "required_fields",
        "optional_fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "semantic_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "required_fields": {
          "$ref": "#/$defs/FieldIdList"
        },
        "optional_fields": {
          "$ref": "#/$defs/FieldIdList"
        }
      },
      "additionalProperties": false
    },
    "Declarations": {
      "type": "object",
      "description": "PublicCatalog.declarations 的九张声明表；空表为 []（§1 第 28 行）。",
      "required": [
        "entity_kinds",
        "content_types",
        "fields",
        "relation_types",
        "pile_types",
        "sequence_types",
        "group_types",
        "action_types",
        "terminal_reasons"
      ],
      "properties": {
        "entity_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityKindDeclaration"
          }
        },
        "content_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentTypeDeclaration"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldDeclaration"
          }
        },
        "relation_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelationTypeDeclaration"
          }
        },
        "pile_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PileTypeDeclaration"
          }
        },
        "sequence_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequenceTypeDeclaration"
          }
        },
        "group_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupTypeDeclaration"
          }
        },
        "action_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionTypeDeclaration"
          }
        },
        "terminal_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TerminalReasonDeclaration"
          }
        }
      },
      "additionalProperties": false
    },
    "PublicCatalog": {
      "type": "object",
      "description": "PublicCatalog = {protocol_version, ruleset_id, catalog_id, declarations}（§1 第 28 行）。",
      "required": [
        "protocol_version",
        "ruleset_id",
        "catalog_id",
        "declarations"
      ],
      "properties": {
        "protocol_version": {
          "const": "0.2",
          "description": "net 协议版本；0.2 与目录/快照必须一致地写 \"0.2\"，与 0.1 精确区分（protocol.md §7）。"
        },
        "ruleset_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "catalog_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "declarations": {
          "$ref": "#/$defs/Declarations"
        }
      },
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "backend_kind": {
          "enum": [
            "simulation",
            "real_game"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "uniqueItems": true
        },
        "scenario_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioProfile"
          }
        },
        "seed_control": {
          "type": "boolean"
        },
        "field_availability": {
          "type": "object",
