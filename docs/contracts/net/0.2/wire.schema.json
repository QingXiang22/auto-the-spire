        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        },
        "piles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pile"
          }
        },
        "sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sequence"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "legal_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegalAction"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "decision"
