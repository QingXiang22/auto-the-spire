    "ExecutionGuarantees": {
      "type": "object",
      "properties": {
        "stable_snapshot": {
          "type": "boolean"
        },
        "request_status": {
          "type": "boolean"
        },
        "active_deduplication": {
          "type": "boolean"
        },
        "decision_pause": {
          "type": "boolean"
        },
        "internal_snapshot_restore": {
          "type": "boolean"
        },
        "seed_action_replay": {
          "enum": [
            "none",
            "public_trace"
          ]
        },
        "public_state_restore": {
          "const": false
        },
        "public_fork": {
          "const": false
        },
        "rng_profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stable_snapshot",
        "request_status",
        "active_deduplication",
        "decision_pause",
        "internal_snapshot_restore",
        "seed_action_replay",
        "public_state_restore",
        "public_fork",
        "rng_profile_id"
      ],
      "additionalProperties": false
    },
    "SessionSeed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical unsigned 64-bit decimal string. Cross-structure validation must also reject values above 18446744073709551615."
    },
    "AttachResult": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "session_status": {
          "enum": [
            "active",
            "terminal",
            "settling"
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/PublicSnapshot"
        }
      },
      "required": [
        "session_id",
        "session_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "session_status": {
                "enum": [
                  "active",
                  "terminal"
                ]
              }
            },
            "required": [
              "session_status"
            ]
          },
          "then": {
            "required": [
              "snapshot"
            ]
          },
          "else": {
            "not": {
              "required": [
                "snapshot"
              ]
            }
          }
        }
      ]
    },
    "CloseResult": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "session_status": {
          "const": "closed"
        }
      },
      "required": [
        "session_id",
        "session_status"
      ],
      "additionalProperties": false
    },
    "GameSeedString": {
      "type": "string",
      "minLength": 1,
      "description": "0.2 的每局游戏 seed 字符串（protocol.md §7）：非空；net 不 trim、不改大小写、不数值强转，具体校验/标准化由规则提供方执行。旧的规范 uint64 十进制编码（SessionSeed）只在 0.1 保留。"
    }
  }
